#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'USAGE'
Usage: autobuild [--copr owner/project] PATH

Options:
  --copr VALUE   Set COPR for the build command, e.g. --copr lacamar/arm64-misc
  -h, --help     Show this help
USAGE
}

COPR_VALUE="${COPR:-}"
SPECFILE_ARG=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --copr)
            [[ $# -ge 2 ]] || { echo "Missing value for --copr" >&2; usage >&2; exit 1; }
            COPR_VALUE="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
        *)
            if [[ -z "$SPECFILE_ARG" ]]; then
                SPECFILE_ARG="$1"
            else
                echo "Unexpected extra argument: $1" >&2
                usage >&2
                exit 1
            fi
            shift
            ;;
    esac
done

if [[ $# -gt 0 ]]; then
    if [[ -z "$SPECFILE_ARG" && $# -eq 1 ]]; then
        SPECFILE_ARG="$1"
    else
        echo "Unexpected extra arguments: $*" >&2
        usage >&2
        exit 1
    fi
fi

[[ -n "$SPECFILE_ARG" ]] || { echo "Missing PATH argument" >&2; usage >&2; exit 1; }
[[ -n "$COPR_VALUE" ]] || { echo "COPR is not set. Use --copr owner/project or export COPR first." >&2; exit 1; }

export COPR="$COPR_VALUE"
TARGET_PATH="$(realpath "$SPECFILE_ARG")"

if [[ -d "$TARGET_PATH" ]]; then
    shopt -s nullglob
    specfiles=("$TARGET_PATH"/*.spec)
    shopt -u nullglob

    if (( ${#specfiles[@]} == 0 )); then
        echo "No .spec files found in directory: $TARGET_PATH" >&2
        exit 1
    fi

    overall_status=0
    for f in "${specfiles[@]}"; do
        "$0" --copr "$COPR" "$f" || overall_status=$?
    done
    exit "$overall_status"
fi

echo "==> Start AutoBuild ----------------------------------------------------------------
"

export OS_VER=fedora-43-aarch64
export SPECFILE="$TARGET_PATH"
export BUILD_CMD="mx-rpm -c $OS_VER --copr $COPR"
export BRANCH="HEAD"

export NAME=$(rpmspec -P "$SPECFILE" | awk '/^Name:/ {print $2; exit}')
export VERSION=$(rpmspec -P "$SPECFILE" | awk '/^Version:/ {print $2; exit}')
export URL=$(rpmspec -P "$SPECFILE" | awk '/^URL:/ {print $2; exit}')
export SRC0=$(rpmspec -P "$SPECFILE" | awk '/^Source0:/ { sub(/^Source0:[ \t]*/, "", $0); print; exit }')

derive_repo_url() {
    local src0="$1"
    case "$src0" in
        */releases/download/*) printf '%s\n' "${src0%/releases/download/*}" ;;
        */-/archive/*)         printf '%s\n' "${src0%/-/archive/*}" ;;
        */archive/*)           printf '%s\n' "${src0%/archive/*}" ;;
        *)                     printf '%s\n' "${src0%/*}" ;;
    esac
}

derive_repo_url_from_goipath() {
    local goipath="$1"
    [[ -n "$goipath" ]] || return 1
    case "$goipath" in
        http://*|https://*) printf '%s
' "$goipath" ;;
        *) printf 'https://%s
' "$goipath" ;;
    esac
}

REPO_URL="$(derive_repo_url "$SRC0")"
if [[ -z "$REPO_URL" && -n "${URL:-}" ]]; then
    REPO_URL="$URL"
fi
if [[ -z "$REPO_URL" && -n "${GOIPATH:-}" ]]; then
    REPO_URL="$(derive_repo_url_from_goipath "$GOIPATH")"
fi

get_latest_tag_chrono() {
    local repo_url="$1"
    local tmpdir latest_tag

    tmpdir="$(mktemp -d)"
    cleanup_get_latest_tag_chrono() {
        rm -rf "$tmpdir"
    }
    trap cleanup_get_latest_tag_chrono RETURN

    git -C "$tmpdir" init -q
    git -C "$tmpdir" remote add origin "$repo_url"
    git -C "$tmpdir" -c protocol.version=2 fetch -q --depth=1 --filter=blob:none origin \
        '+refs/tags/*:refs/tags/*' || return 1

    latest_tag="$(
        git -C "$tmpdir" for-each-ref \
            --sort=-creatordate \
            --format='%(refname:strip=2)' \
            refs/tags \
        | head -n1
    )"

    printf '%s\n' "$latest_tag"
}

normalize_tag_to_numeric() {
    local tag="$1"
    printf '%s\n' "$tag" | tr -cd '0-9.\n'
}

apply_numeric_template() {
    local template_tag="$1"
    local upstream_tag="$2"
    local upstream_numeric prefix numeric suffix

    upstream_numeric="$(normalize_tag_to_numeric "$upstream_tag")"
    [[ -n "$upstream_numeric" ]] || return 1

    if [[ "$template_tag" =~ ^([^0-9]*)([0-9]+(\.[0-9]+)*)([^0-9]*)$ ]]; then
        prefix="${BASH_REMATCH[1]}"
        numeric="${BASH_REMATCH[2]}"
        suffix="${BASH_REMATCH[4]}"
        printf '%s\n' "${prefix}${upstream_numeric}${suffix}"
    else
        printf '%s\n' "$upstream_numeric"
    fi
}

get_latest_commit() {
    local repo_url="$1"
    local branch="$2"
    git ls-remote "$repo_url" "$branch" 2>/dev/null | awk 'NR==1 { print $1; exit }'
}

echo "==> SPECFILE:     $SPECFILE"
echo "==> NVR:          $NAME-$VERSION"
echo "==> BASE URL:     $REPO_URL"
echo "==> COPR REPO:    $COPR"

current_commit="$(awk '/^%global[[:space:]]+commit[[:space:]]+/ {print $3; exit}' "$SPECFILE" || true)"
has_commit=0
if [[ -n "${current_commit:-}" ]]; then
    has_commit=1
fi

current_tag="$(awk '/^%global[[:space:]]+tag[[:space:]]+[^[:space:]]+[[:space:]]*$/ {print $3; exit}' "$SPECFILE" || true)"
tag_target='global_tag'
if [[ -n "${current_tag:-}" ]]; then
    case "$current_tag" in
        '%{version}'|'%{Version}'|'%{VERSION}')
            current_tag="$VERSION"
            ;;
    esac
fi
if [[ -z "${current_tag:-}" ]]; then
    current_tag="$VERSION"
    tag_target='version'
fi

latest_commit=""
if [[ "$has_commit" -eq 1 ]]; then
    latest_commit="$(get_latest_commit "$REPO_URL" "$BRANCH")"
    if [[ -z "${latest_commit:-}" && -n "${URL:-}" && "$URL" != "$REPO_URL" ]]; then
        fallback_commit="$(get_latest_commit "$URL" "$BRANCH")"
        if [[ -n "${fallback_commit:-}" ]]; then
            REPO_URL="$URL"
            latest_commit="$fallback_commit"
        fi
    fi
    if [[ -z "${latest_commit:-}" ]]; then
        echo "==> Failed to get latest commit from $REPO_URL $BRANCH"
        echo "------------------------------------------------------------------------------------" >&2
        exit 1
    fi
fi

latest_raw_tag="$(get_latest_tag_chrono "$REPO_URL" || true)"
latest_tag=""
if [[ -n "${latest_raw_tag:-}" ]]; then
    latest_tag="$(apply_numeric_template "$current_tag" "${latest_raw_tag}")" || latest_tag="$(normalize_tag_to_numeric "${latest_raw_tag}")"
fi

commit_changed=0
tag_changed=0

if [[ "$has_commit" -eq 1 && -n "${latest_commit:-}" && "$latest_commit" != "$current_commit" ]]; then
    commit_changed=1
    echo "==> New commit detected:"
    echo "==>   old: $current_commit"
    echo "==>   new: $latest_commit"
    echo
fi

if [[ -n "${current_tag:-}" && -n "${latest_tag:-}" && "$latest_tag" != "$current_tag" ]]; then
    tag_changed=1
    echo "==> New tag detected:"
    echo "==>   old: $current_tag"
    echo "==>   new: $latest_tag"
    echo
fi

if [[ "$commit_changed" -eq 0 && "$tag_changed" -eq 0 ]]; then
    echo "==> No new upstream commit or tag. Nothing to do."
    echo "------------------------------------------------------------------------------------"
    exit 0
fi

ORIGINAL_SPECFILE_BACKUP="$(mktemp)"
cp -a -- "$SPECFILE" "$ORIGINAL_SPECFILE_BACKUP"
restore_original_specfile() {
    if [[ -f "$ORIGINAL_SPECFILE_BACKUP" ]]; then
        cp -a -- "$ORIGINAL_SPECFILE_BACKUP" "$SPECFILE"
        rm -f -- "$ORIGINAL_SPECFILE_BACKUP"
    fi
}
cleanup_original_specfile_backup() {
    rm -f -- "$ORIGINAL_SPECFILE_BACKUP"
}

# Start file changes here. Tag updates must happen first.
if [[ "$tag_changed" -eq 1 ]]; then
    if [[ "$tag_target" == 'global_tag' ]]; then
        sed -Ei "s|^%global[[:space:]]+tag[[:space:]]+[^[:space:]]+[[:space:]]*$|%global tag ${latest_tag}|" "$SPECFILE"
        sed -Ei 's|^%global[[:space:]]+bumpver[[:space:]]+[0-9]+[[:space:]]*$|%global bumpver 0|' "$SPECFILE"
    else
        sed -Ei "s|^Version:[[:space:]]+[^[:space:]]+[[:space:]]*$|Version:        ${latest_tag}|" "$SPECFILE"
    fi
fi

if [[ "$commit_changed" -eq 1 ]]; then
    sed -Ei "s|^%global[[:space:]]+commit[[:space:]]+[0-9a-f]{7,40}[[:space:]]*$|%global commit ${latest_commit}|" "$SPECFILE"
fi

if [[ "$tag_changed" -eq 0 && "$commit_changed" -eq 1 ]]; then
    perl -0pi -e '
      s/^%global\h+bumpver\h+(\d+)\h*$/"%global bumpver " . ($1 + 1)/me;
    ' "$SPECFILE"
fi

if [[ "$tag_changed" -eq 1 ]]; then
    VR=$(rpmspec -q --srpm --qf '%{version}-%{release}\n' "$SPECFILE" | head -n1)
    VR=${VR%.*}
    entry=$(printf '* %s %s - %s\n - Update to %s\n' \
        "$(LC_ALL=C date '+%a %b %d %Y')" \
        "$(rpmdev-packager)" \
        "$VR" \
        "$latest_tag")
else
    VR=$(rpmspec -q --srpm --qf '%{version}-%{release}\n' "$SPECFILE" | head -n1)
    VR=${VR%.*}
    entry=$(printf '* %s %s - %s\n - Update to commit %s\n' \
        "$(LC_ALL=C date '+%a %b %d %Y')" \
        "$(rpmdev-packager)" \
        "$VR" \
        "$latest_commit")
fi

ENTRY="$entry" perl -0pi -e '
    my $entry = $ENV{ENTRY} . "\n";
    s/^(%changelog\s*\n)/$1$entry\n/m;
' "$SPECFILE"

echo "==> Running AutoBuild: ${BUILD_CMD} $SPECFILE"

if ! $BUILD_CMD $SPECFILE; then
    echo "==> Build failed. Restoring original specfile."
    restore_original_specfile
    echo "------------------------------------------------------------------------------------" >&2
    exit 1
fi

cleanup_original_specfile_backup
echo "------------------------------------------------------------------------------------"
