#!/usr/bin/env bash
# pre-commit: staged specs need a new %changelog entry with "- " bullets
rc=0
while IFS=$'\t' read -r st f; do
  added=$(git diff --cached -U0 -- "$f" | grep '^+[^+]')
  if grep -q '^+ - ' <<<"$added"; then
    echo "$f: changelog bullet ' - ', use '- '" >&2; rc=1
  fi
  if [[ $st == M ]] && ! git show ":$f" | grep -q '%autochangelog' \
     && ! grep -qE '^\+\* [A-Z][a-z]{2} [A-Z][a-z]{2} +[0-9]+ [0-9]{4} ' <<<"$added"; then
    echo "$f: no new %changelog entry" >&2; rc=1
  fi
done < <(git diff --cached --name-status --diff-filter=AM -- '*.spec')
exit $rc
