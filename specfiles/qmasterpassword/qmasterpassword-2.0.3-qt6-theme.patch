From fdbd728d3c0701d286ab397c5c6ba4360c31c2f6 Mon Sep 17 00:00:00 2001
From: lm <lchlnm@pm.me>
Date: Thu, 8 Oct 2026 00:25:46 +0200
Subject: [PATCH] Qt6-only, theme icons, palette-aware identicon

---
 CMakeLists.txt                  | 34 +++++++--------------------------
 include/main_window.h           |  1 +
 include/user_widget.h           |  3 +++
 src/identicon.cpp               |  6 +++++-
 src/main_class.cpp              |  7 +------
 src/main_window.cpp             | 11 +++++++++--
 src/pushbutton_delegate.cpp     |  6 +++---
 src/user_widget.cpp             |  6 ++++++
 ui/main_window.ui               |  6 +++---
 ui/password_generator_widget.ui |  2 +-
 ui/user_widget.ui               |  2 +-
 11 files changed, 40 insertions(+), 44 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 388928c..825dda6 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -7,11 +7,9 @@ set(CMAKE_AUTORCC ON)
 set(CMAKE_INCLUDE_CURRENT_DIR ON)
 set(CMAKE_SKIP_RPATH ON)
 
-find_package(QT NAMES Qt5 Qt6 REQUIRED COMPONENTS Core)
-find_package(Qt${QT_VERSION_MAJOR} REQUIRED COMPONENTS Gui Widgets
-                                                       LinguistTools)
+find_package(Qt6 6.5 REQUIRED COMPONENTS Core Gui Widgets LinguistTools)
 if(CMAKE_BUILD_TYPE STREQUAL Debug)
-    find_package(Qt${QT_VERSION_MAJOR} REQUIRED COMPONENTS Test)
+    find_package(Qt6 REQUIRED COMPONENTS Test)
 endif()
 find_package(OpenSSL REQUIRED)
 find_package(Threads REQUIRED)
@@ -24,30 +22,12 @@ set_source_files_properties(
     ${TS_FILES} PROPERTIES OUTPUT_LOCATION "${CMAKE_CURRENT_BINARY_DIR}/translations")
 # cmake-format: on
 
-if(QT_VERSION LESS 6.3.0)
-    # manual project setup for older Qt versions
-    set(CMAKE_AUTOMOC ON)
-    set(CMAKE_AUTOUIC ON)
-    set(USE_FOLDERS ON)
-    set(QT_TARGET_FOLDER QtInternalTargets)
-    include(GNUInstallDirs)
-
-    if(QT_VERSION LESS 6.0.0)
-        qt5_add_translation(QM_FILES ${TS_FILES})
-    else()
-        qt6_add_translation(QM_FILES ${TS_FILES})
-    endif()
-
-    add_executable(${TARGET} WIN32 ${QM_FILES})
-else()
-    # only available in qt >= 6.3.0
-    qt_standard_project_setup()
+qt_standard_project_setup()
 
-    qt_add_executable(${TARGET} WIN32)
+qt_add_executable(${TARGET} WIN32)
 
-    qt_add_lrelease(${TARGET} TS_FILES ${TS_FILES} QM_FILES_OUTPUT_VARIABLE
-                    QM_FILES)
-endif()
+qt_add_lrelease(${TARGET} TS_FILES ${TS_FILES} QM_FILES_OUTPUT_VARIABLE
+                QM_FILES)
 
 option(DISABLE_FILL_FORM_SHORTCUTS "Build without fill form support" OFF)
 if(DISABLE_FILL_FORM_SHORTCUTS)
@@ -71,7 +51,7 @@ target_link_libraries(${TARGET} PRIVATE Qt::Core Qt::Gui Qt::Widgets
 target_include_directories(${TARGET} PRIVATE ${OPENSSL_INCLUDE_DIR})
 
 if(UNIX)
-    find_package(Qt${QT_VERSION_MAJOR} REQUIRED COMPONENTS DBus)
+    find_package(Qt6 REQUIRED COMPONENTS DBus)
     target_link_libraries(${TARGET} PRIVATE Qt::DBus scrypt)
 
     if(NOT DISABLE_FILL_FORM_SHORTCUTS)
diff --git a/include/main_window.h b/include/main_window.h
index 29237a3..2fb068a 100644
--- a/include/main_window.h
+++ b/include/main_window.h
@@ -185,6 +185,7 @@ class MainWindow : public QMainWindow {
 
    protected:
     void closeEvent(QCloseEvent* event);
+    void changeEvent(QEvent* event);
     bool eventFilter(QObject* obj, QEvent* event);
 };
 
diff --git a/include/user_widget.h b/include/user_widget.h
index fb23118..f0ced23 100644
--- a/include/user_widget.h
+++ b/include/user_widget.h
@@ -40,6 +40,9 @@ class UserWidget : public QDialog {
 
     bool checkPasswordOnLogin() const;
 
+   protected:
+    void changeEvent(QEvent* event);
+
    private:
     Ui::UserWidget* ui;
     Identicon m_identicon;
diff --git a/src/identicon.cpp b/src/identicon.cpp
index 61eb5d2..3abd9f1 100644
--- a/src/identicon.cpp
+++ b/src/identicon.cpp
@@ -17,6 +17,9 @@
 #include "crypto.h"
 #include "crypto_functions.h"
 
+#include <QGuiApplication>
+#include <QPalette>
+
 const char* const Identicon::left_arm[] = {
     reinterpret_cast<const char*>(u8"\u2554"),
     reinterpret_cast<const char*>(u8"\u255a"),
@@ -90,5 +93,6 @@ void Identicon::getIdenticon(const QString& master_password, QString& identicon,
     identicon += body[seed_bytes[1] % arraySize(body)];
     identicon += right_arm[seed_bytes[2] % arraySize(right_arm)];
     identicon += accessory[seed_bytes[3] % arraySize(accessory)];
-    color = colors_dark[seed_bytes[4] % arraySize(colors_dark)];
+    const bool dark = QGuiApplication::palette().color(QPalette::Window).lightness() < 128;
+    color = (dark ? colors_light : colors_dark)[seed_bytes[4] % arraySize(colors_dark)];
 }
diff --git a/src/main_class.cpp b/src/main_class.cpp
index 2a361d4..c67d5cc 100644
--- a/src/main_class.cpp
+++ b/src/main_class.cpp
@@ -152,12 +152,7 @@ void CMain::loadTranslation()
     QString src_app_trans_path = bin_path + QLatin1String("/translations");
     // installed translation path
     QString app_trans_path = bin_path + "/../share/" APP_NAME "/translations";
-    QString qt_trans_path =
-#if QT_VERSION < QT_VERSION_CHECK(6, 0, 0)
-        QLibraryInfo::location(QLibraryInfo::TranslationsPath);
-#else
-        QLibraryInfo::path(QLibraryInfo::TranslationsPath);
-#endif
+    QString qt_trans_path = QLibraryInfo::path(QLibraryInfo::TranslationsPath);
 
     // Try to load it first from app path (in case there's an updated
     // translation), if it fails it will try then from the Qt path.
diff --git a/src/main_window.cpp b/src/main_window.cpp
index 2301afc..6d45521 100644
--- a/src/main_window.cpp
+++ b/src/main_window.cpp
@@ -207,7 +207,7 @@ void MainWindow::addSiteToUI(UiSite& site)
     //simpler version to display a 'copy to clipboard' button
     // (but it will be hidden after filter changes)
     QPushButton* btn = new UserPushButton(site, "");
-    btn->setIcon(QIcon(":/copy.png"));
+    btn->setIcon(QIcon::fromTheme("edit-copy", QIcon(":/copy.png")));
     btn->setFixedWidth(btn->sizeHint().width());
     connect(btn, SIGNAL(clicked()), this, SLOT(copyPWToClipboardClicked()));
     m_ui->tblSites->setIndexWidget(m_proxy_model->mapFromSource(
@@ -814,7 +814,7 @@ void MainWindow::showHidePWClicked()
     if (!button) return;
     UiSite& site = button->site();
     site.password_visible = !site.password_visible;
-    button->setIcon(QIcon(site.password_visible ? ":/hidden.png" : ":/shown.png"));
+    button->setIcon(site.password_visible ? QIcon::fromTheme("view-hidden", QIcon(":/hidden.png")) : QIcon::fromTheme("view-visible", QIcon(":/shown.png")));
 
     for (int i = 0; i < m_sites_model->rowCount(); ++i) {
         TableItem* item = dynamic_cast<TableItem*>(m_sites_model->item(i, 0));
@@ -975,6 +975,13 @@ void MainWindow::uiLoginChanged()
     }
 }
 
+void MainWindow::changeEvent(QEvent* event)
+{
+    if (event->type() == QEvent::PaletteChange && !m_ui->lblIdenticon->text().isEmpty())
+        delayedIdenticonUpdate();
+    QMainWindow::changeEvent(event);
+}
+
 void MainWindow::delayedIdenticonUpdate()
 {
     QColor identicon_color;
diff --git a/src/pushbutton_delegate.cpp b/src/pushbutton_delegate.cpp
index 507284b..29c8b3f 100644
--- a/src/pushbutton_delegate.cpp
+++ b/src/pushbutton_delegate.cpp
@@ -50,17 +50,17 @@ QWidget* PushButtonDelegate::createEditor(QWidget* parent, const QStyleOptionVie
         return button;
     };
 
-    QPushButton* btn_copy = createButton(table_item->site(), QIcon(":/copy.png"));
+    QPushButton* btn_copy = createButton(table_item->site(), QIcon::fromTheme("edit-copy", QIcon(":/copy.png")));
     btn_copy->setToolTip(tr("Copy password to clipboard"));
     connect(btn_copy, SIGNAL(clicked()), &m_main_window, SLOT(copyPWToClipboardClicked()));
 
     QPushButton* btn_show =
         createButton(table_item->site(),
-                     QIcon(table_item->site().password_visible ? ":/hidden.png" : ":/shown.png"));
+                     table_item->site().password_visible ? QIcon::fromTheme("view-hidden", QIcon(":/hidden.png")) : QIcon::fromTheme("view-visible", QIcon(":/shown.png")));
     btn_show->setToolTip(tr("Show/hide password"));
     connect(btn_show, SIGNAL(clicked()), &m_main_window, SLOT(showHidePWClicked()));
 
-    QPushButton* btn_url = createButton(table_item->site(), QIcon(":/internet.png"));
+    QPushButton* btn_url = createButton(table_item->site(), QIcon::fromTheme("globe", QIcon(":/internet.png")));
     connect(btn_url, SIGNAL(clicked()), &m_main_window, SLOT(openUrlClicked()));
     btn_url->setToolTip(tr("Open URL"));
     btn_url->setEnabled(table_item->site().url != "");
diff --git a/src/user_widget.cpp b/src/user_widget.cpp
index f7ddd16..0397757 100644
--- a/src/user_widget.cpp
+++ b/src/user_widget.cpp
@@ -89,6 +89,12 @@ void UserWidget::checkInputValidity()
     }
 }
 
+void UserWidget::changeEvent(QEvent* event)
+{
+    if (event->type() == QEvent::PaletteChange) checkInputValidity();
+    QDialog::changeEvent(event);
+}
+
 bool UserWidget::checkPasswordOnLogin() const
 {
     return ui->chkCheckPassword->isChecked();
