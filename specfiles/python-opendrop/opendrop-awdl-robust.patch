+            with open(f"/sys/class/net/{self.config.interface}/address") as f:
+                m = bytes.fromhex(f.read().strip().replace(":", ""))
+        except (OSError, ValueError):
+            return []
+        return [bytes([169, 254, m[4], m[5]])]
