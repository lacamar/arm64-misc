+class DvzipReader(io.RawIOBase):
+    # x-dvzip: a cpio archive split into blocks of [u32 BE length][zlib stream], decoded as it arrives
+    def __init__(self, src):
+        self.src, self.buf = src, b""
+
+    def readable(self):
+        return True
+
+    def _exact(self, n):
+        out = bytearray()
+        while len(out) < n:
+            b = self.src.read(n - len(out))
+            if not b:
+                break
+            out += b
+        return bytes(out)
+
+    def readinto(self, buf):
+        while not self.buf:
+            head = self._exact(4)
+            if len(head) < 4:
+                return 0
+            self.buf = _dvzip_block(self._exact(int.from_bytes(head, "big")))
+        n = min(len(buf), len(self.buf))
+        buf[:n] = self.buf[:n]
+        self.buf = self.buf[n:]
+        return n
 
 
