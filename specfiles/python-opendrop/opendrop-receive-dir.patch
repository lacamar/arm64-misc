+def save_archive(archive, dest):
+    # iOS wraps each upload in NSIRD_AirDrop_* and adds ._ AppleDouble files
+    with tempfile.TemporaryDirectory(dir=dest, prefix=".airdrop-") as tmp:
+        cwd = os.getcwd()
+        os.chdir(tmp)
+        try:
+            libarchive.extract.extract_entries(archive)
+        finally:
+            os.chdir(cwd)
+        for root, _, names in os.walk(tmp):
+            for n in names:
+                if n.startswith("._"):
+                    os.remove(os.path.join(root, n))
+        for top in os.listdir(tmp):
+            path = os.path.join(tmp, top)
+            items = [os.path.join(path, n) for n in os.listdir(path)] if top.startswith("NSIRD_") and os.path.isdir(path) else [path]
+            for src in items:
+                base, ext = os.path.splitext(os.path.basename(src))
+                dst, i = os.path.join(dest, base + ext), 0
+                while os.path.exists(dst):
+                    i += 1
+                    dst = os.path.join(dest, f"{base} ({i}){ext}")
+                shutil.move(src, dst)
+
