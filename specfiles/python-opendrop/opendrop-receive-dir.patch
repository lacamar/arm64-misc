+def download_dir():
+    d = os.environ.get("XDG_DOWNLOAD_DIR")
+    if not d:
+        conf = os.path.join(
+            os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
+            "user-dirs.dirs",
+        )
+        try:
+            with open(conf) as f:
+                for ln in f:
+                    if ln.startswith("XDG_DOWNLOAD_DIR="):
+                        d = ln.split("=", 1)[1].strip().strip('"')
+        except OSError:
+            pass
+    return os.path.expandvars(d) if d else os.path.expanduser("~/Downloads")
