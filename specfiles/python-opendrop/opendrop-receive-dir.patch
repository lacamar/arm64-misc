+    def _persistent_service_id(self):
+        # a fresh id per run leaves stale devices cached on the sender
+        id_file = os.path.join(self.airdrop_dir, "service_id")
+        try:
+            with open(id_file) as f:
+                sid = f.read().strip()
+            if re.fullmatch(r"[0-9a-f]{12}", sid):
+                return sid
+        except OSError:
+            pass
+        sid = f"{random.randint(0, 0xFFFFFFFFFFFF):012x}"
+        os.makedirs(self.airdrop_dir, exist_ok=True)
+        with open(id_file, "w") as f:
+            f.write(sid)
+        return sid
