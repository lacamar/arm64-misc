+def _odc(name, mode, data=b"", mtime=0, ino=0, uid=501, gid=501, size=None):
+    n = name.encode() + b"\0"
+    return b"070707" + b"%06o%06o%06o%06o%06o%06o%06o%011o%06o%011o" % (
+        0, ino, mode, uid, gid, 1, 0, mtime, len(n), len(data) if size is None else size) + n + data
+
+
+def dvzip(file_path, block=1 << 17):
+    # what iOS sends: an odc cpio of "." and the file, split into [u32 BE len][zlib] blocks; bit 31 = stored
+    st = os.stat(file_path)
+    with open(file_path, "rb") as f:
+        data = f.read()
+    parts = [_odc(".", 0o40700, ino=1, mtime=int(st.st_mtime)),
+             _odc("./" + os.path.basename(file_path), 0o100644, ino=2, mtime=int(st.st_mtime), size=len(data))]
+    parts += [data[i:i + block] for i in range(0, len(data), block)]
+    trailer = _odc("TRAILER!!!", 0, uid=0, gid=0)
+    size = sum(map(len, parts)) + len(trailer)
+    parts.append(trailer + bytes(-size % 512))
+    out = b""
+    for raw in parts:
+        z = zlib.compress(raw)
+        out += (len(z).to_bytes(4, "big") + z) if len(z) < len(raw) else ((len(raw) | 1 << 31).to_bytes(4, "big") + raw)
+    return out
+
