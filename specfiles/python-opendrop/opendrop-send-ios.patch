--- a/opendrop/ble.py	1970-01-01 01:00:00.000000000 +0100
+++ b/opendrop/ble.py	2026-10-26 23:33:51.713333417 +0100
@@ -0,0 +1,109 @@
+import asyncio
+import contextlib
+import hashlib
+import logging
+import os
+import threading
+
+logger = logging.getLogger(__name__)
+
+PATH = "/org/opendrop/advertisement0"
+
+
+def airdrop_payload(ids=()):
+    # Apple continuity type 0x05: 8 zero bytes, version 1, first 2 bytes of SHA-256 of up to 4 contact ids, 0
+    h = b"".join(hashlib.sha256(i.encode()).digest()[:2] for i in list(ids)[:4]).ljust(8, b"\0")
+    return bytes([0x05, 0x12]) + bytes(8) + b"\x01" + h + b"\x00"
+
+
+async def _advertise(data, adapter, started, stop):
+    from dbus_next import BusType, Variant
+    from dbus_next.aio import MessageBus
+    from dbus_next.constants import PropertyAccess
+    from dbus_next.service import ServiceInterface, dbus_property, method
+
+    class Advertisement(ServiceInterface):
+        def __init__(self):
+            super().__init__("org.bluez.LEAdvertisement1")
+            self.tx = 20  # max; the controller clamps
+
+        @method()
+        def Release(self):
+            pass
+
+        @dbus_property(access=PropertyAccess.READ)
+        def Type(self) -> "s":
+            return "broadcast"
+
+        @dbus_property()
+        def TxPower(self) -> "n":
+            return self.tx
+
+        @TxPower.setter
+        def TxPower(self, val: "n"):
+            self.tx = val  # bluez reports back the power it picked
+
+        @dbus_property(access=PropertyAccess.READ)
+        def MinInterval(self) -> "u":
+            return 100  # ms; the bluez default is too slow to wake iOS
+
+        @dbus_property(access=PropertyAccess.READ)
+        def MaxInterval(self) -> "u":
+            return 100
+
+        @dbus_property(access=PropertyAccess.READ)
+        def ManufacturerData(self) -> "a{qv}":
+            return {0x004C: Variant("ay", data)}
+
+    bus = await MessageBus(bus_type=BusType.SYSTEM).connect()
+    try:
+        bus.export(PATH, Advertisement())
+        obj = f"/org/bluez/{adapter}"
+        proxy = bus.get_proxy_object("org.bluez", obj, await bus.introspect("org.bluez", obj))
+        mgr = proxy.get_interface("org.bluez.LEAdvertisingManager1")
+        await mgr.call_register_advertisement(PATH, {})
+        started.set()
+        await stop.wait()
+        await mgr.call_unregister_advertisement(PATH)
+    finally:
+        bus.disconnect()
+
+
+@contextlib.contextmanager
+def wake(ids=(), adapter=None, settle=3.0):
+    """Advertise the AirDrop BLE beacon so nearby iOS receivers switch on AWDL"""
+    adapter = adapter or os.environ.get("OPENDROP_BLE_ADAPTER", "hci0")
+    loop = asyncio.new_event_loop()
+    started, stop = threading.Event(), asyncio.Event()
+    err = []
+
+    def run():
+        try:
+            loop.run_until_complete(_advertise(airdrop_payload(ids), adapter, started, stop))
+        except Exception as e:  # BLE is best effort: macOS receivers never need it
+            err.append(e)
+            started.set()
+
+    t = threading.Thread(target=run, daemon=True)
+    t.start()
+    started.wait(10)
+    if err:
+        logger.warning(f"BLE wake unavailable: {err[0]}")
+    else:
+        logger.info("Advertising AirDrop over BLE")
+        stop_t = loop.time() + settle
+        while loop.time() < stop_t:
+            t.join(0.1)
+    try:
+        yield
+    finally:
+        if not err and t.is_alive():
+            loop.call_soon_threadsafe(stop.set)
+            t.join(5)
+
+
+if __name__ == "__main__":
+    p = airdrop_payload()
+    assert len(p) == 20 and p[:2] == b"\x05\x12" and p[10] == 1, p.hex()
+    assert airdrop_payload(["a@b.c"])[11:13] == hashlib.sha256(b"a@b.c").digest()[:2]
+    print("payload ok", p.hex())
