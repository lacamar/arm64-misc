+def dvzip(file_paths, block=1 << 17):
+    # what iOS sends: an odc cpio of "." and the files, split into [u32 BE len][zlib] blocks; bit 31 = stored
+    if isinstance(file_paths, str):
+        file_paths = [file_paths]
+    parts = [_odc(".", 0o40700, ino=1, mtime=int(os.stat(file_paths[0]).st_mtime))]
