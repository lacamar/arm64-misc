+def dvzip_to_cpio(data):
+    # x-dvzip: a cpio archive split into blocks of [u32 BE length][zlib stream]
+    out, i = bytearray(), 0
+    while i + 4 <= len(data):
+        n = int.from_bytes(data[i:i + 4], "big")
+        out += zlib.decompress(data[i + 4:i + 4 + n])
+        i += 4 + n
+    return bytes(out)
+
