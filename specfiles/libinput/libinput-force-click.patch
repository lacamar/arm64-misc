+static int
+tp_read_force_click_threshold(struct evdev_device *device)
+{
+	uint32_t threshold = 0;
+
+	_unref_(quirks) *q = libinput_device_get_quirks(&device->base);
+	if (q)
+		quirks_get_uint32(q, QUIRK_ATTR_FORCE_CLICK_PRESSURE_THRESHOLD, &threshold);
+
+	return threshold;
+}
+
