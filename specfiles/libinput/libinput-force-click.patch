diff --git src/evdev-mt-touchpad-buttons.c src/evdev-mt-touchpad-buttons.c
index db3a33e..f08a5b9 100644
--- src/evdev-mt-touchpad-buttons.c
+++ src/evdev-mt-touchpad-buttons.c
@@ -1333,9 +1333,40 @@ tp_post_clickpadbutton_buttons(struct tp_dispatch *tp, usec_t time)
 	return 0;
 }
 
+static void
+tp_post_force_click(struct tp_dispatch *tp, usec_t time)
+{
+	struct tp_touch *t;
+	int max = 0;
+	bool want;
+
+	if (!tp->force_click.threshold)
+		return;
+
+	tp_for_each_touch(tp, t) {
+		if (t->state == TOUCH_BEGIN || t->state == TOUCH_UPDATE)
+			max = max(max, t->pressure);
+	}
+
+	want = tp->buttons.state &&
+	       max >= (tp->force_click.active ? tp->force_click.threshold * 3 / 4
+						      : tp->force_click.threshold);
+	if (want == tp->force_click.active)
+		return;
+
+	tp->force_click.active = want;
+	evdev_pointer_notify_physical_button(tp->device,
+					     time,
+					     evdev_usage_from(EVDEV_BTN_TASK),
+					     want ? LIBINPUT_BUTTON_STATE_PRESSED
+						  : LIBINPUT_BUTTON_STATE_RELEASED);
+}
+
 int
 tp_post_button_events(struct tp_dispatch *tp, usec_t time)
 {
+	tp_post_force_click(tp, time);
+
 	if (tp->buttons.is_clickpad ||
 	    tp->device->model_flags & EVDEV_MODEL_APPLE_TOUCHPAD_ONEBUTTON)
 		return tp_post_clickpadbutton_buttons(tp, time);
