+/**
+ * Read EXIF capture time of an image file.
+ * @param path path to the image file
+ * @return capture time, or 0 if not available
+ */
+std::time_t read_exif_time(const std::filesystem::path& path)
+{
+    // preference order: original capture, digitized, last modified
+    static constexpr std::array tags = {
+        "Exif.Photo.DateTimeOriginal",
+        "Exif.Photo.DateTimeDigitized",
+        "Exif.Image.DateTime",
+    };
+
+    try {
+        Exiv2::Image::UniquePtr image =
+            Exiv2::ImageFactory::open(path.string());
+        if (!image) {
+            return 0;
+        }
+        image->readMetadata();
+        const Exiv2::ExifData& exif = image->exifData();
+
+        for (const char* tag : tags) {
+            const auto it = exif.findKey(Exiv2::ExifKey(tag));
+            if (it == exif.end()) {
+                continue;
+            }
+            std::tm tm{};
+            // EXIF date/time format: "YYYY:MM:DD HH:MM:SS"
+            if (std::sscanf(it->toString().c_str(), "%d:%d:%d %d:%d:%d",
+                            &tm.tm_year, &tm.tm_mon, &tm.tm_mday, &tm.tm_hour,
+                            &tm.tm_min, &tm.tm_sec) == 6) {
+                tm.tm_year -= 1900;
+                tm.tm_mon -= 1;
+                tm.tm_isdst = -1;
+                const std::time_t t = std::mktime(&tm);
+                if (t != static_cast<std::time_t>(-1)) {
+                    return t;
+                }
+            }
+        }
+    } catch (const Exiv2::Error&) {
+    }
+
+    return 0;
+}
+#endif // HAVE_LIBEXIV2
