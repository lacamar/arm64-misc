+
+    bool initialize(wl_display* display, wl_surface* surface, bool hdr);
+    void begin(size_t width, size_t height);
+    void end();
+
+    [[nodiscard]] bool hdr_capable() const { return deep_color; }
+    void set_output(bool hdr, float value);
+
