+#ifdef HAVE_GPU
+bool UiWayland::init_gpu()
+{
+    bool hdr = false;
+    if (cm.manager) {
+        wl_display_roundtrip(wl.display);
+        hdr = (cm.features & (1U << WP_COLOR_MANAGER_V1_FEATURE_PARAMETRIC)) &&
+            (cm.tf & (1U << WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_ST2084_PQ)) &&
+            (cm.primaries & (1U << WP_COLOR_MANAGER_V1_PRIMARIES_BT2020));
+    }
+
+    gpu = std::make_unique<GpuGles>();
+    if (!gpu->initialize(wl.display, wl.surface, hdr)) {
+        gpu.reset();
+        return false;
+    }
+    if (!gpu->hdr_capable() || !cm.manager) {
+        return true;
+    }
+
+    wp_image_description_creator_params_v1* creator =
+        wp_color_manager_v1_create_parametric_creator(cm.manager);
+    wp_image_description_creator_params_v1_set_tf_named(
+        creator, WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_ST2084_PQ);
+    wp_image_description_creator_params_v1_set_primaries_named(
+        creator, WP_COLOR_MANAGER_V1_PRIMARIES_BT2020);
+    cm.description = wp_image_description_creator_params_v1_create(creator);
+    wp_image_description_v1_add_listener(
+        cm.description, &WaylandHandler::desc_listener, this);
+    while (!cm.ready && wl_display_roundtrip(wl.display) != -1) { }
+
+    if (cm.ready < 0) {
+        gpu = std::make_unique<GpuGles>();
+        if (!gpu->initialize(wl.display, wl.surface, false)) {
+            gpu.reset();
+            return false;
+        }
+        return true;
+    }
+
+    cm.surface = wp_color_manager_v1_get_surface(cm.manager, wl.surface);
+    gpu->on_encoding = [this](const bool pq) {
+        if (pq) {
+            wp_color_management_surface_v1_set_image_description(
+                cm.surface, cm.description,
+                WP_COLOR_MANAGER_V1_RENDER_INTENT_PERCEPTUAL);
+        } else {
+            wp_color_management_surface_v1_unset_image_description(
+                cm.surface);
+        }
+        Log::verbose("Output encoding: {}", pq ? "PQ BT.2020" : "sRGB");
+    };
+
+    cm.feedback =
+        wp_color_manager_v1_get_surface_feedback(cm.manager, wl.surface);
+    wp_color_management_surface_feedback_v1_add_listener(
+        cm.feedback, &WaylandHandler::feedback_listener, this);
+    request_preferred();
+    for (size_t i = 0; i < 3 && !cm.info; ++i) {
+        wl_display_roundtrip(wl.display);
+    }
+
+    return true;
+}
