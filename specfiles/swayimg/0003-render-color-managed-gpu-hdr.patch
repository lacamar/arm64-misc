+    static bool decode_deep(TIFF* tiff, const Layout& layout, Pixmap& pm)
+    {
+        const size_t pixel = layout.samples * layout.bits / 8;
+        const size_t row = pm.width() * pixel;
+        const bool tiled = TIFFIsTiled(tiff);
+        uint32_t tile_w = 0;
+        uint32_t tile_h = 1;
+        std::vector<uint8_t> tile;
+        if (tiled) {
+            TIFFGetField(tiff, TIFFTAG_TILEWIDTH, &tile_w);
+            TIFFGetField(tiff, TIFFTAG_TILELENGTH, &tile_h);
+            if (!tile_w || !tile_h) {
+                return false;
+            }
+            tile.resize(TIFFTileSize(tiff));
+        }
+        std::vector<uint8_t> band(std::max<size_t>(TIFFScanlineSize(tiff), row) *
+                                  tile_h);
+
+        for (size_t y = 0; y < pm.height(); y += tile_h) {
+            const size_t rows = std::min<size_t>(tile_h, pm.height() - y);
+            if (tiled) {
+                for (size_t x = 0; x < pm.width(); x += tile_w) {
+                    if (TIFFReadTile(tiff, tile.data(), x, y, 0, 0) < 0) {
+                        return false;
+                    }
+                    const size_t len =
+                        std::min<size_t>(tile_w, pm.width() - x) * pixel;
+                    for (size_t r = 0; r < rows; ++r) {
+                        std::memcpy(band.data() + r * row + x * pixel,
+                                    tile.data() + r * tile_w * pixel, len);
+                    }
+                }
+            } else if (TIFFReadScanline(tiff, band.data(), y, 0) < 0) {
+                return false;
+            }
+            for (size_t r = 0; r < rows; ++r) {
+                convert_row(layout, band.data() + r * row,
+                            static_cast<uint16_t*>(pm.ptr(0, y + r)),
+                            pm.width());
+            }
+        }
+        return true;
+    }
+
+    static void convert_row(const Layout& layout, const uint8_t* src,
+                            uint16_t* dst, const size_t width)
+    {
+        const auto sample = [&](const size_t i) -> float {
+            if (layout.bits == 32) {
+                float f;
+                std::memcpy(&f, src + i * 4, 4);
+                return std::isfinite(f) ? std::clamp(f, 0.0F, 65504.0F) : 0;
+            }
+            uint16_t v;
+            std::memcpy(&v, src + i * 2, 2);
+            if (!layout.floating) {
+                return v / 65535.0F;
+            }
+            const float f = half_to_float(v);
+            return std::isfinite(f) ? std::max(f, 0.0F) : 0;
+        };
+        for (size_t x = 0; x < width; ++x) {
+            const size_t base = x * layout.samples;
+            const float a = layout.alpha
+                ? std::min(sample(base + layout.colors), 1.0F)
+                : 1.0F;
+            const float k = layout.premultiplied ? (a > 0 ? 1.0F / a : 0)
+                                                 : 1.0F;
+            for (size_t c = 0; c < 3; ++c) {
+                const size_t i = base + (layout.colors == 3 ? c : 0);
+                *dst++ = float_to_half(sample(i) * k);
+            }
+            *dst++ = float_to_half(a);
+        }
+    }
+
     // Tiff image wrapper
     using TiffImage = std::unique_ptr<TIFF, decltype(&TIFFClose)>;
 
