diff --git a/internal/claudepath/claudepath.go b/internal/claudepath/claudepath.go
new file mode 100644
index 000000000000..81129ede88c8
--- /dev/null
+++ b/internal/claudepath/claudepath.go
@@ -0,0 +1,23 @@
+// Package claudepath resolves Claude Code's live user paths, honoring
+// CLAUDE_CONFIG_DIR, under which Claude Code keeps .credentials.json,
+// settings.json and .claude.json instead of ~/.claude and ~/.claude.json.
+package claudepath
+
+import (
+	"os"
+	"path/filepath"
+)
+
+func Dir(homeDir string) string {
+	if dir := os.Getenv("CLAUDE_CONFIG_DIR"); dir != "" {
+		return dir
+	}
+	return filepath.Join(homeDir, ".claude")
+}
+
+func StatePath(homeDir string) string {
+	if dir := os.Getenv("CLAUDE_CONFIG_DIR"); dir != "" {
+		return filepath.Join(dir, ".claude.json")
+	}
+	return filepath.Join(homeDir, ".claude.json")
+}
