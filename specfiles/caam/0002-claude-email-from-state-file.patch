+// claudeStateAccount reads the email from the .claude.json paired with a
+// credentials file: a sibling (vault, CLAUDE_CONFIG_DIR) or ~/.claude.json.
+func claudeStateAccount(credPath, accountID string) (string, string) {
+	dir := filepath.Dir(credPath)
+	candidates := []string{filepath.Join(dir, ".claude.json")}
+	if filepath.Base(dir) == ".claude" {
+		candidates = append(candidates, filepath.Join(filepath.Dir(dir), ".claude.json"))
+	}
+	for _, c := range candidates {
+		data, err := os.ReadFile(c)
+		if err != nil {
+			continue
+		}
+		var state struct {
+			OauthAccount struct {
+				EmailAddress string `json:"emailAddress"`
+				AccountUUID  string `json:"accountUuid"`
+			} `json:"oauthAccount"`
+		}
+		if json.Unmarshal(data, &state) != nil || state.OauthAccount.EmailAddress == "" {
+			continue
+		}
+		if accountID == "" {
+			accountID = state.OauthAccount.AccountUUID
+		}
+		return state.OauthAccount.EmailAddress, accountID
+	}
+	return "", accountID
+}
