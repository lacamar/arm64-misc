+/// A playlist as `insert_playlist` or `update_playlist` sends it: the
+/// complete ordered member list (track sync ids), and for a folder or a
+/// playlist inside one, the folder flag and parent playlist.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct PlaylistContent<'a> {
+    pub pid: u64,
+    pub name: &'a str,
+    pub members: &'a [u64],
+    pub parent: u64,
+    pub folder: bool,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum PlaylistChange<'a> {
+    Delete(u64),
+    Insert(PlaylistContent<'a>),
+    Update(PlaylistContent<'a>),
+}
+
+/// One session of playlist operations after `update_db_info`, in order
+/// (docs/02-atc-sync-protocol.md, section 10). The bytes prove nothing; the
+/// caller verifies the playlists afterwards.
+pub fn playlist_changes(
+    catalog: &Catalog,
+    changes: &[PlaylistChange<'_>],
+    timestamp: SystemTime,
+) -> Result<Vec<u8>> {
+    prepare_playlist_changes(catalog_identity(catalog), changes, timestamp)
+}
+
+fn prepare_playlist_changes(
+    catalog: CatalogIdentity,
+    changes: &[PlaylistChange<'_>],
+    timestamp: SystemTime,
+) -> Result<Vec<u8>> {
+    ensure!(
+        catalog.database != 0 && catalog.primary_container != 0,
+        "missing current catalog identity"
+    );
+    ensure!(!changes.is_empty(), "no playlist changes");
+    let revision = catalog
+        .anchor
+        .checked_add(1)
+        .context("Media anchor exhausted")?;
+    let mut operations = vec![db_info_update(&catalog)];
+    for change in changes {
+        let (kind, pid, content) = match change {
+            PlaylistChange::Delete(pid) => ("delete_playlist", *pid, None),
+            PlaylistChange::Insert(c) => ("insert_playlist", c.pid, Some(c)),
+            PlaylistChange::Update(c) => ("update_playlist", c.pid, Some(c)),
+        };
+        ensure!(
+            pid != 0 && pid != catalog.primary_container,
+            "playlist {pid:016x} is zero or the library container"
+        );
+        let mut operation = Dictionary::new();
+        operation.insert("operation".into(), kind.into());
+        operation.insert("pid".into(), (pid as i64).into());
+        if let Some(c) = content {
+            ensure!(
+                !c.name.is_empty() && c.name.len() <= 255,
+                "playlist name must be 1 to 255 bytes"
+            );
+            ensure!(
+                !c.folder || c.members.is_empty(),
+                "a playlist folder holds no tracks"
+            );
+            let mut seen = std::collections::BTreeSet::new();
+            ensure!(
+                c.members.iter().all(|m| *m != 0 && seen.insert(*m)),
+                "playlist members must be distinct nonzero tracks"
+            );
+            let date = Value::Date(timestamp.into());
+            let mut container = Dictionary::new();
+            container.insert("name".into(), c.name.into());
+            container.insert("date_created".into(), date.clone());
+            container.insert("date_modified".into(), date);
+            if c.parent != 0 {
+                container.insert("parent_pid".into(), (c.parent as i64).into());
+            }
+            if c.folder {
+                container.insert("smart_is_folder".into(), true.into());
+            }
+            let mut ui = Dictionary::new();
+            ui.insert("play_order".into(), 1.into());
+            ui.insert("album_field_order".into(), 0.into());
+            ui.insert("repeat_mode".into(), 0.into());
+            ui.insert("is_reversed".into(), false.into());
+            ui.insert("shuffle_items".into(), false.into());
+            ui.insert("has_been_shuffled".into(), false.into());
+            operation.insert("container".into(), Value::Dictionary(container));
+            operation.insert("container_ui".into(), Value::Dictionary(ui));
+            operation.insert(
+                "item_to_container".into(),
+                Value::Array(c.members.iter().map(|m| (*m as i64).into()).collect()),
+            );
+        }
+        operations.push(Value::Dictionary(operation));
+    }
+    envelope(revision, timestamp, operations)
+}
