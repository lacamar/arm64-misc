+//! Playlists from M3U files: one metadata-only session per change, verified
+//! by reading the phone's playlists back. Only playlists this host created
+//! (recorded next to the journal) are ever replaced or deleted.
+use anyhow::{Context, Result, bail, ensure};
+use serde::{Deserialize, Serialize};
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    fs,
+    io::Read,
+    path::{Component, Path, PathBuf},
+    time::SystemTime,
+};
+
+use crate::engine::{
+    execution::native_insert::{Control, durable_write},
+    execution::removal_batch::{self, Before, Requests, Sent, hex, sha},
+    state::journal::{Identity, Journal},
+    state::layout,
+};
+use music_protocol::catalogue::mutation::{self, PlaylistChange, PlaylistContent};
+use music_protocol::catalogue::removal::{Tables, playlists::ordinary};
+use music_protocol::catalogue::sqlite::tables::Cell;
+
+const MANAGED: &str = "playlists.json";
+
+/// The entries of an M3U or M3U8 playlist, as absolute paths in file order.
+pub(crate) fn parse_m3u(text: &str, base: &Path) -> Vec<PathBuf> {
+    text.trim_start_matches('\u{feff}')
+        .lines()
+        .map(str::trim)
+        .filter(|line| !line.is_empty() && !line.starts_with('#'))
+        .map(|line| {
+            let path = match line.strip_prefix("file://") {
+                Some(uri) => PathBuf::from(percent_decode(uri.trim_start_matches("localhost"))),
+                None => PathBuf::from(line),
+            };
+            normalize(&base.join(path))
+        })
+        .collect()
+}
+
+fn percent_decode(text: &str) -> String {
+    let bytes = text.as_bytes();
+    let mut out = Vec::with_capacity(bytes.len());
+    let mut i = 0;
+    while i < bytes.len() {
+        let hex = bytes
+            .get(i + 1..i + 3)
+            .and_then(|h| std::str::from_utf8(h).ok())
+            .and_then(|h| u8::from_str_radix(h, 16).ok());
+        match (bytes[i], hex) {
+            (b'%', Some(byte)) => {
+                out.push(byte);
+                i += 3;
+            }
+            (byte, _) => {
+                out.push(byte);
+                i += 1;
+            }
+        }
+    }
+    String::from_utf8_lossy(&out).into_owned()
+}
+
+/// A path's letters and digits, lowercase and without accents, for entries
+/// an older export wrote in ASCII ("Uber" for "Über").
+fn folded(path: &Path) -> String {
+    const FROM: &str = "àáâãäåèéêëìíîïòóôõöøùúûüýÿñçæœß";
+    const TO: [&str; 31] = [
+        "a", "a", "a", "a", "a", "a", "e", "e", "e", "e", "i", "i", "i", "i", "o", "o", "o", "o",
+        "o", "o", "u", "u", "u", "u", "y", "y", "n", "c", "ae", "oe", "ss",
+    ];
+    let mut out = String::new();
+    for c in path.to_string_lossy().chars().flat_map(char::to_lowercase) {
+        match FROM.chars().position(|f| f == c) {
+            Some(i) => out.push_str(TO[i]),
+            None if c.is_alphanumeric() => out.push(c),
+            None => {}
+        }
+    }
+    out
+}
+
+fn normalize(path: &Path) -> PathBuf {
+    let mut out = PathBuf::new();
+    for part in path.components() {
+        match part {
+            Component::ParentDir => {
+                out.pop();
+            }
+            Component::CurDir => {}
+            other => out.push(other),
+        }
+    }
+    out
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+pub struct PhonePlaylist {
+    pub pid: u64,
+    pub name: String,
+    pub kind: &'static str,
+    #[serde(skip_serializing_if = "is_zero")]
+    pub parent: u64,
+    pub members: Vec<u64>,
+}
+
+fn is_zero(value: &u64) -> bool {
+    *value == 0
+}
+
+/// Every playlist a person sees on the phone, built-in ones left out.
+pub(crate) fn phone_playlists(tables: &Tables) -> Result<Vec<PhonePlaylist>> {
+    let table = |name: &str| tables.get(name).with_context(|| format!("no {name} table"));
+    let containers = table("container")?;
+    let info = table("db_info")?;
+    let mut primary = BTreeSet::new();
+    for row in info.rows.keys() {
+        primary.insert(info.at(row, "primary_container_pid")?.integer()?);
+    }
+    let plain = ordinary(tables)?;
+    let store = table("item_store")?;
+    let mut sync_ids = BTreeMap::new();
+    for row in store.rows.keys() {
+        sync_ids.insert(
+            store.at(row, "item_pid")?.integer()?,
+            store.at(row, "sync_id")?.integer()? as u64,
+        );
+    }
+    let mut members: BTreeMap<i64, Vec<(i64, u64)>> = BTreeMap::new();
+    if let Some(items) = tables.get("container_item") {
+        for row in items.rows.keys() {
+            let item = items.at(row, "item_pid")?.integer()?;
+            members
+                .entry(items.at(row, "container_pid")?.integer()?)
+                .or_default()
+                .push((
+                    items.at(row, "position")?.integer()?,
+                    sync_ids.get(&item).copied().unwrap_or(0),
+                ));
+        }
+    }
+    let mut playlists = Vec::new();
+    for row in containers.rows.keys() {
+        let int = |column: &str| containers.at(row, column).and_then(Cell::integer);
+        let pid = int("container_pid")?;
+        if primary.contains(&pid) || int("distinguished_kind")? != 0 || int("is_hidden")? != 0 {
+            continue;
+        }
+        let sync_id = int("sync_id")? as u64;
+        let kind = if int("smart_is_folder")? != 0 {
+            "folder"
+        } else if *containers.at(row, "smart_criteria")? != Cell::Null {
+            "smart"
+        } else if sync_id == 0 {
+            "phone-made"
+        } else if plain.contains(&pid) {
+            "ordinary"
+        } else {
+            "other"
+        };
+        let mut list = members.remove(&pid).unwrap_or_default();
+        list.sort();
+        playlists.push(PhonePlaylist {
+            pid: if sync_id == 0 { pid as u64 } else { sync_id },
+            name: containers.at(row, "name")?.text()?.to_owned(),
+            kind,
+            parent: int("parent_pid")? as u64,
+            members: list.into_iter().map(|(_, m)| m).collect(),
+        });
+    }
+    Ok(playlists)
+}
+
+/// Playlists and folders this host created, by key, newest pid last.
+#[derive(Default, Serialize, Deserialize)]
+struct Managed {
+    #[serde(default)]
+    playlists: BTreeMap<String, Vec<u64>>,
+    #[serde(default)]
+    folders: BTreeMap<String, Vec<u64>>,
+}
+
+impl Managed {
+    fn load(path: &Path) -> Result<Self> {
+        match fs::read(path) {
+            Ok(bytes) => serde_json::from_slice(&bytes).context("reading managed playlists"),
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => Ok(Self::default()),
+            Err(e) => Err(e.into()),
+        }
+    }
+    fn save(&self, path: &Path) -> Result<()> {
+        let parent = path.parent().context("managed playlists have no directory")?;
+        let temporary = parent.join(format!("{MANAGED}.new"));
+        let mut file = fs::File::create(&temporary)?;
+        std::io::Write::write_all(&mut file, &serde_json::to_vec_pretty(self)?)?;
+        file.sync_all()?;
+        fs::rename(&temporary, path)?;
+        fs::File::open(parent)?.sync_all()?;
+        Ok(())
+    }
+    fn all(&self) -> BTreeSet<u64> {
+        self.playlists
+            .values()
+            .chain(self.folders.values())
+            .flatten()
+            .copied()
+            .collect()
+    }
+}
+
+/// Key of a managed playlist: its name, inside its folder when it has one.
+fn key(name: &str, folder: Option<&str>) -> String {
+    match folder {
+        Some(folder) => format!("{folder}/{name}"),
+        None => name.to_owned(),
+    }
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum Decision {
+    Unchanged(u64),
+    Replace(Vec<u64>),
+    Create,
+}
+
+/// What a push does, from the managed playlists of this key still on the
+/// phone (`present`).
+pub(crate) fn decide(present: &[&PhonePlaylist], name: &str, members: &[u64], parent: u64) -> Decision {
+    match present {
+        [] => Decision::Create,
+        [one] if one.name == name && one.members == members && one.parent == parent => {
+            Decision::Unchanged(one.pid)
+        }
+        many => Decision::Replace(many.iter().map(|p| p.pid).collect()),
+    }
+}
+
+pub struct PushOptions<'a> {
+    pub playlist: &'a Path,
+    pub name: Option<String>,
+    pub folder: Option<String>,
+    pub state: &'a Path,
+    pub host_name: &'a str,
+    pub dry_run: bool,
+    pub connection: &'a str,
+}
+
+#[derive(Debug, Serialize)]
+pub struct PushOutcome {
+    pub playlist: String,
+    pub pid: u64,
+    pub members: usize,
+    pub missing: Vec<PathBuf>,
+    pub action: &'static str,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub folder: Option<String>,
+}
+
+struct Started {
+    operation: Vec<u8>,
+    signature: [u8; 21],
+}
+
+impl music_protocol::protocol::session::StartedOperation for Started {
+    fn operation(&self) -> &[u8] {
+        &self.operation
+    }
+    fn signature(&self) -> &[u8; 21] {
+        &self.signature
+    }
+}
+
+struct Opened {
+    identity: Identity,
+    before: Before,
+    journal: PathBuf,
+    managed_path: PathBuf,
+    managed: Managed,
+    playlists: Vec<PhonePlaylist>,
+}
+
+async fn open(state: &Path, directory: &Path, control: &Control) -> Result<Opened> {
+    let (identity, before) = removal_batch::capture_fresh(directory, control).await?;
+    let journal = layout::journal_path(
+        state,
+        &before.snapshot.identity.device_identifier_sha256,
+        &before.snapshot.identity.library_identity_sha256,
+    )?;
+    let managed_path = journal
+        .parent()
+        .context("journal has no directory")?
+        .join(MANAGED);
+    let managed = Managed::load(&managed_path)?;
+    let playlists = phone_playlists(&before.sql.tables)?;
+    Ok(Opened {
+        identity,
+        before,
+        journal,
+        managed_path,
+        managed,
+        playlists,
+    })
+}
+
+fn present<'a>(playlists: &'a [PhonePlaylist], pids: Option<&Vec<u64>>, kind: &str) -> Vec<&'a PhonePlaylist> {
+    let pids = pids.map(Vec::as_slice).unwrap_or_default();
+    playlists
+        .iter()
+        .filter(|p| pids.contains(&p.pid) && p.kind == kind)
+        .collect()
+}
+
+fn fresh_pid(before: &Before, taken: &BTreeSet<u64>) -> Result<u64> {
+    let mut occupied = taken.clone();
+    for (table, columns) in [
+        ("container", &["container_pid", "sync_id"][..]),
+        ("item_store", &["item_pid", "sync_id"][..]),
+    ] {
+        let t = before.sql.table(table)?;
+        for row in t.rows.keys() {
+            for column in columns {
+                occupied.insert(t.at(row, column)?.integer()? as u64);
+            }
+        }
+    }
+    let mut random = fs::File::open("/dev/urandom")?;
+    for _ in 0..128 {
+        let mut bytes = [0; 8];
+        random.read_exact(&mut bytes)?;
+        let pid = u64::from_le_bytes(bytes);
+        if pid >= 1000 && !occupied.contains(&pid) {
+            return Ok(pid);
+        }
+    }
+    bail!("unable to allocate a playlist identity")
+}
+
+/// Send `changes` as one metadata-only session from `opened`'s exact state.
+/// `started` runs once the session is Ready, before anything is staged.
+async fn send(
+    before: &Before,
+    changes: &[PlaylistChange<'_>],
+    host_name: &str,
+    control: &Control,
+    started: impl FnOnce() -> Result<()>,
+) -> Result<()> {
+    let operation = mutation::playlist_changes(&before.current.catalog, changes, SystemTime::now())?;
+    let input = serde_json::to_vec_pretty(&serde_json::json!({
+        "schema": "rustunes.playlist-input",
+        "base_anchor": before.anchor(),
+        "operation_sha256": hex(&sha(&operation)),
+        "before_current_sha256": hex(&before.current.receipt_sha256),
+        "host_name": host_name,
+    }))?;
+    durable_write(&before.directory, "input.json", &input)?;
+    durable_write(&before.directory, "operation.plist", &operation)?;
+    let sent = removal_batch::send_metadata_only(
+        before,
+        &operation,
+        Requests::None,
+        sha(&input),
+        host_name,
+        &before.directory.join("send"),
+        control,
+        |_, signature| {
+            started()?;
+            Ok(Started {
+                operation: operation.clone(),
+                signature,
+            })
+        },
+    )
+    .await;
+    match sent {
+        Sent::Unsent(error) => Err(error.context("nothing was sent to the phone")),
+        // A transport error after Started may still have applied; the
+        // caller's readback decides.
+        Sent::Started(wire) => {
+            if let Err(error) = wire {
+                tracing::warn!("playlist session ended with {error:#}; reading the phone back");
+            }
+            Ok(())
+        }
+    }
+}
+
+/// Push one M3U playlist: create it, replace a managed one whose tracks or
+/// order changed, or leave it.
+pub async fn push(
+    o: PushOptions<'_>,
+    control: impl Fn() -> Control,
+    mut notice: impl FnMut(&Path),
+) -> Result<PushOutcome> {
+    let text = fs::read(o.playlist)
+        .with_context(|| format!("reading {}", o.playlist.display()))?;
+    let base = std::path::absolute(o.playlist)?;
+    let entries = parse_m3u(
+        &String::from_utf8_lossy(&text),
+        base.parent().context("playlist has no directory")?,
+    );
+    let name = match o.name {
+        Some(name) => name,
+        None => o
+            .playlist
+            .file_stem()
+            .and_then(|s| s.to_str())
+            .context("playlist file name is not UTF-8")?
+            .to_owned(),
+    };
+    let run = layout::new_run(o.state)?;
+    let control = control();
+    let mut opened = open(o.state, &run.join("before"), &control).await?;
+    ensure!(
+        opened.journal.join("journal.sqlite").try_exists()?,
+        "no journal for this phone yet; run `rustunes push` or `rustunes pull` first"
+    );
+    crate::engine::execution::replace::ensure_no_unfinished_attempt(
+        &opened.journal,
+        &opened.identity,
+        o.state,
+        &run.join("before").join("snapshot"),
+        o.connection,
+    )?;
+    let sources = Journal::open_read_only(&opened.journal, &opened.identity)?.recorded_sources()?;
+    let on_phone: BTreeSet<u64> = opened
+        .before
+        .current
+        .catalog
+        .tracks()
+        .iter()
+        .map(|t| t.sync_id)
+        .collect();
+    let by_path: BTreeMap<PathBuf, u64> = sources
+        .into_iter()
+        .filter(|(track, _)| on_phone.contains(track))
+        .flat_map(|(track, path)| {
+            let canonical = fs::canonicalize(&path).ok();
+            [Some(path), canonical]
+                .into_iter()
+                .flatten()
+                .map(move |p| (p, track))
+        })
+        .collect();
+    let mut by_folded: BTreeMap<String, Option<u64>> = BTreeMap::new();
+    for (path, track) in &by_path {
+        by_folded
+            .entry(folded(path))
+            .and_modify(|t| {
+                if *t != Some(*track) {
+                    *t = None
+                }
+            })
+            .or_insert(Some(*track));
+    }
+    let mut members = Vec::new();
+    let mut missing = Vec::new();
+    for entry in entries {
+        let track = by_path
+            .get(&entry)
+            .or_else(|| fs::canonicalize(&entry).ok().and_then(|c| by_path.get(&c)))
+            .or_else(|| by_folded.get(&folded(&entry)).and_then(Option::as_ref));
+        match track {
+            Some(track) if !members.contains(track) => members.push(*track),
+            Some(_) => {}
+            None => {
+                notice(&entry);
+                missing.push(entry);
+            }
+        }
+    }
+    ensure!(
+        !members.is_empty(),
+        "none of the playlist's tracks is on the phone"
+    );
+    let key = key(&name, o.folder.as_deref());
+    let mut taken = opened.managed.all();
+    let mut changes = Vec::new();
+    let mut new_folder = None;
+    let parent = match &o.folder {
+        None => 0,
+        Some(folder) => {
+            match present(&opened.playlists, opened.managed.folders.get(folder), "folder").first() {
+                Some(existing) => existing.pid,
+                None => {
+                    let pid = fresh_pid(&opened.before, &taken)?;
+                    taken.insert(pid);
+                    new_folder = Some(pid);
+                    pid
+                }
+            }
+        }
+    };
+    let existing = present(&opened.playlists, opened.managed.playlists.get(&key), "ordinary");
+    let decision = decide(&existing, &name, &members, parent);
+    let outcome = |pid, action| PushOutcome {
+        playlist: name.clone(),
+        pid,
+        members: members.len(),
+        missing: missing.clone(),
+        action,
+        folder: o.folder.clone(),
+    };
+    let replaced = match decision {
+        Decision::Unchanged(pid) => return Ok(outcome(pid, "unchanged")),
+        Decision::Replace(old) => old,
+        Decision::Create => Vec::new(),
+    };
+    let pid = fresh_pid(&opened.before, &taken)?;
+    let action = if replaced.is_empty() { "created" } else { "replaced" };
+    if o.dry_run {
+        return Ok(outcome(pid, action));
+    }
+    let folder_name = o.folder.clone().unwrap_or_default();
+    if let Some(folder) = new_folder {
+        changes.push(PlaylistChange::Insert(PlaylistContent {
+            pid: folder,
+            name: &folder_name,
+            members: &[],
+            parent: 0,
+            folder: true,
+        }));
+    }
+    changes.extend(replaced.iter().map(|p| PlaylistChange::Delete(*p)));
+    changes.push(PlaylistChange::Insert(PlaylistContent {
+        pid,
+        name: &name,
+        members: &members,
+        parent,
+        folder: false,
+    }));
+    let managed_path = opened.managed_path.clone();
+    send(&opened.before, &changes, o.host_name, &control, || {
+        opened.managed.playlists.entry(key.clone()).or_default().push(pid);
+        if let (Some(folder), Some(name)) = (new_folder, &o.folder) {
+            opened.managed.folders.entry(name.clone()).or_default().push(folder);
+        }
+        opened.managed.save(&managed_path)
+    })
+    .await?;
+    let after = open(o.state, &run.join("after"), &control).await?;
+    let made = after
+        .playlists
+        .iter()
+        .find(|p| p.pid == pid)
+        .context("the phone did not create the playlist; nothing else changed")?;
+    ensure!(
+        made.name == name && made.members == members && made.parent == parent,
+        "the phone holds playlist {pid:016x} with other content than sent: {made:?}"
+    );
+    if let Some(left) = after.playlists.iter().find(|p| replaced.contains(&p.pid)) {
+        bail!("the replaced playlist {:016x} is still on the phone", left.pid);
+    }
+    let mut managed = after.managed;
+    managed.playlists.insert(key, vec![pid]);
+    managed.save(&after.managed_path)?;
