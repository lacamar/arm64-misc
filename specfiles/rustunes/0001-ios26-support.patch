+//! `playlist`: M3U playlists on the phone, only ever changing those this
+//! host created.
+use super::{machine, notice};
+use crate::engine::execution::playlist;
+use anyhow::Result;
+use clap::Subcommand;
+use serde_json::json;
+use std::path::PathBuf;
+
+#[derive(Subcommand)]
+pub(super) enum PlaylistCommand {
+    /// Create or update a playlist from an M3U or M3U8 file whose tracks are on the phone; one made on the phone or by another host is never changed.
+    Push {
+        playlist: PathBuf,
+        /// The playlist's name on the phone; defaults to the file name without its extension.
+        #[arg(long)]
+        name: Option<String>,
+        /// Put it in this playlist folder, created by rustunes when absent.
+        #[arg(long)]
+        folder: Option<String>,
+        /// Show what would change without sending it.
+        #[arg(long)]
+        dry_run: bool,
+        #[command(flatten)]
+        common: Common,
+    },
+    /// List the phone's playlists, marking those rustunes created as managed.
+    List {
+        #[arg(long)]
+        json: bool,
+        #[command(flatten)]
+        common: Common,
+    },
+    /// Delete a playlist rustunes created.
+    Remove {
+        name: String,
+        #[arg(long)]
+        folder: Option<String>,
+        #[command(flatten)]
+        common: Common,
+    },
+}
+
+#[derive(clap::Args)]
+pub(super) struct Common {
+    #[arg(long)]
+    state_dir: Option<PathBuf>,
+    #[arg(long, default_value = "rustunes")]
+    host_name: String,
+    #[arg(long, default_value_t = 600, value_parser = clap::value_parser!(u64).range(1..=1800))]
+    seconds: u64,
+}
+
+impl PlaylistCommand {
+    pub(super) fn state_dir(&self) -> Option<&std::path::Path> {
+        match self {
+            Self::Push { common, .. } | Self::List { common, .. } | Self::Remove { common, .. } => {
+                common.state_dir.as_deref()
+            }
+        }
+    }
+}
+
+pub(super) async fn run(command: PlaylistCommand, engine: &crate::engine::Engine) -> Result<()> {
+    let state = |common: &Common| {
+        common
+            .state_dir
+            .clone()
+            .map(Ok)
+            .unwrap_or_else(super::default_state_directory)
+    };
+    match command {
+        PlaylistCommand::Push {
+            playlist,
+            name,
+            folder,
+            dry_run,
+            common,
+        } => {
+            let state = state(&common)?;
+            let connection = engine.command_options();
+            let outcome = engine
+                .scope(playlist::push(
+                    playlist::PushOptions {
+                        playlist: &playlist,
+                        name,
+                        folder,
+                        state: &state,
+                        host_name: &common.host_name,
+                        dry_run,
+                        connection: &connection,
+                    },
+                    || engine.control(common.seconds),
+                    |missing| {
+                        let _ = notice(
+                            "playlist_track_missing",
+                            machine::Level::Warning,
+                            format!("Not on the phone, left out: {}", missing.display()),
+                            json!({"path": missing}),
+                        );
+                    },
+                ))
+                .await?;
+            let fields = serde_json::to_value(&outcome)?;
+            if machine::enabled() {
+                machine::outcome(outcome.action);
+                machine::result_fields(fields);
+            } else {
+                let verb = match (outcome.action, dry_run) {
+                    ("unchanged", _) => "Unchanged",
+                    ("created", false) => "Created",
+                    ("created", true) => "Would create",
+                    (_, false) => "Replaced",
+                    (_, true) => "Would replace",
+                };
+                println!(
+                    "{verb} playlist {:?}: {} tracks, {} not on the phone",
+                    outcome.playlist,
+                    outcome.members,
+                    outcome.missing.len()
+                );
+            }
+        }
+        PlaylistCommand::List { json, common } => {
+            let state = state(&common)?;
+            let listed = engine
+                .scope(playlist::list(&state, || engine.control(common.seconds)))
+                .await?;
+            if machine::enabled() {
+                machine::report("playlists", &listed)?;
+            } else if json {
+                println!("{}", serde_json::to_string_pretty(&json!({"playlists": listed}))?);
+            } else {
+                for p in &listed {
+                    println!(
+                        "{:016x}  {:<10} {:>5}  {}{}",
+                        p.playlist.pid,
+                        p.playlist.kind,
+                        p.playlist.members.len(),
+                        p.playlist.name,
+                        if p.managed { "  (rustunes)" } else { "" }
+                    );
+                }
+            }
+        }
+        PlaylistCommand::Remove {
+            name,
+            folder,
+            common,
+        } => {
+            let state = state(&common)?;
+            let removed = engine
+                .scope(playlist::remove(
+                    &name,
+                    folder.as_deref(),
+                    &state,
+                    &common.host_name,
+                    || engine.control(common.seconds),
+                ))
+                .await?;
+            if machine::enabled() {
+                machine::result_fields(json!({"playlist": name, "removed": removed.removed}));
+            } else {
+                println!("Removed playlist {name:?}");
+            }
+        }
+    }
+    Ok(())
+}
