+/// A `mpeg::Source` with the fields its report form leaves out.
+#[derive(serde::Serialize, serde::Deserialize)]
+struct StoredMpeg {
+    source: mpeg::Source,
+    encoded: Option<EncodedAudio>,
+    declared_types: Vec<bool>,
+}
+impl StoredMpeg {
+    fn new(source: &mpeg::Source) -> Self {
+        Self {
+            source: source.clone(),
+            encoded: source.stream.as_ref().map(|s| s.encoded.clone()),
+            declared_types: source.artwork.iter().map(|p| p.declared_type).collect(),
+        }
+    }
+    fn restore(self) -> Result<mpeg::Source> {
+        let mut source = self.source;
+        ensure!(
+            source.stream.is_some() == self.encoded.is_some()
+                && source.artwork.len() == self.declared_types.len(),
+            "source cache row is incomplete"
+        );
+        if let (Some(stream), Some(encoded)) = (source.stream.as_mut(), self.encoded) {
+            stream.encoded = encoded;
+        }
+        for (picture, declared) in source.artwork.iter_mut().zip(self.declared_types) {
+            picture.declared_type = declared;
+        }
+        Ok(source)
+    }
+}
+impl Persisted for mpeg::Source {
+    fn load(c: &Connection, key: &Key) -> Result<Option<Self>> {
+        let Some(text) = c
+            .query_row(
+                "SELECT source FROM mpeg_sources WHERE path=?1 AND stat=?2",
+                params![key.path(), key.stat()],
+                |r| r.get::<_, String>(0),
+            )
+            .optional()?
+        else {
+            return Ok(None);
+        };
+        let source = serde_json::from_str::<StoredMpeg>(&text)?.restore()?;
+        ensure!(
+            source.fingerprint.file_bytes == key.size,
+            "source cache row size differs from its file"
+        );
+        Ok(Some(source))
+    }
+    fn store(&self, c: &Connection, key: &Key) -> Result<()> {
+        ensure!(
+            self.fingerprint.file_bytes == key.size,
+            "source size differs from its file"
+        );
+        let text = serde_json::to_string(&StoredMpeg::new(self))?;
+        // Kept only when it reads back identical, so a field the stored form
+        // can't carry costs a read instead of changing a plan.
+        ensure!(
+            serde_json::from_str::<StoredMpeg>(&text)?.restore()? == *self,
+            "source does not survive the cache"
+        );
+        c.execute(
+            "INSERT OR REPLACE INTO mpeg_sources VALUES (?1,?2,?3,?4)",
+            params![key.path(), key.stat(), text, unix_now()],
+        )?;
+        Ok(())
+    }
