+/// `2024`, `2024-05-01…`, `20240501` or text such as `May 1, 2024`.
+pub(crate) fn date_year(date: &str) -> Option<u32> {
+    let digits = |s: &str| s.len() == 4 && s.bytes().all(|b| b.is_ascii_digit());
+    let year = if date.starts_with(|c: char| c.is_ascii_digit()) {
+        let compact = date.len() == 8 && date.bytes().all(|b| b.is_ascii_digit());
+        date.get(..4)
+            .filter(|p| digits(p) && (compact || matches!(date.as_bytes().get(4), None | Some(b'-'))))
+    } else {
+        date.split(|c: char| !c.is_ascii_digit()).find(|t| digits(t))
+    };
+    year.and_then(|y| y.parse().ok())
+}
