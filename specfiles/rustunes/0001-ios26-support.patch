+        assert_eq!(decide(&[&a], "Mix", &[1, 2], 9), Decision::Replace(vec![7]));
+        let b = list(8, vec![1, 2]);
+        assert_eq!(decide(&[&a, &b], "Mix", &[1, 2], 0), Decision::Replace(vec![7, 8]));
+    }
+}
