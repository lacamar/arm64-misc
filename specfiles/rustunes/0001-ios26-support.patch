+
+pub struct RemoveOutcome {
+    pub removed: Vec<u64>,
+}
+
+/// Delete the managed playlist `name` (in `folder`) from the phone.
+pub async fn remove(
+    name: &str,
+    folder: Option<&str>,
+    state: &Path,
+    host_name: &str,
+    control: impl Fn() -> Control,
+) -> Result<RemoveOutcome> {
+    let run = layout::new_run(state)?;
+    let control = control();
+    let opened = open(state, &run.join("before"), &control).await?;
+    let key = key(name, folder);
+    let pids: Vec<u64> = present(&opened.playlists, opened.managed.playlists.get(&key), "ordinary")
+        .iter()
+        .map(|p| p.pid)
+        .collect();
+    if pids.is_empty() {
+        let foreign = opened.playlists.iter().any(|p| p.name == name);
+        bail!(
+            "no playlist named {name:?} that rustunes created is on the phone{}",
+            if foreign { "; the one there was made elsewhere and is left alone" } else { "" }
+        );
+    }
+    let changes: Vec<PlaylistChange> = pids.iter().map(|p| PlaylistChange::Delete(*p)).collect();
+    send(&opened.before, &changes, host_name, &control, || Ok(())).await?;
+    let after = open(state, &run.join("after"), &control).await?;
+    ensure!(
+        !after.playlists.iter().any(|p| pids.contains(&p.pid)),
+        "the phone kept the playlist"
+    );
+    let mut managed = after.managed;
+    managed.playlists.remove(&key);
+    managed.save(&after.managed_path)?;
+    Ok(RemoveOutcome { removed: pids })
+}
+
+#[derive(Serialize)]
+pub struct ListedPlaylist {
+    #[serde(flatten)]
+    pub playlist: PhonePlaylist,
+    pub managed: bool,
+}
+
+pub async fn list(state: &Path, control: impl Fn() -> Control) -> Result<Vec<ListedPlaylist>> {
+    let run = layout::new_run(state)?;
+    let opened = open(state, &run.join("list"), &control()).await?;
+    let managed = opened.managed.all();
+    Ok(opened
+        .playlists
+        .into_iter()
+        .map(|playlist| ListedPlaylist {
+            managed: managed.contains(&playlist.pid),
+            playlist,
+        })
+        .collect())
+}
