diff --git a/crates/music-protocol/src/media.rs b/crates/music-protocol/src/media.rs
index c211984..4cfe18f 100644
--- a/crates/music-protocol/src/media.rs
+++ b/crates/music-protocol/src/media.rs
@@ -19,3 +19,24 @@ pub mod jpeg;
 pub mod mpeg;
 pub mod other_audio;
 pub mod png;
+
+/// Spelled as an alias so serde doesn't borrow it from the input.
+pub type Name = &'static str;
+
+/// A `&'static str` field read back from a cache: each distinct value is
+/// leaked once, and these fields hold a handful of codec and schema names.
+pub(crate) fn interned<'de, D: serde::Deserializer<'de>>(d: D) -> Result<&'static str, D::Error> {
+    use std::{collections::HashSet, sync::Mutex};
+    static SEEN: Mutex<Option<HashSet<&'static str>>> = Mutex::new(None);
+    let text = <String as serde::Deserialize>::deserialize(d)?;
+    let mut seen = SEEN.lock().unwrap_or_else(|e| e.into_inner());
+    let seen = seen.get_or_insert_default();
+    Ok(match seen.get(text.as_str()) {
+        Some(known) => known,
+        None => {
+            let leaked: &'static str = Box::leak(text.into_boxed_str());
+            seen.insert(leaked);
+            leaked
+        }
+    })
+}
