+        // WhatsApp Web stamps every message bubble's copyable-text node with a
+        // data-pre-plain-text attribute of the form "[time, date] Sender: " -- the
+        // same metadata it uses for its own copy-to-clipboard feature -- so reading
+        // it back out gives a stable source for sender/timestamp without depending
+        // on WhatsApp's obfuscated CSS class names. Messages are collected in DOM
+        // order, which is chronological order (oldest first). A single 0x01 byte,
+        // which cannot appear in innerText, separates the chat title from the body.
+        constexpr auto const EXPORT_CHAT_SCRIPT = R"JS(
+            (function() {
+                var titleEl = document.querySelector('#main header [data-testid="conversation-info-header-chat-title"]')
+                    || document.querySelector('#main header span[dir="auto"]');
+                var title = titleEl ? titleEl.innerText.trim() : '';
+
+                var lines = [];
+                document.querySelectorAll('#main div.copyable-text[data-pre-plain-text]').forEach(function(node) {
+                    var meta     = (node.getAttribute('data-pre-plain-text') || '').trim();
+                    var textNode = node.querySelector('span.selectable-text') || node;
+                    var text     = (textNode.innerText || '').trim();
+
+                    if (meta || text)
+                    {
+                        lines.push((meta + ' ' + text).trim());
+                    }
+                });
+
+                return title + '' + lines.join('\n');
+            })();
+        )JS";
+
+        std::string sanitizeFilename(std::string name)
+        {
+            for (auto& character : name)
+            {
+                if (character == '/' || character == '\\' || character == ':' || character == '*' || character == '?' || character == '"'
+                    || character == '<' || character == '>' || character == '|')
+                {
+                    character = '_';
+                }
+            }
+
+            return name.empty() ? "whatsapp-chat" : name;
+        }
+
+        void saveChatTranscript(std::string const& suggestedTitle, std::string const& transcript)
+        {
+            auto dialog = Gtk::FileChooserDialog{_("Export Chat Transcript"), Gtk::FILE_CHOOSER_ACTION_SAVE};
+            dialog.add_button(_("Cancel"), Gtk::RESPONSE_CANCEL);
+            dialog.add_button(_("Save"), Gtk::RESPONSE_OK);
+            dialog.set_do_overwrite_confirmation(true);
+            dialog.set_current_name(sanitizeFilename(suggestedTitle) + ".txt");
+
+            if (dialog.run() == Gtk::RESPONSE_OK)
+            {
+                auto outFile = std::ofstream{dialog.get_filename()};
+                outFile << transcript << std::endl;
+            }
+        }
+
+        void exportChatTranscriptFinished(GObject* sourceObject, GAsyncResult* result, gpointer)
+        {
+            GError* error   = nullptr;
+            auto* const value = webkit_web_view_evaluate_javascript_finish(WEBKIT_WEB_VIEW(sourceObject), result, &error);
+
+            if (!value)
+            {
+                std::cerr << "WebView: Failed to export chat transcript: " << (error ? error->message : "unknown error") << std::endl;
+                if (error)
+                {
+                    g_error_free(error);
+                }
+
+                auto dialog = Gtk::MessageDialog{_("Export Failed"), false, Gtk::MESSAGE_ERROR, Gtk::BUTTONS_OK};
+                dialog.set_secondary_text(_("Failed to read the chat transcript."));
+                dialog.run();
+                return;
+            }
+
+            auto* const resultString = jsc_value_to_string(value);
+            auto const  raw          = std::string{resultString ? resultString : ""};
+            g_free(resultString);
+            g_object_unref(value);
+
+            auto const delimiterPos = raw.find('\x01');
+            auto const title        = (delimiterPos == std::string::npos) ? std::string{} : raw.substr(0, delimiterPos);
+            auto const transcript   = (delimiterPos == std::string::npos) ? raw : raw.substr(delimiterPos + 1);
+
+            if (transcript.empty())
+            {
+                auto dialog = Gtk::MessageDialog{_("Nothing to Export"), false, Gtk::MESSAGE_INFO, Gtk::BUTTONS_OK};
+                dialog.set_secondary_text(_("Open a chat with at least one message before exporting."));
+                dialog.run();
+                return;
+            }
+
+            saveChatTranscript(title, transcript);
+        }
