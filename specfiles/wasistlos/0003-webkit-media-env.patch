 int main(int argc, char** argv)
 {
+    // WebKit can't negotiate buffers with V4L2 stateless decoders (Apple AVD): garbled frames, web process crashes
+    auto const rank = Glib::getenv("GST_PLUGIN_FEATURE_RANK");
+    Glib::setenv("GST_PLUGIN_FEATURE_RANK", rank + (rank.empty() ? "" : ",") + "v4l2slh264dec:NONE,v4l2slh265dec:NONE,v4l2slvp9dec:NONE");
+    // WirePlumber would restore a muted video preview's volume onto later voice notes
+    Glib::setenv("PULSE_PROP", "state.restore-props=false");
