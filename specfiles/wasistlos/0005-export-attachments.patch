+
+        std::string attachmentLink(std::string const& exportPath, std::string const& id, std::string const& type, std::string const& name)
+        {
+            auto const  base     = Glib::path_get_basename(exportPath);
+            auto const  dirName  = base.substr(0, base.rfind('.')) + "_attachments";
+            // fromMe_chat_key[_participant]
+            auto const  keyStart = id.find('_', id.find('_') + 1);
+            auto const  keyId    = (keyStart == std::string::npos) ? id : id.substr(keyStart + 1, id.find('_', keyStart + 1) - keyStart - 1);
+            auto const  fileName = sanitizeFilename(name.empty() || name[0] == '.' ? keyId + name : keyId + "_" + name);
+            auto const  file     = Glib::build_filename(Glib::path_get_dirname(exportPath), dirName, fileName);
+
+            auto& state = attachments();
+            if (!Glib::file_test(file, Glib::FILE_TEST_EXISTS) && !state.pending.count(id) && !state.failed.count(id)
+                && (id.find_first_of("'\\\n") == std::string::npos) && voiceNotes().view)
+            {
+                state.pending[id] = file;
+                auto const script = "if (window.__wilFetchAttachment) { window.__wilFetchAttachment('" + id + "'); }";
+                webkit_web_view_evaluate_javascript(voiceNotes().view, script.c_str(), -1, nullptr, nullptr, nullptr, nullptr, nullptr);
+            }
+
+            auto* const escaped = g_uri_escape_string((dirName + "/" + fileName).c_str(), "/", TRUE);
+            auto const  target  = std::string{escaped};
+            g_free(escaped);
+
+            auto const embed = (type == "image") || (type == "sticker");
+            return std::string{embed ? "![" : "[📎 "} + (name.empty() || name[0] == '.' ? type : name) + "](" + target + ")";
+        }
+
+        // Attachments arrive as "\x05id\x05type\x05name\x05caption"; the link is stable, the file lands asynchronously.
+        std::vector<ChatEntry> resolveAttachments(std::string const& exportPath, std::vector<ChatEntry> entries)
+        {
+            for (auto& entry : entries)
+            {
+                if (entry.text.empty() || (entry.text[0] != '\x05'))
+                {
+                    continue;
+                }
+
+                auto const s1 = entry.text.find('\x05', 1);
+                auto const s2 = (s1 == std::string::npos) ? s1 : entry.text.find('\x05', s1 + 1);
+                auto const s3 = (s2 == std::string::npos) ? s2 : entry.text.find('\x05', s2 + 1);
+                if (s3 == std::string::npos)
+                {
+                    continue;
+                }
+
+                auto const caption = entry.text.substr(s3 + 1);
+                auto const link    = attachmentLink(exportPath, entry.text.substr(1, s1 - 1), entry.text.substr(s1 + 1, s2 - s1 - 1), entry.text.substr(s2 + 1, s3 - s2 - 1));
+                entry.text         = caption.empty() ? link : link + "\n" + caption;
+            }
+            return entries;
+        }
+
+        void attachmentReceived(WebKitUserContentManager*, WebKitJavascriptResult* jsResult, gpointer)
+        {
+            auto* const resultString = jsc_value_to_string(webkit_javascript_result_get_js_value(jsResult));
+            auto const  raw          = std::string{resultString ? resultString : ""};
+            g_free(resultString);
+
+            auto&      state = attachments();
+            auto const sep   = raw.find('\x01');
+            auto const it    = state.pending.find(raw.substr(0, sep));
+            if ((sep == std::string::npos) || (it == state.pending.end()))
+            {
+                return;
+            }
+
+            auto const id   = it->first;
+            auto const file = it->second;
+            state.pending.erase(it);
+
+            auto const data = raw.substr(sep + 1);
+            if (data.empty() || (data[0] == '\x01'))
+            {
+                state.failed.insert(id);
+                std::cerr << "WebView: Could not fetch attachment " << id << ": " << (data.empty() ? "" : data.substr(1)) << std::endl;
+                return;
+            }
+
+            gsize       size    = 0;
+            auto* const decoded = g_base64_decode(data.c_str(), &size);
+            g_mkdir_with_parents(Glib::path_get_dirname(file).c_str(), 0755);
+            auto const tmp = file + ".part";
+            {
+                auto outFile = std::ofstream{tmp, std::ios::binary};
+                outFile.write(reinterpret_cast<char const*>(decoded), static_cast<std::streamsize>(size));
+            }
+            g_free(decoded);
+            g_rename(tmp.c_str(), file.c_str());
+        }
