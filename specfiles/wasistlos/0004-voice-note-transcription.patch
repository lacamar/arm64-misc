+        void transcriptionWorker()
+        {
+            auto&            state   = voiceNotes();
+            whisper_context* context = nullptr;
+            std::string      loadedModel;
+
+            whisper_log_set([](ggml_log_level, char const*, void*) {}, nullptr);
+
+            while (true)
+            {
+                auto job = TranscriptionJob{};
+                {
+                    auto lock = std::unique_lock{state.mutex};
+                    state.wake.wait(lock, [&state] { return !state.jobs.empty(); });
+                    job = std::move(state.jobs.front());
+                    state.jobs.pop_front();
+                }
+
+                g_idle_add(voiceNoteTranscribed, new TranscriptionResult{transcribe(job, context, loadedModel)});
+            }
+        }
