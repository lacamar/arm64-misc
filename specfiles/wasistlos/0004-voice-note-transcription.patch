+        gboolean voiceNoteTranscribed(gpointer data)
+        {
+            auto const result = std::unique_ptr<TranscriptionResult>{static_cast<TranscriptionResult*>(data)};
+            auto&      state  = voiceNotes();
+            state.requested.erase(result->id);
+            state.transcribing.erase(result->id);
+
+            if (!result->transcript)
+            {
+                state.failed.insert(result->id);
+                showVoiceNoteError(result->error);
+                return G_SOURCE_REMOVE;
+            }
+
+            saveTranscript(result->id, *result->transcript);
+
+            if (auto const it = state.pending.find(result->id); it != state.pending.end())
+            {
+                auto entry = it->second.entry;
+                entry.text = voiceNoteText(it->second.duration, *result->transcript);
+                if (auto const path = exportPathFor(it->second.title); !path.empty())
+                {
+                    mergeIntoExport(path, it->second.title, {entry});
+                }
+                state.pending.erase(it);
+            }
+            else if (state.view)
+            {
+                triggerImmediateContinuousExportScrape(state.view);
+            }
+
+            return G_SOURCE_REMOVE;
+        }
