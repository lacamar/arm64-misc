+        TranscriptionResult transcribe(TranscriptionJob const& job, whisper_context*& context, std::string& loadedModel)
+        {
+            auto result = TranscriptionResult{job.id, std::nullopt, {}};
+
+            if (!context || (loadedModel != job.modelPath))
+            {
+                if (context)
+                {
+                    whisper_free(context);
+                }
+                context     = whisper_init_from_file_with_params(job.modelPath.c_str(), whisper_context_default_params());
+                loadedModel = context ? job.modelPath : std::string{};
+                if (!context)
+                {
+                    result.error = "failed to load model " + job.modelPath;
+                    return result;
+                }
+            }
+
+            auto const samples = decodeAudio(job.audio, result.error);
+            if (!samples)
+            {
+                return result;
+            }
+
+            auto params             = whisper_full_default_params(WHISPER_SAMPLING_GREEDY);
+            params.language         = job.language.c_str();
+            params.n_threads        = static_cast<int>(std::clamp(std::thread::hardware_concurrency(), 1u, 8u));
+            params.print_progress   = false;
+            params.print_realtime   = false;
+            params.print_special    = false;
+            params.print_timestamps = false;
+
+            if (whisper_full(context, params, samples->data(), static_cast<int>(samples->size())) != 0)
+            {
+                result.error = "whisper_full failed";
+                return result;
+            }
+
+            std::string transcript;
+            for (int i = 0; i < whisper_full_n_segments(context); ++i)
+            {
+                std::string segment = whisper_full_get_segment_text(context, i);
+                auto const  first   = segment.find_first_not_of(" \t\n");
+                if (first == std::string::npos)
+                {
+                    continue;
+                }
+                segment = segment.substr(first, segment.find_last_not_of(" \t\n") - first + 1);
+                transcript += (transcript.empty() ? "" : " ") + segment;
+            }
+
+            result.transcript = transcript;
+            return result;
+        }
