+    void WebView::pasteImageFromClipboard()
+    {
+        auto const clipboard = Gtk::Clipboard::get();
+
+        if (!clipboard->wait_is_image_available())
+        {
+            auto dialog = Gtk::MessageDialog{_("No Image on Clipboard"), false, Gtk::MESSAGE_INFO, Gtk::BUTTONS_OK};
+            dialog.set_secondary_text(_("Copy an image first, then try again."));
+            dialog.run();
+            return;
+        }
+
+        auto const pixbuf = clipboard->wait_for_image();
+        if (!pixbuf)
+        {
+            return;
+        }
+
+        gchar* buffer     = nullptr;
+        gsize  bufferSize = 0;
+        try
+        {
+            pixbuf->save_to_buffer(buffer, bufferSize, "png");
+        }
+        catch (Glib::Error const& error)
+        {
+            std::cerr << "WebView: Failed to encode clipboard image: " << error.what().c_str() << std::endl;
+            return;
+        }
+
+        auto* const base64Data = g_base64_encode(reinterpret_cast<guchar const*>(buffer), bufferSize);
+        g_free(buffer);
+        auto const script = std::string{PASTE_IMAGE_SCRIPT_PREFIX} + base64Data + PASTE_IMAGE_SCRIPT_SUFFIX;
+        g_free(base64Data);
+
+        webkit_web_view_evaluate_javascript(*this, script.c_str(), -1, nullptr, nullptr, nullptr, pasteImageFinished, nullptr);
+    }
