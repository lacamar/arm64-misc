+        // WebKitGTK doesn't surface native clipboard images to paste events; fake a file drop instead.
+        constexpr auto const PASTE_IMAGE_SCRIPT_PREFIX = R"JS(
+            (function() {
+                try {
+                    var binary = atob(')JS";
+
+        constexpr auto const PASTE_IMAGE_SCRIPT_SUFFIX = R"JS(');
+                    var bytes = new Uint8Array(binary.length);
+                    for (var i = 0; i < binary.length; i++) { bytes[i] = binary.charCodeAt(i); }
+                    var file = new File([bytes], 'pasted-image.png', {type: 'image/png'});
+
+                    var dataTransfer = new DataTransfer();
+                    dataTransfer.items.add(file);
+
+                    var target = document.querySelector('#main footer div[contenteditable="true"]')
+                        || document.querySelector('div[aria-label="Type a message"][contenteditable="true"]')
+                        || document.querySelector('#main div[contenteditable="true"][data-tab]');
+
+                    if (!target) { return 'no-target'; }
+
+                    target.focus();
+                    target.dispatchEvent(new DragEvent('drop', {bubbles: true, cancelable: true, dataTransfer: dataTransfer}));
+                    return 'ok';
+                } catch (e) {
+                    return 'error: ' + e.message;
+                }
+            })();
+        )JS";
+
+        void pasteImageFinished(GObject* sourceObject, GAsyncResult* result, gpointer)
+        {
+            GError* error      = nullptr;
+            auto* const value  = webkit_web_view_evaluate_javascript_finish(WEBKIT_WEB_VIEW(sourceObject), result, &error);
+
+            if (!value)
+            {
+                std::cerr << "WebView: Failed to paste image: " << (error ? error->message : "unknown error") << std::endl;
+                if (error)
+                {
+                    g_error_free(error);
+                }
+                return;
+            }
+
+            auto* const resultString = jsc_value_to_string(value);
+            auto const  status       = std::string{resultString ? resultString : ""};
+            g_free(resultString);
+            g_object_unref(value);
+
+            if (status == "no-target")
+            {
+                auto dialog = Gtk::MessageDialog{_("No Chat Open"), false, Gtk::MESSAGE_INFO, Gtk::BUTTONS_OK};
+                dialog.set_secondary_text(_("Open a chat before pasting an image."));
+                dialog.run();
+            }
+            else if (status.rfind("error:", 0) == 0)
+            {
+                auto dialog = Gtk::MessageDialog{_("Paste Failed"), false, Gtk::MESSAGE_ERROR, Gtk::BUTTONS_OK};
+                dialog.set_secondary_text(status);
+                dialog.run();
+            }
+        }
     }
 
