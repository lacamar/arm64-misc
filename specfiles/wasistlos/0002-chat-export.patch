+
+        std::string voiceNoteText(std::string const& duration, std::string const& transcript)
+        {
+            auto text = std::string{"🎤 Voice note"};
+            if (!duration.empty())
+            {
+                text += " (" + duration + ")";
+            }
+            return transcript.empty() ? text : text + ": " + transcript;
+        }
+
+        std::optional<std::vector<float>> decodeAudio(std::string const& audio, std::string& error)
+        {
+            GError* gerror  = nullptr;
+            auto* const process = g_subprocess_new(
+                static_cast<GSubprocessFlags>(G_SUBPROCESS_FLAGS_STDIN_PIPE | G_SUBPROCESS_FLAGS_STDOUT_PIPE | G_SUBPROCESS_FLAGS_STDERR_PIPE), &gerror,
+                "ffmpeg", "-loglevel", "error", "-i", "pipe:0", "-f", "f32le", "-ac", "1", "-ar", "16000", "pipe:1", nullptr);
+            if (!process)
+            {
+                error = gerror->message;
+                g_error_free(gerror);
+                return std::nullopt;
+            }
+
+            auto* const input  = g_bytes_new(audio.data(), audio.size());
+            GBytes*     output = nullptr;
+            GBytes*     stderrBytes = nullptr;
+            auto const  ok     = g_subprocess_communicate(process, input, nullptr, &output, &stderrBytes, &gerror)
+                && g_subprocess_get_if_exited(process) && (g_subprocess_get_exit_status(process) == 0);
+            g_bytes_unref(input);
+
+            std::optional<std::vector<float>> samples;
+            if (ok)
+            {
+                gsize size        = 0;
+                auto const* data  = static_cast<float const*>(g_bytes_get_data(output, &size));
+                samples           = std::vector<float>(data, data + size / sizeof(float));
+            }
+            else if (gerror)
+            {
+                error = gerror->message;
+                g_error_free(gerror);
+            }
+            else
+            {
+                gsize size = 0;
+                auto const* data = static_cast<char const*>(stderrBytes ? g_bytes_get_data(stderrBytes, &size) : nullptr);
+                error = "ffmpeg: " + (data ? std::string{data, size} : std::string{"failed"});
+            }
+
+            if (output)
+            {
+                g_bytes_unref(output);
+            }
+            if (stderrBytes)
+            {
+                g_bytes_unref(stderrBytes);
+            }
+            g_object_unref(process);
+            return samples;
+        }
+
+        std::shared_ptr<whisper_context> loadModel(std::string const& path, std::string& error)
+        {
+            auto&      state = voiceNotes();
+            auto const lock  = std::lock_guard{state.loadMutex};
+            {
+                auto const inner = std::lock_guard{state.mutex};
+                if (state.model && (state.modelPath == path))
+                {
+                    return state.model;
+                }
+            }
+
+            auto params       = whisper_context_default_params();
+            params.flash_attn = true;
+            auto* const raw   = whisper_init_from_file_with_params(path.c_str(), params);
+            if (!raw)
+            {
+                error = "failed to load model " + path;
+                return nullptr;
+            }
+
+            auto const inner = std::lock_guard{state.mutex};
+            state.model      = std::shared_ptr<whisper_context>{raw, whisper_free};
+            state.modelPath  = path;
+            return state.model;
+        }
+
+        TranscriptionResult transcribe(TranscriptionJob const& job, int threads)
+        {
+            auto result = TranscriptionResult{job.id, std::nullopt, {}};
+
+            auto const samples = decodeAudio(job.audio, result.error);
+            if (!samples)
+            {
+                return result;
+            }
+
+            auto const model = loadModel(job.modelPath, result.error);
+            if (!model)
+            {
+                return result;
+            }
+
+            auto const state = std::unique_ptr<whisper_state, decltype(&whisper_free_state)>{whisper_init_state(model.get()), whisper_free_state};
+            if (!state)
+            {
+                result.error = "whisper_init_state failed";
+                return result;
+            }
+
+            auto params             = whisper_full_default_params(WHISPER_SAMPLING_GREEDY);
+            params.language         = job.language.c_str();
+            params.n_threads        = threads;
+            params.print_progress   = false;
+            params.print_realtime   = false;
+            params.print_special    = false;
+            params.print_timestamps = false;
+            params.no_context       = true;
+
+            if (whisper_full_with_state(model.get(), state.get(), params, samples->data(), static_cast<int>(samples->size())) != 0)
+            {
+                result.error = "whisper_full failed";
+                return result;
+            }
+
+            std::string transcript;
+            std::string previous;
+            for (int i = 0; i < whisper_full_n_segments_from_state(state.get()); ++i)
+            {
+                std::string segment = whisper_full_get_segment_text_from_state(state.get(), i);
+                auto const  first   = segment.find_first_not_of(" \t\n");
+                if (first == std::string::npos)
+                {
+                    continue;
+                }
+                segment = segment.substr(first, segment.find_last_not_of(" \t\n") - first + 1);
+                if (segment == previous)
+                {
+                    continue;
+                }
+                previous = segment;
+                transcript += (transcript.empty() ? "" : " ") + segment;
+            }
+
+            result.transcript = transcript;
+            return result;
+        }
+
+        void showVoiceNoteError(std::string const& message)
+        {
+            std::cerr << "WebView: Voice note transcription failed: " << message << std::endl;
+
+            auto& state = voiceNotes();
+            if (state.errorShown)
+            {
+                return;
+            }
+            state.errorShown = true;
+
+            auto dialog = Gtk::MessageDialog{_("Voice Note Transcription Failed"), false, Gtk::MESSAGE_ERROR, Gtk::BUTTONS_OK};
+            dialog.set_secondary_text(message);
+            dialog.run();
+        }
+
+        gboolean voiceNoteTranscribed(gpointer data)
+        {
+            auto const result = std::unique_ptr<TranscriptionResult>{static_cast<TranscriptionResult*>(data)};
+            auto&      state  = voiceNotes();
+            state.requested.erase(result->id);
+            state.transcribing.erase(result->id);
+
+            if (!result->transcript)
+            {
+                state.failed.insert(result->id);
+                showVoiceNoteError(result->error);
+                return G_SOURCE_REMOVE;
+            }
+
+            saveTranscript(result->id, *result->transcript);
+
+            if (auto const it = state.pending.find(result->id); it != state.pending.end())
+            {
+                auto entry = it->second.entry;
+                entry.text = voiceNoteText(it->second.duration, *result->transcript);
+                if (auto const path = exportPathFor(it->second.title); !path.empty())
+                {
+                    mergeIntoExport(path, it->second.title, {entry});
+                }
+                state.pending.erase(it);
+            }
+            else if (state.view)
+            {
+                triggerImmediateContinuousExportScrape(state.view);
+            }
+
+            return G_SOURCE_REMOVE;
+        }
+
+        void transcriptionWorker(int threads)
+        {
+            auto& state = voiceNotes();
+            // Inherited by ggml's compute threads and the ffmpeg child, so the UI keeps priority.
+            setpriority(PRIO_PROCESS, static_cast<id_t>(gettid()), 10);
+
+            while (true)
+            {
+                auto job = TranscriptionJob{};
+                {
+                    auto lock = std::unique_lock{state.mutex};
+                    if (!state.wake.wait_for(lock, std::chrono::minutes{10}, [&state] { return !state.jobs.empty(); }))
+                    {
+                        if (state.busy == 0)
+                        {
+                            state.model.reset();
+                        }
+                        continue;
+                    }
+                    job = std::move(state.jobs.front());
+                    state.jobs.pop_front();
+                    ++state.busy;
+                }
+
+                auto* const result = new TranscriptionResult{transcribe(job, threads)};
+                {
+                    auto const lock = std::lock_guard{state.mutex};
+                    --state.busy;
+                }
+                g_idle_add(voiceNoteTranscribed, result);
+            }
+        }
+
+        void enqueueTranscription(std::string const& id, std::string audio)
+        {
+            auto& state = voiceNotes();
+            {
+                auto const lock = std::lock_guard{state.mutex};
+                state.jobs.push_back(TranscriptionJob{id, std::move(audio), voiceModelPath(),
+                    util::Settings::getInstance().getValue<Glib::ustring>(VOICE_NOTES_GROUP, "language", "auto").raw()});
+            }
+
+            if (state.workers == 0)
+            {
+                whisper_log_set([](ggml_log_level, char const*, void*) {}, nullptr);
+                // Workers share one loaded model via per-job whisper states; a third of the cores stay free for the UI.
+                auto const threads = std::max(1u, std::thread::hardware_concurrency() * 2 / 3);
+                state.workers      = std::clamp(threads / 4, 1u, 3u);
+                for (auto i = 0u; i < state.workers; ++i)
+                {
+                    std::thread{transcriptionWorker, static_cast<int>(threads / state.workers)}.detach();
+                }
+            }
+            state.wake.notify_one();
+        }
+
+        void voiceModelDownloaded(GObject* sourceObject, GAsyncResult* result, gpointer userData)
+        {
+            auto const partialPath = std::unique_ptr<std::string>{static_cast<std::string*>(userData)};
+            auto const finalPath   = partialPath->substr(0, partialPath->size() - std::string{".part"}.size());
+
+            GError* error = nullptr;
+            if (!g_subprocess_wait_check_finish(G_SUBPROCESS(sourceObject), result, &error) || (g_rename(partialPath->c_str(), finalPath.c_str()) != 0))
+            {
+                showVoiceNoteError(error ? std::string{error->message} : std::string{"failed to download "} + VOICE_MODEL_URL);
+                if (error)
+                {
+                    g_error_free(error);
+                }
+                g_unlink(partialPath->c_str());
+                return;
+            }
+
+            voiceNotes().failed.clear();
+            if (auto* const view = voiceNotes().view)
+            {
+                triggerImmediateContinuousExportScrape(view);
+            }
+        }
+
+        bool ensureVoiceModel()
+        {
+            auto& state = voiceNotes();
+            if (Glib::file_test(voiceModelPath(), Glib::FILE_TEST_IS_REGULAR))
+            {
+                return true;
+            }
+            if (state.modelPrompted)
+            {
+                return false;
+            }
+            state.modelPrompted = true;
+
+            auto dialog = Gtk::MessageDialog{_("Transcribe Voice Notes?"), false, Gtk::MESSAGE_QUESTION, Gtk::BUTTONS_NONE};
+            dialog.set_secondary_text(_("Continuous export can transcribe voice notes into the chat log. This needs a Whisper speech recognition model (about 3 GB)."));
+            dialog.add_button(_("Download Model"), Gtk::RESPONSE_ACCEPT);
+            dialog.add_button(_("Choose Model File…"), Gtk::RESPONSE_APPLY);
+            dialog.add_button(_("Not Now"), Gtk::RESPONSE_CANCEL);
+
+            switch (dialog.run())
+            {
+                case Gtk::RESPONSE_ACCEPT:
+                {
+                    auto const path = voiceModelPath();
+                    g_mkdir_with_parents(Glib::path_get_dirname(path).c_str(), 0755);
+
+                    GError* error   = nullptr;
+                    auto* const partialPath = new std::string{path + ".part"};
+                    auto* const process = g_subprocess_new(G_SUBPROCESS_FLAGS_NONE, &error, "curl", "-fsSL", "-o", partialPath->c_str(), VOICE_MODEL_URL, nullptr);
+                    if (!process)
+                    {
+                        delete partialPath;
+                        showVoiceNoteError(error->message);
+                        g_error_free(error);
+                        return false;
+                    }
+                    g_subprocess_wait_check_async(process, nullptr, voiceModelDownloaded, partialPath);
+                    g_object_unref(process);
+                    return false;
+                }
+
+                case Gtk::RESPONSE_APPLY:
+                {
+                    auto chooser = Gtk::FileChooserDialog{_("Choose Whisper Model"), Gtk::FILE_CHOOSER_ACTION_OPEN};
+                    chooser.add_button(_("Cancel"), Gtk::RESPONSE_CANCEL);
+                    chooser.add_button(_("Open"), Gtk::RESPONSE_OK);
+                    if (chooser.run() != Gtk::RESPONSE_OK)
+                    {
+                        return false;
+                    }
+                    util::Settings::getInstance().setValue<Glib::ustring>(VOICE_NOTES_GROUP, "model", chooser.get_filename());
+                    return true;
+                }
+
+                default:
+                    return false;
+            }
+        }
+
+        void requestVoiceNote(std::string const& title, ChatEntry const& entry, std::string const& id, std::string const& duration)
+        {
+            auto& state = voiceNotes();
+            state.pending[id] = PendingVoiceNote{title, entry, duration};
+
+            if (!state.view || state.requested.count(id) || state.failed.count(id)
+                || (id.find_first_of("'\\\n") != std::string::npos) || !ensureVoiceModel())
+            {
+                return;
+            }
+
+            state.requested.insert(id);
+            auto const script = "if (window.__wilFetchMedia) { window.__wilFetchMedia('" + id + "'); }";
+            webkit_web_view_evaluate_javascript(state.view, script.c_str(), -1, nullptr, nullptr, nullptr, nullptr, nullptr);
+        }
+
+        // Voice notes arrive as "\x04id\x04duration"; untranscribed ones are held back until their transcript is ready.
+        std::vector<ChatEntry> resolveVoiceNotes(std::string const& title, std::vector<ChatEntry> entries)
+        {
+            std::vector<ChatEntry> resolved;
+            for (auto& entry : entries)
+            {
+                if (entry.text.empty() || (entry.text[0] != '\x04'))
+                {
+                    resolved.push_back(std::move(entry));
+                    continue;
+                }
+
+                auto const sep      = entry.text.find('\x04', 1);
+                auto const id       = entry.text.substr(1, sep == std::string::npos ? std::string::npos : sep - 1);
+                auto const duration = (sep == std::string::npos) ? std::string{} : entry.text.substr(sep + 1);
+
+                if (auto const transcript = cachedTranscript(id))
+                {
+                    entry.text = voiceNoteText(duration, *transcript);
+                    resolved.push_back(std::move(entry));
+                }
+                else
+                {
+                    requestVoiceNote(title, entry, id, duration);
+                }
+            }
+            return resolved;
+        }
+
+        void voiceNoteReceived(std::string const& id, std::string const& data)
+        {
+            auto& state = voiceNotes();
+            if (!state.requested.count(id) || state.transcribing.count(id))
+            {
+                return;
+            }
+
+            if (data.empty() || (data[0] == '\x01'))
+            {
+                state.requested.erase(id);
+                state.failed.insert(id);
+                std::cerr << "WebView: Could not fetch audio for voice note " << id << ": " << (data.empty() ? "" : data.substr(1)) << std::endl;
+                return;
+            }
+
+            gsize       size    = 0;
+            auto* const decoded = g_base64_decode(data.c_str(), &size);
+            state.transcribing.insert(id);
+            enqueueTranscription(id, std::string{reinterpret_cast<char const*>(decoded), size});
+            g_free(decoded);
+        }
+
+        struct AttachmentState
+        {
+            std::map<std::string, std::string> pending;
+            std::set<std::string>              failed;
+        };
+
+        AttachmentState& attachments()
+        {
+            static AttachmentState state;
+            return state;
+        }
+
+        std::string attachmentLink(std::string const& exportPath, std::string const& id, std::string const& type, std::string const& name)
+        {
+            auto const  base     = Glib::path_get_basename(exportPath);
+            auto const  dirName  = base.substr(0, base.rfind('.')) + "_attachments";
+            // fromMe_chat_key[_participant]
+            auto const  keyStart = id.find('_', id.find('_') + 1);
+            auto const  keyId    = (keyStart == std::string::npos) ? id : id.substr(keyStart + 1, id.find('_', keyStart + 1) - keyStart - 1);
+            auto const  fileName = sanitizeFilename(name.empty() || name[0] == '.' ? keyId + name : keyId + "_" + name);
+            auto const  file     = Glib::build_filename(Glib::path_get_dirname(exportPath), dirName, fileName);
+
+            auto& state = attachments();
+            if (!Glib::file_test(file, Glib::FILE_TEST_EXISTS) && !state.pending.count(id) && !state.failed.count(id)
+                && (id.find_first_of("'\\\n") == std::string::npos) && voiceNotes().view)
+            {
+                state.pending[id] = file;
+                auto const script = "if (window.__wilFetchMedia) { window.__wilFetchMedia('" + id + "'); }";
+                webkit_web_view_evaluate_javascript(voiceNotes().view, script.c_str(), -1, nullptr, nullptr, nullptr, nullptr, nullptr);
+            }
+
+            auto* const escaped = g_uri_escape_string((dirName + "/" + fileName).c_str(), "/", TRUE);
+            auto const  target  = std::string{escaped};
+            g_free(escaped);
+
+            auto const embed = (type == "image") || (type == "sticker");
+            return std::string{embed ? "![" : "[📎 "} + (name.empty() || name[0] == '.' ? type : name) + "](" + target + ")";
+        }
+
+        // Attachments arrive as "\x05id\x05type\x05name\x05caption"; the link is stable, the file lands asynchronously.
+        std::vector<ChatEntry> resolveAttachments(std::string const& exportPath, std::vector<ChatEntry> entries)
+        {
+            for (auto& entry : entries)
+            {
+                if (entry.text.empty() || (entry.text[0] != '\x05'))
+                {
+                    continue;
+                }
+
+                auto const s1 = entry.text.find('\x05', 1);
+                auto const s2 = (s1 == std::string::npos) ? s1 : entry.text.find('\x05', s1 + 1);
+                auto const s3 = (s2 == std::string::npos) ? s2 : entry.text.find('\x05', s2 + 1);
+                if (s3 == std::string::npos)
+                {
+                    continue;
+                }
+
+                auto const caption = entry.text.substr(s3 + 1);
+                auto const link    = attachmentLink(exportPath, entry.text.substr(1, s1 - 1), entry.text.substr(s1 + 1, s2 - s1 - 1), entry.text.substr(s2 + 1, s3 - s2 - 1));
+                entry.text         = caption.empty() ? link : link + "\n" + caption;
+            }
+            return entries;
+        }
+
+        void attachmentReceived(std::string const& id, std::string const& data)
+        {
+            auto&      state = attachments();
+            auto const it    = state.pending.find(id);
+            auto const file  = it->second;
+            state.pending.erase(it);
+
+            if (data.empty() || (data[0] == '\x01'))
+            {
+                state.failed.insert(id);
+                std::cerr << "WebView: Could not fetch attachment " << id << ": " << (data.empty() ? "" : data.substr(1)) << std::endl;
+                return;
+            }
+
+            gsize       size    = 0;
+            auto* const decoded = g_base64_decode(data.c_str(), &size);
+            g_mkdir_with_parents(Glib::path_get_dirname(file).c_str(), 0755);
+            auto const tmp = file + ".part";
+            {
+                auto outFile = std::ofstream{tmp, std::ios::binary};
+                outFile.write(reinterpret_cast<char const*>(decoded), static_cast<std::streamsize>(size));
+            }
+            g_free(decoded);
+            g_rename(tmp.c_str(), file.c_str());
+        }
+
+        void mediaReceived(WebKitUserContentManager*, WebKitJavascriptResult* jsResult, gpointer)
+        {
+            auto* const resultString = jsc_value_to_string(webkit_javascript_result_get_js_value(jsResult));
+            auto const  raw          = std::string{resultString ? resultString : ""};
+            g_free(resultString);
+
+            auto const sep = raw.find('\x01');
+            if (sep == std::string::npos)
+            {
+                return;
+            }
+
