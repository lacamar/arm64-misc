+                    });
+                }
+
+                var mediaQueue = Promise.resolve();
+                window.__wilFetchMedia = function(id) {
+                    mediaQueue = mediaQueue.then(function() { return downloadMedia(id).then(readBase64); })
+                        .catch(function(e) { return '\x01' + String(e && e.message || e); })
+                        .then(function(data) {
+                            try { window.webkit.messageHandlers.wilMedia.postMessage(id + '\x01' + data); } catch (e) { /* handler not registered yet */ }
