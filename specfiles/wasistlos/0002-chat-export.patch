+                var lastTitle      = currentTitle();
+                var debounceTimer  = null;
+                var observer       = new MutationObserver(function() {
+                    var title = currentTitle();
+                    if (title && title !== lastTitle) {
+                        lastTitle = title;
+                        if (debounceTimer) { clearTimeout(debounceTimer); debounceTimer = null; }
+                        scrapeAndNotify();
+                        return;
+                    }
