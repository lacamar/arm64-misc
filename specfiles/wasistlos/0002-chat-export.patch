+                window.__wilForceContinuousExportScrape = scrapeAndNotify;
+
+                async function downloadMedia(id) {
+                    var msg = storeMessage(id);
+                    if (!msg) { throw new Error('message not in store'); }
+                    if (!msg.mediaData || msg.mediaData.mediaStage === 'REUPLOADING') { throw new Error('no mediaData'); }
