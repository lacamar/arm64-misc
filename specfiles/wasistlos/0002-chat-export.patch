+                var VOICE_SELECTOR = '[data-icon="audio-play"], [data-icon="audio-pause"], [data-icon^="ptt"], [aria-label*="voice message" i]';
+                var CLOCK_PATTERN  = /^\d{1,2}[:.]\d{2}(\s*[ap]\.?\s?m\.?)?$/i;
+
+                function voiceNote(row, seen) {
+                    var id = row.getAttribute('data-id');
+                    if (!id || seen[id] || row.querySelector('div.copyable-text[data-pre-plain-text]')) { return null; }
+
+                    var msg = storeMessage(id);
+                    var media = isAttachment(msg);
+                    if (!media && (msg ? !/^(ptt|audio)$/.test(msg.type) : !row.querySelector(VOICE_SELECTOR))) { return null; }
+                    seen[id] = true;
+
+                    var clocks = Array.prototype.map.call(row.querySelectorAll('span'), function(span) {
+                        return (span.innerText || '').trim();
+                    }).filter(function(text) { return CLOCK_PATTERN.test(text); });
+
+                    var seconds  = msg ? parseInt(msg.duration, 10) : NaN;
+                    var duration = isNaN(seconds) ? (clocks.length > 1 ? clocks[0] : '')
+                        : Math.floor(seconds / 60) + ':' + ('0' + seconds % 60).slice(-2);
+                    var group    = id.indexOf('@g.us') !== -1;
+                    var sender   = msg && msg.senderObj ? (msg.senderObj.formattedName || msg.senderObj.pushname || '') : '';
+
+                    return {
+                        voice:    true,
+                        media:    media ? attachmentMarker(id, msg) : '',
+                        id:       id,
+                        duration: duration,
+                        clock:    clocks.length ? clocks[clocks.length - 1] : '',
+                        t:        msg ? msg.t : 0,
+                        out:      msg ? msg.id.fromMe : (id.indexOf('true_') === 0 || !!row.closest('.message-out')),
+                        sender:   group ? sender : ''
