+                }
+
+                function isAttachment(msg) {
+                    return !!(msg && msg.mediaData && /^(image|video|document|sticker|ptv)$/.test(msg.type));
+                }
+
+                // "\x05id\x05type\x05name\x05" prefixes the caption; native code turns it into a link.
+                function attachmentMarker(id, msg) {
