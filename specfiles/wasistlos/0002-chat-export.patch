+                function messageScroller() {
+                    var message = document.querySelector('#main div.copyable-text[data-pre-plain-text]');
+                    for (var el = message && message.parentElement; el && el !== document.body; el = el.parentElement) {
+                        var overflowY = getComputedStyle(el).overflowY;
+                        if ((overflowY === 'auto' || overflowY === 'scroll') && el.scrollHeight > el.clientHeight) {
