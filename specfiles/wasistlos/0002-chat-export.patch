+
+        std::string sanitizeFilename(std::string name)
+        {
+            for (auto& character : name)
+            {
+                if (character == '/' || character == '\\' || character == ':' || character == '*' || character == '?' || character == '"'
+                    || character == '<' || character == '>' || character == '|')
+                {
+                    character = '_';
+                }
+            }
+
+            return name.empty() ? "whatsapp-chat" : name;
+        }
+
+        std::string sanitizeSettingsKey(std::string name)
+        {
+            for (auto& character : name)
+            {
+                if (!std::isalnum(static_cast<unsigned char>(character)) && character != '.' && character != '-' && character != '_')
+                {
+                    character = '_';
+                }
+            }
+
+            return name.empty() ? "whatsapp-chat" : name;
+        }
+
+        std::string exportPathFor(std::string const& title)
+        {
+            return util::Settings::getInstance().getValue<Glib::ustring>(CONTINUOUS_EXPORT_GROUP, sanitizeSettingsKey(title), Glib::ustring{}).raw();
+        }
+
+        void triggerImmediateContinuousExportScrape(WebKitWebView* view)
+        {
+            webkit_web_view_evaluate_javascript(view, "if (window.__wilForceContinuousExportScrape) { window.__wilForceContinuousExportScrape(); }",
+                -1, nullptr, nullptr, nullptr, nullptr, nullptr);
+        }
+
+        void startContinuousExportBackfill(WebKitWebView* view)
+        {
+            webkit_web_view_evaluate_javascript(view, "if (window.__wilContinuousExportBackfill) { window.__wilContinuousExportBackfill(); }",
+                -1, nullptr, nullptr, nullptr, nullptr, nullptr);
+        }
+
+        // Returns true if a destination was set (i.e. the user didn't cancel).
+        bool promptForContinuousExportPath(std::string const& chatTitle)
+        {
+            auto dialog = Gtk::FileChooserDialog{_("Continuous Chat Export Location"), Gtk::FILE_CHOOSER_ACTION_SAVE};
+            dialog.add_button(_("Cancel"), Gtk::RESPONSE_CANCEL);
+            dialog.add_button(_("Save"), Gtk::RESPONSE_OK);
+            dialog.set_current_name(sanitizeFilename(chatTitle) + ".md");
+
+            if (dialog.run() != Gtk::RESPONSE_OK)
+            {
+                return false;
+            }
+
+            util::Settings::getInstance().setValue<Glib::ustring>(
+                CONTINUOUS_EXPORT_GROUP, sanitizeSettingsKey(chatTitle), dialog.get_filename());
+            return true;
+        }
+
+        void continuousExportConfigureFinished(GObject* sourceObject, GAsyncResult* result, gpointer)
+        {
+            GError* error      = nullptr;
+            auto* const value  = webkit_web_view_evaluate_javascript_finish(WEBKIT_WEB_VIEW(sourceObject), result, &error);
+
+            if (!value)
+            {
+                std::cerr << "WebView: Failed to read current chat title: " << (error ? error->message : "unknown error") << std::endl;
+                if (error)
+                {
+                    g_error_free(error);
+                }
+                return;
+            }
+
+            auto* const resultString = jsc_value_to_string(value);
+            auto const  title        = std::string{resultString ? resultString : ""};
+            g_free(resultString);
+            g_object_unref(value);
+
+            if (title.empty())
+            {
+                auto dialog = Gtk::MessageDialog{_("No Chat Open"), false, Gtk::MESSAGE_INFO, Gtk::BUTTONS_OK};
+                dialog.set_secondary_text(_("Open a chat before configuring continuous export."));
+                dialog.run();
+                return;
+            }
+
+            auto* const view = WEBKIT_WEB_VIEW(sourceObject);
+            auto const  key  = sanitizeSettingsKey(title);
+
+            if (auto const currentPath = exportPathFor(title); !currentPath.empty())
+            {
+
+                auto dialog = Gtk::MessageDialog{_("Continuous Export Enabled"), false, Gtk::MESSAGE_QUESTION, Gtk::BUTTONS_NONE};
+                dialog.set_secondary_text(Glib::ustring::compose(_("“%1” is currently exporting to:\n%2"), title, currentPath));
+                dialog.add_button(_("Fetch Full History"), Gtk::RESPONSE_ACCEPT);
+                dialog.add_button(_("Stop Exporting"), Gtk::RESPONSE_REJECT);
+                dialog.add_button(_("Change Location"), Gtk::RESPONSE_APPLY);
+                dialog.add_button(_("Cancel"), Gtk::RESPONSE_CANCEL);
+
+                switch (dialog.run())
+                {
+                    case Gtk::RESPONSE_ACCEPT:
+                        startContinuousExportBackfill(view);
+                        break;
+
+                    case Gtk::RESPONSE_REJECT:
+                        util::Settings::getInstance().removeValue(CONTINUOUS_EXPORT_GROUP, key);
+                        break;
+
+                    case Gtk::RESPONSE_APPLY:
+                        if (promptForContinuousExportPath(title))
+                        {
+                            startContinuousExportBackfill(view);
+                        }
+                        break;
+
+                    default:
+                        break;
+                }
+            }
+            else
+            {
+                auto dialog = Gtk::MessageDialog{_("Enable Continuous Export?"), false, Gtk::MESSAGE_QUESTION, Gtk::BUTTONS_YES_NO};
+                dialog.set_secondary_text(
+                    Glib::ustring::compose(_("Continuously export “%1” to a markdown file, updated as new messages arrive?"), title));
+
+                if ((dialog.run() == Gtk::RESPONSE_YES) && promptForContinuousExportPath(title))
+                {
+                    startContinuousExportBackfill(view);
+                }
+            }
+        }
+
+        struct ChatEntry
+        {
+            std::string time;
+            std::string sender;
+            std::string text;
+            long long   t = 0;
+
+            bool operator==(ChatEntry const& other) const
+            {
+                return (time == other.time) && (sender == other.sender) && (text == other.text);
+            }
+        };
+
+        std::vector<ChatEntry> parseIncomingRecords(std::string const& records)
+        {
+            std::vector<ChatEntry> entries;
+            std::size_t pos = 0;
+
+            while (pos < records.size())
+            {
+                auto const recordEnd = records.find('\x03', pos);
+                if (recordEnd == std::string::npos)
+                {
+                    break;
+                }
+
+                auto const record = records.substr(pos, recordEnd - pos);
+                auto const sep0   = record.find('\x02');
+                auto const sep1   = (sep0 == std::string::npos) ? sep0 : record.find('\x02', sep0 + 1);
+                auto const sep2   = (sep1 == std::string::npos) ? sep1 : record.find('\x02', sep1 + 1);
+
+                if (sep2 != std::string::npos)
+                {
+                    entries.push_back(ChatEntry{record.substr(sep0 + 1, sep1 - sep0 - 1), record.substr(sep1 + 1, sep2 - sep1 - 1), record.substr(sep2 + 1),
+                        std::atoll(record.c_str())});
+                }
+
+                pos = recordEnd + 1;
+            }
+
+            return entries;
+        }
+
+        std::string renderChatMarkdown(std::string const& title, std::vector<ChatEntry> const& entries)
+        {
+            std::string out = "# " + title + "\n\n";
+
+            for (auto const& entry : entries)
+            {
+                out += "**" + entry.sender + "** _" + entry.time + "_\n";
+                if (entry.t > 0)
+                {
+                    out += "<!-- " + std::to_string(entry.t) + " -->\n";
+                }
+                out += "\n";
+
+                std::size_t lineStart = 0;
+                while (true)
+                {
+                    auto const lineEnd = entry.text.find('\n', lineStart);
+                    auto const line    = (lineEnd == std::string::npos) ? entry.text.substr(lineStart) : entry.text.substr(lineStart, lineEnd - lineStart);
+                    out += "> " + line + "\n";
+
+                    if (lineEnd == std::string::npos)
+                    {
+                        break;
+                    }
+                    lineStart = lineEnd + 1;
+                }
+
+                out += "\n";
+            }
+
+            return out;
+        }
+
+        std::vector<ChatEntry> parseExistingMarkdown(std::string const& markdown)
+        {
+            std::vector<ChatEntry> entries;
+            std::istringstream     stream{markdown};
+            std::string            line;
+            bool                   inEntry = false;
+            std::string            currentSender;
+            std::string            currentTime;
+            long long              currentT = 0;
+            std::vector<std::string> currentLines;
+
+            auto flush = [&]()
+            {
+                if (!inEntry)
+                {
+                    return;
+                }
+
+                std::string text;
+                for (std::size_t i = 0; i < currentLines.size(); ++i)
+                {
+                    if (i)
+                    {
+                        text += "\n";
+                    }
+                    text += currentLines[i];
+                }
+
+                entries.push_back(ChatEntry{currentTime, currentSender, text, currentT});
+                inEntry = false;
+                currentLines.clear();
+            };
+
+            while (std::getline(stream, line))
+            {
+                if ((line.rfind("**", 0) == 0) && !line.empty() && (line.back() == '_'))
+                {
+                    if (auto const sepPos = line.find("** _", 2); sepPos != std::string::npos)
+                    {
+                        flush();
+                        inEntry       = true;
+                        currentSender = line.substr(2, sepPos - 2);
+                        currentTime   = line.substr(sepPos + 4, line.size() - (sepPos + 4) - 1);
+                        currentT      = 0;
+                        continue;
+                    }
+                }
+
+                if (inEntry && (line.rfind("<!-- ", 0) == 0))
+                {
+                    currentT = std::atoll(line.c_str() + 5);
+                }
+                else if (inEntry && (line.rfind("> ", 0) == 0))
+                {
+                    currentLines.push_back(line.substr(2));
+                }
+                else if (inEntry && (line == ">"))
+                {
+                    currentLines.push_back("");
+                }
+            }
+            flush();
+
+            return entries;
+        }
+
+        std::string alnumPrefix(std::string const& text, std::size_t length)
+        {
+            std::string prefix;
+            for (auto const c : text)
+            {
+                if (std::isalnum(static_cast<unsigned char>(c)) && prefix.size() < length)
+                {
+                    prefix += c;
+                }
+            }
+            return prefix;
+        }
+
+        // Entries exported before full-text lookup hold the "Read more" cut-off text.
+        bool isTruncatedOf(ChatEntry const& old, ChatEntry const& full)
+        {
+            auto const endsWith = [&old](std::string const& suffix)
+            {
+                return old.text.size() >= suffix.size() && old.text.compare(old.text.size() - suffix.size(), suffix.size(), suffix) == 0;
+            };
+            return old.time == full.time && old.sender == full.sender && full.text.size() > old.text.size()
+                && (endsWith("...") || endsWith("\u2026")) && alnumPrefix(old.text, 16) == alnumPrefix(full.text, 16);
+        }
+
+        std::vector<ChatEntry> mergeEntries(std::vector<ChatEntry> existing, std::vector<ChatEntry> const& window)
+        {
+            if (existing.empty())
+            {
+                return window;
+            }
+
+            auto findPos = [&existing](ChatEntry const& needle) -> std::optional<std::size_t>
+            {
+                for (std::size_t i = 0; i < existing.size(); ++i)
+                {
+                    if (existing[i] == needle)
+                    {
+                        return i;
+                    }
+                    if (isTruncatedOf(existing[i], needle))
+                    {
+                        existing[i].text = needle.text;
+                        return i;
+                    }
+                }
+                return std::nullopt;
+            };
+
+            struct Insertion
+            {
+                std::size_t             at;
+                std::vector<ChatEntry>  items;
+            };
+
+            std::vector<Insertion>     insertions;
+            std::vector<ChatEntry>     pending;
+            std::optional<std::size_t> afterPos;
+
+            auto flushPending = [&]()
+            {
+                if (pending.empty())
+                {
+                    return;
+                }
+                insertions.push_back(Insertion{afterPos.has_value() ? (*afterPos + 1) : 0, pending});
+                pending.clear();
+            };
+
+            for (auto const& item : window)
+            {
+                if (auto const pos = findPos(item))
+                {
+                    if (!existing[*pos].t)
+                    {
+                        existing[*pos].t = item.t;
+                    }
+                    flushPending();
+                    afterPos = pos;
+                }
+                else
+                {
+                    pending.push_back(item);
+                }
+            }
+
+            if (!pending.empty())
+            {
+                insertions.push_back(Insertion{afterPos.has_value() ? (*afterPos + 1) : existing.size(), pending});
+            }
+
+            std::sort(insertions.begin(), insertions.end(), [](Insertion const& a, Insertion const& b) { return a.at > b.at; });
+
+            for (auto const& insertion : insertions)
+            {
+                existing.insert(existing.begin() + static_cast<std::ptrdiff_t>(insertion.at), insertion.items.begin(), insertion.items.end());
+            }
+
+            return existing;
+        }
+
+        void mergeIntoExport(std::string const& path, std::string const& title, std::vector<ChatEntry> const& windowEntries)
+        {
+            auto existingEntries = std::vector<ChatEntry>{};
+            if (auto inFile = std::ifstream{path}; inFile)
+            {
+                auto const existingMarkdown = std::string{std::istreambuf_iterator<char>(inFile), std::istreambuf_iterator<char>()};
+                existingEntries              = parseExistingMarkdown(existingMarkdown);
+            }
+
+            auto mergedEntries = mergeEntries(std::move(existingEntries), windowEntries);
+            if (std::all_of(mergedEntries.begin(), mergedEntries.end(), [](ChatEntry const& entry) { return entry.t > 0; }))
+            {
+                std::stable_sort(mergedEntries.begin(), mergedEntries.end(), [](ChatEntry const& a, ChatEntry const& b) { return a.t < b.t; });
+            }
+
+            auto outFile = std::ofstream{path};
+            outFile << renderChatMarkdown(title, mergedEntries);
+        }
+
+        constexpr auto const VOICE_NOTES_GROUP = "voice-notes";
+        constexpr auto const VOICE_MODEL_URL   = "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3.bin";
+
+        struct PendingVoiceNote
+        {
+            std::string title;
+            ChatEntry   entry;
+            std::string duration;
+        };
+
+        struct TranscriptionJob
+        {
+            std::string id;
+            std::string audio;
+            std::string modelPath;
+            std::string language;
+        };
+
+        struct TranscriptionResult
+        {
+            std::string                id;
+            std::optional<std::string> transcript;
+            std::string                error;
+        };
+
+        struct VoiceNoteState
+        {
+            WebKitWebView*                          view = nullptr;
+            std::map<std::string, PendingVoiceNote> pending;
+            std::set<std::string>                   requested;
+            std::set<std::string>                   transcribing;
+            std::set<std::string>                   failed;
+            bool                                    modelPrompted = false;
+            bool                                    errorShown    = false;
+
+            std::mutex                       mutex;
+            std::condition_variable          wake;
+            std::deque<TranscriptionJob>     jobs;
+            unsigned                         workers = 0;
+            unsigned                         busy    = 0;
+            std::shared_ptr<whisper_context> model;
+            std::string                      modelPath;
+            std::mutex                       loadMutex;
+        };
+
+        VoiceNoteState& voiceNotes()
+        {
+            // Leaked on purpose: detached workers outlive static destruction.
+            static auto* const state = new VoiceNoteState{};
+            return *state;
+        }
+
+        std::string voiceModelPath()
+        {
+            // Shared with pywhispercpp's model cache.
+            auto const fallback = Glib::build_filename(Glib::get_user_data_dir(), std::string{"pywhispercpp"}, std::string{"models"}, std::string{"ggml-large-v3.bin"});
+            return util::Settings::getInstance().getValue<Glib::ustring>(VOICE_NOTES_GROUP, "model", fallback).raw();
+        }
+
+        std::string transcriptPath(std::string const& id)
+        {
+            return Glib::build_filename(std::string{g_get_user_state_dir()}, std::string{WIL_NAME}, std::string{"voice-notes"}, sanitizeSettingsKey(id) + ".txt");
+        }
+
+        std::optional<std::string> cachedTranscript(std::string const& id)
+        {
+            auto inFile = std::ifstream{transcriptPath(id)};
+            if (!inFile)
+            {
+                return std::nullopt;
+            }
+            return std::string{std::istreambuf_iterator<char>(inFile), std::istreambuf_iterator<char>()};
