+                // Walks the chat upwards in overlapping steps so every message passes through
+                // the virtualized window once; stops after the top stops loading older history.
+                var backfilling = false;
+                window.__wilContinuousExportBackfill = function() {
+                    var scroller = messageScroller();
+                    if (backfilling || !scroller) { return; }
+                    backfilling = true;
+
+                    var title      = currentTitle();
+                    var lastHeight = scroller.scrollHeight;
+                    var idleSteps  = 0;
+
+                    function step() {
+                        if (!scroller.isConnected || currentTitle() !== title) {
+                            backfilling = false;
+                            return;
+                        }
