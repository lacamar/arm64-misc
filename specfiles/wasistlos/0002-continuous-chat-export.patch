+        constexpr auto const CONTINUOUS_EXPORT_INIT_SCRIPT = R"JS(
+            (function() {
+                if (window.__wilContinuousExportInstalled) { return; }
+                window.__wilContinuousExportInstalled = true;
+
+                function currentTitle() {
+                    var titleEl = document.querySelector('#main header [data-testid="conversation-info-header-chat-title"]')
+                        || document.querySelector('#main header span[dir="auto"]');
+                    return titleEl ? titleEl.innerText.trim() : '';
+                }
+
+                // A reply's quoted message comes first; the reply text is the last top-level span.
+                function messageTextNode(node) {
+                    var spans = Array.prototype.filter.call(node.querySelectorAll('span.selectable-text'), function(span) {
+                        return !span.parentElement.closest('span.selectable-text');
+                    });
+                    return spans.length ? spans[spans.length - 1] : node;
+                }
+
+                function scrapeAndNotify() {
+                    var title = currentTitle();
+                    if (!title) { return; }
+
+                    var entries = [];
+                    document.querySelectorAll('#main div.copyable-text[data-pre-plain-text]').forEach(function(node) {
+                        var meta     = (node.getAttribute('data-pre-plain-text') || '').trim();
+                        var match    = meta.match(/^\[(.*?)\]\s*(.*?):\s*$/);
+                        var text     = (messageTextNode(node).innerText || '').trim();
+
+                        if (!match && !text) { return; }
+
+                        entries.push({
+                            time:   match ? match[1] : '',
+                            sender: match ? match[2] : '',
+                            text:   text
+                        });
+                    });
+
+                    if (entries.length === 0) { return; }
+
+                    var records = entries.map(function(entry) {
+                        return entry.time + '\x02' + entry.sender + '\x02' + entry.text + '\x03';
+                    }).join('');
+
