+        // Returns true if a destination was set (i.e. the user didn't cancel).
+        bool promptForContinuousExportPath(std::string const& chatTitle)
+        {
+            auto dialog = Gtk::FileChooserDialog{_("Continuous Chat Export Location"), Gtk::FILE_CHOOSER_ACTION_SAVE};
+            dialog.add_button(_("Cancel"), Gtk::RESPONSE_CANCEL);
+            dialog.add_button(_("Save"), Gtk::RESPONSE_OK);
+            dialog.set_current_name(sanitizeFilename(chatTitle) + ".md");
+
+            if (dialog.run() != Gtk::RESPONSE_OK)
+            {
+                return false;
+            }
+
