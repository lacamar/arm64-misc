+            for (auto const& entry : entries)
+            {
+                out += "**" + entry.sender + "** _" + entry.time + "_\n\n";
+
+                std::size_t lineStart = 0;
+                while (true)
+                {
+                    auto const lineEnd = entry.text.find('\n', lineStart);
+                    auto const line    = (lineEnd == std::string::npos) ? entry.text.substr(lineStart) : entry.text.substr(lineStart, lineEnd - lineStart);
+                    out += "> " + line + "\n";
+
+                    if (lineEnd == std::string::npos)
+                    {
+                        break;
+                    }
+                    lineStart = lineEnd + 1;
+                }
