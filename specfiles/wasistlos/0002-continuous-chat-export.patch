+
+    void WebView::setupContinuousExport()
+    {
+        auto* const manager = webkit_web_view_get_user_content_manager(*this);
+
+        // Connect before registering, per WebKitUserContentManager's own recommendation,
+        // to avoid a race between the handler name becoming active and this signal
+        // connection existing.
+        g_signal_connect(manager, "script-message-received::wilContinuousExport", G_CALLBACK(continuousExportMessageReceived), nullptr);
+        webkit_user_content_manager_register_script_message_handler(manager, "wilContinuousExport");
+
+        auto* const script = webkit_user_script_new(
+            CONTINUOUS_EXPORT_INIT_SCRIPT, WEBKIT_USER_CONTENT_INJECT_TOP_FRAME, WEBKIT_USER_SCRIPT_INJECT_AT_DOCUMENT_END, nullptr, nullptr);
+        webkit_user_content_manager_add_script(manager, script);
+        webkit_user_script_unref(script);
+    }
 }
