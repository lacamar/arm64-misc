+        // Splices a chronological window of newly-scraped entries into the existing,
+        // already-chronological accumulated list. Entries the window shares with
+        // `existing` act as anchors: any brand-new entries immediately before/after an
+        // anchor in the window are inserted immediately before/after that anchor's
+        // position in `existing`. In normal use (gradual scrolling, or new messages
+        // arriving at the bottom) consecutive scrapes overlap, so an anchor is nearly
+        // always found; a window that shares no entries at all with `existing` (e.g.
+        // jumping to a search result) falls back to appending at the end -- imperfect
+        // ordering in that rare case, but no message is ever dropped.
+        std::vector<ChatEntry> mergeEntries(std::vector<ChatEntry> existing, std::vector<ChatEntry> const& window)
+        {
+            if (existing.empty())
+            {
+                return window;
+            }
+
+            auto findPos = [&existing](ChatEntry const& needle) -> std::optional<std::size_t>
+            {
+                for (std::size_t i = 0; i < existing.size(); ++i)
+                {
+                    if (existing[i] == needle)
+                    {
+                        return i;
+                    }
+                }
+                return std::nullopt;
+            };
+
+            struct Insertion
+            {
+                std::size_t             at;
+                std::vector<ChatEntry>  items;
+            };
+
+            std::vector<Insertion>     insertions;
+            std::vector<ChatEntry>     pending;
+            std::optional<std::size_t> afterPos;
+
+            auto flushPending = [&]()
+            {
+                if (pending.empty())
+                {
+                    return;
+                }
+                insertions.push_back(Insertion{afterPos.has_value() ? (*afterPos + 1) : 0, pending});
+                pending.clear();
+            };
+
+            for (auto const& item : window)
+            {
+                if (auto const pos = findPos(item))
+                {
+                    flushPending();
+                    afterPos = pos;
+                }
+                else
+                {
+                    pending.push_back(item);
+                }
+            }
+
+            if (!pending.empty())
+            {
+                insertions.push_back(Insertion{afterPos.has_value() ? (*afterPos + 1) : existing.size(), pending});
+            }
+
+            std::sort(insertions.begin(), insertions.end(), [](Insertion const& a, Insertion const& b) { return a.at > b.at; });
+
+            for (auto const& insertion : insertions)
+            {
+                existing.insert(existing.begin() + static_cast<std::ptrdiff_t>(insertion.at), insertion.items.begin(), insertion.items.end());
+            }
+
+            return existing;
+        }
