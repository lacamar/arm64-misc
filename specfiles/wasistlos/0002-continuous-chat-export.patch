+
+        // Parses the "time\x02sender\x02text\x03" records posted by
+        // CONTINUOUS_EXPORT_INIT_SCRIPT for whichever window of the chat is currently
+        // rendered -- see that script's comment for why this is only ever a window,
+        // never the full history.
+        std::vector<ChatEntry> parseIncomingRecords(std::string const& records)
+        {
+            std::vector<ChatEntry> entries;
+            std::size_t pos = 0;
+
+            while (pos < records.size())
+            {
+                auto const recordEnd = records.find('\x03', pos);
+                if (recordEnd == std::string::npos)
+                {
+                    break;
+                }
+
+                auto const record = records.substr(pos, recordEnd - pos);
+                auto const sep1   = record.find('\x02');
+                auto const sep2   = (sep1 == std::string::npos) ? std::string::npos : record.find('\x02', sep1 + 1);
+
+                if ((sep1 != std::string::npos) && (sep2 != std::string::npos))
+                {
+                    entries.push_back(ChatEntry{record.substr(0, sep1), record.substr(sep1 + 1, sep2 - sep1 - 1), record.substr(sep2 + 1)});
+                }
+
+                pos = recordEnd + 1;
+            }
+
+            return entries;
+        }
