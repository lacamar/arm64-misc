+        std::vector<ChatEntry> parseExistingMarkdown(std::string const& markdown)
+        {
+            std::vector<ChatEntry> entries;
+            std::istringstream     stream{markdown};
+            std::string            line;
+            bool                   inEntry = false;
+            std::string            currentSender;
+            std::string            currentTime;
+            std::vector<std::string> currentLines;
+
+            auto flush = [&]()
+            {
+                if (!inEntry)
+                {
+                    return;
+                }
+
+                std::string text;
+                for (std::size_t i = 0; i < currentLines.size(); ++i)
+                {
+                    if (i)
+                    {
+                        text += "\n";
+                    }
+                    text += currentLines[i];
+                }
+
+                entries.push_back(ChatEntry{currentTime, currentSender, text});
+                inEntry = false;
+                currentLines.clear();
+            };
+
+            while (std::getline(stream, line))
+            {
+                if ((line.rfind("**", 0) == 0) && !line.empty() && (line.back() == '_'))
+                {
+                    if (auto const sepPos = line.find("** _", 2); sepPos != std::string::npos)
+                    {
+                        flush();
+                        inEntry       = true;
+                        currentSender = line.substr(2, sepPos - 2);
+                        currentTime   = line.substr(sepPos + 4, line.size() - (sepPos + 4) - 1);
