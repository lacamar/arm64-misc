+                if (inEntry && (line.rfind("> ", 0) == 0))
+                {
+                    currentLines.push_back(line.substr(2));
+                }
+                else if (inEntry && (line == ">"))
+                {
+                    currentLines.push_back("");
+                }
+            }
+            flush();
+
+            return entries;
+        }
