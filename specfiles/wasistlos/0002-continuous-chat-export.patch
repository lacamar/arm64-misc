+        void continuousExportMessageReceived(WebKitUserContentManager*, WebKitJavascriptResult* jsResult, gpointer)
+        {
+            auto* const value         = webkit_javascript_result_get_js_value(jsResult);
+            auto* const resultString  = jsc_value_to_string(value);
+            auto const  raw           = std::string{resultString ? resultString : ""};
+            g_free(resultString);
+
+            auto const delimiterPos = raw.find('\x01');
+            if (delimiterPos == std::string::npos)
+            {
+                return;
+            }
+
+            auto const title   = raw.substr(0, delimiterPos);
+            auto const records = raw.substr(delimiterPos + 1);
+            auto const key     = sanitizeSettingsKey(title);
+
+            if (!util::Settings::getInstance().hasKey(CONTINUOUS_EXPORT_GROUP, key))
+            {
+                return;
+            }
+
+            auto const path = util::Settings::getInstance().getValue<Glib::ustring>(CONTINUOUS_EXPORT_GROUP, key, Glib::ustring{});
+            if (path.empty())
+            {
+                return;
+            }
+
+            auto const windowEntries = parseIncomingRecords(records);
+            if (windowEntries.empty())
+            {
+                return;
+            }
+
+            auto existingEntries = std::vector<ChatEntry>{};
+            if (auto inFile = std::ifstream{path.raw()}; inFile)
+            {
+                auto const existingMarkdown = std::string{std::istreambuf_iterator<char>(inFile), std::istreambuf_iterator<char>()};
+                existingEntries              = parseExistingMarkdown(existingMarkdown);
+            }
+
+            auto mergedEntries = mergeEntries(std::move(existingEntries), windowEntries);
+            sortByTimestamp(mergedEntries);
+
+            auto outFile = std::ofstream{path.raw()};
+            outFile << renderChatMarkdown(title, mergedEntries);
+        }
