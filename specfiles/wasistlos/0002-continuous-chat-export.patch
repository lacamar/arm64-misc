+        constexpr auto const CONTINUOUS_EXPORT_GROUP = "chat-export";
+
+        // Same title lookup as EXPORT_CHAT_SCRIPT, used on its own to figure out which
+        // chat the continuous-export menu action should be configuring.
+        constexpr auto const CURRENT_CHAT_TITLE_SCRIPT = R"JS(
+            (function() {
+                var titleEl = document.querySelector('#main header [data-testid="conversation-info-header-chat-title"]')
+                    || document.querySelector('#main header span[dir="auto"]');
+                return titleEl ? titleEl.innerText.trim() : '';
+            })();
+        )JS";
+
+        // Installed once per page load and left running for the lifetime of the
+        // WhatsApp Web session. WhatsApp Web swaps out #main's contents wholesale on
+        // every chat switch, so there is no single stable node to observe instead of
+        // document.body. Debounced on every mutation, it re-scrapes whichever chat is
+        // currently open (same data-pre-plain-text technique as EXPORT_CHAT_SCRIPT) and
+        // posts the title plus a markdown-formatted transcript back to native code,
+        // which only writes to disk if that chat has a continuous-export destination
+        // configured -- see WebView::configureContinuousExport().
+        constexpr auto const CONTINUOUS_EXPORT_INIT_SCRIPT = R"JS(
+            (function() {
+                if (window.__wilContinuousExportInstalled) { return; }
+                window.__wilContinuousExportInstalled = true;
+
+                function currentTitle() {
+                    var titleEl = document.querySelector('#main header [data-testid="conversation-info-header-chat-title"]')
+                        || document.querySelector('#main header span[dir="auto"]');
+                    return titleEl ? titleEl.innerText.trim() : '';
+                }
+
+                function toMarkdown(title, entries) {
+                    var out = '# ' + title + '\n\n';
+                    entries.forEach(function(entry) {
+                        out += '**' + entry.sender + '** _' + entry.time + '_\n\n';
+                        entry.text.split('\n').forEach(function(line) {
+                            out += '> ' + line + '\n';
+                        });
+                        out += '\n';
+                    });
+                    return out;
+                }
+
+                function scrapeAndNotify() {
+                    var title = currentTitle();
+                    if (!title) { return; }
+
+                    var entries = [];
+                    document.querySelectorAll('#main div.copyable-text[data-pre-plain-text]').forEach(function(node) {
+                        var meta     = (node.getAttribute('data-pre-plain-text') || '').trim();
+                        var match    = meta.match(/^\[(.*?)\]\s*(.*?):\s*$/);
+                        var textNode = node.querySelector('span.selectable-text') || node;
+                        var text     = (textNode.innerText || '').trim();
+
+                        if (!match && !text) { return; }
+
+                        entries.push({
+                            time:   match ? match[1] : '',
+                            sender: match ? match[2] : '',
+                            text:   text
+                        });
+                    });
+
+                    if (entries.length === 0) { return; }
+
+                    try {
+                        window.webkit.messageHandlers.wilContinuousExport.postMessage(title + '' + toMarkdown(title, entries));
+                    } catch (e) { /* handler not registered yet */ }
+                }
+
+                window.__wilForceContinuousExportScrape = scrapeAndNotify;
+
+                var debounceTimer = null;
+                var observer = new MutationObserver(function() {
+                    if (debounceTimer) { clearTimeout(debounceTimer); }
+                    debounceTimer = setTimeout(scrapeAndNotify, 600);
+                });
+                observer.observe(document.body, {childList: true, subtree: true});
+
+                scrapeAndNotify();
+            })();
+        )JS";
