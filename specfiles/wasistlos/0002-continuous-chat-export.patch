+        std::optional<Timestamp> parseTimestamp(std::string const& time)
+        {
+            auto const comma = time.find(',');
+            if (comma == std::string::npos)
+            {
+                return std::nullopt;
+            }
+
+            auto numbers = [](std::string const& part)
+            {
+                std::vector<int> result;
+                for (std::size_t i = 0; i < part.size();)
+                {
+                    if (std::isdigit(static_cast<unsigned char>(part[i])))
+                    {
+                        auto const start = i;
+                        while (i < part.size() && std::isdigit(static_cast<unsigned char>(part[i])))
+                        {
+                            ++i;
+                        }
+                        result.push_back(std::stoi(part.substr(start, i - start)));
+                    }
+                    else
+                    {
+                        ++i;
+                    }
+                }
+                return result;
+            };
+
+            auto const clock = time.substr(0, comma);
+            auto const date  = time.substr(comma + 1);
+            auto const hm    = numbers(clock);
+            auto const dmy   = numbers(date);
+            if (hm.size() < 2 || dmy.size() != 3)
+            {
+                return std::nullopt;
+            }
+
+            auto hour  = hm[0];
+            auto lower = clock;
+            std::transform(lower.begin(), lower.end(), lower.begin(), [](unsigned char ch) { return std::tolower(ch); });
+            if (lower.find("pm") != std::string::npos && hour < 12)
+            {
+                hour += 12;
+            }
+            else if (lower.find("am") != std::string::npos && hour == 12)
+            {
+                hour = 0;
+            }
+
+            auto const separator = date.find_first_of("./-");
+            return Timestamp{hour, hm[1], dmy[0], dmy[1], dmy[2], separator == std::string::npos ? '/' : date[separator]};
+        }
+
+        // Anchor merging can't place a window that shares nothing with the file, so
+        // order by timestamp; stable, since timestamps only have minute resolution.
+        void sortByTimestamp(std::vector<ChatEntry>& entries)
+        {
+            std::vector<Timestamp> stamps;
+            bool dayFirst   = false;
+            bool monthFirst = false;
+
+            for (auto const& entry : entries)
+            {
+                auto const stamp = parseTimestamp(entry.time);
+                if (!stamp)
+                {
+                    return;
+                }
+                dayFirst   |= stamp->a > 12 && stamp->a < 1000;
+                monthFirst |= stamp->b > 12 && stamp->a < 1000;
+                stamps.push_back(*stamp);
+            }
+
+            if (dayFirst && monthFirst)
+            {
+                return;
+            }
+            if (!dayFirst && !monthFirst)
+            {
+                dayFirst = std::any_of(stamps.begin(), stamps.end(), [](Timestamp const& stamp) { return stamp.separator != '/'; });
+            }
+
+            auto key = [dayFirst](Timestamp const& stamp)
+            {
+                int year, month, day;
+                if (stamp.a >= 1000)
+                {
+                    year = stamp.a, month = stamp.b, day = stamp.c;
+                }
+                else
+                {
+                    year  = stamp.c < 100 ? stamp.c + 2000 : stamp.c;
+                    month = dayFirst ? stamp.b : stamp.a;
+                    day   = dayFirst ? stamp.a : stamp.b;
+                }
+                return ((((static_cast<long long>(year) * 13 + month) * 32 + day) * 24 + stamp.hour) * 60) + stamp.minute;
+            };
+
+            std::vector<std::size_t> order(entries.size());
+            for (std::size_t i = 0; i < order.size(); ++i)
+            {
+                order[i] = i;
+            }
+            std::stable_sort(order.begin(), order.end(), [&](std::size_t x, std::size_t y) { return key(stamps[x]) < key(stamps[y]); });
+
+            std::vector<ChatEntry> sorted;
+            sorted.reserve(entries.size());
+            for (auto const index : order)
+            {
+                sorted.push_back(std::move(entries[index]));
+            }
+            entries = std::move(sorted);
+        }
