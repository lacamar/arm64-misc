+
+void shad_call_native(void* fn, const uint64_t gpr[16], const double fp[8], uint64_t out[4]);
+
+static shad_box64_callbacks_t g_callbacks;
+static box64context_t g_context;
+
+static __thread x64emu_t* t_emu;
+static __thread void* t_emu_stack;
+static __thread uintptr_t t_stack_top;
+
+#define EMU_STACK_SIZE (8u << 20)
+#define ORBIS_MXCSR 0x9fc0
+
+// ---- bridges -------------------------------------------------------------
+
+#define BRIDGES_PER_BRICK 4096
+
+typedef struct brick_s {
+    onebridge_t* entries;
+    int used;
+    struct brick_s* next;
+} brick_t;
+
+typedef struct bridge_entry_s {
+    void* fn;
+    uintptr_t addr;
+    const char* name;
+} bridge_entry_t;
+
+static pthread_mutex_t g_bridge_mutex = PTHREAD_MUTEX_INITIALIZER;
+static brick_t* g_bricks;
+static bridge_entry_t* g_bridge_map;
+static size_t g_bridge_count, g_bridge_cap;
+static uintptr_t g_exit_bridge;
+
+static void ps4_wrapper(x64emu_t* emu, uintptr_t fnc);
+
+static onebridge_t* alloc_bridge_slot(void) {
+    brick_t* b = g_bricks;
+    if (!b || b->used == BRIDGES_PER_BRICK) {
+        const size_t size = BRIDGES_PER_BRICK * sizeof(onebridge_t);
+        void* mem = mmap(NULL, size, PROT_READ | PROT_WRITE | PROT_EXEC,
+                         MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+        if (mem == MAP_FAILED) {
+            return NULL;
+        }
+        setProtection_box((uintptr_t)mem, size, PROT_READ | PROT_WRITE | PROT_EXEC | PROT_NOPROT);
+        b = calloc(1, sizeof(brick_t));
+        b->entries = mem;
+        b->next = g_bricks;
+        g_bricks = b;
+    }
+    return &b->entries[b->used++];
+}
+
+static int bridge_map_find(void* fn, size_t* pos) {
+    size_t lo = 0, hi = g_bridge_count;
+    while (lo < hi) {
+        size_t mid = (lo + hi) / 2;
+        if (g_bridge_map[mid].fn < fn) {
+            lo = mid + 1;
+        } else if (g_bridge_map[mid].fn > fn) {
+            hi = mid;
+        } else {
+            *pos = mid;
+            return 1;
+        }
+    }
+    *pos = lo;
+    return 0;
+}
+
+static uintptr_t make_bridge(wrapper_t w, void* fn, const char* name) {
+    pthread_mutex_lock(&g_bridge_mutex);
+    size_t pos;
+    if (fn && bridge_map_find(fn, &pos)) {
+        uintptr_t ret = g_bridge_map[pos].addr;
+        pthread_mutex_unlock(&g_bridge_mutex);
+        return ret;
+    }
+    onebridge_t* e = alloc_bridge_slot();
+    if (!e) {
+        pthread_mutex_unlock(&g_bridge_mutex);
+        return 0;
+    }
+    e->CC = 0xCC;
+    e->S = 'S';
+    e->C = 'C';
+    e->w = w;
+    e->f = (uintptr_t)fn;
+    e->C3 = 0xC3;
+    e->N = 0;
+    e->func = 0;
+    e->name_or_func = (void*)name;
+    const uintptr_t addr = (uintptr_t)e;
+    if (fn) {
+        if (g_bridge_count == g_bridge_cap) {
+            g_bridge_cap = g_bridge_cap ? g_bridge_cap * 2 : 1024;
+            g_bridge_map = realloc(g_bridge_map, g_bridge_cap * sizeof(bridge_entry_t));
+        }
+        memmove(&g_bridge_map[pos + 1], &g_bridge_map[pos],
+                (g_bridge_count - pos) * sizeof(bridge_entry_t));
+        g_bridge_map[pos].fn = fn;
+        g_bridge_map[pos].addr = addr;
+        g_bridge_map[pos].name = name;
+        ++g_bridge_count;
+    }
+    pthread_mutex_unlock(&g_bridge_mutex);
+    return addr;
+}
+
+uintptr_t shad_box64_bridge(void* native_fn, const char* name) {
+    return make_bridge(ps4_wrapper, native_fn, name);
+}
+
+int shad_box64_is_bridge(uintptr_t addr) {
+    for (brick_t* b = g_bricks; b; b = b->next) {
+        const uintptr_t start = (uintptr_t)b->entries;
+        if (addr >= start && addr < start + BRIDGES_PER_BRICK * sizeof(onebridge_t)) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+void* shad_box64_bridge_target(uintptr_t addr) {
+    if (!shad_box64_is_bridge(addr)) {
+        return NULL;
+    }
+    onebridge_t* b = (onebridge_t*)addr;
+    return (b->CC == 0xCC && b->S == 'S' && b->C == 'C') ? (void*)b->f : NULL;
+}
+
+const char* shad_box64_bridge_name(uintptr_t addr) {
+    if (!shad_box64_is_bridge(addr)) {
+        return NULL;
+    }
+    onebridge_t* b = (onebridge_t*)(addr & ~(uintptr_t)(sizeof(onebridge_t) - 1));
+    return b->name_or_func;
+}
+
+// ---- host call marshalling ------------------------------------------------
+
+static int g_trace_hle = -1;
+
+static const char* bridge_name_for_fn(void* fn) {
+    size_t pos;
+    pthread_mutex_lock(&g_bridge_mutex);
+    const char* name = bridge_map_find(fn, &pos) ? g_bridge_map[pos].name : NULL;
+    pthread_mutex_unlock(&g_bridge_mutex);
+    return name;
+}
+
+static void ps4_wrapper(x64emu_t* emu, uintptr_t fnc) {
+    uint64_t gpr[16];
+    double fp[8];
+    uint64_t out[4];
+    char trace[256];
+    if (g_trace_hle < 0) {
+        g_trace_hle = getenv("SHADPS4_TRACE_HLE") != NULL;
+    }
+    if (g_trace_hle) {
+        const char* name = bridge_name_for_fn((void*)fnc);
+        snprintf(trace, sizeof(trace), "%04d|%p: %s(%#lx, %#lx, %#lx, %#lx, %#lx, %#lx)", GetTID(),
+                 *(void**)R_RSP, name ? name : "?", (unsigned long)R_RDI, (unsigned long)R_RSI,
+                 (unsigned long)R_RDX, (unsigned long)R_RCX, (unsigned long)R_R8,
+                 (unsigned long)R_R9);
+    }
+    gpr[0] = R_RDI;
+    gpr[1] = R_RSI;
+    gpr[2] = R_RDX;
+    gpr[3] = R_RCX;
+    gpr[4] = R_R8;
+    gpr[5] = R_R9;
+    // Stack arguments (above the return address), bounded by the top of the guest stack.
+    const uintptr_t sp = R_RSP;
+    const uintptr_t limit = t_stack_top > sp ? t_stack_top : (sp | (box64_pagesize - 1)) + 1;
+    int avail = (int)((limit - sp) / 8) - 1;
+    if (avail > 10) {
+        avail = 10;
+    }
+    for (int i = 0; i < 10; ++i) {
+        gpr[6 + i] = i < avail ? ((const uint64_t*)sp)[1 + i] : 0;
+    }
+    for (int i = 0; i < 8; ++i) {
+        fp[i] = emu->xmm[i].d[0];
+    }
+    shad_call_native((void*)fnc, gpr, fp, out);
+    R_RAX = out[0];
+    R_RDX = out[1];
+    emu->xmm[0].q[0] = out[2];
+    emu->xmm[1].q[0] = out[3];
+    if (g_trace_hle) {
+        char buf[320];
+        snprintf(buf, sizeof(buf), "%s = %#lx", trace, (unsigned long)out[0]);
+        shad_box64_log(buf);
+    }
+}
+
+// ---- emu lifetime ---------------------------------------------------------
+
+static x64emu_t* new_emu(uintptr_t stack, size_t stack_size, int own_stack) {
+    x64emu_t* emu = NewX64Emu(&g_context, 0, stack, (int)stack_size, own_stack);
+    emu->mxcsr.x32 = ORBIS_MXCSR;
+    emu->stack2free = NULL;
+    return emu;
+}
+
+x64emu_t* shad_box64_current_emu(void) {
+    return t_emu;
+}
+
+x64emu_t* shad_box64_thread_emu(void) {
+    if (t_emu) {
+        return t_emu;
+    }
+    void* stack = mmap(NULL, EMU_STACK_SIZE, PROT_READ | PROT_WRITE,
+                       MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+    if (stack == MAP_FAILED) {
+        return NULL;
+    }
+    setProtection_mmap((uintptr_t)stack, EMU_STACK_SIZE, PROT_READ | PROT_WRITE);
+    t_emu_stack = stack;
+    t_stack_top = (uintptr_t)stack + EMU_STACK_SIZE;
+    t_emu = new_emu((uintptr_t)stack, EMU_STACK_SIZE, 0);
+    return t_emu;
+}
+
+void shad_box64_thread_exit(void) {
+    if (t_emu) {
+        FreeX64Emu(&t_emu);
+        t_emu = NULL;
+    }
+    if (t_emu_stack) {
+        freeProtection((uintptr_t)t_emu_stack, EMU_STACK_SIZE);
+        munmap(t_emu_stack, EMU_STACK_SIZE);
+        t_emu_stack = NULL;
+    }
+}
+
+void shad_box64_set_fs(uintptr_t base) {
+    x64emu_t* emu = shad_box64_thread_emu();
+    emu->segs_offs[_FS] = base;
+}
+
+// ---- running guest code ----------------------------------------------------
+
+uint64_t shad_box64_run_thread(uintptr_t fn, uintptr_t arg, uintptr_t stack_top) {
+    x64emu_t* emu = shad_box64_thread_emu();
+    t_stack_top = stack_top;
+    R_RSP = stack_top & ~(uintptr_t)15;
+    R_RBP = 0;
+    R_RDI = arg;
+    PushExit(emu);
+    R_RIP = fn;
+    emu->quit = 0;
+    emu->df = d_none;
+    EmuRun(emu, 1, 0);
+    emu->quit = 0;
+    return R_RAX;
+}
+
+void shad_box64_run_main(uintptr_t entry, uintptr_t rsp, uintptr_t rdi, uintptr_t rsi) {
+    x64emu_t* emu = shad_box64_thread_emu();
+    t_stack_top = (rsp + 32 + 15) & ~(uintptr_t)15;
+    R_RSP = rsp;
+    R_RBP = 0;
+    R_RDI = rdi;
+    R_RSI = rsi;
+    R_RIP = entry;
+    emu->quit = 0;
+    emu->df = d_none;
+    EmuRun(emu, 1, 0);
+}
+
+uint64_t shad_box64_call(uintptr_t fn, int nargs, const uint64_t* args) {
+    x64emu_t* emu = shad_box64_thread_emu();
+    const int stackn = nargs > 6 ? (nargs - 6) + ((nargs - 6) & 1) : 0;
+    Push64(emu, R_RBP);
+    R_RBP = R_RSP;
+    R_RSP -= stackn * sizeof(uint64_t);
+    uint64_t* p = (uint64_t*)R_RSP;
+    static const int regs[6] = {_DI, _SI, _DX, _CX, _R8, _R9};
+    for (int i = 0; i < nargs; ++i) {
+        if (i < 6) {
+            emu->regs[regs[i]].q[0] = args[i];
+        } else {
+            *p++ = args[i];
+        }
+    }
+    const uintptr_t old_ip = R_RIP;
+    const int old_quit = emu->quit;
+    emu->quit = 0;
+    DynaCall(emu, fn, 0);
+    if (old_ip == R_RIP) {
+        R_RSP = R_RBP;
+        R_RBP = Pop64(emu);
+    }
+    emu->quit = old_quit;
+    return R_RAX;
+}
+
+uint64_t shad_box64_call_from_native(uintptr_t fn, const uint64_t* args, int nargs) {
+    return shad_box64_call(fn, nargs, args);
+}
+
+// ---- memory tracking -------------------------------------------------------
+
+void shad_box64_on_map(uintptr_t addr, size_t size, int prot) {
+    setProtection_mmap(addr, size, (uint32_t)prot);
+}
+
+void shad_box64_on_protect(uintptr_t addr, size_t size, int prot) {
+    setProtection(addr, size, (uint32_t)prot);
+}
+
+void shad_box64_on_unmap(uintptr_t addr, size_t size) {
+    cleanDBFromAddressRange(addr, size, 1);
+    freeProtection(addr, size);
+}
+
+void shad_box64_invalidate(uintptr_t addr, size_t size) {
+    cleanDBFromAddressRange(addr, size, 0);
+}
+
+int shad_box64_handle_fault(void* addr, int si_code) {
+    if (!addr || si_code != SEGV_ACCERR) {
+        return 0;
+    }
+    const uint32_t prot = getProtection((uintptr_t)addr);
+    if (prot & PROT_DYNAREC) {
+        unprotectDB((uintptr_t)addr, 1, 1);
+        return 1;
+    }
+    if (prot & PROT_DYNAREC_R) {
+        unprotectDB((uintptr_t)addr, 1, 1);
+    }
+    return 0;
+}
+
+// ---- faults inside JIT code -------------------------------------------------------------
+
+static void* find_fpsimd(ucontext_t* p) {
+    struct _aarch64_ctx* ff = (struct _aarch64_ctx*)p->uc_mcontext.__reserved;
+    while (ff->magic) {
+        if (ff->magic == FPSIMD_MAGIC) {
+            return ff;
+        }
+        ff = (struct _aarch64_ctx*)((uintptr_t)ff + ff->size);
+    }
+    return NULL;
+}
+
+static x64emu_t* emu_from_context(ucontext_t* p) {
+    if (CONTEXT_REG(p, xEmu) > 0x10000) {
+        return (x64emu_t*)CONTEXT_REG(p, xEmu);
+    }
+    return t_emu;
+}
+
+static void leave_dynablock(ucontext_t* p, x64emu_t* emu, dynablock_t* db, uintptr_t x64pc,
+                            void* pc, int full) {
+    copyUCTXreg2Emu(emu, p, db, x64pc);
+    if (full) {
+        adjustregs(emu, pc);
+        if (db->arch_size) {
+            ARCH_ADJUST(db, emu, p, x64pc);
+        }
+    }
+    emu->test.clean = 0;
+    dynablock_leave_runtime(db);
+    copyEmu2USignalCTXreg(p, emu, native_epilog);
+}
+
+static int handle_callret_trap(ucontext_t* p, x64emu_t* emu, dynablock_t* db, void* pc,
+                               uintptr_t x64pc) {
+    int type_callret = -1;
+    for (int i = 0; i < db->callret_size; ++i) {
+        if (pc == (void*)((uintptr_t)db->block + db->callrets[i].offs)) {
+            type_callret = db->callrets[i].type;
+            break;
+        }
+    }
+    if (type_callret < 0) {
+        return 0;
+    }
+    if (!type_callret) {
+        x64pc = CONTEXT_REG(p, xRIP);
+    }
+    const int is_hotpage = checkInHotPage(x64pc);
+    const uint32_t hash = (db->gone || is_hotpage) ? 0 : X31_hash_code(db->x64_addr, db->x64_size);
+    if (!db->gone && (!is_hotpage || db->autocrc) && hash == db->hash) {
+        CONTEXT_PC(p) += 4;
+        if (db->always_test) {
+            protectDB((uintptr_t)db->x64_addr, 1);
+        } else {
+            for (int i = 0; i < db->callret_size; ++i) {
+                *(uint32_t*)((uintptr_t)db->block + db->callrets[i].offs) = ARCH_NOP;
+            }
+            ClearCache(db->block, db->size);
+            protectDBJumpTable((uintptr_t)db->x64_addr, db->x64_size, db->block, db->jmpnext);
+            for (int i = 0; i < db->sep_size; ++i) {
+                const uint32_t x64_offs = db->sep[i].x64_offs;
+                const uint32_t nat_offs = db->sep[i].nat_offs;
+                db->sep[i].active = addJumpTableIfDefault64(
+                    (void*)((uintptr_t)db->x64_addr + x64_offs),
+                    db->always_test ? db->jmpnext : (void*)((uintptr_t)db->block + nat_offs));
+            }
+        }
+        return 1;
+    }
+    leave_dynablock(p, emu, db, x64pc, pc, type_callret != 0);
+    return 1;
+}
+
+int shad_box64_jit_fault_begin(int sig, void* siginfo, void* ucontext) {
+    siginfo_t* info = (siginfo_t*)siginfo;
+    ucontext_t* p = (ucontext_t*)ucontext;
+    void* pc = (void*)CONTEXT_PC(p);
+    void* addr = info->si_addr;
+    dynablock_t* db = FindDynablockFromNativeAddress(pc);
+    if (!db) {
+        return 0;
+    }
+    x64emu_t* emu = emu_from_context(p);
+    uintptr_t x64pc = getX64Address(db, (uintptr_t)pc);
+
+    if (sig == SIGBUS && addr != pc) {
+        if (sigbus_specialcases(info, p, pc, find_fpsimd(p), db, x64pc, 0)) {
+            return 1;
+        }
+    }
+    if (sig == SIGILL && db->callret_size && handle_callret_trap(p, emu, db, pc, x64pc)) {
+        return 1;
+    }
+    if (sig == SIGSEGV && addr && info->si_code == SEGV_ACCERR) {
+        const uint32_t prot = getProtection((uintptr_t)addr);
+        if (prot & PROT_DYNAREC) {
+            CheckHotPage((uintptr_t)addr, prot);
+            unprotectDB((uintptr_t)addr, 1, 1);
+            const int in_block = (uintptr_t)addr >= (uintptr_t)db->x64_addr &&
+                                 (uintptr_t)addr < (uintptr_t)db->x64_addr + db->x64_size;
+            const int need_test =
+                BOX64ENV(dynarec_dirty) ? 0 : getNeedTest((uintptr_t)db->x64_addr);
+            if (in_block || need_test) {
+                if (in_block && BOX64ENV(dynarec_dirty)) {
+                    mark_db_autosmc(db, x64pc);
+                }
+                leave_dynablock(p, emu, db, x64pc, pc, 1);
+            }
+            return 1;
+        }
+        if (prot & PROT_DYNAREC_R) {
+            unprotectDB((uintptr_t)addr, 1, 1);
+        }
+    }
+    return 2;
+}
+
+void shad_box64_jit_fault_sync(void* ucontext) {
+    ucontext_t* p = (ucontext_t*)ucontext;
+    void* pc = (void*)CONTEXT_PC(p);
+    dynablock_t* db = FindDynablockFromNativeAddress(pc);
+    if (!db) {
+        return;
+    }
+    x64emu_t* emu = emu_from_context(p);
+    const uintptr_t x64pc = getX64Address(db, (uintptr_t)pc);
+    copyUCTXreg2Emu(emu, p, db, x64pc);
+    adjustregs(emu, pc);
+    if (db->arch_size) {
+        ARCH_ADJUST(db, emu, p, x64pc);
+    }
+}
+
+void shad_box64_jit_fault_end(void* ucontext) {
+    ucontext_t* p = (ucontext_t*)ucontext;
+    x64emu_t* emu = emu_from_context(p);
+    void* pc = (void*)CONTEXT_PC(p);
+    dynablock_t* db = FindDynablockFromNativeAddress(pc);
+    if (db) {
+        emu->test.clean = 0;
+        dynablock_leave_runtime(db);
+    }
+    copyEmu2USignalCTXreg(p, emu, native_epilog);
+}
+
+// ---- register access ------------------------------------------------------
+
+void shad_box64_get_regs(x64emu_t* emu, shad_guest_regs_t* r) {
+    r->rax = R_RAX;
+    r->rbx = R_RBX;
+    r->rcx = R_RCX;
+    r->rdx = R_RDX;
+    r->rsi = R_RSI;
+    r->rdi = R_RDI;
+    r->rbp = R_RBP;
+    r->rsp = R_RSP;
+    r->r8 = R_R8;
+    r->r9 = R_R9;
+    r->r10 = R_R10;
+    r->r11 = R_R11;
+    r->r12 = R_R12;
+    r->r13 = R_R13;
+    r->r14 = R_R14;
+    r->r15 = R_R15;
+    r->rip = R_RIP;
+    r->rflags = emu->eflags.x64;
+    r->fs_base = emu->segs_offs[_FS];
+}
+
+void shad_box64_set_regs(x64emu_t* emu, const shad_guest_regs_t* r) {
+    R_RAX = r->rax;
+    R_RBX = r->rbx;
+    R_RCX = r->rcx;
+    R_RDX = r->rdx;
+    R_RSI = r->rsi;
+    R_RDI = r->rdi;
+    R_RBP = r->rbp;
+    R_RSP = r->rsp;
+    R_R8 = r->r8;
+    R_R9 = r->r9;
+    R_R10 = r->r10;
+    R_R11 = r->r11;
+    R_R12 = r->r12;
+    R_R13 = r->r13;
+    R_R14 = r->r14;
+    R_R15 = r->r15;
+    R_RIP = r->rip;
+    emu->eflags.x64 = (uint32_t)r->rflags;
+}
+
+// ---- callbacks into the emulator ---------------------------------------------
+
+void shad_box64_log(const char* msg) {
+    if (g_callbacks.log) {
+        g_callbacks.log(msg);
+    } else {
+        fputs(msg, stderr);
+    }
+}
+
+void shad_box64_on_guest_signal(x64emu_t* emu, int sig, void* addr, int code) {
+    if (g_callbacks.guest_signal) {
+        g_callbacks.guest_signal(emu, sig, addr, code);
+    } else {
+        abort();
+    }
+}
+
+void shad_box64_on_syscall(x64emu_t* emu) {
+    if (g_callbacks.syscall) {
+        g_callbacks.syscall(emu);
+    } else {
+        abort();
+    }
+}
+
+// ---- init --------------------------------------------------------------------
+
+int shad_box64_init(const shad_box64_callbacks_t* callbacks) {
+    if (my_context) {
+        return 1;
+    }
+    if (callbacks) {
+        g_callbacks = *callbacks;
+    }
+    box64_pagesize = sysconf(_SC_PAGESIZE);
+    if (box64_pagesize <= 0) {
+        box64_pagesize = 4096;
+    }
+    LoadEnvVariables();
+    InitializeSystemInfo();
+    if (!DetectHostCpuFeatures()) {
+        SET_BOX64ENV(dynarec, 0);
+    }
+    if (!BOX64ENV(nobanner)) {
+        PrintHostCpuFeatures();
+    }
+
+    my_context = &g_context;
+    memset(&g_context, 0, sizeof(g_context));
+    init_custommem_helper(&g_context);
+    g_context.db_sizes = rbtree_init("db_sizes");
+
+    pthread_mutexattr_t attr;
+    pthread_mutexattr_init(&attr);
+    pthread_mutexattr_settype(&attr, PTHREAD_MUTEX_ERRORCHECK);
+    pthread_mutex_init(&g_context.mutex_dyndump, &attr);
+    pthread_mutex_init(&g_context.mutex_trace, &attr);
+    pthread_mutex_init(&g_context.mutex_tls, &attr);
+    pthread_mutex_init(&g_context.mutex_thread, &attr);
+    pthread_mutex_init(&g_context.mutex_bridge, &attr);
+    pthread_mutexattr_destroy(&attr);
+
+    for (int i = 0; i < 16; i++) {
+        g_context.seggdt[i].limit = (uintptr_t)-1LL;
+    }
+    g_context.seggdt[10].present = 1;
+    g_context.seggdt[8].present = 1;
+    g_context.seggdt[6].present = 1;
+    g_context.seggdt[5].present = 1;
+
+    InitX64Trace(&g_context);
+
+    g_exit_bridge = make_bridge(NULL, NULL, "exit");
+    g_context.exit_bridge = g_exit_bridge;
+    return g_exit_bridge != 0;
+}
