+} // namespace Bytecode
+
+static bool BuildExpr(Bytecode::Builder& b, PassInfo& pass_info, const IR::Value& value, u32& out);
+
+static bool BuildBinary(Bytecode::Builder& b, PassInfo& pass_info, IR::Inst* inst,
+                        Bytecode::BinOp op, u32& out) {
+    ASSERT(!inst->AreAllArgsImmediates());
+    u32 lhs, rhs;
+    if (!BuildExpr(b, pass_info, inst->Arg(0), lhs) ||
+        !BuildExpr(b, pass_info, inst->Arg(1), rhs)) {
+        return false;
+    }
+    out = b.Add({.kind = Bytecode::ExprKind::Binary, .op = op, .a = lhs, .b = rhs});
+    return true;
+}
+
+static bool BuildExpr(Bytecode::Builder& b, PassInfo& pass_info, const IR::Value& value, u32& out) {
+    using namespace Bytecode;
+    if (value.IsImmediate()) {
+        out = b.Add({.kind = ExprKind::Imm, .imm = value.U32()});
+        return true;
+    }
+    IR::Inst* inst = value.Inst();
+    switch (inst->GetOpcode()) {
+    case IR::Opcode::GetUserData:
+        out =
+            b.Add({.kind = ExprKind::UserData, .imm = static_cast<u32>(inst->Arg(0).ScalarReg())});
+        return true;
+    case IR::Opcode::ReadConst:
+    case IR::Opcode::ReadConstBuffer:
+        if (u16 offset = GetFlatbufOffset(pass_info.DeduplicateInstruction(inst)); offset != 0) {
+            out = b.Add({.kind = ExprKind::FlatBuf, .imm = offset});
+            return true;
+        }
+        return false;
+    case IR::Opcode::IAdd32:
+        return BuildBinary(b, pass_info, inst, BinOp::Add, out);
+    case IR::Opcode::ISub32:
+        return BuildBinary(b, pass_info, inst, BinOp::Sub, out);
+    case IR::Opcode::IMul32:
+        return BuildBinary(b, pass_info, inst, BinOp::Mul, out);
+    case IR::Opcode::ShiftLeftLogical32:
+        return BuildBinary(b, pass_info, inst, BinOp::Shl, out);
+    case IR::Opcode::ShiftRightLogical32:
+        return BuildBinary(b, pass_info, inst, BinOp::Shr, out);
+    case IR::Opcode::BitwiseAnd32:
+        return BuildBinary(b, pass_info, inst, BinOp::And, out);
+    case IR::Opcode::BitwiseOr32:
+        return BuildBinary(b, pass_info, inst, BinOp::Or, out);
+    case IR::Opcode::BitwiseXor32:
+        return BuildBinary(b, pass_info, inst, BinOp::Xor, out);
+    case IR::Opcode::UMin32:
+        return BuildBinary(b, pass_info, inst, BinOp::UMin, out);
+    case IR::Opcode::UMax32:
+        return BuildBinary(b, pass_info, inst, BinOp::UMax, out);
+    case IR::Opcode::BitwiseNot32: {
+        u32 a;
+        if (!BuildExpr(b, pass_info, inst->Arg(0), a)) {
+            return false;
+        }
+        out = b.Add({.kind = ExprKind::Not, .a = a});
+        return true;
+    }
+    case IR::Opcode::BitFieldUExtract: {
+        u32 a, sh, cnt;
+        if (!BuildExpr(b, pass_info, inst->Arg(0), a) ||
+            !BuildExpr(b, pass_info, inst->Arg(1), sh) ||
+            !BuildExpr(b, pass_info, inst->Arg(2), cnt)) {
+            return false;
+        }
+        out = b.Add({.kind = ExprKind::Bfe, .a = a, .b = sh, .c = cnt});
+        return true;
+    }
+    default:
+        LOG_ERROR(Render_Recompiler, "Unexpected instruction for offset computation, {}",
+                  magic_enum::enum_name(inst->GetOpcode()));
+        return false;
+    }
+}
+
+static void VisitPointer(const IR::Value& off_dw, IR::Inst* subtree, PassInfo& pass_info,
+                         Bytecode::Builder& b) {
+    using namespace Bytecode;
+    if (subtree->GetOpcode() == IR::Opcode::ReadConst && subtree->Flags<u16>() == 0 ||
+        subtree->GetOpcode() == IR::Opcode::ReadConstBuffer &&
+            subtree->Flags<IR::BufferInstInfo>().flatbuf_off_dw == 0) {
+        return;
+    }
+    if (off_dw.IsImmediate()) {
+        b.ops.push_back({.kind = OpKind::PushPtrImm, .arg = off_dw.U32()});
+    } else {
+        u32 expr;
+        if (!BuildExpr(b, pass_info, off_dw, expr)) {
+            LOG_ERROR(Render_Recompiler, "Failed to compute offset for SRT walker");
+            return;
+        }
+        b.ops.push_back({.kind = OpKind::PushPtrExpr, .arg = expr});
+    }
+    PassInfo::PtrUserList* use_list = pass_info.GetUsesAsPointer(subtree);
+    ASSERT(use_list);
+
+    for (auto [src_off_dw, use] : *use_list) {
+        if (src_off_dw.IsImmediate()) {
+            b.ops.push_back(
+                {.kind = OpKind::CopyImm, .arg = src_off_dw.U32(), .dst = pass_info.dst_off_dw});
+        } else {
+            u32 expr;
+            if (!BuildExpr(b, pass_info, src_off_dw, expr)) {
+                LOG_ERROR(Render_Recompiler, "Failed to compute offset for SRT walker");
+                continue;
+            }
+            b.ops.push_back({.kind = OpKind::CopyExpr, .arg = expr, .dst = pass_info.dst_off_dw});
+        }
+        SetFlatbufOffset(use, pass_info.dst_off_dw);
+        pass_info.dst_off_dw++;
+    }
+
+    for (const auto [src_off_dw, use] : *use_list) {
+        if (pass_info.GetUsesAsPointer(use)) {
+            VisitPointer(src_off_dw, use, pass_info, b);
+        }
+    }
+
+    b.ops.push_back({.kind = OpKind::PopPtr});
+}
+
+static void GenerateSrtProgram(Info& info, PassInfo& pass_info) {
+    if (pass_info.srt_roots.empty()) {
+        return;
+    }
+    Bytecode::Builder b;
+    pass_info.dst_off_dw = NUM_USER_DATA_REGS;
+    ASSERT(pass_info.dst_off_dw == info.srt_info.flattened_bufsize_dw);
+
+    for (const auto& [sgpr_base, root] : pass_info.srt_roots) {
+        VisitPointer(IR::Value(static_cast<u32>(sgpr_base)), root, pass_info, b);
+    }
+
+    const auto blob = b.Finish();
+    info.srt_info.walker_func = reinterpret_cast<PFN_SrtWalker>(
+        const_cast<u8*>(Bytecode::Persist(blob.data(), blob.size())));
+    info.srt_info.walker_func_size = blob.size();
+    info.srt_info.flattened_bufsize_dw = pass_info.dst_off_dw;
+}
