diff --git a/src/core/cpu/box64/box64_call.S b/src/core/cpu/box64/box64_call.S
new file mode 100644
index 00000000..18ab905b
--- /dev/null
+++ b/src/core/cpu/box64/box64_call.S
@@ -0,0 +1,68 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// void shad_call_native(void* fn, const uint64_t gpr[16], const double fp[8], uint64_t out[4]);
+// gpr[0..7] -> x0..x7, gpr[8..15] -> stack, fp[0..7] -> d0..d7, x8 = gpr[0] (sret buffer).
+// out[0] = x0, out[1] = x1, out[2] = d0, out[3] = d1.
+.text
+.global shad_call_native
+.type shad_call_native, %function
+shad_call_native:
+    stp x29, x30, [sp, #-48]!
+    stp x19, x20, [sp, #16]
+    stp x21, x22, [sp, #32]
+    mov x29, sp
+    mov x19, x0
+    mov x20, x1
+    mov x21, x2
+    mov x22, x3
+    sub sp, sp, #64
+    ldp x8, x9, [x20, #64]
+    stp x8, x9, [sp]
+    ldp x8, x9, [x20, #80]
+    stp x8, x9, [sp, #16]
+    ldp x8, x9, [x20, #96]
+    stp x8, x9, [sp, #32]
+    ldp x8, x9, [x20, #112]
+    stp x8, x9, [sp, #48]
+    ldp d0, d1, [x21]
+    ldp d2, d3, [x21, #16]
+    ldp d4, d5, [x21, #32]
+    ldp d6, d7, [x21, #48]
+    ldp x0, x1, [x20]
+    ldp x2, x3, [x20, #16]
+    ldp x4, x5, [x20, #32]
+    ldp x6, x7, [x20, #48]
+    mov x8, x0
+    blr x19
+    stp x0, x1, [x22]
+    stp d0, d1, [x22, #16]
+    add sp, sp, #64
+    ldp x21, x22, [sp, #32]
+    ldp x19, x20, [sp, #16]
+    ldp x29, x30, [sp], #48
+    ret
+.size shad_call_native, .-shad_call_native
+.section .note.GNU-stack,"",%progbits
+
+// Entered via a redirected instruction-fetch fault when native code calls a guest function
+// pointer directly. x16 = guest target, x0-x7 = arguments, x30 = native return address.
+.text
+.global shad_guest_call_trampoline
+.type shad_guest_call_trampoline, %function
+shad_guest_call_trampoline:
+    stp x29, x30, [sp, #-16]!
+    mov x29, sp
+    sub sp, sp, #64
+    stp x0, x1, [sp]
+    stp x2, x3, [sp, #16]
+    stp x4, x5, [sp, #32]
+    stp x6, x7, [sp, #48]
+    mov x0, x16
+    mov x1, sp
+    mov x2, #8
+    bl shad_box64_call_from_native
+    add sp, sp, #64
+    ldp x29, x30, [sp], #16
+    ret
+.size shad_guest_call_trampoline, .-shad_guest_call_trampoline
