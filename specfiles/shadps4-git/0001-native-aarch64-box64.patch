@@ -0,0 +1,90 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <array>
+#include <type_traits>
+#include "common/arch.h"
+#include "common/types.h"
+
+namespace Core::Cpu {
+
+struct GuestRegs {
+    u64 rax, rbx, rcx, rdx, rsi, rdi, rbp, rsp;
+    u64 r8, r9, r10, r11, r12, r13, r14, r15;
+    u64 rip, rflags, fs_base;
+};
+
+void Initialize();
+bool IsGuestAddress(VAddr addr);
+
+// Address the guest can call/jump to in order to reach a native function.
+u64 MakeGuestCallable(const void* native_fn, const char* name = nullptr);
+// Native function behind a guest-callable address, or nullptr if the address is guest code.
+void* ResolveNative(VAddr addr);
+
+u64 CallGuestRaw(VAddr fn, const u64* args, int nargs);
+void* RunThreadEntry(void* PS4_SYSV_ABI (*start)(void*), void* arg, void* stack_top);
+[[noreturn]] void RunMainEntry(VAddr entry, VAddr rsp, VAddr rdi, VAddr rsi);
+
+void SetTlsBase(void* tcb);
+void OnThreadExit();
+
+void OnMap(VAddr addr, u64 size, bool read, bool write, bool exec);
+void OnProtect(VAddr addr, u64 size, bool read, bool write, bool exec);
+void OnUnmap(VAddr addr, u64 size);
+bool HandleFault(void* addr, int si_code);
+// Native code jumped into (non-executable) guest memory: reroute the call through the emulator.
+bool HandleGuestCallFault(void* raw_context, void* fault_addr);
+// Native code jumped to a guest-callable bridge: continue at the bridged native function.
+bool HandleBridgeCallFault(void* raw_context);
+// Fault while running translated guest code. Handled: fully resolved, return from the signal.
+// GuestFault: guest registers were synced; dispatch the guest exception then call EndJitFault.
+enum class JitFault { NotInJit, Handled, GuestFault };
+JitFault BeginJitFault(int sig, void* siginfo, void* raw_context);
+void SyncJitGuestState(void* raw_context);
+void EndJitFault(void* raw_context);
+
+bool GetCurrentGuestRegs(GuestRegs& regs);
+void SetCurrentGuestRegs(const GuestRegs& regs);
+
+template <typename T>
+u64 ToArg(T v) {
+    static_assert(!std::is_floating_point_v<T>, "floating point callback args unsupported");
+    if constexpr (std::is_pointer_v<T>) {
+        return reinterpret_cast<u64>(v);
+    } else if constexpr (std::is_enum_v<T>) {
+        return static_cast<u64>(static_cast<std::underlying_type_t<T>>(v));
+    } else {
+        return static_cast<u64>(v);
+    }
+}
+
+// Calls a function pointer that may be guest code or native code.
+template <typename R, typename... Params, typename... Args>
+R Call(R PS4_SYSV_ABI (*fn)(Params...), Args&&... args) {
+#ifdef ARCH_X86_64
+    return fn(static_cast<Params>(args)...);
+#else
+    const VAddr addr = reinterpret_cast<VAddr>(fn);
+    if (!IsGuestAddress(addr)) {
+        if (void* native = ResolveNative(addr)) {
+            return reinterpret_cast<R PS4_SYSV_ABI (*)(Params...)>(native)(
+                static_cast<Params>(args)...);
+        }
+        return fn(static_cast<Params>(args)...);
+    }
+    const std::array<u64, sizeof...(Params)> raw{ToArg(static_cast<Params>(args))...};
+    const u64 ret = CallGuestRaw(addr, raw.data(), static_cast<int>(raw.size()));
+    if constexpr (std::is_void_v<R>) {
+        return;
+    } else if constexpr (std::is_pointer_v<R>) {
+        return reinterpret_cast<R>(ret);
+    } else {
+        return static_cast<R>(ret);
+    }
+#endif
+}
+
+} // namespace Core::Cpu
