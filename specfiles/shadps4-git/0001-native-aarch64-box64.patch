+
+bool HandleBridgeCallFault(void* raw_context) {
+    auto* uc = reinterpret_cast<ucontext_t*>(raw_context);
+    void* target = shad_box64_bridge_target(uc->uc_mcontext.pc);
+    if (!target) {
+        return false;
+    }
+    uc->uc_mcontext.pc = reinterpret_cast<VAddr>(target);
+    return true;
+}
+
+bool GetCurrentGuestRegs(GuestRegs& regs) {
+    x64emu_t* emu = shad_box64_current_emu();
+    if (!emu) {
+        return false;
+    }
+    static_assert(sizeof(GuestRegs) == sizeof(shad_guest_regs_t));
+    shad_box64_get_regs(emu, reinterpret_cast<shad_guest_regs_t*>(&regs));
+    return true;
+}
+
+void SetCurrentGuestRegs(const GuestRegs& regs) {
+    x64emu_t* emu = shad_box64_current_emu();
+    if (emu) {
