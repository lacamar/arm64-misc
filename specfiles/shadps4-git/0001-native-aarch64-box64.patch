diff --git a/src/core/cpu/cpu.cpp b/src/core/cpu/cpu.cpp
new file mode 100644
index 00000000..5d4183c7
--- /dev/null
+++ b/src/core/cpu/cpu.cpp
@@ -0,0 +1,260 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include <cstring>
+#include <mutex>
+#include <fmt/format.h>
+#include "common/assert.h"
+#include "common/logging/log.h"
+#include "core/cpu/cpu.h"
+#include "core/memory.h"
+
+#ifdef ARCH_ARM64
+#include <sys/mman.h>
+#include <sys/ucontext.h>
+#include "core/cpu/box64/box64_glue.h"
+#include "core/libraries/kernel/threads/pthread.h"
+#endif
+
+namespace Core::Cpu {
+
+#ifdef ARCH_ARM64
+
+static void LogCallback(const char* msg) {
+    std::string_view view{msg};
+    while (!view.empty() && (view.back() == '\n' || view.back() == '\r')) {
+        view.remove_suffix(1);
+    }
+    if (!view.empty()) {
+        LOG_INFO(Core, "box64: {}", view);
+    }
+}
+
+static void GuestSignalCallback(x64emu_t* emu, int sig, void* addr, int code) {
+    shad_guest_regs_t regs{};
+    shad_box64_get_regs(emu, &regs);
+    UNREACHABLE_MSG("Guest raised signal {} at rip={:#x} addr={} code={:#x}", sig, regs.rip,
+                    fmt::ptr(addr), code);
+}
+
+static void SyscallCallback(x64emu_t* emu) {
+    shad_guest_regs_t regs{};
+    shad_box64_get_regs(emu, &regs);
+    UNREACHABLE_MSG("Guest executed syscall {:#x} at rip={:#x}", regs.rax, regs.rip);
+}
+
+void Initialize() {
+    static std::once_flag flag;
+    std::call_once(flag, [] {
+        const shad_box64_callbacks_t callbacks{
+            .log = LogCallback,
+            .guest_signal = GuestSignalCallback,
+            .syscall = SyscallCallback,
+        };
+        ASSERT_MSG(shad_box64_init(&callbacks), "Failed to initialize box64 CPU core");
+    });
+}
+
+bool IsGuestAddress(VAddr addr) {
+    auto& space = Memory::Instance()->GetAddressSpace();
+    const VAddr sm = space.SystemManagedVirtualBase();
+    const VAddr sr = space.SystemReservedVirtualBase();
+    const VAddr user = space.UserVirtualBase();
+    return (addr >= sm && addr < sm + space.SystemManagedVirtualSize()) ||
+           (addr >= sr && addr < sr + space.SystemReservedVirtualSize()) ||
+           (addr >= user && addr < user + space.UserVirtualSize());
+}
+
+u64 MakeGuestCallable(const void* native_fn, const char* name) {
+    if (!native_fn) {
+        return 0;
+    }
+    Initialize();
+    const u64 addr = shad_box64_bridge(const_cast<void*>(native_fn), name);
+    ASSERT_MSG(addr != 0, "Failed to create bridge for {}", name ? name : "?");
+    return addr;
+}
+
+void* ResolveNative(VAddr addr) {
+    return shad_box64_bridge_target(addr);
+}
+
+u64 CallGuestRaw(VAddr fn, const u64* args, int nargs) {
+    Initialize();
+    return shad_box64_call(fn, nargs, args);
+}
+
+void* RunThreadEntry(void* PS4_SYSV_ABI (*start)(void*), void* arg, void* stack_top) {
+    const VAddr addr = reinterpret_cast<VAddr>(start);
+    if (!IsGuestAddress(addr)) {
+        if (void* native = ResolveNative(addr)) {
+            return reinterpret_cast<void* PS4_SYSV_ABI (*)(void*)>(native)(arg);
+        }
+        return start(arg);
+    }
+    Initialize();
+    return reinterpret_cast<void*>(
+        shad_box64_run_thread(addr, reinterpret_cast<u64>(arg), reinterpret_cast<u64>(stack_top)));
+}
+
+void RunMainEntry(VAddr entry, VAddr rsp, VAddr rdi, VAddr rsi) {
+    Initialize();
+    shad_box64_run_main(entry, rsp, rdi, rsi);
+    UNREACHABLE_MSG("Guest main entry returned");
+}
+
+void SetTlsBase(void* tcb) {
+    Initialize();
+    shad_box64_set_fs(reinterpret_cast<u64>(tcb));
+}
+
+void OnThreadExit() {
+    shad_box64_thread_exit();
+}
+
+static int ToProt(bool read, bool write, bool exec) {
+    return (read ? PROT_READ : 0) | (write ? PROT_WRITE : 0) | (exec ? PROT_EXEC : 0);
+}
+
+void OnMap(VAddr addr, u64 size, bool read, bool write, bool exec) {
+    Initialize();
+    shad_box64_on_map(addr, size, ToProt(read, write, exec));
+}
+
+void OnProtect(VAddr addr, u64 size, bool read, bool write, bool exec) {
+    Initialize();
+    shad_box64_on_protect(addr, size, ToProt(read, write, exec));
+}
+
+void OnUnmap(VAddr addr, u64 size) {
+    Initialize();
+    shad_box64_on_unmap(addr, size);
+}
+
+bool HandleFault(void* addr, int si_code) {
+    if (!shad_box64_current_emu()) {
+        return false;
+    }
+    return shad_box64_handle_fault(addr, si_code) != 0;
+}
+
+bool HandleGuestCallFault(void* raw_context, void* fault_addr) {
+    auto* uc = reinterpret_cast<ucontext_t*>(raw_context);
+    const VAddr pc = uc->uc_mcontext.pc;
+    if (pc != reinterpret_cast<VAddr>(fault_addr) || !IsGuestAddress(pc)) {
+        return false;
+    }
+    Initialize();
+    uc->uc_mcontext.regs[16] = pc;
+    uc->uc_mcontext.pc = reinterpret_cast<VAddr>(&shad_guest_call_trampoline);
+    return true;
+}
+
+JitFault BeginJitFault(int sig, void* siginfo, void* raw_context) {
+    switch (shad_box64_jit_fault_begin(sig, siginfo, raw_context)) {
+    case 1:
+        return JitFault::Handled;
+    case 2:
+        return JitFault::GuestFault;
+    default:
+        return JitFault::NotInJit;
+    }
+}
+
+void SyncJitGuestState(void* raw_context) {
+    shad_box64_jit_fault_sync(raw_context);
+}
+
+void EndJitFault(void* raw_context) {
+    shad_box64_jit_fault_end(raw_context);
