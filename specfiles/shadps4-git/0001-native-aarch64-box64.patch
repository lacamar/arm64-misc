+// Portable SRT walker: a flat bytecode blob interpreted at runtime. Memory layout of the blob is
+// header, ops, exprs so it can be persisted as-is by the pipeline cache.
+namespace Bytecode {
+
+enum class ExprKind : u8 { Imm, UserData, FlatBuf, Binary, Not, Bfe };
+enum class BinOp : u8 { Add, Sub, Mul, Shl, Shr, And, Or, Xor, UMin, UMax };
+enum class OpKind : u8 { PushPtrImm, PushPtrExpr, PopPtr, CopyImm, CopyExpr };
+
+struct Expr {
+    ExprKind kind;
+    BinOp op;
+    u16 pad;
+    u32 imm;
+    u32 a, b, c;
+};
+
+struct Op {
+    OpKind kind;
+    u8 pad[3];
+    u32 arg;
+    u32 dst;
+};
+
+struct Header {
+    u32 num_ops;
+    u32 num_exprs;
+};
+
+struct Builder {
+    std::vector<Op> ops;
+    std::vector<Expr> exprs;
+
+    u32 Add(Expr e) {
+        exprs.push_back(e);
+        return static_cast<u32>(exprs.size() - 1);
+    }
+
+    std::vector<u8> Finish() const {
+        std::vector<u8> blob(sizeof(Header) + ops.size() * sizeof(Op) +
+                             exprs.size() * sizeof(Expr));
+        const Header hdr{static_cast<u32>(ops.size()), static_cast<u32>(exprs.size())};
+        std::memcpy(blob.data(), &hdr, sizeof(hdr));
+        std::memcpy(blob.data() + sizeof(Header), ops.data(), ops.size() * sizeof(Op));
+        std::memcpy(blob.data() + sizeof(Header) + ops.size() * sizeof(Op), exprs.data(),
+                    exprs.size() * sizeof(Expr));
+        return blob;
+    }
+};
+
+static thread_local jmp_buf* g_fault_jmp = nullptr;
+
+static bool FaultHandler(void* context, void* fault_address) {
+    if (!g_fault_jmp) {
+        return false;
+    }
+    sigset_t set;
+    sigemptyset(&set);
+    sigaddset(&set, SIGSEGV);
+    sigaddset(&set, SIGBUS);
+    sigprocmask(SIG_UNBLOCK, &set, nullptr);
+    longjmp(*g_fault_jmp, 1);
+}
+
+template <typename T>
+static T SafeRead(const void* addr) {
+    jmp_buf env;
+    T value{};
+    g_fault_jmp = &env;
+    if (setjmp(env) == 0) {
+        value = *static_cast<const volatile T*>(addr);
+    } else {
+        LOG_WARNING(Render_Recompiler, "SRT walker read fault at {}", fmt::ptr(addr));
+    }
+    g_fault_jmp = nullptr;
+    return value;
+}
+
+struct Interpreter {
+    const Header* hdr;
+    const Op* ops;
+    const Expr* exprs;
+    const u32* flat;
+
+    u32 Eval(u32 idx) const {
+        const Expr& e = exprs[idx];
+        switch (e.kind) {
+        case ExprKind::Imm:
+            return e.imm;
+        case ExprKind::UserData:
+        case ExprKind::FlatBuf:
+            return flat[e.imm];
+        case ExprKind::Not:
+            return ~Eval(e.a);
+        case ExprKind::Bfe: {
+            const u32 v = Eval(e.a) >> (Eval(e.b) & 31);
+            return v & ((1U << (Eval(e.c) & 31)) - 1);
+        }
+        case ExprKind::Binary: {
+            const u32 a = Eval(e.a);
+            const u32 b = Eval(e.b);
+            switch (e.op) {
+            case BinOp::Add:
+                return a + b;
+            case BinOp::Sub:
+                return a - b;
+            case BinOp::Mul:
+                return a * b;
+            case BinOp::Shl:
+                return a << (b & 31);
+            case BinOp::Shr:
+                return a >> (b & 31);
+            case BinOp::And:
+                return a & b;
+            case BinOp::Or:
+                return a | b;
+            case BinOp::Xor:
+                return a ^ b;
+            case BinOp::UMin:
+                return std::min(a, b);
+            case BinOp::UMax:
+                return std::max(a, b);
+            }
+            return 0;
+        }
+        }
+        return 0;
+    }
+
+    void Run(const u32* user_data, u32* flat_dst) {
+        flat = flat_dst;
+        boost::container::small_vector<uintptr_t, 8> stack;
+        uintptr_t ptr = reinterpret_cast<uintptr_t>(user_data);
+        for (u32 i = 0; i < hdr->num_ops; ++i) {
+            const Op& op = ops[i];
+            switch (op.kind) {
+            case OpKind::PushPtrImm:
+            case OpKind::PushPtrExpr: {
+                stack.push_back(ptr);
+                const u32 off_dw = op.kind == OpKind::PushPtrImm ? op.arg : Eval(op.arg);
+                const u64 next =
+                    SafeRead<u64>(reinterpret_cast<const void*>(ptr + (u64(off_dw) << 2)));
+                ptr = next & 0xFFFFFFFFFFFFULL;
+                break;
+            }
+            case OpKind::PopPtr:
+                ptr = stack.back();
+                stack.pop_back();
+                break;
+            case OpKind::CopyImm:
+            case OpKind::CopyExpr: {
+                const u32 off_dw = op.kind == OpKind::CopyImm ? op.arg : Eval(op.arg);
+                flat_dst[op.dst] =
+                    SafeRead<u32>(reinterpret_cast<const void*>(ptr + (u64(off_dw) << 2)));
+                break;
+            }
+            }
+        }
+    }
+};
+
+static std::mutex g_programs_mutex;
+static std::vector<std::unique_ptr<u8[]>> g_programs;
+static std::once_flag g_handler_flag;
+
+static const u8* Persist(const u8* blob, size_t size) {
+    std::call_once(g_handler_flag, [] {
+        constexpr u32 priority = 1;
+        Core::Signals::Instance()->RegisterAccessViolationHandler(FaultHandler, priority);
+    });
+    auto storage = std::make_unique<u8[]>(size);
+    std::memcpy(storage.get(), blob, size);
+    const u8* ret = storage.get();
+    std::scoped_lock lk{g_programs_mutex};
+    g_programs.push_back(std::move(storage));
+    return ret;
+}
