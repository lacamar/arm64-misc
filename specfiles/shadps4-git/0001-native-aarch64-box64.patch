@@ -1,8 +1,11 @@
 // SPDX-FileCopyrightText: Copyright 2024 shadPS4 Emulator Project
 // SPDX-License-Identifier: GPL-2.0-or-later
 
+#include <cstring>
+#include <optional>
 #include "common/arch.h"
 #include "common/signal_context.h"
+#include "common/types.h"
 
 #ifdef _WIN32
 #include <windows.h>
@@ -26,11 +29,50 @@ void* GetRip(void* ctx) {
     return (void*)((ucontext_t*)ctx)->uc_mcontext.mc_rip;
 #elif defined(ARCH_X86_64)
     return (void*)((ucontext_t*)ctx)->uc_mcontext.gregs[REG_RIP];
+#elif defined(ARCH_ARM64)
+    return (void*)((ucontext_t*)ctx)->uc_mcontext.pc;
 #else
 #error "Unsupported architecture"
 #endif
 }
 
+#if defined(__linux__) && defined(ARCH_ARM64)
+static std::optional<u64> Arm64GetEsr(const ucontext_t* uc) {
+    constexpr u32 ESR_MAGIC = 0x45535201;
+    const u8* p = uc->uc_mcontext.__reserved;
+    const u8* end = p + sizeof(uc->uc_mcontext.__reserved);
+    while (p + 8 <= end) {
+        u32 magic, size;
+        std::memcpy(&magic, p, 4);
+        std::memcpy(&size, p + 4, 4);
+        if (magic == 0 || size == 0) {
+            break;
+        }
+        if (magic == ESR_MAGIC) {
+            u64 esr;
+            std::memcpy(&esr, p + 8, 8);
+            return esr;
+        }
+        p += size;
+    }
+    return std::nullopt;
+}
+
+static bool Arm64IsWriteFault(const ucontext_t* uc) {
+    const auto esr = Arm64GetEsr(uc);
+    return esr && (*esr & (1 << 6)) != 0;
+}
+
+static bool Arm64IsExecFault(const ucontext_t* uc) {
+    const auto esr = Arm64GetEsr(uc);
+    if (!esr) {
+        return false;
+    }
+    const u64 ec = (*esr >> 26) & 0x3f;
+    return ec == 0x20 || ec == 0x21;
+}
+#endif
+
 bool IsWriteError(void* ctx) {
 #if defined(_WIN32)
     return ((EXCEPTION_POINTERS*)ctx)->ExceptionRecord->ExceptionInformation[0] == 1;
@@ -42,6 +84,8 @@ bool IsWriteError(void* ctx) {
     return ((ucontext_t*)ctx)->uc_mcontext.mc_err & 0x2;
 #elif defined(ARCH_X86_64)
     return ((ucontext_t*)ctx)->uc_mcontext.gregs[REG_ERR] & 0x2;
+#elif defined(__linux__) && defined(ARCH_ARM64)
+    return Arm64IsWriteFault((ucontext_t*)ctx);
 #else
 #error "Unsupported architecture"
 #endif
@@ -56,6 +100,8 @@ bool IsExecuteError(void* ctx) {
     return ((ucontext_t*)ctx)->uc_mcontext.mc_err & 0x10;
 #elif defined(ARCH_X86_64)
     return ((ucontext_t*)ctx)->uc_mcontext.gregs[REG_ERR] & 0x10;
+#elif defined(__linux__) && defined(ARCH_ARM64)
+    return Arm64IsExecFault((ucontext_t*)ctx);
 #else
 #error "Unsupported architecture"
 #endif
