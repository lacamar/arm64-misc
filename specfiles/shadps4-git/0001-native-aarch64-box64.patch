+void EmuInt3(void* e, void* a) {
+    x64emu_t* emu = (x64emu_t*)e;
+    uintptr_t* addr = (uintptr_t*)a;
+    onebridge_t* bridge = (onebridge_t*)(*addr - 1);
+    if (IsBridgeSignature(bridge->S, bridge->C)) {
+        *addr += 2;
+        uintptr_t w = F64(addr);
+        if (w == 0) {
+            *addr += 8;
+            R_RIP = *addr;
+            emu->quit = 1;
+            return;
+        }
+        RESET_FLAGS(emu);
+        uintptr_t f = F64(addr);
+        R_RIP = *addr;
+        ((wrapper_t)w)(emu, f);
+        return;
+    }
+    R_RIP = *addr;
+    EmitSignal(emu, X64_SIGTRAP, NULL, 3);
