+    }
+    onebridge_t* b = (onebridge_t*)addr;
+    if (b->CC == 0xCC && IsBridgeSignature(b->S, b->C) && b->w) {
+        if (retn) {
+            *retn = 0;
+        }
+        if (calladdress) {
+            *calladdress = addr + 1;
+        }
+        return 1;
+    }
+    return 0;
