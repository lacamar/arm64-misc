+void shad_box64_on_protect(uintptr_t addr, size_t size, int prot);
+void shad_box64_on_unmap(uintptr_t addr, size_t size);
+void shad_box64_invalidate(uintptr_t addr, size_t size);
+int shad_box64_handle_fault(void* addr, int si_code);
+// Fault raised while executing JIT code. Returns 0 if pc is not in a dynablock, 1 if fully
+// handled (return from the signal handler), 2 if the guest state was synced into the emu and the
+// caller should dispatch a guest exception and then call shad_box64_jit_fault_end.
+int shad_box64_jit_fault_begin(int sig, void* siginfo, void* ucontext);
+// Rebuilds the guest register state from the JIT context (only needed before dispatching a guest
+// exception).
+void shad_box64_jit_fault_sync(void* ucontext);
+void shad_box64_jit_fault_end(void* ucontext);
+
+void shad_box64_get_regs(x64emu_t* emu, shad_guest_regs_t* regs);
+void shad_box64_set_regs(x64emu_t* emu, const shad_guest_regs_t* regs);
