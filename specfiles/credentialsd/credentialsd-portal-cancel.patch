+
+async fn until_closed<T>(
+    connection: &Connection,
+    request_handle: Option<OwnedObjectPath>,
+    response: impl Future<Output = Result<T, Error>>,
+) -> Result<T, Error> {
+    let Some(handle) = request_handle else {
+        return response.await;
+    };
+    let (closed_tx, closed_rx) = oneshot::channel();
+    let server = connection.object_server();
+    match server.at(&handle, PortalRequest(Some(closed_tx))).await {
+        Ok(true) => {}
+        Ok(false) => return response.await,
+        Err(err) => {
+            tracing::warn!(%handle, %err, "Failed to export portal request");
+            return response.await;
+        }
     }
+    let result = tokio::select! {
+        result = response => result,
+        _ = closed_rx => {
+            tracing::debug!(%handle, "Portal request closed by client");
+            Err(Error::AbortError)
+        }
+    };
+    _ = server.remove::<PortalRequest, _>(&handle).await;
+    result
 }
 
