+    fn signal_commit_timers(&mut self) {
+        let now = get_monotonic_time();
+        let mut wait: Option<Duration> = None;
+        let mut signal = |surface: &WlSurface, states: &SurfaceData| {
+            let Some(timers) = states.data_map.get::<CommitTimerBarrierStateUserData>() else {
+                return;
+            };
+            let mut timers = timers.lock().unwrap();
+            let target = surface_primary_scanout_output(surface, states)
+                .and_then(|output| self.output_state.get(&output))
+                .map_or(now, |state| state.frame_clock.next_presentation_time());
+            if timers.signal_until(Time::<Monotonic>::from(target)) {
+                if let Some(client) = surface.client() {
+                    let _ = self.blocker_cleared_tx.send(client);
+                }
+            }
+            if let Some(deadline) = timers.next_deadline() {
+                let left = Duration::from(Time::<Monotonic>::from(deadline)).saturating_sub(target);
+                wait = Some(wait.map_or(left, |wait| wait.min(left)));
+            }
+        };
+
+        self.layout
+            .with_windows(|mapped, _, _, _| mapped.window.with_surfaces(&mut signal));
+        for output in self.global_space.outputs() {
+            for layer in layer_map_for_output(output).layers() {
+                layer.with_surfaces(&mut signal);
+            }
+        }
+
+        if let Some(token) = self.commit_timer.take() {
+            self.event_loop.remove(token);
+        }
+        if let Some(wait) = wait {
+            let timer = Timer::from_duration(wait);
+            let token = self.event_loop.insert_source(timer, |_, _, state| {
+                state.niri.commit_timer = None;
+                TimeoutAction::Drop
+            });
+            self.commit_timer = token.ok();
+        }
+    }
