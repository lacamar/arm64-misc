+fn signal_fifo_barrier(surface: &WlSurface, states: &SurfaceData, tx: &Sender<Client>) {
+    let barrier = states
+        .cached_state
+        .get::<FifoBarrierCachedState>()
+        .current()
+        .barrier
+        .take();
+    if let Some(barrier) = barrier {
+        barrier.signal();
+        if let Some(client) = surface.client() {
+            let _ = tx.send(client);
+        }
+    }
