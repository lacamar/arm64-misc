+#[test]
+fn instant_action_completes_animations() {
+    use niri_config::Action;
+
+    let config = Config::parse_mem("workspace \"a\"\nworkspace \"b\"\n").unwrap();
+    let mut f = Fixture::with_config(config);
+    f.add_output(1, (1920, 1080));
+    f.niri_complete_animations();
+
+    let state = f.niri_state();
+    state.do_action(Action::FocusWorkspaceDown, false);
+    assert!(state.niri.layout.are_animations_ongoing(None));
+
+    f.niri_complete_animations();
+    let state = f.niri_state();
+    state.do_action_instantly(Action::FocusWorkspaceUp);
