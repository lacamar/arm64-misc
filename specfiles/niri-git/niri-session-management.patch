+impl Dispatch2<XdgSessionV1, State> for SessionData {
+    fn request(
+        &self,
+        state: &mut State,
+        _client: &Client,
+        resource: &XdgSessionV1,
+        request: xdg_session_v1::Request,
+        _dhandle: &DisplayHandle,
+        data_init: &mut DataInit<'_, State>,
+    ) {
+        let (id, toplevel, name, restore) = match request {
+            xdg_session_v1::Request::Destroy => {
+                let resource = SessionResource::Xdg(resource.clone());
+                state.niri.session_management_state.deactivate(&resource);
+                return;
+            }
+            xdg_session_v1::Request::Remove => {
+                let resource = SessionResource::Xdg(resource.clone());
+                state.niri.session_management_state.remove_session(&resource);
+                return;
+            }
+            xdg_session_v1::Request::RemoveToplevel { name } => {
+                if let Some(sid) = self.id() {
+                    state.niri.session_management_state.remove_toplevel(&sid, &name);
+                }
+                return;
+            }
+            xdg_session_v1::Request::AddToplevel { id, toplevel, name } => {
+                (id, toplevel, name, false)
+            }
+            xdg_session_v1::Request::RestoreToplevel { id, toplevel, name } => {
+                (id, toplevel, name, true)
+            }
+        };
+
+        let resolved = resolve_toplevel(state, self, &toplevel);
+        let sm = &mut state.niri.session_management_state;
+        let saved = match &resolved {
+            Some((sid, surface)) => match sm.add_toplevel(sid, surface, name, restore) {
+                Ok(saved) => saved,
+                Err(err) => {
+                    let (code, msg) = match err {
+                        AddError::AlreadyAdded => {
+                            (xdg_session_v1::Error::AlreadyAdded, "toplevel already added")
+                        }
+                        AddError::NameInUse => {
+                            (xdg_session_v1::Error::NameInUse, "toplevel name in use")
+                        }
+                        AddError::AlreadyMapped => {
+                            (xdg_session_v1::Error::AlreadyMapped, "toplevel already mapped")
+                        }
+                    };
+                    resource.post_error(code, msg);
+                    return;
+                }
+            },
+            None => None,
+        };
+
+        let surface = resolved.map(|(_, s)| s);
+        let toplevel_session = data_init.init(
+            id,
+            ToplevelSessionData {
+                session: resource.clone(),
+                toplevel: surface.clone(),
+            },
+        );
+        if let (Some(saved), Some(surface)) = (saved, surface) {
+            set_restore_state(surface.wl_surface(), Some(saved));
+            toplevel_session.restored();
+        }
+    }
+
+    fn destroyed(
+        &self,
+        state: &mut State,
+        _client: smithay::reexports::wayland_server::backend::ClientId,
+        resource: &XdgSessionV1,
+    ) {
+        let resource = SessionResource::Xdg(resource.clone());
+        state.niri.session_management_state.deactivate(&resource);
+    }
+}
+
+impl Dispatch2<XxSessionV1, State> for SessionData {
+    fn request(
+        &self,
+        state: &mut State,
+        _client: &Client,
+        resource: &XxSessionV1,
+        request: xx_session_v1::Request,
+        _dhandle: &DisplayHandle,
+        data_init: &mut DataInit<'_, State>,
+    ) {
+        let (id, toplevel, name, restore) = match request {
+            xx_session_v1::Request::Destroy => {
+                let resource = SessionResource::Xx(resource.clone());
+                state.niri.session_management_state.deactivate(&resource);
+                return;
+            }
+            xx_session_v1::Request::Remove => {
+                let resource = SessionResource::Xx(resource.clone());
+                state.niri.session_management_state.remove_session(&resource);
+                return;
+            }
+            xx_session_v1::Request::AddToplevel { id, toplevel, name } => {
+                (id, toplevel, name, false)
+            }
+            xx_session_v1::Request::RestoreToplevel { id, toplevel, name } => {
+                (id, toplevel, name, true)
+            }
+        };
+
+        let resolved = resolve_toplevel(state, self, &toplevel);
+        let sm = &mut state.niri.session_management_state;
+        let saved = match &resolved {
+            Some((sid, surface)) => match sm.add_toplevel(sid, surface, name, restore) {
+                Ok(saved) => saved,
+                Err(err) => {
+                    let (code, msg) = match err {
+                        AddError::AlreadyAdded => {
+                            let session = resource.clone();
+                            data_init.init(id, ToplevelSessionData { session, toplevel: None });
+                            return;
+                        }
+                        AddError::NameInUse => {
+                            (xx_session_v1::Error::NameInUse, "toplevel name in use")
+                        }
+                        AddError::AlreadyMapped => {
+                            (xx_session_v1::Error::AlreadyMapped, "toplevel already mapped")
+                        }
+                    };
+                    resource.post_error(code, msg);
+                    return;
+                }
+            },
+            None => None,
+        };
+
+        let surface = resolved.map(|(_, s)| s);
+        let toplevel_session = data_init.init(
+            id,
+            ToplevelSessionData {
+                session: resource.clone(),
+                toplevel: surface.clone(),
+            },
+        );
+        if let (Some(saved), Some(surface)) = (saved, surface) {
+            set_restore_state(surface.wl_surface(), Some(saved));
+            toplevel_session.restored(&toplevel);
+        }
+    }
+
+    fn destroyed(
+        &self,
+        state: &mut State,
+        _client: smithay::reexports::wayland_server::backend::ClientId,
+        resource: &XxSessionV1,
+    ) {
+        let resource = SessionResource::Xx(resource.clone());
+        state.niri.session_management_state.deactivate(&resource);
+    }
+}
+
+impl<S: Resource> ToplevelSessionData<S> {
+    fn ids(&self) -> Option<(String, &ToplevelSurface)> {
+        let sid = self.session.data::<SessionData>()?.id()?;
+        Some((sid, self.toplevel.as_ref()?))
+    }
+}
+
+impl Dispatch2<XdgToplevelSessionV1, State> for ToplevelSessionData<XdgSessionV1> {
+    fn request(
+        &self,
+        state: &mut State,
+        _client: &Client,
+        _resource: &XdgToplevelSessionV1,
+        request: xdg_toplevel_session_v1::Request,
+        _dhandle: &DisplayHandle,
+        _data_init: &mut DataInit<'_, State>,
+    ) {
+        let xdg_toplevel_session_v1::Request::Rename { name } = request else {
+            return;
+        };
+        let Some((sid, toplevel)) = self.ids() else {
+            return;
+        };
+        let sm = &mut state.niri.session_management_state;
+        if !sm.rename_toplevel(&sid, toplevel, name) {
+            self.session
+                .post_error(xdg_session_v1::Error::NameInUse, "toplevel name in use");
+        }
+    }
+}
+
+impl Dispatch2<XxToplevelSessionV1, State> for ToplevelSessionData<XxSessionV1> {
+    fn request(
+        &self,
+        state: &mut State,
+        _client: &Client,
+        _resource: &XxToplevelSessionV1,
+        request: xx_toplevel_session_v1::Request,
+        _dhandle: &DisplayHandle,
+        _data_init: &mut DataInit<'_, State>,
+    ) {
+        let xx_toplevel_session_v1::Request::Remove = request else {
+            return;
+        };
+        let Some((sid, toplevel)) = self.ids() else {
+            return;
+        };
+        let sm = &mut state.niri.session_management_state;
+        if let Some(name) = sm.name_of(&sid, toplevel) {
+            sm.remove_toplevel(&sid, &name);
+        }
+    }
+}
