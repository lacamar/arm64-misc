+    #[test]
+    fn apply_saved_state() {
+        let saved = ToplevelState {
+            output: Some("DP-1".into()),
+            size: Some((800, 600)),
+            floating_pos: Some((10., 20.)),
+            maximized: true,
+            ..Default::default()
+        };
+        let json = serde_json::to_string(&saved).unwrap();
+        assert_eq!(serde_json::from_str::<ToplevelState>(&json).unwrap(), saved);
+
+        let mut rules = ResolvedWindowRules::default();
+        saved.apply(&mut rules);
+        assert_eq!(rules.open_on_output.as_deref(), Some("DP-1"));
+        assert_eq!(rules.default_width, Some(Some(PresetSize::Fixed(800))));
+        assert_eq!(rules.open_floating, Some(true));
+        assert_eq!(rules.default_floating_position.unwrap().y, FloatOrInt(20.));
+        assert_eq!(rules.open_maximized_to_edges, Some(true));
+        assert_eq!(rules.open_fullscreen, Some(false));
+    }
+}
