+use std::collections::HashMap;
+use std::hash::{BuildHasher, RandomState};
+use std::path::PathBuf;
+use std::sync::Mutex;
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+use directories::BaseDirs;
+use niri_config::{FloatOrInt, FloatingPosition, PresetSize, RelativeTo};
+use serde::{Deserialize, Serialize};
+use smithay::reexports::wayland_server::protocol::wl_surface::WlSurface;
+use smithay::reexports::wayland_server::{
+    Client, DataInit, DisplayHandle, New, Resource, WEnum,
+};
+use smithay::wayland::compositor::with_states;
+use smithay::wayland::shell::xdg::ToplevelSurface;
+use smithay::wayland::{Dispatch2, GlobalDispatch2};
+
+use smithay::reexports::wayland_protocols::xdg::shell::server::xdg_toplevel::XdgToplevel;
+
+use super::raw::xdg_session_management::v1::server::xdg_session_manager_v1::{
+    self, XdgSessionManagerV1,
+};
+use super::raw::xdg_session_management::v1::server::xdg_session_v1::{self, XdgSessionV1};
+use super::raw::xdg_session_management::v1::server::xdg_toplevel_session_v1::{
+    self, XdgToplevelSessionV1,
+};
+use super::raw::xx_session_management::v1::server::xx_session_manager_v1::{
+    self, XxSessionManagerV1,
+};
+use super::raw::xx_session_management::v1::server::xx_session_v1::{self, XxSessionV1};
+use super::raw::xx_session_management::v1::server::xx_toplevel_session_v1::{
+    self, XxToplevelSessionV1,
+};
+use crate::layout::{LayoutElement, SizingMode};
+use crate::niri::State;
+use crate::window::ResolvedWindowRules;
+
+const VERSION: u32 = 1;
+const MAX_AGE: Duration = Duration::from_secs(30 * 24 * 3600);
+pub const SAVE_INTERVAL: Duration = Duration::from_secs(1);
+
+#[derive(Debug, Clone, Default, PartialEq, Serialize, Deserialize)]
+pub struct ToplevelState {
+    pub output: Option<String>,
+    pub workspace_name: Option<String>,
+    pub workspace_idx: usize,
+    pub column_idx: Option<usize>,
+    pub size: Option<(i32, i32)>,
+    pub floating_pos: Option<(f64, f64)>,
+    pub fullscreen: bool,
+    pub maximized: bool,
+}
+
+#[derive(Default, Serialize, Deserialize)]
+struct StoredSession {
+    last_used: u64,
+    toplevels: HashMap<String, ToplevelState>,
+}
+
+#[derive(Clone, PartialEq)]
+enum SessionResource {
+    Xdg(XdgSessionV1),
+    Xx(XxSessionV1),
+}
+
+struct ActiveSession {
+    resource: SessionResource,
+    toplevels: HashMap<String, ToplevelSurface>,
+}
+
+pub struct SessionManagementState {
+    path: Option<PathBuf>,
+    sessions: HashMap<String, StoredSession>,
+    active: HashMap<String, ActiveSession>,
+    dirty: bool,
+}
+
+pub struct SessionManagerGlobalData;
+pub struct SessionManagerData;
+pub struct SessionData(Mutex<Option<String>>);
+pub struct ToplevelSessionData<S> {
+    session: S,
+    toplevel: Option<ToplevelSurface>,
+}
+
+enum AddError {
+    AlreadyAdded,
+    NameInUse,
+    AlreadyMapped,
+}
+
+struct RestoreData(Mutex<Option<ToplevelState>>);
+
+fn now() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_or(0, |d| d.as_secs())
+}
+
+fn new_session_id() -> String {
+    let s = RandomState::new();
+    format!("{:016x}{:016x}", s.hash_one(0u8), s.hash_one(1u8))
+}
+
+fn set_restore_state(surface: &WlSurface, value: Option<ToplevelState>) {
+    with_states(surface, |states| {
+        let data = states
+            .data_map
+            .get_or_insert_threadsafe(|| RestoreData(Mutex::new(None)));
+        *data.0.lock().unwrap() = value;
+    });
+}
+
+pub fn restore_state(surface: &WlSurface) -> Option<ToplevelState> {
+    with_states(surface, |states| {
+        states
+            .data_map
+            .get::<RestoreData>()
+            .and_then(|d| d.0.lock().unwrap().clone())
+    })
+}
+
+pub fn take_restore_state(surface: &WlSurface) -> Option<ToplevelState> {
+    with_states(surface, |states| {
+        states
+            .data_map
+            .get::<RestoreData>()
+            .and_then(|d| d.0.lock().unwrap().take())
+    })
+}
+
+impl ToplevelState {
+    pub fn apply(&self, rules: &mut ResolvedWindowRules) {
+        if self.output.is_some() {
+            rules.open_on_output = self.output.clone();
+        }
+        rules.open_on_workspace = self.workspace_name.clone();
+        if let Some((w, h)) = self.size {
+            rules.default_width = Some(Some(PresetSize::Fixed(w)));
+            rules.default_height = Some(Some(PresetSize::Fixed(h)));
+        }
+        rules.open_floating = Some(self.floating_pos.is_some());
+        if let Some((x, y)) = self.floating_pos {
+            rules.default_floating_position = Some(FloatingPosition {
+                x: FloatOrInt(x),
+                y: FloatOrInt(y),
+                relative_to: RelativeTo::TopLeft,
+            });
+        }
+        rules.open_fullscreen = Some(self.fullscreen);
+        rules.open_maximized_to_edges = Some(self.maximized);
+    }
+}
+
+impl SessionManagementState {
+    pub fn new(display: &DisplayHandle) -> Self {
+        display.create_global::<State, XdgSessionManagerV1, _>(VERSION, SessionManagerGlobalData);
+        display.create_global::<State, XxSessionManagerV1, _>(VERSION, SessionManagerGlobalData);
+
+        let path = BaseDirs::new()
+            .and_then(|d| d.state_dir().map(|p| p.join("niri/sessions.json")));
+        let mut sessions: HashMap<String, StoredSession> = path
+            .as_ref()
+            .and_then(|p| std::fs::read(p).ok())
+            .and_then(|data| {
+                serde_json::from_slice(&data)
+                    .map_err(|err| warn!("error parsing session store: {err}"))
+                    .ok()
+            })
+            .unwrap_or_default();
+        let cutoff = now().saturating_sub(MAX_AGE.as_secs());
+        sessions.retain(|_, s| s.last_used >= cutoff);
+
+        Self {
+            path,
+            sessions,
+            active: HashMap::new(),
+            dirty: false,
+        }
+    }
+
+    fn deactivate(&mut self, resource: &SessionResource) {
+        let Some(id) = resource.data().and_then(|d| d.0.lock().unwrap().take()) else {
+            return;
+        };
+        if self.active.get(&id).is_some_and(|a| a.resource == *resource) {
+            self.active.remove(&id);
+        }
+    }
+
+    fn open_session(&mut self, client: &Client, session_id: Option<String>) -> Option<(String, bool)> {
+        if let Some(old) = session_id.as_ref().and_then(|id| self.active.get(id)) {
+            if old.resource.client().as_ref() == Some(client) {
+                return None;
+            }
+            let old = old.resource.clone();
+            self.deactivate(&old);
+            old.replaced();
+        }
+
+        let (sid, restored) = match session_id.filter(|sid| self.sessions.contains_key(sid)) {
+            Some(sid) => (sid, true),
+            None => (new_session_id(), false),
+        };
+        self.sessions.entry(sid.clone()).or_default().last_used = now();
+        self.dirty = true;
+        Some((sid, restored))
+    }
+
+    fn activate(&mut self, sid: String, resource: SessionResource) {
+        let toplevels = HashMap::new();
+        self.active.insert(sid, ActiveSession { resource, toplevels });
+    }
+
+    fn remove_session(&mut self, resource: &SessionResource) {
+        let id = resource.data().and_then(|d| d.0.lock().unwrap().clone());
+        self.deactivate(resource);
+        if let Some(id) = id {
+            self.sessions.remove(&id);
+            self.dirty = true;
+        }
+    }
+
+    fn add_toplevel(
+        &mut self,
+        sid: &str,
+        surface: &ToplevelSurface,
+        name: String,
+        restore: bool,
+    ) -> Result<Option<ToplevelState>, AddError> {
+        if self.tracks(surface) {
+            return Err(AddError::AlreadyAdded);
+        }
+        let active = self.active.get_mut(sid).unwrap();
+        if active.toplevels.get(&name).is_some_and(|t| t.alive()) {
+            return Err(AddError::NameInUse);
+        }
+        if restore && surface.is_initial_configure_sent() {
+            return Err(AddError::AlreadyMapped);
+        }
+
+        let stored = self.sessions.entry(sid.to_owned()).or_default();
+        let saved = if restore {
+            stored.toplevels.get(&name).cloned()
+        } else {
+            stored.toplevels.remove(&name);
+            None
+        };
+        active.toplevels.insert(name, surface.clone());
+        Ok(saved)
+    }
+
+    fn name_of(&self, sid: &str, toplevel: &ToplevelSurface) -> Option<String> {
+        let active = self.active.get(sid)?;
+        let (name, _) = active.toplevels.iter().find(|(_, t)| *t == toplevel)?;
+        Some(name.clone())
+    }
+
+    fn remove_toplevel(&mut self, sid: &str, name: &str) {
+        if let Some(active) = self.active.get_mut(sid) {
+            active.toplevels.remove(name);
+        }
+        if let Some(s) = self.sessions.get_mut(sid) {
+            s.toplevels.remove(name);
+            self.dirty = true;
+        }
+    }
+
+    fn rename_toplevel(&mut self, sid: &str, toplevel: &ToplevelSurface, name: String) -> bool {
+        let Some(old) = self.name_of(sid, toplevel) else {
+            return true;
+        };
+        let active = self.active.get_mut(sid).unwrap();
+        if active.toplevels.get(&name).is_some_and(|t| t.alive()) {
+            return false;
+        }
+        let t = active.toplevels.remove(&old).unwrap();
+        active.toplevels.insert(name.clone(), t);
+        if let Some(s) = self.sessions.get_mut(sid) {
+            if let Some(saved) = s.toplevels.remove(&old) {
+                s.toplevels.insert(name, saved);
+                self.dirty = true;
+            }
+        }
+        true
+    }
+
+    fn tracks(&self, toplevel: &ToplevelSurface) -> bool {
+        self.active
+            .values()
+            .any(|a| a.toplevels.values().any(|t| t == toplevel))
+    }
+
+    fn write(&mut self) {
+        let Some(path) = &self.path else { return };
+        let res = (|| {
+            std::fs::create_dir_all(path.parent().unwrap())?;
+            let tmp = path.with_extension("json.tmp");
+            std::fs::write(&tmp, serde_json::to_vec(&self.sessions)?)?;
+            std::fs::rename(&tmp, path)
+        })();
+        if let Err(err) = res {
+            warn!("error writing session store: {err}");
+        }
+        self.dirty = false;
+    }
+}
+
+impl State {
+    pub fn save_sessions(&mut self) {
+        let sm = &mut self.niri.session_management_state;
+        let mut tracked: HashMap<WlSurface, (String, String)> = HashMap::new();
+        for (id, active) in &mut sm.active {
+            active.toplevels.retain(|_, t| t.alive());
+            for (name, t) in &active.toplevels {
+                tracked.insert(t.wl_surface().clone(), (id.clone(), name.clone()));
+            }
+        }
+
+        let layout = &self.niri.layout;
+        let mut updates = Vec::new();
+        layout.with_windows(|mapped, output, ws_id, wl| {
+            let (Some(output), Some(ws_id)) = (output, ws_id) else {
+                return;
+            };
+            let Some(key) = tracked.get(mapped.toplevel().wl_surface()) else {
+                return;
+            };
+            let Some((ws_idx, ws)) = layout.find_workspace_by_id(ws_id) else {
+                return;
+            };
+            let mode = mapped.sizing_mode();
+            updates.push((
+                key.clone(),
+                ToplevelState {
+                    output: Some(output.name()),
+                    workspace_name: ws.name().cloned(),
+                    workspace_idx: ws_idx,
+                    column_idx: wl.pos_in_scrolling_layout.map(|(col, _)| col - 1),
+                    size: (mode == SizingMode::Normal).then_some(wl.window_size),
+                    floating_pos: mapped
+                        .is_floating()
+                        .then_some(wl.tile_pos_in_workspace_view)
+                        .flatten()
+                        .map(|(x, y)| {
+                            let loc = ws.floating().working_area().loc;
+                            (x - loc.x, y - loc.y)
+                        }),
+                    fullscreen: mode == SizingMode::Fullscreen,
+                    maximized: mode == SizingMode::Maximized,
+                },
+            ));
+        });
+
+        let sm = &mut self.niri.session_management_state;
+        for ((id, name), mut new) in updates {
+            let session = sm.sessions.entry(id).or_default();
+            let old = session.toplevels.entry(name).or_default();
+            if new.size.is_none() {
+                new.size = old.size;
+            }
+            if *old != new {
+                *old = new;
+                sm.dirty = true;
+            }
+        }
+
+        if sm.dirty {
+            sm.write();
+        }
+    }
+}
+
+impl SessionResource {
+    fn data(&self) -> Option<&SessionData> {
+        match self {
+            Self::Xdg(r) => r.data(),
+            Self::Xx(r) => r.data(),
+        }
+    }
+
+    fn client(&self) -> Option<Client> {
+        match self {
+            Self::Xdg(r) => r.client(),
+            Self::Xx(r) => r.client(),
+        }
+    }
+
+    fn replaced(&self) {
+        match self {
+            Self::Xdg(r) => r.replaced(),
+            Self::Xx(r) => r.replaced(),
+        }
+    }
+}
+
+impl SessionData {
+    fn id(&self) -> Option<String> {
+        self.0.lock().unwrap().clone()
+    }
+}
+
+/// Returns the active session id and toplevel, or `None` for an inert toplevel session.
+fn resolve_toplevel(
+    state: &State,
+    data: &SessionData,
+    toplevel: &XdgToplevel,
+) -> Option<(String, ToplevelSurface)> {
+    let sid = data.id()?;
+    let surface = state.niri.xdg_shell_state.get_toplevel(toplevel)?;
+    Some((sid, surface))
+}
+
+impl<I: Resource + 'static> GlobalDispatch2<I, State> for SessionManagerGlobalData
+where
+    SessionManagerData: Dispatch2<I, State>,
+{
+    fn bind(
+        &self,
+        _state: &mut State,
+        _handle: &DisplayHandle,
+        _client: &Client,
+        manager: New<I>,
+        data_init: &mut DataInit<'_, State>,
+    ) {
+        data_init.init(manager, SessionManagerData);
+    }
+}
+
+impl Dispatch2<XdgSessionManagerV1, State> for SessionManagerData {
+    fn request(
+        &self,
+        state: &mut State,
+        client: &Client,
+        resource: &XdgSessionManagerV1,
+        request: xdg_session_manager_v1::Request,
+        _dhandle: &DisplayHandle,
+        data_init: &mut DataInit<'_, State>,
+    ) {
+        let xdg_session_manager_v1::Request::GetSession {
+            id,
+            reason,
+            session_id,
+        } = request
+        else {
+            return;
+        };
+        if !matches!(reason, WEnum::Value(_)) {
+            resource.post_error(
+                xdg_session_manager_v1::Error::InvalidReason,
+                "invalid reason",
+            );
+            return;
+        }
+
+        let sm = &mut state.niri.session_management_state;
+        let Some((sid, restored)) = sm.open_session(client, session_id) else {
+            resource.post_error(xdg_session_manager_v1::Error::InUse, "session in use");
+            return;
+        };
+        let session = data_init.init(id, SessionData(Mutex::new(Some(sid.clone()))));
+        sm.activate(sid.clone(), SessionResource::Xdg(session.clone()));
+        if restored {
+            session.restored();
+        } else {
+            session.created(sid);
+        }
+    }
+}
