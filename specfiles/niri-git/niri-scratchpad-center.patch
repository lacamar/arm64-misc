+#[test]
+fn scratchpad_centers_at_new_size() {
+    let ops = [
+        Op::AddOutput(1),
+        Op::AddWindow {
+            params: TestWindowParams::new(1),
+        },
+        Op::MoveWindowToScratchpad { id: None },
+    ];
+    let mut layout = check_ops(ops);
+    let mut options = Options::default();
+    options.layout.scratchpad.width = Some(niri_config::DefaultPresetSize(Some(
+        PresetSize::Proportion(0.5),
+    )));
+    options.layout.scratchpad.height =
+        Some(niri_config::DefaultPresetSize(Some(PresetSize::Fixed(100))));
+    layout.update_options(options);
+    layout.toggle_scratchpad(None);
+
+    let ws = layout.active_workspace().unwrap();
+    let area = ws.working_area().size;
+    let (_, l) = ws.tiles_with_ipc_layouts().next().unwrap();
+    let (x, y) = l.tile_pos_in_workspace_view.unwrap();
+    assert_eq!((x, y), (area.w / 4., (area.h - 100.) / 2.));
+}
