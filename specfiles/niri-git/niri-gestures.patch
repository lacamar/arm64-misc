+
+    #[test]
+    fn find_prefers_exact_direction() {
+        let mut g = Gestures::default();
+        let close = GestureAction::Action(Action::CloseWindow);
+        g.binds.push(GestureBind {
+            fingers: 3,
+            direction: GestureDirection::Left,
+            action: close.clone(),
+        });
+        assert_eq!(g.find(3, GestureDirection::Left), Some(&close));
+        assert_eq!(g.find(3, GestureDirection::Right), Some(&GestureAction::ViewScroll));
+        assert_eq!(g.find(4, GestureDirection::Up), Some(&GestureAction::Overview));
+        assert_eq!(g.find(4, GestureDirection::PinchIn), None);
+        assert!(!g.has(4, true));
+    }
+}
