+impl Gestures {
+    pub fn has(&self, fingers: u32, pinch: bool) -> bool {
+        self.binds
+            .iter()
+            .any(|b| u32::from(b.fingers) == fingers && b.direction.is_pinch() == pinch)
+    }
+
+    pub fn find(&self, fingers: u32, direction: GestureDirection) -> Option<&GestureAction> {
+        use GestureDirection::*;
+        let fallbacks: &[GestureDirection] = match direction {
+            Left | Right => &[Horizontal, Swipe],
+            Up | Down => &[Vertical, Swipe],
+            PinchIn | PinchOut => &[Pinch],
+            _ => &[],
+        };
+        std::iter::once(&direction)
+            .chain(fallbacks)
+            .find_map(|d| {
+                self.binds
+                    .iter()
+                    .find(|b| u32::from(b.fingers) == fingers && b.direction == *d)
+            })
+            .map(|b| &b.action)
+    }
+}
