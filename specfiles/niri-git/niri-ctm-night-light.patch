+const CTM_GAMMA_SIZE: u32 = 256;
+
+/// Least-squares slope of the ramp as S31.32 fixed point.
+fn ctm_gain_from_ramp(ramp: &[u16]) -> u64 {
+    let denom = (ramp.len() - 1).max(1) as f64;
+    let (mut xy, mut xx) = (0., 0.);
+    for (i, &y) in ramp.iter().enumerate() {
+        let x = i as f64 / denom;
+        xy += x * f64::from(y) / f64::from(u16::MAX);
+        xx += x * x;
+    }
+    let gain = if xx > 0. { (xy / xx).clamp(0., 1.) } else { 1. };
+    // Ramp gains are in encoded space; the CTM may be applied in linear light.
+    let gamma = env::var("NIRI_CTM_GAMMA")
+        .ok()
+        .and_then(|v| v.parse::<f64>().ok())
+        .filter(|g| *g > 0.)
+        .unwrap_or(1.);
+    (gain.powf(gamma) * (1u64 << 32) as f64).round() as u64
+}
