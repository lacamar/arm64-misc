@@ -3477,6 +3477,16 @@ impl<W: LayoutElement> Layout<W> {
             .position(|r| r.tile.window().id() == window)
     }
 
+    /// Hidden scratchpad windows, oldest first, then shown ones.
+    pub fn scratchpad_windows(&self) -> impl Iterator<Item = &W> {
+        let shown = self.workspaces().flat_map(|(_, _, ws)| {
+            ws.tiles()
+                .filter(|tile| tile.is_scratchpad && ws.is_floating(tile.window().id()))
+                .map(|tile| tile.window())
+        });
+        self.scratchpad.iter().map(|r| r.tile.window()).chain(shown)
+    }
+
     pub fn is_in_scratchpad(&self, window: &W::Id) -> bool {
         self.scratchpad_idx(window).is_some()
     }
diff --git a/src/layout/tests.rs b/src/layout/tests.rs
index af08b15..b13c879 100644
--- a/src/layout/tests.rs
+++ b/src/layout/tests.rs
@@ -3313,6 +3313,21 @@ fn scratchpad_shows_one_at_a_time() {
     layout.toggle_scratchpad(Some(&3));
     assert!(layout.has_window(&3));
     assert!(layout.is_in_scratchpad(&2));
+
+    // showing one on another workspace hides the first
+    layout.switch_workspace_down();
+    layout.refresh(true);
+    layout.toggle_scratchpad(Some(&2));
+    assert!(layout.has_window(&2));
+    assert!(layout.is_in_scratchpad(&3));
+    let mut all: Vec<_> = layout.scratchpad_windows().map(|w| *w.id()).collect();
+    all.sort_unstable();
+    assert_eq!(all, [2, 3]);
+    let shown = layout
+        .scratchpad_windows()
+        .filter(|w| !layout.is_in_scratchpad(w.id()))
+        .count();
+    assert_eq!(shown, 1);
     layout.verify_invariants();
 }
 
