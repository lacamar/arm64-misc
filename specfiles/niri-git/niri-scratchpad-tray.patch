diff --git a/src/dbus/scratchpad_tray.rs b/src/dbus/scratchpad_tray.rs
new file mode 100644
index 0000000..04279b2
--- /dev/null
+++ b/src/dbus/scratchpad_tray.rs
@@ -0,0 +1,283 @@
+//! A StatusNotifierItem per scratchpad window; activating one toggles that window.
+
+use std::collections::HashMap;
+use std::path::PathBuf;
+use std::sync::{Arc, Mutex};
+
+use futures_util::StreamExt as _;
+use zbus::blocking::Connection;
+use zbus::object_server::SignalEmitter;
+use zbus::zvariant::OwnedObjectPath;
+use zbus::{fdo, interface};
+
+const WATCHER: &str = "org.kde.StatusNotifierWatcher";
+const PATH: &str = "/StatusNotifierItem";
+
+/// (icon name, icon pixmaps, title, description)
+type ToolTip = (String, Vec<(i32, i32, Vec<u8>)>, String, String);
+
+struct Item {
+    id: u64,
+    title: String,
+    icon: String,
+    to_niri: calloop::channel::Sender<u64>,
+}
+
+#[interface(name = "org.kde.StatusNotifierItem")]
+impl Item {
+    #[zbus(property)]
+    fn category(&self) -> &str {
+        "ApplicationStatus"
+    }
+
+    #[zbus(property)]
+    fn id(&self) -> String {
+        format!("niri-scratchpad-{}", self.id)
+    }
+
+    #[zbus(property)]
+    fn title(&self) -> &str {
+        &self.title
+    }
+
+    #[zbus(property)]
+    fn status(&self) -> &str {
+        "Active"
+    }
+
+    #[zbus(property)]
+    fn icon_name(&self) -> &str {
+        &self.icon
+    }
+
+    #[zbus(property)]
+    fn tool_tip(&self) -> ToolTip {
+        (self.icon.clone(), vec![], self.title.clone(), String::new())
+    }
+
+    #[zbus(property)]
+    fn item_is_menu(&self) -> bool {
+        false
+    }
+
+    #[zbus(property)]
+    fn menu(&self) -> OwnedObjectPath {
+        OwnedObjectPath::try_from("/NO_DBUSMENU").unwrap()
+    }
+
+    fn activate(&self, _x: i32, _y: i32) {
+        let _ = self.to_niri.send(self.id);
+    }
+
+    fn secondary_activate(&self, _x: i32, _y: i32) {
+        let _ = self.to_niri.send(self.id);
+    }
+
+    fn context_menu(&self, _x: i32, _y: i32) {}
+
+    fn scroll(&self, _delta: i32, _orientation: &str) {}
+
+    #[zbus(signal)]
+    async fn new_title(emitter: &SignalEmitter<'_>) -> zbus::Result<()>;
+}
+
+pub struct ScratchpadTray {
+    to_niri: calloop::channel::Sender<u64>,
+    items: HashMap<u64, (Connection, String)>,
+    names: Arc<Mutex<Vec<String>>>,
+    icons: HashMap<String, String>,
+    _monitor: Option<Connection>,
+}
+
+impl ScratchpadTray {
+    pub fn new(to_niri: calloop::channel::Sender<u64>) -> Self {
+        let names = Arc::new(Mutex::new(Vec::new()));
+        let monitor = watch_watcher(names.clone())
+            .inspect_err(|err| warn!("error watching {WATCHER}: {err:?}"))
+            .ok();
+        Self {
+            to_niri,
+            items: HashMap::new(),
+            names,
+            icons: HashMap::new(),
+            _monitor: monitor,
+        }
+    }
+
+    /// `windows`: (id, app id, title) of every scratchpad window, hidden or shown.
+    pub fn sync(&mut self, windows: &[(u64, String, String)]) {
+        self.items
+            .retain(|id, _| windows.iter().any(|(w, _, _)| w == id));
+        let mut names = self.names.lock().unwrap();
+        names.retain(|n| self.items.keys().any(|id| *n == name(*id)));
+        drop(names);
+
+        for (id, app_id, title) in windows {
+            if let Some((conn, old)) = self.items.get_mut(id) {
+                if old != title {
+                    *old = title.clone();
+                    set_title(conn, title);
+                }
+                continue;
+            }
+            let icon = self
+                .icons
+                .entry(app_id.clone())
+                .or_insert_with(|| desktop_icon(app_id).unwrap_or_else(|| app_id.clone()))
+                .clone();
+            let item = Item {
+                id: *id,
+                title: title.clone(),
+                icon,
+                to_niri: self.to_niri.clone(),
+            };
+            match publish(*id, item) {
+                Ok(conn) => {
+                    self.names.lock().unwrap().push(name(*id));
+                    self.items.insert(*id, (conn, title.clone()));
+                }
+                Err(err) => warn!("error publishing scratchpad tray item: {err:?}"),
+            }
+        }
+    }
+}
+
+fn name(id: u64) -> String {
+    format!("org.kde.StatusNotifierItem-{}-{id}", std::process::id())
+}
+
+fn publish(id: u64, item: Item) -> anyhow::Result<Connection> {
+    let name = name(id);
+    let conn = zbus::blocking::connection::Builder::session()?
+        .name(name.clone())?
+        .serve_at(PATH, item)?
+        .build()?;
+    // no watcher yet is fine: the monitor registers us when one appears
+    let _ = register(&conn, &name);
+    Ok(conn)
+}
+
+fn register(conn: &Connection, name: &str) -> zbus::Result<()> {
+    conn.call_method(
+        Some(WATCHER),
+        "/StatusNotifierWatcher",
+        Some(WATCHER),
+        "RegisterStatusNotifierItem",
+        &name,
+    )
+    .map(drop)
+}
+
+fn set_title(conn: &Connection, title: &str) {
+    let Ok(iface) = conn.object_server().interface::<_, Item>(PATH) else {
+        return;
+    };
+    iface.get_mut().title = title.to_owned();
+    let emitter = iface.signal_emitter().clone();
+    async_io::block_on(async {
+        let _ = Item::new_title(&emitter).await;
+        let _ = iface.get_mut().title_changed(&emitter).await;
+    });
+}
+
+/// Re-registers every item when a tray host (re)starts.
+fn watch_watcher(names: Arc<Mutex<Vec<String>>>) -> anyhow::Result<Connection> {
+    let conn = Connection::session()?;
+    let inner = conn.inner().clone();
+    let task = async_io::block_on(async {
+        let proxy = fdo::DBusProxy::new(&inner).await?;
+        let mut stream = proxy
+            .receive_name_owner_changed_with_args(&[(0, WATCHER)])
+            .await?;
+        let inner = inner.clone();
+        anyhow::Ok(async move {
+            while let Some(signal) = stream.next().await {
+                if signal.args().is_ok_and(|a| a.new_owner().is_some()) {
+                    let names = names.lock().unwrap().clone();
+                    for name in names {
+                        let _ = inner
+                            .call_method(
+                                Some(WATCHER),
+                                "/StatusNotifierWatcher",
+                                Some(WATCHER),
+                                "RegisterStatusNotifierItem",
+                                &name,
+                            )
+                            .await;
+                    }
+                }
+            }
+        })
+    })?;
+    conn.inner()
+        .executor()
+        .spawn(task, "scratchpad tray watcher")
+        .detach();
+    Ok(conn)
+}
+
+fn data_dirs() -> Vec<PathBuf> {
+    let home = std::env::var_os("XDG_DATA_HOME")
+        .filter(|v| !v.is_empty())
+        .map(PathBuf::from)
+        .or_else(|| std::env::var_os("HOME").map(|h| PathBuf::from(h).join(".local/share")));
+    let dirs = std::env::var("XDG_DATA_DIRS")
+        .ok()
+        .filter(|v| !v.is_empty())
+        .unwrap_or_else(|| String::from("/usr/local/share:/usr/share"));
+    home.into_iter()
+        .chain(dirs.split(':').map(PathBuf::from))
+        .map(|d| d.join("applications"))
+        .collect()
+}
+
+/// The `Icon=` of the app's desktop file: named after the app id, or claiming it as
+/// `StartupWMClass`.
+fn desktop_icon(app_id: &str) -> Option<String> {
+    let dirs = data_dirs();
+    let direct = [app_id.to_owned(), app_id.to_lowercase()]
+        .into_iter()
+        .flat_map(|n| dirs.iter().map(move |d| d.join(format!("{n}.desktop"))))
+        .find_map(|p| std::fs::read_to_string(p).ok());
+    let text = direct.or_else(|| {
+        dirs.iter()
+            .filter_map(|d| std::fs::read_dir(d).ok())
+            .flatten()
+            .flatten()
+            .filter(|e| e.path().extension().is_some_and(|x| x == "desktop"))
+            .filter_map(|e| std::fs::read_to_string(e.path()).ok())
+            .find(|t| entry(t, "StartupWMClass").is_some_and(|c| c.eq_ignore_ascii_case(app_id)))
+    })?;
+    entry(&text, "Icon").map(str::to_owned)
+}
+
+fn entry<'a>(text: &'a str, key: &str) -> Option<&'a str> {
+    let mut main = false;
+    for line in text.lines() {
+        let line = line.trim();
+        if line.starts_with('[') {
+            main = line == "[Desktop Entry]";
+        } else if main {
+            if let Some((k, v)) = line.split_once('=') {
+                if k.trim() == key {
+                    return Some(v.trim());
+                }
+            }
+        }
+    }
+    None
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn entry_reads_only_the_main_group() {
+        let t = "[Desktop Entry]\nName=Foot\nIcon=foot\n[Desktop Action new]\nIcon=other\n";
+        assert_eq!(entry(t, "Icon"), Some("foot"));
+        let t = "[Desktop Action x]\nIcon=other\n[Desktop Entry]\nStartupWMClass = Zen\n";
+        assert_eq!(entry(t, "Icon"), None);
+        assert_eq!(entry(t, "StartupWMClass"), Some("Zen"));
+    }
+}
