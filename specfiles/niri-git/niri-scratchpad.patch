+#[test]
+fn scratchpad_toggle() {
+    let ops = [
+        Op::AddOutput(1),
+        Op::AddWindow {
+            params: TestWindowParams::new(1),
+        },
+        Op::AddWindow {
+            params: TestWindowParams::new(2),
+        },
+        Op::MoveWindowToScratchpad { id: None },
+    ];
+    let mut layout = check_ops(ops);
+    assert_eq!(layout.focus().unwrap().id(), &1);
+    assert!(!layout.has_window(&2));
+    assert!(layout.is_in_scratchpad(&2));
+    assert!(layout
+        .find_window_and_output_by(|w, _| w.id() == &2)
+        .is_some());
+
+    layout.toggle_scratchpad(None);
+    assert_eq!(layout.focus().unwrap().id(), &2);
+    assert!(layout.active_workspace().unwrap().is_floating(&2));
+
+    layout.switch_workspace_down();
+    layout.toggle_scratchpad(None);
+    assert_eq!(layout.focus().unwrap().id(), &2);
+    assert!(layout.active_workspace().unwrap().has_window(&2));
+
+    layout.toggle_scratchpad(None);
+    assert!(!layout.has_window(&2));
+
+    layout.toggle_scratchpad(Some(&2));
+    assert_eq!(layout.focus().unwrap().id(), &2);
+    layout.toggle_scratchpad(Some(&2));
+    assert!(!layout.has_window(&2));
+
+    layout.remove_window(&2, Transaction::new());
+    assert!(layout.scratchpad.is_empty());
+    layout.verify_invariants();
+}
