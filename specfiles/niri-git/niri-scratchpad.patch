+    fn scratchpad_idx(&self, window: &W::Id) -> Option<usize> {
+        self.scratchpad
+            .iter()
+            .position(|r| r.tile.window().id() == window)
+    }
+
+    pub fn is_in_scratchpad(&self, window: &W::Id) -> bool {
+        self.scratchpad_idx(window).is_some()
+    }
+
+    pub fn move_window_to_scratchpad(&mut self, window: Option<&W::Id>) {
+        let Some(id) = window.or_else(|| self.focus().map(|win| win.id())).cloned() else {
+            return;
+        };
+        if self.is_in_scratchpad(&id) {
+            return;
+        }
+        if let Some(mut removed) = self.remove_window(&id, Transaction::new()) {
+            removed.tile.is_scratchpad = true;
+            self.scratchpad.push(removed);
+        }
+    }
+
+    pub fn toggle_scratchpad(&mut self, window: Option<&W::Id>) {
+        let Some(active_ws) = self.active_workspace() else {
+            return;
+        };
+        let active_ws_id = active_ws.id();
+
+        let id = match window {
+            Some(id) if active_ws.has_window(id) => {
+                self.move_window_to_scratchpad(Some(id));
+                return;
+            }
+            Some(id) => id.clone(),
+            None => {
+                let focus = self.focus().map(|win| win.id().clone());
+                let visible: Vec<_> = self
+                    .workspaces()
+                    .flat_map(|(_, _, ws)| {
+                        ws.tiles()
+                            .filter(|tile| tile.is_scratchpad && ws.is_floating(tile.window().id()))
+                            .map(|tile| (ws.id(), tile.window().id().clone()))
+                    })
+                    .collect();
+
+                if let Some(focus) = focus.filter(|f| visible.iter().any(|(_, id)| id == f)) {
+                    self.move_window_to_scratchpad(Some(&focus));
+                    return;
+                }
+                if let Some((_, id)) = visible.iter().find(|(ws, _)| *ws == active_ws_id) {
+                    self.activate_window(id);
+                    return;
+                }
+                match visible.into_iter().next() {
+                    Some((_, id)) => id,
+                    None => match self.scratchpad.first() {
+                        Some(removed) => removed.tile.window().id().clone(),
+                        None => return,
+                    },
+                }
+            }
+        };
+
+        let Some(mut removed) = self.remove_window(&id, Transaction::new()) else {
+            return;
+        };
+        removed.tile.is_scratchpad = true;
+
+        self.active_monitor().unwrap().add_tile(
+            removed.tile,
+            MonitorAddWindowTarget::Auto,
+            ActivateWindow::Yes,
+            true,
+            removed.width,
+            removed.is_full_width,
+            true,
+            None,
+        );
+        self.start_open_animation_for_window(&id);
+    }
