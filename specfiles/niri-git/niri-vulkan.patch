@@ -0,0 +1,265 @@
+//! Multi-gpu [`GraphicsApi`] over GBM devices, rendering with Vulkan or OpenGL ES
+
+use std::{
+    collections::HashMap,
+    fmt,
+    os::unix::prelude::AsFd,
+    sync::atomic::{AtomicBool, Ordering},
+};
+
+use tracing::{info, warn};
+#[cfg(all(feature = "wayland_frontend", feature = "use_system_lib"))]
+use wayland_server::protocol::wl_buffer;
+
+use super::gbm::Error;
+use crate::backend::{
+    allocator::{
+        Allocator,
+        dmabuf::{AnyError, Dmabuf, DmabufAllocator},
+        gbm::{GbmAllocator, GbmBufferFlags, GbmDevice},
+    },
+    drm::DrmNode,
+    egl::{EGLContext, EGLDisplay, Error as EGLError, context::ContextPriority},
+    renderer::{
+        RendererSuper,
+        base::{BaseError, BaseRenderer},
+        gles::GlesRenderer,
+        multigpu::{ApiDevice, Error as MultiError, GraphicsApi},
+        vulkan::VulkanRenderer,
+    },
+};
+#[cfg(all(feature = "wayland_frontend", feature = "use_system_lib"))]
+use crate::{
+    backend::{
+        allocator::Buffer as BufferTrait,
+        egl::display::EGLBufferReader,
+        renderer::{
+            ImportEgl,
+            multigpu::{MultiRenderer, MultiTexture, import_dmabuf_internal},
+        },
+    },
+    utils::{Buffer as BufferCoords, Rectangle},
+};
+
+/// [`GraphicsApi`] creating a [`BaseRenderer`] per GBM device
+pub struct GbmBaseBackend<A: AsFd + 'static> {
+    devices: HashMap<DrmNode, (EGLDisplay, GbmAllocator<A>)>,
+    context_priority: Option<ContextPriority>,
+    allocator_flags: GbmBufferFlags,
+    prefer_vulkan: bool,
+    needs_enumeration: AtomicBool,
+}
+
+impl<A: AsFd + fmt::Debug + 'static> fmt::Debug for GbmBaseBackend<A> {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("GbmBaseBackend")
+            .field("devices", &self.devices)
+            .field("prefer_vulkan", &self.prefer_vulkan)
+            .finish()
+    }
+}
+
+impl<A: AsFd + Clone + Send + 'static> GbmBaseBackend<A> {
+    /// Create a backend; `prefer_vulkan` tries Vulkan first and falls back to GLES per device
+    pub fn new(prefer_vulkan: bool, priority: Option<ContextPriority>) -> Self {
+        GbmBaseBackend {
+            devices: HashMap::new(),
+            context_priority: priority,
+            allocator_flags: GbmBufferFlags::RENDERING,
+            prefer_vulkan,
+            needs_enumeration: AtomicBool::new(true),
+        }
+    }
+
+    /// Set the flags of the GBM allocators used for rendering
+    pub fn set_allocator_flags(&mut self, flags: GbmBufferFlags) {
+        self.allocator_flags = flags;
+    }
+
+    /// Add a new GBM device for a given node
+    pub fn add_node(&mut self, node: DrmNode, gbm: GbmDevice<A>) -> Result<(), EGLError> {
+        if self.devices.contains_key(&node) {
+            return Ok(());
+        }
+
+        let allocator = GbmAllocator::new(gbm.clone(), self.allocator_flags);
+        self.devices
+            .insert(node, (unsafe { EGLDisplay::new(gbm)? }, allocator));
+        self.needs_enumeration.store(true, Ordering::SeqCst);
+        Ok(())
+    }
+
+    /// Remove a given node
+    pub fn remove_node(&mut self, node: &DrmNode) {
+        if self.devices.remove(node).is_some() {
+            self.needs_enumeration.store(true, Ordering::SeqCst);
+        }
+    }
+
+    fn create_renderer(&self, node: &DrmNode, display: &EGLDisplay) -> Result<BaseRenderer, Error> {
+        if self.prefer_vulkan {
+            match VulkanRenderer::new(node) {
+                Ok(r) => {
+                    info!("Using Vulkan renderer for {node}: {}", r.device_name());
+                    return Ok(r.into());
+                }
+                Err(err) => warn!("Vulkan renderer unavailable for {node}, using GLES: {err}"),
+            }
+        }
+        let context = EGLContext::new_with_priority(display, self.context_priority.unwrap_or_default())?;
+        Ok(unsafe { GlesRenderer::new(context)? }.into())
+    }
+}
+
+impl<A: AsFd + Clone + Send + 'static> GraphicsApi for GbmBaseBackend<A> {
+    type Device = GbmBaseDevice;
+    type Error = Error;
+
+    fn enumerate(&self, list: &mut Vec<Self::Device>) -> Result<(), Self::Error> {
+        self.needs_enumeration.store(false, Ordering::SeqCst);
+
+        list.retain(|renderer| self.devices.keys().any(|node| renderer.node.dev_id() == node.dev_id()));
+
+        for (node, (display, gbm)) in &self.devices {
+            if list.iter().any(|renderer| renderer.node.dev_id() == node.dev_id()) {
+                continue;
+            }
+            match self.create_renderer(node, display) {
+                Ok(renderer) => list.push(GbmBaseDevice {
+                    node: *node,
+                    _display: display.clone(),
+                    renderer,
+                    allocator: Box::new(DmabufAllocator(gbm.clone())),
+                }),
+                Err(err) => warn!("Skipping GbmDevice: {}", err),
+            }
+        }
+
+        Ok(())
+    }
+
+    fn needs_enumeration(&self) -> bool {
+        self.needs_enumeration.load(Ordering::Acquire)
+    }
+
+    fn identifier() -> &'static str {
+        "gbm_base"
+    }
+}
+
+impl<A: AsFd + Clone + Send + 'static, T: GraphicsApi> From<BaseError> for MultiError<GbmBaseBackend<A>, T>
+where
+    T::Error: 'static,
+    <<T::Device as ApiDevice>::Renderer as RendererSuper>::Error: 'static,
+{
+    fn from(err: BaseError) -> Self {
+        MultiError::Render(err)
+    }
+}
+
+/// Device of a [`GbmBaseBackend`]
+pub struct GbmBaseDevice {
+    node: DrmNode,
+    renderer: BaseRenderer,
+    allocator: Box<dyn Allocator<Buffer = Dmabuf, Error = AnyError>>,
+    _display: EGLDisplay,
+}
+
+impl fmt::Debug for GbmBaseDevice {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("GbmBaseDevice")
+            .field("node", &self.node)
+            .field("renderer", &self.renderer)
+            .finish_non_exhaustive()
+    }
+}
+
+impl ApiDevice for GbmBaseDevice {
+    type Renderer = BaseRenderer;
+
+    fn renderer(&self) -> &BaseRenderer {
+        &self.renderer
+    }
+    fn renderer_mut(&mut self) -> &mut BaseRenderer {
+        &mut self.renderer
+    }
+    fn allocator(&mut self) -> &mut dyn Allocator<Buffer = Dmabuf, Error = AnyError> {
+        self.allocator.as_mut()
+    }
+    fn node(&self) -> &DrmNode {
+        &self.node
+    }
+    fn can_do_cross_device_imports(&self) -> bool {
+        !self.renderer.is_software()
+    }
+}
+
+#[cfg(all(feature = "wayland_frontend", feature = "use_system_lib"))]
+impl<A: AsFd + Clone + Send + 'static> ImportEgl for MultiRenderer<'_, '_, GbmBaseBackend<A>, GbmBaseBackend<A>> {
+    fn bind_wl_display(&mut self, display: &wayland_server::DisplayHandle) -> Result<(), EGLError> {
+        self.render.renderer_mut().bind_wl_display(display)
+    }
+    fn unbind_wl_display(&mut self) {
+        self.render.renderer_mut().unbind_wl_display()
+    }
+    fn egl_reader(&self) -> Option<&EGLBufferReader> {
+        self.render.renderer().egl_reader()
+    }
+
+    #[profiling::function]
+    fn import_egl_buffer(
+        &mut self,
+        buffer: &wl_buffer::WlBuffer,
+        surface: Option<&crate::wayland::compositor::SurfaceData>,
+        damage: &[Rectangle<i32, BufferCoords>],
+    ) -> Result<Self::TextureId, Self::Error> {
+        if let Some(dmabuf) = try_import_egl(self.render.renderer_mut(), buffer)
+            .or_else(|| {
+                self.target
+                    .as_mut()
+                    .and_then(|renderer| try_import_egl(renderer.device.renderer_mut(), buffer))
+            })
+            .or_else(|| {
+                self.other_renderers
+                    .iter_mut()
+                    .find_map(|renderer| try_import_egl(renderer.renderer_mut(), buffer))
+            })
+        {
+            let texture = MultiTexture::from_surface(surface, dmabuf.size(), dmabuf.format());
+            let texture_ref = texture.0.clone();
+            let res = import_dmabuf_internal(
+                self.render,
+                self.target.as_mut().map(|target| &mut *target.device),
+                &mut self.other_renderers,
+                &dmabuf,
+                texture,
+                Some(damage),
+            );
+            if res.is_ok() {
+                if let Some(surface) = surface {
+                    surface.data_map.insert_if_missing_threadsafe(|| texture_ref);
+                }
+            }
+            return res;
+        }
+
+        Err(MultiError::DeviceMissing)
+    }
+}
+
+#[cfg(all(feature = "wayland_frontend", feature = "use_system_lib"))]
+fn try_import_egl(renderer: &mut BaseRenderer, buffer: &wl_buffer::WlBuffer) -> Option<Dmabuf> {
+    let BaseRenderer::Gles(renderer) = renderer else {
+        return None;
+    };
+    if !renderer.extensions.iter().any(|ext| ext == "GL_OES_EGL_image") {
+        return None;
+    }
+    unsafe { renderer.egl_context().make_current().ok()? };
+    let egl = renderer.egl_reader()?.egl_buffer_contents(buffer).ok()?;
+    renderer
+        .egl_context()
+        .display()
+        .create_dmabuf_from_image(egl.image(0).unwrap(), egl.size, egl.y_inverted)
+        .ok()
+}
