+fn image_supported(dev: &Device, format: vk::Format, modifier: u64, usage: vk::ImageUsageFlags) -> bool {
+    let mut mod_info = vk::PhysicalDeviceImageDrmFormatModifierInfoEXT::default()
+        .drm_format_modifier(modifier)
+        .sharing_mode(vk::SharingMode::EXCLUSIVE);
+    let mut ext_info = vk::PhysicalDeviceExternalImageFormatInfo::default()
+        .handle_type(vk::ExternalMemoryHandleTypeFlags::DMA_BUF_EXT);
+    let info = vk::PhysicalDeviceImageFormatInfo2::default()
+        .format(format)
+        .ty(vk::ImageType::TYPE_2D)
+        .tiling(vk::ImageTiling::DRM_FORMAT_MODIFIER_EXT)
+        .usage(usage)
+        .push_next(&mut mod_info)
+        .push_next(&mut ext_info);
+    let mut ext_props = vk::ExternalImageFormatProperties::default();
+    let ok = {
+        let mut props = vk::ImageFormatProperties2::default().push_next(&mut ext_props);
+        unsafe {
+            dev.ih()
+                .get_physical_device_image_format_properties2(dev.phd.handle(), &info, &mut props)
+        }
+        .is_ok()
+    };
+    ok && ext_props
+        .external_memory_properties
+        .external_memory_features
+        .contains(vk::ExternalMemoryFeatureFlags::IMPORTABLE)
+}
+
+fn modifiers(dev: &Device, format: vk::Format) -> Vec<vk::DrmFormatModifierPropertiesEXT> {
+    let (ih, pd) = (dev.ih(), dev.phd.handle());
+    let mut list = vk::DrmFormatModifierPropertiesListEXT::default();
+    unsafe {
+        ih.get_physical_device_format_properties2(pd, format, &mut vk::FormatProperties2::default().push_next(&mut list))
+    };
+    let mut mods = vec![vk::DrmFormatModifierPropertiesEXT::default(); list.drm_format_modifier_count as usize];
+    let n = {
+        let mut list = vk::DrmFormatModifierPropertiesListEXT::default().drm_format_modifier_properties(&mut mods);
+        unsafe {
+            ih.get_physical_device_format_properties2(
+                pd,
+                format,
+                &mut vk::FormatProperties2::default().push_next(&mut list),
+            )
+        };
+        list.drm_format_modifier_count as usize
+    };
+    mods.truncate(n);
+    mods
+}
+
+pub(super) fn dmabuf_formats(dev: &Device) -> (FormatSet, FormatSet) {
+    use vk::FormatFeatureFlags as F;
+    use vk::ImageUsageFlags as U;
+    let mut tex = Vec::new();
+    let mut render = Vec::new();
+    for &code in FOURCCS {
+        let format = vk_format(code).unwrap();
+        for m in modifiers(dev, format) {
+            let feats = m.drm_format_modifier_tiling_features;
+            let mod_ = m.drm_format_modifier;
+            if !feats.contains(F::SAMPLED_IMAGE) || !image_supported(dev, format, mod_, U::SAMPLED) {
+                continue;
+            }
+            let f = Format {
+                code,
+                modifier: Modifier::from(mod_),
+            };
+            tex.push(f);
+            if feats.contains(F::COLOR_ATTACHMENT | F::COLOR_ATTACHMENT_BLEND)
+                && image_supported(dev, format, mod_, U::SAMPLED | U::COLOR_ATTACHMENT)
+            {
+                render.push(f);
+            }
+        }
+    }
+    (tex.into_iter().collect(), render.into_iter().collect())
+}
+
+fn inode(fd: std::os::fd::BorrowedFd<'_>) -> Option<(u64, u64)> {
+    rustix::fs::fstat(fd).ok().map(|s| (s.st_dev as u64, s.st_ino as u64))
+}
+
+fn import_dmabuf_image(dev: &Arc<Device>, dmabuf: &Dmabuf, renderable: bool) -> Result<TexInner, VulkanError> {
+    if dmabuf.format().modifier == Modifier::Invalid {
+        return Err(VulkanError::Unsupported("dmabuf without modifier"));
+    }
+    let fmt = dmabuf.format();
+    let mut t = TexInner::bare(dev, fmt.code, dmabuf.size(), dmabuf.y_inverted())?;
+    let first = dmabuf.handles().next().ok_or(VulkanError::Unsupported("dmabuf without planes"))?;
+    let ino = inode(first);
+    if ino.is_none() || dmabuf.handles().any(|h| inode(h) != ino) {
+        return Err(VulkanError::Unsupported("disjoint dmabuf"));
+    }
+    let layouts: Vec<_> = dmabuf
+        .offsets()
+        .zip(dmabuf.strides())
+        .map(|(offset, stride)| vk::SubresourceLayout {
+            offset: offset as u64,
+            size: 0,
+            row_pitch: stride as u64,
+            array_pitch: 0,
+            depth_pitch: 0,
+        })
+        .collect();
+    let mut usage = vk::ImageUsageFlags::SAMPLED;
+    if renderable {
+        usage |= vk::ImageUsageFlags::COLOR_ATTACHMENT;
+    }
+    let mut ext_ci =
+        vk::ExternalMemoryImageCreateInfo::default().handle_types(vk::ExternalMemoryHandleTypeFlags::DMA_BUF_EXT);
+    let mut mod_ci = vk::ImageDrmFormatModifierExplicitCreateInfoEXT::default()
+        .drm_format_modifier(u64::from(fmt.modifier))
+        .plane_layouts(&layouts);
+    let ext = t.extent();
+    let raw = &dev.raw;
+    t.image = unsafe {
+        raw.create_image(
+            &vk::ImageCreateInfo::default()
+                .image_type(vk::ImageType::TYPE_2D)
+                .format(t.format)
+                .extent(vk::Extent3D {
+                    width: ext.width,
+                    height: ext.height,
+                    depth: 1,
+                })
+                .mip_levels(1)
+                .array_layers(1)
+                .samples(vk::SampleCountFlags::TYPE_1)
+                .tiling(vk::ImageTiling::DRM_FORMAT_MODIFIER_EXT)
+                .usage(usage)
+                .sharing_mode(vk::SharingMode::EXCLUSIVE)
+                .initial_layout(vk::ImageLayout::UNDEFINED)
+                .push_next(&mut ext_ci)
+                .push_next(&mut mod_ci),
+            None,
+        )
+    }?;
+    let req = unsafe { raw.get_image_memory_requirements(t.image) };
+    let fd = first.try_clone_to_owned().map_err(|_| VulkanError::Unsupported("dup"))?;
+    let mut fd_props = vk::MemoryFdPropertiesKHR::default();
+    unsafe {
+        dev.mem_fd.get_memory_fd_properties(
+            vk::ExternalMemoryHandleTypeFlags::DMA_BUF_EXT,
+            fd.as_raw_fd(),
+            &mut fd_props,
+        )
+    }?;
+    let ty = dev
+        .mem_type(req.memory_type_bits & fd_props.memory_type_bits, vk::MemoryPropertyFlags::empty())
+        .ok_or(VulkanError::Unsupported("dmabuf memory type"))?;
+    let mut import = vk::ImportMemoryFdInfoKHR::default()
+        .handle_type(vk::ExternalMemoryHandleTypeFlags::DMA_BUF_EXT)
+        .fd(fd.as_raw_fd());
+    let mut dedicated = vk::MemoryDedicatedAllocateInfo::default().image(t.image);
+    t.memory = unsafe {
+        raw.allocate_memory(
+            &vk::MemoryAllocateInfo::default()
+                .allocation_size(req.size)
+                .memory_type_index(ty)
+                .push_next(&mut import)
+                .push_next(&mut dedicated),
+            None,
+        )
+    }?;
+    let _ = fd.into_raw_fd();
+    unsafe { raw.bind_image_memory(t.image, t.memory, 0) }?;
+    t.make_views(renderable)?;
+    t.foreign = Some(first.try_clone_to_owned().map_err(|_| VulkanError::Unsupported("dup"))?);
+    Ok(t)
+}
+
+/// Pixels read back from a texture
+#[derive(Debug)]
+pub struct VulkanMapping {
+    buf: Arc<HostBuf>,
+    serial: u64,
+    size: Size<i32, BufferCoord>,
+    fourcc: Fourcc,
+}
+
+impl Texture for VulkanMapping {
+    fn width(&self) -> u32 {
+        self.size.w as u32
+    }
+    fn height(&self) -> u32 {
+        self.size.h as u32
+    }
+    fn format(&self) -> Option<Fourcc> {
+        Some(self.fourcc)
+    }
+}
+
+impl TextureMapping for VulkanMapping {
+    fn flipped(&self) -> bool {
+        true
+    }
+}
+
+impl VulkanRenderer {
+    fn import_dmabuf_cached(&mut self, dmabuf: &Dmabuf) -> Result<VulkanTexture, VulkanError> {
+        if let Some(t) = self.dmabuf_cache.get(&dmabuf.weak()) {
+            return Ok(t.clone());
+        }
+        let renderable = self.render_formats.contains(&dmabuf.format());
+        let tex = VulkanTexture(Arc::new(import_dmabuf_image(&self.dev, dmabuf, renderable)?));
+        self.dmabuf_cache.insert(dmabuf.weak(), tex.clone());
+        Ok(tex)
+    }
+
+    fn readback(
+        &mut self,
+        src: &Arc<TexInner>,
+        region: Rectangle<i32, BufferCoord>,
+        format: Fourcc,
+    ) -> Result<VulkanMapping, VulkanError> {
+        let bpp = get_bpp(format).ok_or(VulkanError::Format(format))? / 8;
+        let region = region
+            .intersection(Rectangle::from_size(src.size))
+            .ok_or(VulkanError::Unsupported("empty region"))?;
+        let tmp = Arc::new(TexInner::new_own(&self.dev, format, region.size, false)?);
+        let (w, h) = (region.size.w as f32, region.size.h as f32);
+        let (sw, sh) = (src.size.w as f32, src.size.h as f32);
+        let tex_matrix = Mat3::from_cols_array(&[
+            1. / sw,
+            0.,
+            0.,
+            0.,
+            1. / sh,
+            0.,
+            region.loc.x as f32 / sw,
+            region.loc.y as f32 / sh,
+            1.,
+        ]);
+        let matrix = Mat3::from_cols_array(&[2. / w, 0., 0., 0., 2. / h, 0., -1., -1., 1.]);
+        let prog = self.tex_prog.0.clone();
+        self.draw(
+            &tmp,
+            tmp.extent(),
+            &prog,
+            matrix,
+            tex_matrix,
+            &[[0., 0., w, h]],
+            false,
+            &[&[Uniform::new("alpha", 1.0f32), Uniform::new("tint", 0.0f32)]],
+            &[("tex", src, 0)],
+        )?;
+        let cb = self.use_tex(&tmp, vk::ImageLayout::TRANSFER_SRC_OPTIMAL, true)?;
+        let len = region.size.w as u64 * region.size.h as u64 * bpp as u64;
+        let buf = Arc::new(HostBuf::new(&self.dev, len)?);
+        let barrier = vk::BufferMemoryBarrier2::default()
+            .src_stage_mask(vk::PipelineStageFlags2::ALL_TRANSFER)
+            .src_access_mask(vk::AccessFlags2::TRANSFER_WRITE)
+            .dst_stage_mask(vk::PipelineStageFlags2::HOST)
+            .dst_access_mask(vk::AccessFlags2::HOST_READ)
+            .src_queue_family_index(vk::QUEUE_FAMILY_IGNORED)
+            .dst_queue_family_index(vk::QUEUE_FAMILY_IGNORED)
+            .buffer(buf.buf)
+            .size(vk::WHOLE_SIZE);
+        unsafe {
+            let raw = &self.dev.raw;
+            raw.cmd_copy_image_to_buffer(
+                cb,
+                tmp.image,
+                vk::ImageLayout::TRANSFER_SRC_OPTIMAL,
+                buf.buf,
+                &[vk::BufferImageCopy {
+                    buffer_offset: 0,
+                    buffer_row_length: 0,
+                    buffer_image_height: 0,
+                    image_subresource: COLOR_LAYERS,
+                    image_offset: vk::Offset3D::default(),
+                    image_extent: vk::Extent3D {
+                        width: region.size.w as u32,
+                        height: region.size.h as u32,
+                        depth: 1,
+                    },
+                }],
+            );
+            raw.cmd_pipeline_barrier2(cb, &vk::DependencyInfo::default().buffer_memory_barriers(&[barrier]));
+        }
+        self.rec.bufs.push(buf.clone());
+        Ok(VulkanMapping {
+            buf,
+            serial: self.rec.serial,
+            size: region.size,
+            fourcc: format,
+        })
+    }
+}
+
+impl ImportMem for VulkanRenderer {
+    fn import_memory(
+        &mut self,
+        data: &[u8],
+        format: Fourcc,
+        size: Size<i32, BufferCoord>,
+        flipped: bool,
+    ) -> Result<VulkanTexture, VulkanError> {
+        if !self.mem_formats.contains(&format) {
+            return Err(VulkanError::Format(format));
+        }
+        let stride = size.w.max(0) as usize * (get_bpp(format).unwrap() / 8);
+        if data.len() < stride * size.h.max(0) as usize {
+            return Err(VulkanError::Unsupported("buffer too small"));
+        }
+        let tex = Arc::new(TexInner::new_own(&self.dev, format, size, flipped)?);
+        self.upload(&tex, data, stride, &[Rectangle::from_size(size)])?;
+        Ok(VulkanTexture(tex))
+    }
+
+    fn update_memory(
+        &mut self,
+        texture: &VulkanTexture,
+        data: &[u8],
+        region: Rectangle<i32, BufferCoord>,
+    ) -> Result<(), VulkanError> {
+        let t = &texture.0;
+        if t.foreign.is_some() {
+            return Err(VulkanError::Unsupported("update of imported texture"));
+        }
+        let stride = t.size.w as usize * (get_bpp(t.fourcc).unwrap() / 8);
+        if data.len() < stride * t.size.h as usize {
+            return Err(VulkanError::Unsupported("buffer too small"));
+        }
+        let Some(region) = region.intersection(Rectangle::from_size(t.size)) else {
+            return Ok(());
+        };
+        self.upload(t, data, stride, &[region])
+    }
+
+    fn mem_formats(&self) -> Box<dyn Iterator<Item = Fourcc>> {
+        Box::new(self.mem_formats.clone().into_iter())
+    }
+}
+
+#[cfg(feature = "wayland_frontend")]
+impl ImportMemWl for VulkanRenderer {
+    fn import_shm_buffer(
+        &mut self,
+        buffer: &wl_buffer::WlBuffer,
+        surface: Option<&SurfaceData>,
+        damage: &[Rectangle<i32, BufferCoord>],
+    ) -> Result<VulkanTexture, VulkanError> {
+        type Cache = HashMap<ContextId<VulkanTexture>, VulkanTexture>;
+        let mut cache = surface.map(|s| {
+            s.data_map
+                .get_or_insert_threadsafe(|| Arc::new(Mutex::new(Cache::new())))
+                .lock()
+                .unwrap()
+        });
+        with_buffer_contents(buffer, |ptr, len, data| {
+            let fourcc = shm_format_to_fourcc(data.format)
+                .filter(|f| self.mem_formats.contains(f))
+                .ok_or(VulkanError::Unsupported("shm format"))?;
+            let bpp = get_bpp(fourcc).unwrap() / 8;
+            let (off, w, h, stride) = (data.offset, data.width, data.height, data.stride);
+            if off < 0
+                || w <= 0
+                || h <= 0
+                || (stride as usize) < w as usize * bpp
+                || off as usize + (h as usize - 1) * stride as usize + w as usize * bpp > len
+            {
+                return Err(VulkanError::Unsupported("invalid shm buffer"));
+            }
+            let pixels = unsafe { std::slice::from_raw_parts(ptr.add(off as usize), len - off as usize) };
+            let size = Size::from((w, h));
+            let id = self.context_id();
+            let existing = cache
+                .as_ref()
+                .and_then(|c| c.get(&id).cloned())
+                .filter(|t| t.0.size == size && t.0.fourcc == fourcc);
+            let full = existing.is_none() || damage.is_empty();
+            let tex = match existing {
+                Some(t) => t,
+                None => VulkanTexture(Arc::new(TexInner::new_own(&self.dev, fourcc, size, false)?)),
+            };
+            let bounds = Rectangle::from_size(size);
+            let rects: Vec<_> = if full {
+                vec![bounds]
+            } else {
+                damage.iter().filter_map(|r| r.intersection(bounds)).collect()
+            };
+            self.upload(&tex.0, pixels, stride as usize, &rects)?;
+            if let Some(c) = cache.as_mut() {
+                c.insert(id, tex.clone());
+            }
+            Ok(tex)
+        })?
+    }
+}
+
+impl ImportDma for VulkanRenderer {
+    fn dmabuf_formats(&self) -> FormatSet {
+        self.tex_formats.clone()
+    }
+
+    fn import_dmabuf(
+        &mut self,
+        dmabuf: &Dmabuf,
+        _damage: Option<&[Rectangle<i32, BufferCoord>]>,
+    ) -> Result<VulkanTexture, VulkanError> {
+        self.import_dmabuf_cached(dmabuf)
+    }
+}
+
+#[cfg(feature = "wayland_frontend")]
+impl ImportDmaWl for VulkanRenderer {}
+
+#[cfg(all(feature = "wayland_frontend", feature = "backend_egl", feature = "use_system_lib"))]
+impl crate::backend::renderer::ImportEgl for VulkanRenderer {
+    fn bind_wl_display(
+        &mut self,
+        _display: &wayland_server::DisplayHandle,
+    ) -> Result<(), crate::backend::egl::Error> {
+        Err(crate::backend::egl::Error::DisplayNotSupported)
+    }
+
+    fn unbind_wl_display(&mut self) {}
+
+    fn egl_reader(&self) -> Option<&crate::backend::egl::display::EGLBufferReader> {
+        None
+    }
+
+    fn import_egl_buffer(
+        &mut self,
+        _buffer: &wl_buffer::WlBuffer,
+        _surface: Option<&SurfaceData>,
+        _damage: &[Rectangle<i32, BufferCoord>],
+    ) -> Result<VulkanTexture, VulkanError> {
+        Err(VulkanError::Unsupported("EGL buffers"))
+    }
+}
+
+impl ExportMem for VulkanRenderer {
+    type TextureMapping = VulkanMapping;
+
+    fn copy_framebuffer(
+        &mut self,
+        target: &VulkanTarget<'_>,
+        region: Rectangle<i32, BufferCoord>,
+        format: Fourcc,
+    ) -> Result<VulkanMapping, VulkanError> {
+        let src = target.0.0.clone();
+        self.readback(&src, region, format)
+    }
+
+    fn copy_texture(
+        &mut self,
+        texture: &VulkanTexture,
+        region: Rectangle<i32, BufferCoord>,
+        format: Fourcc,
+    ) -> Result<VulkanMapping, VulkanError> {
+        let src = texture.0.clone();
+        self.readback(&src, region, format)
+    }
+
+    fn can_read_texture(&mut self, _texture: &VulkanTexture) -> Result<bool, VulkanError> {
+        Ok(true)
+    }
+
+    fn map_texture<'a>(&mut self, mapping: &'a VulkanMapping) -> Result<&'a [u8], VulkanError> {
+        if mapping.serial == self.rec.serial {
+            let _ = self.submit()?;
+        }
+        self.wait_serial(mapping.serial)?;
+        let len = mapping.size.w as usize * mapping.size.h as usize * (get_bpp(mapping.fourcc).unwrap() / 8);
+        Ok(unsafe { std::slice::from_raw_parts(mapping.buf.ptr, len) })
+    }
+}
+
+impl Bind<VulkanTexture> for VulkanRenderer {
+    fn bind<'a>(&mut self, target: &'a mut VulkanTexture) -> Result<VulkanTarget<'a>, VulkanError> {
+        if target.0.att_view == vk::ImageView::null() {
+            return Err(VulkanError::Unsupported("texture is not renderable"));
+        }
+        Ok(VulkanTarget(target.clone(), PhantomData))
+    }
+}
+
+impl Bind<Dmabuf> for VulkanRenderer {
+    fn bind<'a>(&mut self, target: &'a mut Dmabuf) -> Result<VulkanTarget<'a>, VulkanError> {
+        let tex = self.import_dmabuf_cached(target)?;
+        if tex.0.att_view == vk::ImageView::null() {
+            return Err(VulkanError::Unsupported("dmabuf is not renderable"));
+        }
+        Ok(VulkanTarget(tex, PhantomData))
+    }
+
+    fn supported_formats(&self) -> Option<FormatSet> {
+        Some(self.render_formats.clone())
+    }
+}
+
+impl Offscreen<VulkanTexture> for VulkanRenderer {
+    fn create_buffer(&mut self, format: Fourcc, size: Size<i32, BufferCoord>) -> Result<VulkanTexture, VulkanError> {
+        self.create_texture(format, size)
+    }
+}
