+pub(super) const VERT_SRC: &str = r#"#version 450
+layout(push_constant) uniform PC { mat3 matrix; mat3 tex_matrix; } pc;
+layout(location = 0) in vec4 inst;
+layout(location = 0) out vec2 v_coords;
+void main() {
+    vec2 vert = vec2(float(gl_VertexIndex & 1), float(gl_VertexIndex >> 1));
+    vec3 position = vec3(vert * inst.zw + inst.xy, 1.0);
+    v_coords = (pc.tex_matrix * position).xy;
+    gl_Position = vec4((pc.matrix * position).xy, 0.0, 1.0);
+}
+"#;
+
+pub(super) fn translate(src: &str, defines: &[&str]) -> String {
+    let defs: String = defines.iter().map(|d| format!("#define {d}\n")).collect();
+    let src = if src.contains("//_DEFINES_") {
+        src.replacen("//_DEFINES_", &defs, 1)
+    } else {
+        format!("{defs}{src}")
+    };
+    format!(
+        "#version 140\n{}",
+        src.replace("#version 100", "").replace("texture2D(", "texture(")
+    )
+}
+
+pub(super) fn compile(src: &str, frag: bool) -> Result<Vec<u32>, String> {
+    unsafe {
+        let c = shaderc_compiler_initialize();
+        let o = shaderc_compile_options_initialize();
+        if c.is_null() || o.is_null() {
+            return Err("shaderc init failed".into());
+        }
+        shaderc_compile_options_set_target_env(o, 0, (1 << 22) | (3 << 12));
+        shaderc_compile_options_set_auto_bind_uniforms(o, true);
+        shaderc_compile_options_set_auto_map_locations(o, true);
+        shaderc_compile_options_set_vulkan_rules_relaxed(o, true);
+        let r = shaderc_compile_into_spv(
+            c,
+            src.as_ptr().cast(),
+            src.len(),
+            frag as c_int,
+            c"shader".as_ptr(),
+            c"main".as_ptr(),
+            o,
+        );
+        let res = if r.is_null() {
+            Err("shaderc returned null".into())
+        } else if shaderc_result_get_compilation_status(r) == 0 {
+            let bytes =
+                std::slice::from_raw_parts(shaderc_result_get_bytes(r).cast::<u8>(), shaderc_result_get_length(r));
+            Ok(bytes
+                .chunks_exact(4)
+                .map(|w| u32::from_ne_bytes(w.try_into().unwrap()))
+                .collect())
+        } else {
+            Err(CStr::from_ptr(shaderc_result_get_error_message(r))
+                .to_string_lossy()
+                .into_owned())
+        };
+        if !r.is_null() {
+            shaderc_result_release(r);
+        }
+        shaderc_compile_options_release(o);
+        shaderc_compiler_release(c);
+        res
+    }
+}
+
+#[derive(Debug, Default)]
+pub(super) struct Reflection {
+    pub ubo: Option<(u32, u32)>,
+    pub members: HashMap<String, (u32, u32)>,
+    pub samplers: HashMap<String, u32>,
+}
+
+fn spv_str(words: &[u32]) -> String {
+    let bytes: Vec<u8> = words.iter().flat_map(|w| w.to_le_bytes()).take_while(|b| *b != 0).collect();
+    String::from_utf8_lossy(&bytes).into_owned()
+}
+
+pub(super) fn reflect(spv: &[u32]) -> Reflection {
+    let mut names = HashMap::new();
+    let mut member_names = Vec::new();
+    let mut bindings = HashMap::new();
+    let mut offsets = HashMap::new();
+    let mut strides = HashMap::new();
+    let mut pointers = HashMap::new();
+    let mut vars = Vec::new();
+    let mut i = 5;
+    while i < spv.len() {
+        let n = (spv[i] >> 16) as usize;
+        if n == 0 || i + n > spv.len() {
+            break;
+        }
+        let ins = &spv[i..i + n];
+        match (spv[i] & 0xffff, n) {
+            (5, 3..) => {
+                names.insert(ins[1], spv_str(&ins[2..]));
+            }
+            (6, 4..) => member_names.push((ins[1], ins[2], spv_str(&ins[3..]))),
+            (71, 4..) if ins[2] == 33 => {
+                bindings.insert(ins[1], ins[3]);
+            }
+            (72, 5..) if ins[3] == 35 => {
+                offsets.insert((ins[1], ins[2]), ins[4]);
+            }
+            (72, 5..) if ins[3] == 7 => {
+                strides.insert((ins[1], ins[2]), ins[4]);
+            }
+            (32, 4..) => {
+                pointers.insert(ins[1], ins[3]);
+            }
+            (59, 4..) => vars.push((ins[1], ins[2], ins[3])),
+            _ => {}
+        }
+        i += n;
+    }
+
+    let mut r = Reflection::default();
+    for (ty, id, class) in vars {
+        let Some(&binding) = bindings.get(&id) else { continue };
+        match class {
+            0 => {
+                if let Some(name) = names.get(&id) {
+                    r.samplers.insert(name.clone(), binding);
+                }
+            }
+            2 => {
+                let Some(&st) = pointers.get(&ty) else { continue };
+                let mut size = 0;
+                for (s, m, name) in &member_names {
+                    if *s != st {
+                        continue;
+                    }
+                    if let Some(&off) = offsets.get(&(*s, *m)) {
+                        size = size.max(off + 64);
+                        r.members
+                            .insert(name.clone(), (off, strides.get(&(*s, *m)).copied().unwrap_or(16)));
+                    }
+                }
+                r.ubo = Some((binding, size));
+            }
+            _ => {}
+        }
+    }
+    r
+}
+
+pub(super) fn write_uniform(buf: &mut [u8], (off, stride): (u32, u32), v: &UniformValue) {
+    let (off, stride) = (off as usize, stride as usize);
+    let mut put = |at: usize, w: u32| {
+        if let Some(d) = buf.get_mut(off + at..off + at + 4) {
+            d.copy_from_slice(&w.to_ne_bytes());
+        }
+    };
+    macro_rules! mat {
+        ($m:expr, $t:expr, $c:literal, $r:literal) => {
+            if let Some(m) = $m.first() {
+                for c in 0..$c {
+                    for r in 0..$r {
+                        let v = if $t { m[r * $c + c] } else { m[c * $r + r] };
+                        put(c * stride + r * 4, v.to_bits());
+                    }
+                }
+            }
+        };
+    }
+    use UniformValue::*;
+    let f = |v: &[f32]| v.iter().map(|x| x.to_bits()).collect::<Vec<_>>();
+    let words = match v {
+        _1f(a) => f(&[*a]),
+        _2f(a, b) => f(&[*a, *b]),
+        _3f(a, b, c) => f(&[*a, *b, *c]),
+        _4f(a, b, c, d) => f(&[*a, *b, *c, *d]),
+        _1i(a) => vec![*a as u32],
+        _2i(a, b) => vec![*a as u32, *b as u32],
+        _3i(a, b, c) => vec![*a as u32, *b as u32, *c as u32],
+        _4i(a, b, c, d) => vec![*a as u32, *b as u32, *c as u32, *d as u32],
+        _1ui(a) => vec![*a],
+        _2ui(a, b) => vec![*a, *b],
+        _3ui(a, b, c) => vec![*a, *b, *c],
+        _4ui(a, b, c, d) => vec![*a, *b, *c, *d],
+        Matrix2x2 { matrices, transpose } => {
+            mat!(matrices, *transpose, 2, 2);
+            return;
+        }
+        Matrix2x3 { matrices, transpose } => {
+            mat!(matrices, *transpose, 2, 3);
+            return;
+        }
+        Matrix2x4 { matrices, transpose } => {
+            mat!(matrices, *transpose, 2, 4);
+            return;
+        }
+        Matrix3x2 { matrices, transpose } => {
+            mat!(matrices, *transpose, 3, 2);
+            return;
+        }
+        Matrix3x3 { matrices, transpose } => {
+            mat!(matrices, *transpose, 3, 3);
+            return;
+        }
+        Matrix3x4 { matrices, transpose } => {
+            mat!(matrices, *transpose, 3, 4);
+            return;
+        }
+        Matrix4x2 { matrices, transpose } => {
+            mat!(matrices, *transpose, 4, 2);
+            return;
+        }
+        Matrix4x3 { matrices, transpose } => {
+            mat!(matrices, *transpose, 4, 3);
+            return;
+        }
+        Matrix4x4 { matrices, transpose } => {
+            mat!(matrices, *transpose, 4, 4);
+            return;
+        }
+    };
+    for (i, w) in words.into_iter().enumerate() {
+        put(i * 4, w);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn compile_and_reflect() {
+        let src = translate(
+            include_str!("../gles/shaders/implicit/texture.frag"),
+            &["DEBUG_FLAGS"],
+        );
+        let spv = compile(&src, true).unwrap();
+        let r = reflect(&spv);
+        assert!(r.samplers.contains_key("tex"));
+        assert!(r.members.contains_key("alpha") && r.members.contains_key("tint"));
+        compile(VERT_SRC, false).unwrap();
+
+        let mut buf = vec![0u8; 64];
+        let m = UniformValue::Matrix3x3 {
+            matrices: vec![[1., 2., 3., 4., 5., 6., 7., 8., 9.]],
+            transpose: false,
+        };
+        write_uniform(&mut buf, (0, 16), &m);
+        let w = |i: usize| f32::from_ne_bytes(buf[i * 4..i * 4 + 4].try_into().unwrap());
+        assert_eq!((w(0), w(2), w(4), w(10)), (1., 3., 4., 9.));
+    }
+}
