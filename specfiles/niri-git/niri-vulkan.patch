diff --git a/smithay/src/backend/renderer/base.rs b/smithay/src/backend/renderer/base.rs
new file mode 100644
index 0000000..45a6238
--- /dev/null
+++ b/smithay/src/backend/renderer/base.rs
@@ -0,0 +1,655 @@
+//! Runtime choice between [`GlesRenderer`] and [`VulkanRenderer`]
+
+use std::fmt;
+
+use super::{
+    Bind, Color32F, ContextId, DebugFlags, ExportMem, Frame, FrameContext, ImportDma, ImportMem, Offscreen,
+    Renderer, RendererSuper, Texture, TextureFilter, TextureMapping,
+    gles::{
+        GlesError, GlesFrame, GlesMapping, GlesRenderer, GlesTarget, GlesTexProgram, GlesTexture, Uniform,
+        UniformName, profiler::SpanLocation,
+    },
+    sync::SyncPoint,
+    vulkan::{VulkanError, VulkanFrame, VulkanMapping, VulkanProgram, VulkanRenderer, VulkanTarget, VulkanTexture},
+};
+use crate::{
+    backend::{
+        SwapBuffersError,
+        allocator::{Format, Fourcc, dmabuf::Dmabuf, format::FormatSet},
+        egl::EGLSurface,
+    },
+    utils::{Buffer as BufferCoord, Physical, Rectangle, Size, Transform},
+};
+#[cfg(feature = "wayland_frontend")]
+use super::{ImportDmaWl, ImportMemWl};
+#[cfg(feature = "wayland_frontend")]
+use crate::wayland::compositor::SurfaceData;
+#[cfg(feature = "wayland_frontend")]
+use wayland_server::protocol::wl_buffer;
+
+/// Either a [`GlesRenderer`] or a [`VulkanRenderer`]
+#[allow(clippy::large_enum_variant)]
+pub enum BaseRenderer {
+    /// OpenGL ES
+    Gles(GlesRenderer),
+    /// Vulkan
+    Vulkan(VulkanRenderer),
+}
+
+/// Texture of a [`BaseRenderer`]
+#[derive(Debug, Clone)]
+pub enum BaseTexture {
+    /// OpenGL ES
+    Gles(GlesTexture),
+    /// Vulkan
+    Vulkan(VulkanTexture),
+}
+
+/// Framebuffer of a [`BaseRenderer`]
+#[derive(Debug)]
+pub enum BaseTarget<'a> {
+    /// OpenGL ES
+    Gles(GlesTarget<'a>),
+    /// Vulkan
+    Vulkan(VulkanTarget<'a>),
+}
+
+/// Frame of a [`BaseRenderer`]
+#[derive(Debug)]
+pub enum BaseFrame<'frame, 'buffer> {
+    /// OpenGL ES
+    Gles(GlesFrame<'frame, 'buffer>),
+    /// Vulkan
+    Vulkan(VulkanFrame<'frame, 'buffer>),
+}
+
+/// Memory mapping of a [`BaseRenderer`]
+#[derive(Debug)]
+pub enum BaseMapping {
+    /// OpenGL ES
+    Gles(GlesMapping),
+    /// Vulkan
+    Vulkan(VulkanMapping),
+}
+
+/// Texture shader program of a [`BaseRenderer`]
+#[derive(Debug, Clone)]
+pub enum BaseTexProgram {
+    /// OpenGL ES
+    Gles(GlesTexProgram),
+    /// Vulkan
+    Vulkan(VulkanProgram),
+}
+
+/// Error of a [`BaseRenderer`]
+#[derive(Debug, thiserror::Error)]
+pub enum BaseError {
+    /// OpenGL ES
+    #[error(transparent)]
+    Gles(#[from] GlesError),
+    /// Vulkan
+    #[error(transparent)]
+    Vulkan(#[from] VulkanError),
+    /// Object belongs to the other backend
+    #[error("object belongs to a different renderer backend")]
+    Mismatch,
+}
+
+impl From<BaseError> for SwapBuffersError {
+    fn from(err: BaseError) -> Self {
+        match err {
+            BaseError::Gles(e) => e.into(),
+            BaseError::Vulkan(e) => e.into(),
+            e @ BaseError::Mismatch => SwapBuffersError::ContextLost(Box::new(e)),
+        }
+    }
+}
+
+macro_rules! each {
+    ($ty:ident, $e:expr, $v:ident => $body:expr) => {
+        match $e {
+            $ty::Gles($v) => $body,
+            $ty::Vulkan($v) => $body,
+        }
+    };
+}
+
+macro_rules! wrap {
+    ($e:expr, $out:ident, $v:ident => $body:expr) => {
+        match $e {
+            BaseRenderer::Gles($v) => Ok($out::Gles($body?)),
+            BaseRenderer::Vulkan($v) => Ok($out::Vulkan($body?)),
+        }
+    };
+}
+
+impl fmt::Debug for BaseRenderer {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        each!(Self, self, r => r.fmt(f))
+    }
+}
+
+impl From<GlesRenderer> for BaseRenderer {
+    fn from(r: GlesRenderer) -> Self {
+        Self::Gles(r)
+    }
+}
+
+impl From<VulkanRenderer> for BaseRenderer {
+    fn from(r: VulkanRenderer) -> Self {
+        Self::Vulkan(r)
+    }
+}
+
+impl BaseRenderer {
+    /// The GLES renderer, if this is one
+    pub fn gles(&mut self) -> Option<&mut GlesRenderer> {
+        match self {
+            Self::Gles(r) => Some(r),
+            Self::Vulkan(_) => None,
+        }
+    }
+
+    /// The Vulkan renderer, if this is one
+    pub fn vulkan(&mut self) -> Option<&mut VulkanRenderer> {
+        match self {
+            Self::Vulkan(r) => Some(r),
+            Self::Gles(_) => None,
+        }
+    }
+
+    /// Per-renderer user data
+    pub fn user_data(&self) -> &crate::utils::user_data::UserDataMap {
+        match self {
+            Self::Gles(r) => r.egl_context().user_data(),
+            Self::Vulkan(r) => r.user_data(),
+        }
+    }
+
+    /// Formats renderable through dmabufs
+    pub fn dmabuf_render_formats(&self) -> FormatSet {
+        match self {
+            Self::Gles(r) => r.egl_context().dmabuf_render_formats().clone(),
+            Self::Vulkan(r) => r.dmabuf_render_formats().clone(),
+        }
+    }
+
+    /// Compile a custom texture shader
+    pub fn compile_custom_texture_shader(
+        &mut self,
+        shader: impl AsRef<str>,
+        additional_uniforms: &[UniformName<'_>],
+    ) -> Result<BaseTexProgram, BaseError> {
+        wrap!(self, BaseTexProgram, r => r.compile_custom_texture_shader(shader, additional_uniforms))
+    }
+
+    /// Whether this is a software renderer
+    pub fn is_software(&self) -> bool {
+        match self {
+            Self::Gles(r) => r.is_software(),
+            Self::Vulkan(_) => false,
+        }
+    }
+}
+
+impl BaseTexture {
+    /// Whether no other reference to this texture exists
+    pub fn is_unique_reference(&mut self) -> bool {
+        each!(Self, self, t => t.is_unique_reference())
+    }
+}
+
+impl BaseFrame<'_, '_> {
+    /// Per-renderer user data
+    pub fn user_data(&self) -> &crate::utils::user_data::UserDataMap {
+        match self {
+            Self::Gles(f) => f.egl_context().user_data(),
+            Self::Vulkan(f) => f.user_data(),
+        }
+    }
+
+    /// Replace the default texture program for the rest of this frame
+    pub fn override_default_tex_program(&mut self, program: BaseTexProgram, uniforms: Vec<Uniform<'static>>) {
+        match (self, program) {
+            (Self::Gles(f), BaseTexProgram::Gles(p)) => f.override_default_tex_program(p, uniforms),
+            (Self::Vulkan(f), BaseTexProgram::Vulkan(p)) => f.override_default_tex_program(p, uniforms),
+            _ => tracing::warn!("tex program of a different renderer backend"),
+        }
+    }
+
+    /// Reset [`Self::override_default_tex_program`]
+    pub fn clear_tex_program_override(&mut self) {
+        each!(Self, self, f => f.clear_tex_program_override())
+    }
+
+    // ponytail: no GPU profiling spans, add when tracy GPU profiling is needed
+    /// Run `func` in a GPU profiling span
+    pub fn with_gpu_span<F, R>(&mut self, _location: SpanLocation, func: F) -> R
+    where
+        F: FnOnce(&mut Self) -> R,
+    {
+        func(self)
+    }
+
+    /// Create an offscreen texture on the frame's renderer
+    pub fn create_buffer(&mut self, format: Fourcc, size: Size<i32, BufferCoord>) -> Result<BaseTexture, BaseError> {
+        match self {
+            Self::Gles(f) => Ok(BaseTexture::Gles(f.renderer().as_mut().create_buffer(format, size)?)),
+            Self::Vulkan(f) => Ok(BaseTexture::Vulkan(f.renderer().as_mut().create_buffer(format, size)?)),
+        }
+    }
+
+    /// Render `src` of `texture` into `dst`, optionally with a custom texture program
+    #[allow(clippy::too_many_arguments)]
+    pub fn render_texture_from_to(
+        &mut self,
+        texture: &BaseTexture,
+        src: Rectangle<f64, BufferCoord>,
+        dst: Rectangle<i32, Physical>,
+        damage: &[Rectangle<i32, Physical>],
+        opaque_regions: &[Rectangle<i32, Physical>],
+        src_transform: Transform,
+        alpha: f32,
+        program: Option<&BaseTexProgram>,
+        additional_uniforms: &[Uniform<'_>],
+    ) -> Result<(), BaseError> {
+        match (self, texture, program) {
+            (Self::Gles(f), BaseTexture::Gles(t), None | Some(BaseTexProgram::Gles(_))) => {
+                let p = match program {
+                    Some(BaseTexProgram::Gles(p)) => Some(p),
+                    _ => None,
+                };
+                Ok(f.render_texture_from_to(
+                    t,
+                    src,
+                    dst,
+                    damage,
+                    opaque_regions,
+                    src_transform,
+                    alpha,
+                    p,
+                    additional_uniforms,
+                )?)
+            }
+            (Self::Vulkan(f), BaseTexture::Vulkan(t), None | Some(BaseTexProgram::Vulkan(_))) => {
+                let p = match program {
+                    Some(BaseTexProgram::Vulkan(p)) => Some(p),
+                    _ => None,
+                };
+                Ok(f.render_texture_from_to(
+                    t,
+                    src,
+                    dst,
+                    damage,
+                    opaque_regions,
+                    src_transform,
+                    alpha,
+                    p,
+                    additional_uniforms,
+                )?)
+            }
+            _ => Err(BaseError::Mismatch),
+        }
+    }
+}
+
+impl Texture for BaseTexture {
+    fn width(&self) -> u32 {
+        each!(Self, self, t => t.width())
+    }
+    fn height(&self) -> u32 {
+        each!(Self, self, t => t.height())
+    }
+    fn size(&self) -> Size<i32, BufferCoord> {
+        each!(Self, self, t => t.size())
+    }
+    fn format(&self) -> Option<Fourcc> {
+        each!(Self, self, t => t.format())
+    }
+}
+
+impl Texture for BaseTarget<'_> {
+    fn width(&self) -> u32 {
+        each!(Self, self, t => t.width())
+    }
+    fn height(&self) -> u32 {
+        each!(Self, self, t => t.height())
+    }
+    fn size(&self) -> Size<i32, BufferCoord> {
+        each!(Self, self, t => t.size())
+    }
+    fn format(&self) -> Option<Fourcc> {
+        each!(Self, self, t => t.format())
+    }
+}
+
+impl Texture for BaseMapping {
+    fn width(&self) -> u32 {
+        each!(Self, self, t => t.width())
+    }
+    fn height(&self) -> u32 {
+        each!(Self, self, t => t.height())
+    }
+    fn size(&self) -> Size<i32, BufferCoord> {
+        each!(Self, self, t => t.size())
+    }
+    fn format(&self) -> Option<Fourcc> {
+        each!(Self, self, t => Texture::format(t))
+    }
+}
+
+impl TextureMapping for BaseMapping {
+    fn flipped(&self) -> bool {
+        each!(Self, self, t => t.flipped())
+    }
+    fn format(&self) -> Fourcc {
+        each!(Self, self, t => TextureMapping::format(t))
+    }
+}
+
+impl RendererSuper for BaseRenderer {
+    type Error = BaseError;
+    type TextureId = BaseTexture;
+    type Framebuffer<'buffer> = BaseTarget<'buffer>;
+    type Frame<'frame, 'buffer>
+        = BaseFrame<'frame, 'buffer>
+    where
+        'buffer: 'frame,
+        Self: 'frame;
+}
+
+impl Renderer for BaseRenderer {
+    fn context_id(&self) -> ContextId<BaseTexture> {
+        each!(Self, self, r => r.context_id().map())
+    }
+
+    fn downscale_filter(&mut self, filter: TextureFilter) -> Result<(), BaseError> {
+        each!(Self, self, r => Ok(r.downscale_filter(filter)?))
+    }
+
+    fn upscale_filter(&mut self, filter: TextureFilter) -> Result<(), BaseError> {
+        each!(Self, self, r => Ok(r.upscale_filter(filter)?))
+    }
+
+    fn set_debug_flags(&mut self, flags: DebugFlags) {
+        each!(Self, self, r => r.set_debug_flags(flags))
+    }
+
+    fn debug_flags(&self) -> DebugFlags {
+        each!(Self, self, r => r.debug_flags())
+    }
+
+    fn render<'frame, 'buffer>(
+        &'frame mut self,
+        framebuffer: &'frame mut BaseTarget<'buffer>,
+        output_size: Size<i32, Physical>,
+        dst_transform: Transform,
+    ) -> Result<BaseFrame<'frame, 'buffer>, BaseError>
+    where
+        'buffer: 'frame,
+    {
+        match (self, framebuffer) {
+            (Self::Gles(r), BaseTarget::Gles(t)) => Ok(BaseFrame::Gles(r.render(t, output_size, dst_transform)?)),
+            (Self::Vulkan(r), BaseTarget::Vulkan(t)) => {
+                Ok(BaseFrame::Vulkan(r.render(t, output_size, dst_transform)?))
+            }
+            _ => Err(BaseError::Mismatch),
+        }
+    }
+
+    fn wait(&mut self, sync: &SyncPoint) -> Result<(), BaseError> {
+        each!(Self, self, r => Ok(r.wait(sync)?))
+    }
+
+    fn cleanup_texture_cache(&mut self) -> Result<(), BaseError> {
+        each!(Self, self, r => Ok(r.cleanup_texture_cache()?))
+    }
+}
+
+impl Frame for BaseFrame<'_, '_> {
+    type Error = BaseError;
+    type TextureId = BaseTexture;
+
+    fn context_id(&self) -> ContextId<BaseTexture> {
+        each!(Self, self, f => f.context_id().map())
+    }
+
+    fn clear(&mut self, color: Color32F, at: &[Rectangle<i32, Physical>]) -> Result<(), BaseError> {
+        each!(Self, self, f => Ok(f.clear(color, at)?))
+    }
+
+    fn draw_solid(
+        &mut self,
+        dst: Rectangle<i32, Physical>,
+        damage: &[Rectangle<i32, Physical>],
+        color: Color32F,
+    ) -> Result<(), BaseError> {
+        each!(Self, self, f => Ok(f.draw_solid(dst, damage, color)?))
+    }
+
+    fn render_texture_from_to(
+        &mut self,
+        texture: &BaseTexture,
+        src: Rectangle<f64, BufferCoord>,
+        dst: Rectangle<i32, Physical>,
+        damage: &[Rectangle<i32, Physical>],
+        opaque_regions: &[Rectangle<i32, Physical>],
+        src_transform: Transform,
+        alpha: f32,
+    ) -> Result<(), BaseError> {
+        match (self, texture) {
+            (Self::Gles(f), BaseTexture::Gles(t)) => Ok(Frame::render_texture_from_to(
+                f,
+                t,
+                src,
+                dst,
+                damage,
+                opaque_regions,
+                src_transform,
+                alpha,
+            )?),
+            (Self::Vulkan(f), BaseTexture::Vulkan(t)) => Ok(Frame::render_texture_from_to(
+                f,
+                t,
+                src,
+                dst,
+                damage,
+                opaque_regions,
+                src_transform,
+                alpha,
+            )?),
+            _ => Err(BaseError::Mismatch),
+        }
+    }
+
+    fn transformation(&self) -> Transform {
+        each!(Self, self, f => f.transformation())
+    }
+
+    fn output_size(&self) -> Size<i32, Physical> {
+        each!(Self, self, f => f.output_size())
+    }
+
+    fn wait(&mut self, sync: &SyncPoint) -> Result<(), BaseError> {
+        each!(Self, self, f => Ok(f.wait(sync)?))
+    }
+
+    fn finish(self) -> Result<SyncPoint, BaseError> {
+        each!(Self, self, f => Ok(f.finish()?))
+    }
+}
+
+impl ImportMem for BaseRenderer {
+    fn import_memory(
+        &mut self,
+        data: &[u8],
+        format: Fourcc,
+        size: Size<i32, BufferCoord>,
+        flipped: bool,
+    ) -> Result<BaseTexture, BaseError> {
+        wrap!(self, BaseTexture, r => r.import_memory(data, format, size, flipped))
+    }
+
+    fn update_memory(
+        &mut self,
+        texture: &BaseTexture,
+        data: &[u8],
+        region: Rectangle<i32, BufferCoord>,
+    ) -> Result<(), BaseError> {
+        match (self, texture) {
+            (Self::Gles(r), BaseTexture::Gles(t)) => Ok(r.update_memory(t, data, region)?),
+            (Self::Vulkan(r), BaseTexture::Vulkan(t)) => Ok(r.update_memory(t, data, region)?),
+            _ => Err(BaseError::Mismatch),
+        }
+    }
+
+    fn mem_formats(&self) -> Box<dyn Iterator<Item = Fourcc>> {
+        each!(Self, self, r => r.mem_formats())
+    }
+}
+
+#[cfg(feature = "wayland_frontend")]
+impl ImportMemWl for BaseRenderer {
+    fn import_shm_buffer(
+        &mut self,
+        buffer: &wl_buffer::WlBuffer,
+        surface: Option<&SurfaceData>,
+        damage: &[Rectangle<i32, BufferCoord>],
+    ) -> Result<BaseTexture, BaseError> {
+        wrap!(self, BaseTexture, r => r.import_shm_buffer(buffer, surface, damage))
+    }
+}
+
+impl ImportDma for BaseRenderer {
+    fn dmabuf_formats(&self) -> FormatSet {
+        each!(Self, self, r => r.dmabuf_formats())
+    }
+
+    fn has_dmabuf_format(&self, format: Format) -> bool {
+        each!(Self, self, r => r.has_dmabuf_format(format))
+    }
+
+    fn import_dmabuf(
+        &mut self,
+        dmabuf: &Dmabuf,
+        damage: Option<&[Rectangle<i32, BufferCoord>]>,
+    ) -> Result<BaseTexture, BaseError> {
+        wrap!(self, BaseTexture, r => r.import_dmabuf(dmabuf, damage))
+    }
+}
+
+#[cfg(feature = "wayland_frontend")]
+impl ImportDmaWl for BaseRenderer {}
+
+#[cfg(all(feature = "wayland_frontend", feature = "use_system_lib"))]
+impl super::ImportEgl for BaseRenderer {
+    fn bind_wl_display(
+        &mut self,
+        display: &wayland_server::DisplayHandle,
+    ) -> Result<(), crate::backend::egl::Error> {
+        each!(Self, self, r => r.bind_wl_display(display))
+    }
+
+    fn unbind_wl_display(&mut self) {
+        each!(Self, self, r => r.unbind_wl_display())
+    }
+
+    fn egl_reader(&self) -> Option<&crate::backend::egl::display::EGLBufferReader> {
+        each!(Self, self, r => r.egl_reader())
+    }
+
+    fn import_egl_buffer(
+        &mut self,
+        buffer: &wl_buffer::WlBuffer,
+        surface: Option<&SurfaceData>,
+        damage: &[Rectangle<i32, BufferCoord>],
+    ) -> Result<BaseTexture, BaseError> {
+        wrap!(self, BaseTexture, r => r.import_egl_buffer(buffer, surface, damage))
+    }
+}
+
+impl ExportMem for BaseRenderer {
+    type TextureMapping = BaseMapping;
+
+    fn copy_framebuffer(
+        &mut self,
+        target: &BaseTarget<'_>,
+        region: Rectangle<i32, BufferCoord>,
+        format: Fourcc,
+    ) -> Result<BaseMapping, BaseError> {
+        match (self, target) {
+            (Self::Gles(r), BaseTarget::Gles(t)) => Ok(BaseMapping::Gles(r.copy_framebuffer(t, region, format)?)),
+            (Self::Vulkan(r), BaseTarget::Vulkan(t)) => {
+                Ok(BaseMapping::Vulkan(r.copy_framebuffer(t, region, format)?))
+            }
+            _ => Err(BaseError::Mismatch),
+        }
+    }
+
+    fn copy_texture(
+        &mut self,
+        texture: &BaseTexture,
+        region: Rectangle<i32, BufferCoord>,
+        format: Fourcc,
+    ) -> Result<BaseMapping, BaseError> {
+        match (self, texture) {
+            (Self::Gles(r), BaseTexture::Gles(t)) => Ok(BaseMapping::Gles(r.copy_texture(t, region, format)?)),
+            (Self::Vulkan(r), BaseTexture::Vulkan(t)) => Ok(BaseMapping::Vulkan(r.copy_texture(t, region, format)?)),
+            _ => Err(BaseError::Mismatch),
+        }
+    }
+
+    fn can_read_texture(&mut self, texture: &BaseTexture) -> Result<bool, BaseError> {
+        match (self, texture) {
+            (Self::Gles(r), BaseTexture::Gles(t)) => Ok(r.can_read_texture(t)?),
+            (Self::Vulkan(r), BaseTexture::Vulkan(t)) => Ok(r.can_read_texture(t)?),
+            _ => Err(BaseError::Mismatch),
+        }
+    }
+
+    fn map_texture<'a>(&mut self, mapping: &'a BaseMapping) -> Result<&'a [u8], BaseError> {
+        match (self, mapping) {
+            (Self::Gles(r), BaseMapping::Gles(m)) => Ok(r.map_texture(m)?),
+            (Self::Vulkan(r), BaseMapping::Vulkan(m)) => Ok(r.map_texture(m)?),
+            _ => Err(BaseError::Mismatch),
+        }
+    }
+}
+
+impl Bind<Dmabuf> for BaseRenderer {
+    fn bind<'a>(&mut self, target: &'a mut Dmabuf) -> Result<BaseTarget<'a>, BaseError> {
+        match self {
+            Self::Gles(r) => Ok(BaseTarget::Gles(r.bind(target)?)),
+            Self::Vulkan(r) => Ok(BaseTarget::Vulkan(r.bind(target)?)),
+        }
+    }
+
+    fn supported_formats(&self) -> Option<FormatSet> {
+        each!(Self, self, r => Bind::<Dmabuf>::supported_formats(r))
+    }
+}
+
+impl Bind<BaseTexture> for BaseRenderer {
+    fn bind<'a>(&mut self, target: &'a mut BaseTexture) -> Result<BaseTarget<'a>, BaseError> {
+        match (self, target) {
+            (Self::Gles(r), BaseTexture::Gles(t)) => Ok(BaseTarget::Gles(r.bind(t)?)),
+            (Self::Vulkan(r), BaseTexture::Vulkan(t)) => Ok(BaseTarget::Vulkan(r.bind(t)?)),
+            _ => Err(BaseError::Mismatch),
+        }
+    }
+}
+
+impl Bind<EGLSurface> for BaseRenderer {
+    fn bind<'a>(&mut self, target: &'a mut EGLSurface) -> Result<BaseTarget<'a>, BaseError> {
+        match self {
+            Self::Gles(r) => Ok(BaseTarget::Gles(r.bind(target)?)),
+            Self::Vulkan(_) => Err(BaseError::Mismatch),
+        }
+    }
+}
+
+impl Offscreen<BaseTexture> for BaseRenderer {
+    fn create_buffer(&mut self, format: Fourcc, size: Size<i32, BufferCoord>) -> Result<BaseTexture, BaseError> {
+        wrap!(self, BaseTexture, r => r.create_buffer(format, size))
+    }
+}
