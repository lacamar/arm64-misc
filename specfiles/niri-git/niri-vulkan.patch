+use ash::{ext, khr, vk};
+use glam::Mat3;
+
+pub use frame::{VulkanFrame, VulkanFrameGuard};
+pub use import::VulkanMapping;
+pub use sync::SyncFdFence;
+
+use super::{
+    ContextId, DebugFlags, Renderer, RendererSuper, Texture, TextureFilter,
+    gles::{Uniform, UniformName},
+    sync::{Fence, SyncPoint},
+};
+use crate::{
+    backend::{
+        SwapBuffersError,
+        allocator::{
+            Fourcc,
+            dmabuf::WeakDmabuf,
+            format::{FormatSet, get_bpp, has_alpha},
+        },
+        drm::{DrmNode, NodeType},
+        vulkan::{Instance, InstanceError, PhysicalDevice, version::Version},
+    },
+    utils::{Buffer as BufferCoord, Physical, Rectangle, Size, Transform, user_data::UserDataMap},
+};
+
+/// Errors of the [`VulkanRenderer`]
+#[derive(Debug, thiserror::Error)]
+#[allow(missing_docs)]
+pub enum VulkanError {
+    #[error("vulkan: {0}")]
+    Vk(#[from] vk::Result),
+    #[error(transparent)]
+    Instance(#[from] InstanceError),
+    #[error("no suitable vulkan device")]
+    NoDevice,
+    #[error("unsupported: {0}")]
+    Unsupported(&'static str),
+    #[error("unsupported format {0:?}")]
+    Format(Fourcc),
+    #[error("shader: {0}")]
+    Shader(String),
+    #[cfg(feature = "wayland_frontend")]
+    #[error(transparent)]
+    BufferAccess(#[from] crate::wayland::shm::BufferAccessError),
+}
+
+impl From<VulkanError> for SwapBuffersError {
+    fn from(e: VulkanError) -> Self {
+        match e {
+            VulkanError::Vk(vk::Result::ERROR_DEVICE_LOST) => SwapBuffersError::ContextLost(Box::new(e)),
+            e => SwapBuffersError::TemporaryFailure(Box::new(e)),
+        }
+    }
+}
+
+const FOURCCS: &[Fourcc] = &[
+    Fourcc::Argb8888,
+    Fourcc::Xrgb8888,
+    Fourcc::Abgr8888,
+    Fourcc::Xbgr8888,
+    Fourcc::Argb2101010,
+    Fourcc::Xrgb2101010,
+    Fourcc::Abgr2101010,
+    Fourcc::Xbgr2101010,
+    Fourcc::Abgr16161616f,
+    Fourcc::Xbgr16161616f,
+    Fourcc::Rgb565,
+];
+
+fn vk_format(f: Fourcc) -> Option<vk::Format> {
+    use Fourcc::*;
+    Some(match f {
+        Argb8888 | Xrgb8888 => vk::Format::B8G8R8A8_UNORM,
+        Abgr8888 | Xbgr8888 => vk::Format::R8G8B8A8_UNORM,
+        Argb2101010 | Xrgb2101010 => vk::Format::A2R10G10B10_UNORM_PACK32,
+        Abgr2101010 | Xbgr2101010 => vk::Format::A2B10G10R10_UNORM_PACK32,
+        Abgr16161616f | Xbgr16161616f => vk::Format::R16G16B16A16_SFLOAT,
+        Rgb565 => vk::Format::R5G6B5_UNORM_PACK16,
+        _ => return None,
+    })
+}
+
+const COLOR_RANGE: vk::ImageSubresourceRange = vk::ImageSubresourceRange {
+    aspect_mask: vk::ImageAspectFlags::COLOR,
+    base_mip_level: 0,
+    level_count: 1,
+    base_array_layer: 0,
+    layer_count: 1,
+};
+const COLOR_LAYERS: vk::ImageSubresourceLayers = vk::ImageSubresourceLayers {
+    aspect_mask: vk::ImageAspectFlags::COLOR,
+    mip_level: 0,
+    base_array_layer: 0,
+    layer_count: 1,
+};
+const CHUNK: u64 = 1 << 20;
+const MAX_PENDING: usize = 16;
+
+fn rect2d(extent: vk::Extent2D) -> vk::Rect2D {
+    vk::Rect2D {
+        offset: vk::Offset2D::default(),
+        extent,
+    }
+}
+
+struct Device {
+    phd: PhysicalDevice,
+    raw: ash::Device,
+    queue: vk::Queue,
+    qfi: u32,
+    push: khr::push_descriptor::Device,
+    mem_fd: khr::external_memory_fd::Device,
+    sem_fd: khr::external_semaphore_fd::Device,
+    mem_props: vk::PhysicalDeviceMemoryProperties,
+    ubo_align: u64,
+    sync_fd: bool,
+    vert: vk::ShaderModule,
+    samplers: [vk::Sampler; 5],
+}
+
+impl fmt::Debug for Device {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("Device").field("name", &self.phd.name()).finish()
+    }
+}
+
+impl Drop for Device {
+    fn drop(&mut self) {
+        unsafe {
+            let _ = self.raw.device_wait_idle();
+            for s in self.samplers {
+                self.raw.destroy_sampler(s, None);
+            }
+            self.raw.destroy_shader_module(self.vert, None);
+            self.raw.destroy_device(None);
+        }
+    }
+}
+
+const DEVICE_EXTENSIONS: [&std::ffi::CStr; 6] = [
+    khr::push_descriptor::NAME,
+    khr::external_memory_fd::NAME,
+    ext::external_memory_dma_buf::NAME,
+    ext::image_drm_format_modifier::NAME,
+    ext::queue_family_foreign::NAME,
+    khr::external_semaphore_fd::NAME,
+];
+
+impl Device {
+    fn new(node: &DrmNode) -> Result<Arc<Self>, VulkanError> {
+        let instance = Instance::new(Version::VERSION_1_3, None)?;
+        let want = node
+            .node_with_type(NodeType::Render)
+            .and_then(Result::ok)
+            .unwrap_or(*node);
+        let phd = PhysicalDevice::enumerate(&instance)?
+            .find(|p| {
+                p.render_node().ok().flatten() == Some(want) || p.primary_node().ok().flatten() == Some(*node)
+            })
+            .ok_or(VulkanError::NoDevice)?;
+        if phd.api_version() < Version::VERSION_1_3 {
+            return Err(VulkanError::Unsupported("vulkan 1.3"));
+        }
+        if !DEVICE_EXTENSIONS.iter().all(|e| phd.has_device_extension(e)) {
+            return Err(VulkanError::Unsupported("device extensions"));
+        }
+        let ih = instance.handle();
+        let pd = phd.handle();
+        let mut f13 = vk::PhysicalDeviceVulkan13Features::default();
+        unsafe {
+            ih.get_physical_device_features2(pd, &mut vk::PhysicalDeviceFeatures2::default().push_next(&mut f13))
+        };
+        if f13.dynamic_rendering == 0 || f13.synchronization2 == 0 {
+            return Err(VulkanError::Unsupported("dynamic rendering / synchronization2"));
+        }
+        let qfi = unsafe { ih.get_physical_device_queue_family_properties(pd) }
+            .iter()
+            .position(|q| q.queue_flags.contains(vk::QueueFlags::GRAPHICS))
+            .ok_or(VulkanError::NoDevice)? as u32;
+
+        let mut sem_props = vk::ExternalSemaphoreProperties::default();
+        unsafe {
+            ih.get_physical_device_external_semaphore_properties(
+                pd,
+                &vk::PhysicalDeviceExternalSemaphoreInfo::default()
+                    .handle_type(vk::ExternalSemaphoreHandleTypeFlags::SYNC_FD),
+                &mut sem_props,
+            )
+        };
+        let sync_fd = sem_props.external_semaphore_features.contains(
+            vk::ExternalSemaphoreFeatureFlags::EXPORTABLE | vk::ExternalSemaphoreFeatureFlags::IMPORTABLE,
+        );
+
+        let exts = DEVICE_EXTENSIONS.map(|e| e.as_ptr());
+        let prio = [1.0];
+        let qci = [vk::DeviceQueueCreateInfo::default()
+            .queue_family_index(qfi)
+            .queue_priorities(&prio)];
+        let mut f13 = vk::PhysicalDeviceVulkan13Features::default()
+            .dynamic_rendering(true)
+            .synchronization2(true);
+        let ci = vk::DeviceCreateInfo::default()
+            .queue_create_infos(&qci)
+            .enabled_extension_names(&exts)
+            .push_next(&mut f13);
+        let raw = unsafe { ih.create_device(pd, &ci, None) }?;
+
+        let mut dev = Device {
+            queue: unsafe { raw.get_device_queue(qfi, 0) },
+            qfi,
+            push: khr::push_descriptor::Device::new(ih, &raw),
+            mem_fd: khr::external_memory_fd::Device::new(ih, &raw),
+            sem_fd: khr::external_semaphore_fd::Device::new(ih, &raw),
+            mem_props: unsafe { ih.get_physical_device_memory_properties(pd) },
+            ubo_align: phd.limits().min_uniform_buffer_offset_alignment.max(16),
+            sync_fd,
+            vert: vk::ShaderModule::null(),
+            samplers: [vk::Sampler::null(); 5],
+            raw,
+            phd,
+        };
+        let spv = shaders::compile(shaders::VERT_SRC, false).map_err(VulkanError::Shader)?;
+        dev.vert = unsafe {
+            dev.raw
+                .create_shader_module(&vk::ShaderModuleCreateInfo::default().code(&spv), None)
+        }?;
+        let filter = |b: bool| if b { vk::Filter::LINEAR } else { vk::Filter::NEAREST };
+        for i in 0..5 {
+            let (min, mag, mode) = if i == 4 {
+                (true, true, vk::SamplerAddressMode::CLAMP_TO_BORDER)
+            } else {
+                (i & 2 != 0, i & 1 != 0, vk::SamplerAddressMode::CLAMP_TO_EDGE)
+            };
+            let ci = vk::SamplerCreateInfo::default()
+                .min_filter(filter(min))
+                .mag_filter(filter(mag))
+                .mipmap_mode(vk::SamplerMipmapMode::NEAREST)
+                .address_mode_u(mode)
+                .address_mode_v(mode)
+                .address_mode_w(mode)
+                .border_color(vk::BorderColor::FLOAT_TRANSPARENT_BLACK)
+                .max_lod(0.0);
+            dev.samplers[i] = unsafe { dev.raw.create_sampler(&ci, None) }?;
+        }
+        Ok(Arc::new(dev))
+    }
+
+    fn ih(&self) -> &ash::Instance {
+        self.phd.instance().handle()
+    }
+
+    fn mem_type(&self, bits: u32, flags: vk::MemoryPropertyFlags) -> Option<u32> {
+        (0..self.mem_props.memory_type_count).find(|&i| {
+            bits & (1 << i) != 0 && self.mem_props.memory_types[i as usize].property_flags.contains(flags)
+        })
+    }
+
+    fn optimal_features(&self, format: vk::Format) -> vk::FormatFeatureFlags {
+        unsafe { self.ih().get_physical_device_format_properties(self.phd.handle(), format) }
+            .optimal_tiling_features
+    }
+}
+
+struct HostBuf {
+    dev: Arc<Device>,
+    buf: vk::Buffer,
+    mem: vk::DeviceMemory,
+    ptr: *mut u8,
+    size: u64,
+}
+
+unsafe impl Send for HostBuf {}
+unsafe impl Sync for HostBuf {}
+
+impl fmt::Debug for HostBuf {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("HostBuf").field("size", &self.size).finish()
+    }
+}
+
+impl HostBuf {
+    fn new(dev: &Arc<Device>, size: u64) -> Result<Self, VulkanError> {
+        use vk::BufferUsageFlags as U;
+        use vk::MemoryPropertyFlags as M;
+        let raw = &dev.raw;
+        let buf = unsafe {
+            raw.create_buffer(
+                &vk::BufferCreateInfo::default()
+                    .size(size)
+                    .usage(U::VERTEX_BUFFER | U::UNIFORM_BUFFER | U::TRANSFER_SRC | U::TRANSFER_DST),
+                None,
+            )
+        }?;
+        let mut hb = HostBuf {
+            dev: dev.clone(),
+            buf,
+            mem: vk::DeviceMemory::null(),
+            ptr: std::ptr::null_mut(),
+            size,
+        };
+        let req = unsafe { raw.get_buffer_memory_requirements(buf) };
+        let vc = M::HOST_VISIBLE | M::HOST_COHERENT;
+        let ty = dev
+            .mem_type(req.memory_type_bits, vc | M::HOST_CACHED)
+            .or_else(|| dev.mem_type(req.memory_type_bits, vc))
+            .ok_or(VulkanError::Unsupported("host visible memory"))?;
+        hb.mem = unsafe {
+            raw.allocate_memory(
+                &vk::MemoryAllocateInfo::default()
+                    .allocation_size(req.size)
+                    .memory_type_index(ty),
+                None,
+            )
+        }?;
+        unsafe { raw.bind_buffer_memory(buf, hb.mem, 0) }?;
+        hb.ptr = unsafe { raw.map_memory(hb.mem, 0, vk::WHOLE_SIZE, vk::MemoryMapFlags::empty()) }?.cast();
+        Ok(hb)
+    }
+}
+
+impl Drop for HostBuf {
+    fn drop(&mut self) {
+        unsafe {
+            self.dev.raw.destroy_buffer(self.buf, None);
+            self.dev.raw.free_memory(self.mem, None);
+        }
+    }
+}
+
+#[derive(Debug)]
+struct TexState {
+    layout: vk::ImageLayout,
+    serial: u64,
+    main: bool,
+    written: bool,
+    transitioned: bool,
+}
+
+struct TexInner {
+    dev: Arc<Device>,
+    image: vk::Image,
+    memory: vk::DeviceMemory,
+    view: vk::ImageView,
+    att_view: vk::ImageView,
+    format: vk::Format,
+    fourcc: Fourcc,
+    size: Size<i32, BufferCoord>,
+    has_alpha: bool,
+    y_inverted: bool,
+    foreign: Option<OwnedFd>,
+    state: Mutex<TexState>,
+    held: AtomicUsize,
+}
+
+impl fmt::Debug for TexInner {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("VulkanTexture")
+            .field("fourcc", &self.fourcc)
+            .field("size", &self.size)
+            .field("foreign", &self.foreign.is_some())
+            .finish()
+    }
+}
+
+impl Drop for TexInner {
+    fn drop(&mut self) {
+        unsafe {
+            let raw = &self.dev.raw;
+            raw.destroy_image_view(self.view, None);
+            raw.destroy_image_view(self.att_view, None);
+            raw.destroy_image(self.image, None);
+            raw.free_memory(self.memory, None);
+        }
+    }
+}
+
+struct Held(Arc<TexInner>);
+
+impl Held {
+    fn new(t: &Arc<TexInner>) -> Self {
+        t.held.fetch_add(1, Ordering::Relaxed);
+        Held(t.clone())
+    }
+}
+
+impl Drop for Held {
+    fn drop(&mut self) {
+        self.0.held.fetch_sub(1, Ordering::Relaxed);
+    }
+}
+
+impl TexInner {
+    fn bare(
+        dev: &Arc<Device>,
+        fourcc: Fourcc,
+        size: Size<i32, BufferCoord>,
+        y_inverted: bool,
+    ) -> Result<Self, VulkanError> {
+        Ok(TexInner {
+            dev: dev.clone(),
+            image: vk::Image::null(),
+            memory: vk::DeviceMemory::null(),
+            view: vk::ImageView::null(),
+            att_view: vk::ImageView::null(),
+            format: vk_format(fourcc).ok_or(VulkanError::Format(fourcc))?,
+            fourcc,
+            size,
+            has_alpha: has_alpha(fourcc),
+            y_inverted,
+            foreign: None,
+            state: Mutex::new(TexState {
+                layout: vk::ImageLayout::UNDEFINED,
+                serial: 0,
+                main: false,
+                written: false,
+                transitioned: false,
+            }),
+            held: AtomicUsize::new(0),
+        })
+    }
+
+    fn extent(&self) -> vk::Extent2D {
+        vk::Extent2D {
+            width: self.size.w.max(1) as u32,
+            height: self.size.h.max(1) as u32,
+        }
+    }
+
+    fn make_views(&mut self, renderable: bool) -> Result<(), VulkanError> {
+        let ci = |a| {
+            vk::ImageViewCreateInfo::default()
+                .image(self.image)
+                .view_type(vk::ImageViewType::TYPE_2D)
+                .format(self.format)
+                .components(vk::ComponentMapping {
+                    r: vk::ComponentSwizzle::IDENTITY,
+                    g: vk::ComponentSwizzle::IDENTITY,
+                    b: vk::ComponentSwizzle::IDENTITY,
+                    a,
+                })
+                .subresource_range(COLOR_RANGE)
+        };
+        let a = if self.has_alpha {
+            vk::ComponentSwizzle::IDENTITY
+        } else {
+            vk::ComponentSwizzle::ONE
+        };
+        let view = unsafe { self.dev.raw.create_image_view(&ci(a), None) }?;
+        self.view = view;
+        if renderable {
+            let att = unsafe { self.dev.raw.create_image_view(&ci(vk::ComponentSwizzle::IDENTITY), None) }?;
+            self.att_view = att;
+        }
+        Ok(())
+    }
+
+    fn new_own(
+        dev: &Arc<Device>,
+        fourcc: Fourcc,
+        size: Size<i32, BufferCoord>,
+        y_inverted: bool,
+    ) -> Result<Self, VulkanError> {
+        use vk::FormatFeatureFlags as F;
+        use vk::ImageUsageFlags as U;
+        let mut t = Self::bare(dev, fourcc, size, y_inverted)?;
+        let feats = dev.optimal_features(t.format);
+        if !feats.contains(F::SAMPLED_IMAGE | F::TRANSFER_DST) {
+            return Err(VulkanError::Format(fourcc));
+        }
+        let renderable = feats.contains(F::COLOR_ATTACHMENT | F::COLOR_ATTACHMENT_BLEND);
+        let mut usage = U::SAMPLED | U::TRANSFER_SRC | U::TRANSFER_DST;
+        if renderable {
+            usage |= U::COLOR_ATTACHMENT;
+        }
+        let ext = t.extent();
+        t.image = unsafe {
+            dev.raw.create_image(
+                &vk::ImageCreateInfo::default()
+                    .image_type(vk::ImageType::TYPE_2D)
+                    .format(t.format)
+                    .extent(vk::Extent3D {
+                        width: ext.width,
+                        height: ext.height,
+                        depth: 1,
+                    })
+                    .mip_levels(1)
+                    .array_layers(1)
+                    .samples(vk::SampleCountFlags::TYPE_1)
+                    .tiling(vk::ImageTiling::OPTIMAL)
+                    .usage(usage)
+                    .initial_layout(vk::ImageLayout::UNDEFINED),
+                None,
+            )
+        }?;
+        let req = unsafe { dev.raw.get_image_memory_requirements(t.image) };
+        let ty = dev
+            .mem_type(req.memory_type_bits, vk::MemoryPropertyFlags::DEVICE_LOCAL)
+            .or_else(|| dev.mem_type(req.memory_type_bits, vk::MemoryPropertyFlags::empty()))
+            .ok_or(VulkanError::Unsupported("image memory"))?;
+        t.memory = unsafe {
+            dev.raw.allocate_memory(
+                &vk::MemoryAllocateInfo::default()
+                    .allocation_size(req.size)
+                    .memory_type_index(ty),
+                None,
+            )
+        }?;
+        unsafe { dev.raw.bind_image_memory(t.image, t.memory, 0) }?;
+        t.make_views(renderable)?;
+        Ok(t)
+    }
+}
