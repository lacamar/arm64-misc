+use std::os::fd::{AsFd, AsRawFd, BorrowedFd, FromRawFd, OwnedFd};
+
+use rustix::{
+    event::{PollFd, PollFlags, poll},
+    io::Errno,
+    ioctl::{Opcode, Setter, Updater, ioctl, opcode},
+    time::Timespec,
+};
+
+use crate::backend::renderer::sync::{Fence, Interrupted};
+
+/// Fence backed by a sync_file
+#[derive(Debug)]
+pub struct SyncFdFence(pub OwnedFd);
+
+pub(super) fn fd_signaled(fd: BorrowedFd<'_>) -> bool {
+    let zero = Timespec { tv_sec: 0, tv_nsec: 0 };
+    matches!(poll(&mut [PollFd::new(&fd, PollFlags::IN)], Some(&zero)), Ok(1))
+}
+
+impl Fence for SyncFdFence {
+    fn is_signaled(&self) -> bool {
+        fd_signaled(self.0.as_fd())
+    }
+
+    fn wait(&self) -> Result<(), Interrupted> {
+        loop {
+            match poll(&mut [PollFd::new(&self.0, PollFlags::IN)], None) {
+                Ok(_) => return Ok(()),
+                Err(Errno::INTR | Errno::AGAIN) => continue,
+                Err(_) => return Err(Interrupted),
+            }
+        }
+    }
+
+    fn is_exportable(&self) -> bool {
+        true
+    }
+
+    fn export(&self) -> Option<OwnedFd> {
+        self.0.try_clone().ok()
+    }
+}
+
+#[repr(C)]
+struct DmaBufSyncFile {
+    flags: u32,
+    fd: i32,
+}
+
+const EXPORT: Opcode = opcode::read_write::<DmaBufSyncFile>(b'b', 2);
+const IMPORT: Opcode = opcode::write::<DmaBufSyncFile>(b'b', 3);
+
+fn flags(write: bool) -> u32 {
+    if write { 2 } else { 1 }
+}
+
+pub(super) fn export_sync_file(dmabuf: BorrowedFd<'_>, write: bool) -> Option<OwnedFd> {
+    let mut arg = DmaBufSyncFile {
+        flags: flags(write),
+        fd: -1,
+    };
+    unsafe { ioctl(dmabuf, Updater::<EXPORT, _>::new(&mut arg)) }.ok()?;
+    (arg.fd >= 0).then(|| unsafe { OwnedFd::from_raw_fd(arg.fd) })
+}
+
+pub(super) fn import_sync_file(dmabuf: BorrowedFd<'_>, sync: BorrowedFd<'_>, write: bool) {
+    let arg = DmaBufSyncFile {
+        flags: flags(write),
+        fd: sync.as_raw_fd(),
+    };
+    let _ = unsafe { ioctl(dmabuf, Setter::<IMPORT, _>::new(arg)) };
+}
