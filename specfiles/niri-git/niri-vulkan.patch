+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::backend::renderer::{Bind, Color32F, ExportMem, Frame, ImportMem, Offscreen};
+
+    #[test]
+    fn render_readback() {
+        let _ = tracing_subscriber::fmt().with_test_writer().try_init();
+        let Ok(node) = DrmNode::from_path("/dev/dri/renderD128") else {
+            return;
+        };
+        let mut r = VulkanRenderer::new(&node).unwrap();
+        r.upscale_filter(TextureFilter::Nearest).unwrap();
+        let mut fb: VulkanTexture = r.create_buffer(Fourcc::Abgr8888, (8, 8).into()).unwrap();
+        let src = r
+            .import_memory(&[0, 0, 255, 0, 255, 0, 0, 0], Fourcc::Xrgb8888, (2, 1).into(), false)
+            .unwrap();
+        let mut target = r.bind(&mut fb).unwrap();
+        let mut f = r.render(&mut target, (8, 8).into(), Transform::Normal).unwrap();
+        f.clear(Color32F::new(0., 0., 0., 1.), &[Rectangle::from_size((8, 8).into())])
+            .unwrap();
+        f.draw_solid(
+            Rectangle::new((4, 0).into(), (4, 4).into()),
+            &[Rectangle::from_size((4, 4).into())],
+            Color32F::new(0., 1., 0., 1.),
+        )
+        .unwrap();
+        Frame::render_texture_from_to(
+            &mut f,
+            &src,
+            Rectangle::from_size((2., 1.).into()),
+            Rectangle::new((0, 4).into(), (8, 4).into()),
+            &[Rectangle::from_size((8, 4).into())],
+            &[],
+            Transform::Normal,
+            1.0,
+        )
+        .unwrap();
+        f.finish().unwrap().wait().unwrap();
+        let mut src = src;
+        assert!(src.is_unique_reference());
+
+        let m = r
+            .copy_framebuffer(&target, Rectangle::from_size((8, 8).into()), Fourcc::Abgr8888)
+            .unwrap();
+        let px = r.map_texture(&m).unwrap();
+        let at = |x: usize, y: usize| &px[(y * 8 + x) * 4..][..4];
+        assert_eq!(at(0, 0), [0, 0, 0, 255]);
+        assert_eq!(at(7, 0), [0, 255, 0, 255]);
+        assert_eq!(at(0, 7), [255, 0, 0, 255]);
+        assert_eq!(at(7, 7), [0, 0, 255, 255]);
+
+        let m = r
+            .copy_texture(&src, Rectangle::new((1, 0).into(), (1, 1).into()), Fourcc::Argb8888)
+            .unwrap();
+        assert_eq!(r.map_texture(&m).unwrap(), [255, 0, 0, 255]);
+    }
+
+    #[cfg(feature = "backend_gbm")]
+    #[test]
+    fn dmabuf_roundtrip() {
+        use crate::backend::allocator::{
+            Allocator,
+            dmabuf::AsDmabuf,
+            gbm::{GbmAllocator, GbmBufferFlags, GbmDevice},
+        };
+        use crate::backend::renderer::ImportDma;
+        let _ = tracing_subscriber::fmt().with_test_writer().try_init();
+        let Ok(file) = std::fs::OpenOptions::new().read(true).write(true).open("/dev/dri/renderD128") else {
+            return;
+        };
+        let node = DrmNode::from_path("/dev/dri/renderD128").unwrap();
+        let mut r = VulkanRenderer::new(&node).unwrap();
+        let gbm = GbmDevice::new(crate::utils::DeviceFd::from(std::os::fd::OwnedFd::from(file))).unwrap();
+        let mut alloc = GbmAllocator::new(gbm, GbmBufferFlags::RENDERING);
+        let mods: Vec<_> = r
+            .dmabuf_render_formats()
+            .iter()
+            .filter(|f| f.code == Fourcc::Xrgb8888)
+            .map(|f| f.modifier)
+            .collect();
+        assert!(!mods.is_empty());
+        let bo = alloc.create_buffer(16, 16, Fourcc::Xrgb8888, &mods).unwrap();
+        let mut dmabuf = bo.export().unwrap();
+        let full = Rectangle::from_size((16, 16).into());
+
+        let mut target = r.bind(&mut dmabuf).unwrap();
+        let mut f = r.render(&mut target, (16, 16).into(), Transform::Normal).unwrap();
+        f.clear(Color32F::new(1., 0., 0., 1.), &[full]).unwrap();
+        f.draw_solid(
+            Rectangle::new((0, 8).into(), (16, 8).into()),
+            &[Rectangle::from_size((16, 8).into())],
+            Color32F::new(0., 0., 1., 1.),
+        )
+        .unwrap();
+        f.finish().unwrap().wait().unwrap();
+        drop(target);
+
+        let tex = r.import_dmabuf(&dmabuf, None).unwrap();
+        let m = r.copy_texture(&tex, Rectangle::from_size((16, 16).into()), Fourcc::Abgr8888).unwrap();
+        let px = r.map_texture(&m).unwrap();
+        assert_eq!(&px[..4], [255, 0, 0, 255]);
+        assert_eq!(&px[(15 * 16 + 15) * 4..][..4], [0, 0, 255, 255]);
+    }
+}
