+struct ProgramInner {
+    dev: Arc<Device>,
+    frag: vk::ShaderModule,
+    set_layout: vk::DescriptorSetLayout,
+    layout: vk::PipelineLayout,
+    refl: shaders::Reflection,
+    pipelines: Mutex<HashMap<(vk::Format, bool), vk::Pipeline>>,
+}
+
+impl fmt::Debug for ProgramInner {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("VulkanProgram").field("refl", &self.refl).finish()
+    }
+}
+
+impl Drop for ProgramInner {
+    fn drop(&mut self) {
+        unsafe {
+            let raw = &self.dev.raw;
+            for p in self.pipelines.get_mut().unwrap().values() {
+                raw.destroy_pipeline(*p, None);
+            }
+            raw.destroy_pipeline_layout(self.layout, None);
+            raw.destroy_descriptor_set_layout(self.set_layout, None);
+            raw.destroy_shader_module(self.frag, None);
+        }
+    }
+}
+
+impl ProgramInner {
+    fn new(dev: &Arc<Device>, src: &str) -> Result<Arc<Self>, VulkanError> {
+        let spv =
+            shaders::compile(&shaders::translate(src, &["DEBUG_FLAGS"]), true).map_err(VulkanError::Shader)?;
+        let mut p = ProgramInner {
+            dev: dev.clone(),
+            frag: vk::ShaderModule::null(),
+            set_layout: vk::DescriptorSetLayout::null(),
+            layout: vk::PipelineLayout::null(),
+            refl: shaders::reflect(&spv),
+            pipelines: Mutex::default(),
+        };
+        let raw = &dev.raw;
+        p.frag = unsafe { raw.create_shader_module(&vk::ShaderModuleCreateInfo::default().code(&spv), None) }?;
+        let binding = |b, ty| {
+            vk::DescriptorSetLayoutBinding::default()
+                .binding(b)
+                .descriptor_type(ty)
+                .descriptor_count(1)
+                .stage_flags(vk::ShaderStageFlags::FRAGMENT)
+        };
+        let mut bindings: Vec<_> = p
+            .refl
+            .samplers
+            .values()
+            .map(|b| binding(*b, vk::DescriptorType::COMBINED_IMAGE_SAMPLER))
+            .collect();
+        if let Some((b, _)) = p.refl.ubo {
+            bindings.push(binding(b, vk::DescriptorType::UNIFORM_BUFFER));
+        }
+        p.set_layout = unsafe {
+            raw.create_descriptor_set_layout(
+                &vk::DescriptorSetLayoutCreateInfo::default()
+                    .flags(vk::DescriptorSetLayoutCreateFlags::PUSH_DESCRIPTOR_KHR)
+                    .bindings(&bindings),
+                None,
+            )
+        }?;
+        let ranges = [vk::PushConstantRange::default()
+            .stage_flags(vk::ShaderStageFlags::VERTEX)
+            .size(96)];
+        let sets = [p.set_layout];
+        p.layout = unsafe {
+            raw.create_pipeline_layout(
+                &vk::PipelineLayoutCreateInfo::default()
+                    .set_layouts(&sets)
+                    .push_constant_ranges(&ranges),
+                None,
+            )
+        }?;
+        Ok(Arc::new(p))
+    }
+
+    fn pipeline(&self, format: vk::Format, blend: bool) -> Result<vk::Pipeline, VulkanError> {
+        let mut map = self.pipelines.lock().unwrap();
+        if let Some(p) = map.get(&(format, blend)) {
+            return Ok(*p);
+        }
+        use vk::BlendFactor as B;
+        let stages = [
+            vk::PipelineShaderStageCreateInfo::default()
+                .stage(vk::ShaderStageFlags::VERTEX)
+                .module(self.dev.vert)
+                .name(c"main"),
+            vk::PipelineShaderStageCreateInfo::default()
+                .stage(vk::ShaderStageFlags::FRAGMENT)
+                .module(self.frag)
+                .name(c"main"),
+        ];
+        let vb = [vk::VertexInputBindingDescription::default()
+            .stride(16)
+            .input_rate(vk::VertexInputRate::INSTANCE)];
+        let va = [vk::VertexInputAttributeDescription::default().format(vk::Format::R32G32B32A32_SFLOAT)];
+        let vi = vk::PipelineVertexInputStateCreateInfo::default()
+            .vertex_binding_descriptions(&vb)
+            .vertex_attribute_descriptions(&va);
+        let ia =
+            vk::PipelineInputAssemblyStateCreateInfo::default().topology(vk::PrimitiveTopology::TRIANGLE_STRIP);
+        let vp = vk::PipelineViewportStateCreateInfo::default()
+            .viewport_count(1)
+            .scissor_count(1);
+        let rs = vk::PipelineRasterizationStateCreateInfo::default()
+            .polygon_mode(vk::PolygonMode::FILL)
+            .cull_mode(vk::CullModeFlags::NONE)
+            .line_width(1.0);
+        let ms =
+            vk::PipelineMultisampleStateCreateInfo::default().rasterization_samples(vk::SampleCountFlags::TYPE_1);
+        let att = [vk::PipelineColorBlendAttachmentState::default()
+            .blend_enable(blend)
+            .src_color_blend_factor(B::ONE)
+            .dst_color_blend_factor(B::ONE_MINUS_SRC_ALPHA)
+            .color_blend_op(vk::BlendOp::ADD)
+            .src_alpha_blend_factor(B::ONE)
+            .dst_alpha_blend_factor(B::ONE_MINUS_SRC_ALPHA)
+            .alpha_blend_op(vk::BlendOp::ADD)
+            .color_write_mask(vk::ColorComponentFlags::RGBA)];
+        let cb = vk::PipelineColorBlendStateCreateInfo::default().attachments(&att);
+        let dyn_states = [vk::DynamicState::VIEWPORT, vk::DynamicState::SCISSOR];
+        let ds = vk::PipelineDynamicStateCreateInfo::default().dynamic_states(&dyn_states);
+        let fmts = [format];
+        let mut ri = vk::PipelineRenderingCreateInfo::default().color_attachment_formats(&fmts);
+        let ci = vk::GraphicsPipelineCreateInfo::default()
+            .stages(&stages)
+            .vertex_input_state(&vi)
+            .input_assembly_state(&ia)
+            .viewport_state(&vp)
+            .rasterization_state(&rs)
+            .multisample_state(&ms)
+            .color_blend_state(&cb)
+            .dynamic_state(&ds)
+            .layout(self.layout)
+            .push_next(&mut ri);
+        let p = unsafe {
+            self.dev
+                .raw
+                .create_graphics_pipelines(vk::PipelineCache::null(), &[ci], None)
+        }
+        .map_err(|(_, e)| e)?[0];
+        map.insert((format, blend), p);
+        Ok(p)
+    }
+}
+
+/// Compiled fragment shader program
+#[derive(Debug, Clone)]
+pub struct VulkanProgram(Arc<ProgramInner>);
+
+struct Recording {
+    serial: u64,
+    pre: vk::CommandBuffer,
+    main: vk::CommandBuffer,
+    rendering: Option<vk::Image>,
+    textures: Vec<Held>,
+    programs: Vec<Arc<ProgramInner>>,
+    bufs: Vec<Arc<HostBuf>>,
+    chunks: Vec<HostBuf>,
+    used: u64,
+    waits: Vec<OwnedFd>,
+}
+
+impl Recording {
+    fn new(serial: u64) -> Self {
+        Recording {
+            serial,
+            pre: vk::CommandBuffer::null(),
+            main: vk::CommandBuffer::null(),
+            rendering: None,
+            textures: Vec::new(),
+            programs: Vec::new(),
+            bufs: Vec::new(),
+            chunks: Vec::new(),
+            used: 0,
+            waits: Vec::new(),
+        }
+    }
+}
+
+struct Pending {
+    serial: u64,
+    fence: vk::Fence,
+    cbs: Vec<vk::CommandBuffer>,
+    sems: Vec<vk::Semaphore>,
+    chunks: Vec<HostBuf>,
+    _keep: (Vec<Held>, Vec<Arc<ProgramInner>>, Vec<Arc<HostBuf>>),
+}
+
+fn stage_access(l: vk::ImageLayout) -> (vk::PipelineStageFlags2, vk::AccessFlags2) {
+    use vk::AccessFlags2 as A;
+    use vk::ImageLayout as L;
+    use vk::PipelineStageFlags2 as P;
+    match l {
+        L::COLOR_ATTACHMENT_OPTIMAL => (
+            P::COLOR_ATTACHMENT_OUTPUT,
+            A::COLOR_ATTACHMENT_READ | A::COLOR_ATTACHMENT_WRITE,
+        ),
+        L::SHADER_READ_ONLY_OPTIMAL => (P::FRAGMENT_SHADER, A::SHADER_SAMPLED_READ),
+        L::TRANSFER_DST_OPTIMAL => (P::ALL_TRANSFER, A::TRANSFER_WRITE),
+        L::TRANSFER_SRC_OPTIMAL => (P::ALL_TRANSFER, A::TRANSFER_READ),
+        L::GENERAL => (P::ALL_COMMANDS, A::MEMORY_READ | A::MEMORY_WRITE),
+        _ => (P::NONE, A::NONE),
+    }
+}
+
+fn push_constants(matrix: Mat3, tex_matrix: Mat3) -> [f32; 24] {
+    let mut pc = [0f32; 24];
+    for (i, m) in [matrix, tex_matrix].iter().enumerate() {
+        for c in 0..3 {
+            for r in 0..3 {
+                pc[i * 12 + c * 4 + r] = m.col(c)[r];
+            }
+        }
+    }
+    pc
+}
+
+fn as_bytes<T: Copy>(v: &[T]) -> &[u8] {
+    unsafe { std::slice::from_raw_parts(v.as_ptr().cast(), std::mem::size_of_val(v)) }
+}
+
+/// Native Vulkan renderer
+pub struct VulkanRenderer {
+    dev: Arc<Device>,
+    pool: vk::CommandPool,
+    rec: Recording,
+    pending: VecDeque<Pending>,
+    free_cbs: Vec<vk::CommandBuffer>,
+    free_sems: Vec<vk::Semaphore>,
+    free_fences: Vec<vk::Fence>,
+    free_chunks: Vec<HostBuf>,
+    tex_prog: VulkanProgram,
+    solid_prog: VulkanProgram,
+    dummy: VulkanTexture,
+    dmabuf_cache: HashMap<WeakDmabuf, VulkanTexture>,
+    tex_formats: FormatSet,
+    render_formats: FormatSet,
+    mem_formats: Vec<Fourcc>,
+    context_id: ContextId<VulkanTexture>,
+    debug_flags: DebugFlags,
+    min_filter: TextureFilter,
+    mag_filter: TextureFilter,
+    user_data: UserDataMap,
+}
+
+impl fmt::Debug for VulkanRenderer {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("VulkanRenderer").field("device", &self.dev).finish()
+    }
+}
+
+impl Drop for VulkanRenderer {
+    fn drop(&mut self) {
+        unsafe {
+            let _ = self.dev.raw.device_wait_idle();
+            for p in std::mem::take(&mut self.pending) {
+                self.retire(p);
+            }
+            let raw = &self.dev.raw;
+            for f in &self.free_fences {
+                raw.destroy_fence(*f, None);
+            }
+            for s in &self.free_sems {
+                raw.destroy_semaphore(*s, None);
+            }
+            raw.destroy_command_pool(self.pool, None);
+        }
+    }
+}
+
+impl VulkanRenderer {
+    /// Create a renderer for the GPU behind `node`
+    pub fn new(node: &DrmNode) -> Result<Self, VulkanError> {
+        let dev = Device::new(node)?;
+        let tex_prog = VulkanProgram(ProgramInner::new(
+            &dev,
+            include_str!("../gles/shaders/implicit/texture.frag"),
+        )?);
+        let solid_prog = VulkanProgram(ProgramInner::new(
+            &dev,
+            include_str!("../gles/shaders/implicit/solid.frag"),
+        )?);
+        let mem_formats: Vec<Fourcc> = FOURCCS
+            .iter()
+            .copied()
+            .filter(|f| {
+                dev.optimal_features(vk_format(*f).unwrap())
+                    .contains(vk::FormatFeatureFlags::SAMPLED_IMAGE | vk::FormatFeatureFlags::TRANSFER_DST)
+            })
+            .collect();
+        let (tex_formats, render_formats) = import::dmabuf_formats(&dev);
+        let dummy = VulkanTexture(Arc::new(TexInner::new_own(
+            &dev,
+            Fourcc::Abgr8888,
+            (1, 1).into(),
+            false,
+        )?));
+        let pool = unsafe {
+            dev.raw.create_command_pool(
+                &vk::CommandPoolCreateInfo::default()
+                    .flags(vk::CommandPoolCreateFlags::RESET_COMMAND_BUFFER)
+                    .queue_family_index(dev.qfi),
+                None,
+            )
+        }?;
+        let mut r = VulkanRenderer {
+            dev,
+            pool,
+            rec: Recording::new(1),
+            pending: VecDeque::new(),
+            free_cbs: Vec::new(),
+            free_sems: Vec::new(),
+            free_fences: Vec::new(),
+            free_chunks: Vec::new(),
+            tex_prog,
+            solid_prog,
+            dummy,
+            dmabuf_cache: HashMap::new(),
+            tex_formats,
+            render_formats,
+            mem_formats,
+            context_id: ContextId::new(),
+            debug_flags: DebugFlags::empty(),
+            min_filter: TextureFilter::Linear,
+            mag_filter: TextureFilter::Linear,
+            user_data: UserDataMap::new(),
+        };
+        let dummy = r.dummy.0.clone();
+        r.upload(&dummy, &[0; 4], 4, &[Rectangle::from_size((1, 1).into())])?;
+        Ok(r)
+    }
+
+    /// Name of the Vulkan device
+    pub fn device_name(&self) -> &str {
+        self.dev.phd.name()
+    }
+
+    /// User data attached to this renderer
+    pub fn user_data(&self) -> &UserDataMap {
+        &self.user_data
+    }
+
+    /// Formats renderable through dmabufs
+    pub fn dmabuf_render_formats(&self) -> &FormatSet {
+        &self.render_formats
+    }
+
+    /// Compile a texture shader (same source conventions as GLES)
+    pub fn compile_custom_texture_shader(
+        &mut self,
+        src: impl AsRef<str>,
+        _additional_uniforms: &[UniformName<'_>],
+    ) -> Result<VulkanProgram, VulkanError> {
+        Ok(VulkanProgram(ProgramInner::new(&self.dev, src.as_ref())?))
+    }
+
+    /// Compile a plain fragment shader program
+    pub fn compile_shader_program(&mut self, src: impl AsRef<str>) -> Result<VulkanProgram, VulkanError> {
+        Ok(VulkanProgram(ProgramInner::new(&self.dev, src.as_ref())?))
+    }
+
+    /// Render `program` over the whole `target` texture, without blending
+    pub fn draw_into(
+        &mut self,
+        target: &VulkanTexture,
+        program: &VulkanProgram,
+        textures: &[(&str, &VulkanTexture)],
+        uniforms: &[Uniform<'_>],
+    ) -> Result<(), VulkanError> {
+        let textures: Vec<_> = textures.iter().map(|(n, t)| (*n, &t.0, 3)).collect();
+        let matrix = Mat3::from_cols_array(&[2., 0., 0., 0., 2., 0., -1., -1., 1.]);
+        self.draw(
+            &target.0,
+            target.0.extent(),
+            &program.0,
+            matrix,
+            Mat3::IDENTITY,
+            &[[0., 0., 1., 1.]],
+            false,
+            &[uniforms],
+            &textures,
+        )
+    }
+
+    /// Create an uninitialised texture
+    pub fn create_texture(
+        &mut self,
+        fourcc: Fourcc,
+        size: Size<i32, BufferCoord>,
+    ) -> Result<VulkanTexture, VulkanError> {
+        Ok(VulkanTexture(Arc::new(TexInner::new_own(&self.dev, fourcc, size, false)?)))
+    }
+
+    /// Submit recorded work
+    pub fn flush(&mut self) -> Result<SyncPoint, VulkanError> {
+        self.submit()
+    }
+
+    fn sampler_idx(&self) -> usize {
+        ((self.min_filter == TextureFilter::Linear) as usize) << 1 | (self.mag_filter == TextureFilter::Linear) as usize
+    }
+
+    fn cmd(&mut self, main: bool) -> Result<vk::CommandBuffer, VulkanError> {
+        let slot = if main { self.rec.main } else { self.rec.pre };
+        if slot != vk::CommandBuffer::null() {
+            return Ok(slot);
+        }
+        let raw = &self.dev.raw;
+        let cb = match self.free_cbs.pop() {
+            Some(cb) => cb,
+            None => unsafe {
+                raw.allocate_command_buffers(
+                    &vk::CommandBufferAllocateInfo::default()
+                        .command_pool(self.pool)
+                        .level(vk::CommandBufferLevel::PRIMARY)
+                        .command_buffer_count(1),
+                )
+            }?[0],
+        };
+        if let Err(e) = unsafe {
+            raw.begin_command_buffer(
+                cb,
+                &vk::CommandBufferBeginInfo::default().flags(vk::CommandBufferUsageFlags::ONE_TIME_SUBMIT),
+            )
+        } {
+            self.free_cbs.push(cb);
+            return Err(e.into());
+        }
+        if main {
+            self.rec.main = cb;
+        } else {
+            self.rec.pre = cb;
+        }
+        Ok(cb)
+    }
+
+    fn alloc_with(&mut self, len: usize, f: impl FnOnce(&mut [u8])) -> Result<(vk::Buffer, u64), VulkanError> {
+        let len = (len as u64).max(4);
+        let align = self.dev.ubo_align;
+        let used = self.rec.used;
+        let fits = self
+            .rec
+            .chunks
+            .last()
+            .is_some_and(|c| used.next_multiple_of(align) + len <= c.size);
+        if !fits {
+            let c = match (len <= CHUNK).then(|| self.free_chunks.pop()).flatten() {
+                Some(c) => c,
+                None => HostBuf::new(&self.dev, len.max(CHUNK))?,
+            };
+            self.rec.chunks.push(c);
+            self.rec.used = 0;
+        }
+        let c = self.rec.chunks.last().unwrap();
+        let off = self.rec.used.next_multiple_of(align);
+        self.rec.used = off + len;
+        f(unsafe { std::slice::from_raw_parts_mut(c.ptr.add(off as usize), len as usize) });
+        Ok((c.buf, off))
+    }
+
+    fn alloc(&mut self, data: &[u8]) -> Result<(vk::Buffer, u64), VulkanError> {
+        self.alloc_with(data.len(), |d| d[..data.len()].copy_from_slice(data))
+    }
+
+    fn end_rendering(&mut self) {
+        if self.rec.rendering.take().is_some() {
+            unsafe { self.dev.raw.cmd_end_rendering(self.rec.main) };
+        }
+    }
+
+    fn use_tex(
+        &mut self,
+        tex: &Arc<TexInner>,
+        layout: vk::ImageLayout,
+        main_use: bool,
+    ) -> Result<vk::CommandBuffer, VulkanError> {
+        use vk::ImageLayout as L;
+        let mut st = tex.state.lock().unwrap();
+        let first = st.serial != self.rec.serial;
+        if first {
+            st.serial = self.rec.serial;
+            st.main = false;
+            st.written = false;
+            self.rec.textures.push(Held::new(tex));
+        }
+        let acquire = first && tex.foreign.is_some();
+        let old = match (acquire, st.transitioned) {
+            (true, true) => L::GENERAL,
+            (true, false) => L::PREINITIALIZED,
+            _ => st.layout,
+        };
+        let need = acquire || old != layout || layout != L::SHADER_READ_ONLY_OPTIMAL;
+        let barrier_main = st.main;
+        let use_main = st.main || main_use;
+        if need {
+            if barrier_main {
+                self.end_rendering();
+            }
+            let cb = self.cmd(barrier_main)?;
+            let (ss, sa) = stage_access(old);
+            let (ds, da) = stage_access(layout);
+            let mut b = vk::ImageMemoryBarrier2::default()
+                .src_stage_mask(ss)
+                .src_access_mask(sa)
+                .dst_stage_mask(ds)
+                .dst_access_mask(da)
+                .old_layout(old)
+                .new_layout(layout)
+                .src_queue_family_index(vk::QUEUE_FAMILY_IGNORED)
+                .dst_queue_family_index(vk::QUEUE_FAMILY_IGNORED)
+                .image(tex.image)
+                .subresource_range(COLOR_RANGE);
+            if acquire {
+                b = b
+                    .src_queue_family_index(vk::QUEUE_FAMILY_FOREIGN_EXT)
+                    .dst_queue_family_index(self.dev.qfi)
+                    .src_stage_mask(vk::PipelineStageFlags2::NONE)
+                    .src_access_mask(vk::AccessFlags2::NONE);
+            }
+            unsafe {
+                self.dev
+                    .raw
+                    .cmd_pipeline_barrier2(cb, &vk::DependencyInfo::default().image_memory_barriers(&[b]))
+            };
+        }
+        let cb = self.cmd(use_main)?;
+        if use_main && matches!(layout, L::TRANSFER_DST_OPTIMAL | L::TRANSFER_SRC_OPTIMAL) {
+            self.end_rendering();
+        }
+        st.layout = layout;
+        st.written |= matches!(layout, L::COLOR_ATTACHMENT_OPTIMAL | L::TRANSFER_DST_OPTIMAL);
+        st.main = use_main;
+        Ok(cb)
+    }
+
+    fn begin_rendering(&mut self, target: &Arc<TexInner>) -> Result<vk::CommandBuffer, VulkanError> {
+        if self.rec.rendering == Some(target.image) {
+            return Ok(self.rec.main);
+        }
+        if target.att_view == vk::ImageView::null() {
+            return Err(VulkanError::Unsupported("texture is not renderable"));
+        }
+        self.end_rendering();
+        let cb = self.use_tex(target, vk::ImageLayout::COLOR_ATTACHMENT_OPTIMAL, true)?;
+        let att = [vk::RenderingAttachmentInfo::default()
+            .image_view(target.att_view)
+            .image_layout(vk::ImageLayout::COLOR_ATTACHMENT_OPTIMAL)
+            .load_op(vk::AttachmentLoadOp::LOAD)
+            .store_op(vk::AttachmentStoreOp::STORE)];
+        let ri = vk::RenderingInfo::default()
+            .render_area(rect2d(target.extent()))
+            .layer_count(1)
+            .color_attachments(&att);
+        unsafe { self.dev.raw.cmd_begin_rendering(cb, &ri) };
+        self.rec.rendering = Some(target.image);
+        Ok(cb)
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn draw(
+        &mut self,
+        target: &Arc<TexInner>,
+        viewport: vk::Extent2D,
+        prog: &Arc<ProgramInner>,
+        matrix: Mat3,
+        tex_matrix: Mat3,
+        instances: &[[f32; 4]],
+        blend: bool,
+        uniforms: &[&[Uniform<'_>]],
+        textures: &[(&str, &Arc<TexInner>, usize)],
+    ) -> Result<(), VulkanError> {
+        if instances.is_empty() {
+            return Ok(());
+        }
+        let mut images = Vec::new();
+        for (name, &binding) in &prog.refl.samplers {
+            let (tex, sampler) = textures
+                .iter()
+                .find(|t| t.0 == name)
+                .map(|t| (t.1.clone(), t.2))
+                .unwrap_or_else(|| (self.dummy.0.clone(), 0));
+            self.use_tex(&tex, vk::ImageLayout::SHADER_READ_ONLY_OPTIMAL, true)?;
+            images.push((
+                binding,
+                [vk::DescriptorImageInfo::default()
+                    .sampler(self.dev.samplers[sampler])
+                    .image_view(tex.view)
+                    .image_layout(vk::ImageLayout::SHADER_READ_ONLY_OPTIMAL)],
+            ));
+        }
+        let ubo = match prog.refl.ubo {
+            Some((binding, size)) => {
+                let refl = &prog.refl;
+                let (buffer, offset) = self.alloc_with(size as usize, |dst| {
+                    dst.fill(0);
+                    for u in uniforms.iter().flat_map(|u| u.iter()) {
+                        if let Some(&m) = refl.members.get(&*u.name) {
+                            shaders::write_uniform(dst, m, &u.value);
+                        }
+                    }
+                })?;
+                Some((
+                    binding,
+                    [vk::DescriptorBufferInfo {
+                        buffer,
+                        offset,
+                        range: size as u64,
+                    }],
+                ))
+            }
+            None => None,
+        };
+        let (vbuf, voff) = self.alloc(as_bytes(instances))?;
+        let pipeline = prog.pipeline(target.format, blend)?;
+        let cb = self.begin_rendering(target)?;
+
+        let mut writes: Vec<_> = images
+            .iter()
+            .map(|(b, info)| {
+                vk::WriteDescriptorSet::default()
+                    .dst_binding(*b)
+                    .descriptor_type(vk::DescriptorType::COMBINED_IMAGE_SAMPLER)
+                    .image_info(info)
+            })
+            .collect();
+        if let Some((b, info)) = &ubo {
+            writes.push(
+                vk::WriteDescriptorSet::default()
+                    .dst_binding(*b)
+                    .descriptor_type(vk::DescriptorType::UNIFORM_BUFFER)
+                    .buffer_info(info),
+            );
+        }
+        let ext = target.extent();
+        let scissor = vk::Extent2D {
+            width: viewport.width.min(ext.width),
+            height: viewport.height.min(ext.height),
+        };
+        let raw = &self.dev.raw;
+        unsafe {
+            raw.cmd_bind_pipeline(cb, vk::PipelineBindPoint::GRAPHICS, pipeline);
+            if !writes.is_empty() {
+                self.dev
+                    .push
+                    .cmd_push_descriptor_set(cb, vk::PipelineBindPoint::GRAPHICS, prog.layout, 0, &writes);
+            }
+            raw.cmd_set_viewport(
+                cb,
+                0,
+                &[vk::Viewport {
+                    x: 0.,
+                    y: 0.,
+                    width: viewport.width as f32,
+                    height: viewport.height as f32,
+                    min_depth: 0.,
+                    max_depth: 1.,
+                }],
+            );
+            raw.cmd_set_scissor(cb, 0, &[rect2d(scissor)]);
+            raw.cmd_push_constants(
+                cb,
+                prog.layout,
+                vk::ShaderStageFlags::VERTEX,
+                0,
+                as_bytes(&push_constants(matrix, tex_matrix)),
+            );
+            raw.cmd_bind_vertex_buffers(cb, 0, &[vbuf], &[voff]);
+            raw.cmd_draw(cb, 4, instances.len() as u32, 0, 0);
+        }
+        if !self.rec.programs.iter().any(|p| Arc::ptr_eq(p, prog)) {
+            self.rec.programs.push(prog.clone());
+        }
+        Ok(())
+    }
+
+    fn upload(
+        &mut self,
+        tex: &Arc<TexInner>,
+        data: &[u8],
+        stride: usize,
+        rects: &[Rectangle<i32, BufferCoord>],
+    ) -> Result<(), VulkanError> {
+        let bpp = get_bpp(tex.fourcc).ok_or(VulkanError::Format(tex.fourcc))? / 8;
+        for r in rects {
+            if r.size.w <= 0 || r.size.h <= 0 {
+                continue;
+            }
+            let row = r.size.w as usize * bpp;
+            let (buf, off) = self.alloc_with(row * r.size.h as usize, |dst| {
+                for y in 0..r.size.h as usize {
+                    let s = (r.loc.y as usize + y) * stride + r.loc.x as usize * bpp;
+                    dst[y * row..(y + 1) * row].copy_from_slice(&data[s..s + row]);
+                }
+            })?;
+            let cb = self.use_tex(tex, vk::ImageLayout::TRANSFER_DST_OPTIMAL, false)?;
+            unsafe {
+                self.dev.raw.cmd_copy_buffer_to_image(
+                    cb,
+                    buf,
+                    tex.image,
+                    vk::ImageLayout::TRANSFER_DST_OPTIMAL,
+                    &[vk::BufferImageCopy {
+                        buffer_offset: off,
+                        buffer_row_length: 0,
+                        buffer_image_height: 0,
+                        image_subresource: COLOR_LAYERS,
+                        image_offset: vk::Offset3D {
+                            x: r.loc.x,
+                            y: r.loc.y,
+                            z: 0,
+                        },
+                        image_extent: vk::Extent3D {
+                            width: r.size.w as u32,
+                            height: r.size.h as u32,
+                            depth: 1,
+                        },
+                    }],
+                )
+            };
+        }
+        Ok(())
+    }
+
+    fn pooled_sem(&mut self) -> Result<vk::Semaphore, VulkanError> {
+        if let Some(s) = self.free_sems.pop() {
+            return Ok(s);
+        }
+        let mut export =
+            vk::ExportSemaphoreCreateInfo::default().handle_types(vk::ExternalSemaphoreHandleTypeFlags::SYNC_FD);
+        Ok(unsafe {
+            self.dev
+                .raw
+                .create_semaphore(&vk::SemaphoreCreateInfo::default().push_next(&mut export), None)
+        }?)
+    }
+
+    fn pooled_fence(&mut self) -> Result<vk::Fence, VulkanError> {
+        if let Some(f) = self.free_fences.pop() {
+            return Ok(f);
+        }
+        Ok(unsafe { self.dev.raw.create_fence(&vk::FenceCreateInfo::default(), None) }?)
+    }
+
+    fn retire(&mut self, p: Pending) {
+        unsafe {
+            for cb in &p.cbs {
+                let _ = self
+                    .dev
+                    .raw
+                    .reset_command_buffer(*cb, vk::CommandBufferResetFlags::empty());
+            }
+            let _ = self.dev.raw.reset_fences(&[p.fence]);
+        }
+        self.free_cbs.extend(p.cbs);
+        self.free_fences.push(p.fence);
+        self.free_sems.extend(p.sems);
+        self.free_chunks.extend(p.chunks.into_iter().filter(|c| c.size == CHUNK));
+        self.free_chunks.truncate(8);
+    }
+
+    fn recycle(&mut self) -> Result<(), VulkanError> {
+        while let Some(p) = self.pending.front() {
+            if !unsafe { self.dev.raw.get_fence_status(p.fence) }? {
+                if self.pending.len() <= MAX_PENDING {
+                    break;
+                }
+                unsafe { self.dev.raw.wait_for_fences(&[p.fence], true, u64::MAX) }?;
+            }
+            let p = self.pending.pop_front().unwrap();
+            self.retire(p);
+        }
+        Ok(())
+    }
+
+    fn wait_serial(&mut self, serial: u64) -> Result<(), VulkanError> {
+        while let Some(p) = self.pending.front() {
+            if p.serial > serial {
+                break;
+            }
+            unsafe { self.dev.raw.wait_for_fences(&[p.fence], true, u64::MAX) }?;
+            let p = self.pending.pop_front().unwrap();
+            self.retire(p);
+        }
+        Ok(())
+    }
+
+    fn submit(&mut self) -> Result<SyncPoint, VulkanError> {
+        self.recycle()?;
+        if self.rec.pre == vk::CommandBuffer::null() && self.rec.main == vk::CommandBuffer::null() {
+            return Ok(SyncPoint::signaled());
+        }
+        let dev = self.dev.clone();
+        self.end_rendering();
+        let main = self.cmd(true)?;
+        let foreign: Vec<_> = self
+            .rec
+            .textures
+            .iter()
+            .filter(|t| t.0.foreign.is_some())
+            .map(|t| t.0.clone())
+            .collect();
+        let mut written = Vec::with_capacity(foreign.len());
+        let barriers: Vec<_> = foreign
+            .iter()
+            .map(|t| {
+                let mut st = t.state.lock().unwrap();
+                let (ss, sa) = stage_access(st.layout);
+                let b = vk::ImageMemoryBarrier2::default()
+                    .src_stage_mask(ss)
+                    .src_access_mask(sa)
+                    .old_layout(st.layout)
+                    .new_layout(vk::ImageLayout::GENERAL)
+                    .src_queue_family_index(dev.qfi)
+                    .dst_queue_family_index(vk::QUEUE_FAMILY_FOREIGN_EXT)
+                    .image(t.image)
+                    .subresource_range(COLOR_RANGE);
+                st.layout = vk::ImageLayout::GENERAL;
+                st.transitioned = true;
+                written.push(st.written);
+                b
+            })
+            .collect();
+        if !barriers.is_empty() {
+            unsafe {
+                dev.raw
+                    .cmd_pipeline_barrier2(main, &vk::DependencyInfo::default().image_memory_barriers(&barriers))
+            };
+        }
+
+        let mut waits = std::mem::take(&mut self.rec.waits);
+        for (t, w) in foreign.iter().zip(&written) {
+            waits.extend(sync::export_sync_file(t.foreign.as_ref().unwrap().as_fd(), *w));
+        }
+        waits.retain(|fd| !sync::fd_signaled(fd.as_fd()));
+
+        let mut sems = Vec::new();
+        for fd in waits {
+            if dev.sync_fd {
+                let sem = self.pooled_sem()?;
+                let r = unsafe {
+                    dev.sem_fd.import_semaphore_fd(
+                        &vk::ImportSemaphoreFdInfoKHR::default()
+                            .semaphore(sem)
+                            .flags(vk::SemaphoreImportFlags::TEMPORARY)
+                            .handle_type(vk::ExternalSemaphoreHandleTypeFlags::SYNC_FD)
+                            .fd(fd.as_raw_fd()),
+                    )
+                };
+                match r {
+                    Ok(()) => {
+                        let _ = fd.into_raw_fd();
+                        sems.push(sem);
+                        continue;
+                    }
+                    Err(_) => self.free_sems.push(sem),
+                }
+            }
+            let _ = SyncFdFence(fd).wait();
+        }
+        let wait_count = sems.len();
+        let signal = if dev.sync_fd {
+            let s = self.pooled_sem()?;
+            sems.push(s);
+            Some(s)
+        } else {
+            None
+        };
+        let fence = self.pooled_fence()?;
+
+        let cbs: Vec<_> = [self.rec.pre, main]
+            .into_iter()
+            .filter(|c| *c != vk::CommandBuffer::null())
+            .collect();
+        let next = Recording::new(self.rec.serial + 1);
+        let rec = std::mem::replace(&mut self.rec, next);
+        let pending = Pending {
+            serial: rec.serial,
+            fence,
+            cbs: cbs.clone(),
+            sems: sems.clone(),
+            chunks: rec.chunks,
+            _keep: (rec.textures, rec.programs, rec.bufs),
+        };
+
+        let res = (|| unsafe {
+            for cb in &cbs {
+                dev.raw.end_command_buffer(*cb)?;
+            }
+            let cb_infos: Vec<_> = cbs
+                .iter()
+                .map(|c| vk::CommandBufferSubmitInfo::default().command_buffer(*c))
+                .collect();
+            let sem_info = |s: &vk::Semaphore| {
+                vk::SemaphoreSubmitInfo::default()
+                    .semaphore(*s)
+                    .stage_mask(vk::PipelineStageFlags2::ALL_COMMANDS)
+            };
+            let wait_infos: Vec<_> = sems[..wait_count].iter().map(sem_info).collect();
+            let sig_infos: Vec<_> = signal.iter().map(sem_info).collect();
+            let submit = vk::SubmitInfo2::default()
+                .wait_semaphore_infos(&wait_infos)
+                .command_buffer_infos(&cb_infos)
+                .signal_semaphore_infos(&sig_infos);
+            dev.raw.queue_submit2(dev.queue, &[submit], fence)
+        })();
+        if let Err(e) = res {
+            let _ = unsafe { dev.raw.device_wait_idle() };
+            self.retire(pending);
+            return Err(e.into());
+        }
+        self.pending.push_back(pending);
+
+        let Some(s) = signal else {
+            unsafe { dev.raw.wait_for_fences(&[fence], true, u64::MAX) }?;
+            return Ok(SyncPoint::signaled());
+        };
+        let fd = unsafe {
+            dev.sem_fd.get_semaphore_fd(
+                &vk::SemaphoreGetFdInfoKHR::default()
+                    .semaphore(s)
+                    .handle_type(vk::ExternalSemaphoreHandleTypeFlags::SYNC_FD),
+            )
+        };
+        match fd {
+            Ok(fd) if fd < 0 => Ok(SyncPoint::signaled()),
+            Ok(fd) => {
+                let fd = unsafe { OwnedFd::from_raw_fd(fd) };
+                for (t, w) in foreign.iter().zip(&written) {
+                    sync::import_sync_file(t.foreign.as_ref().unwrap().as_fd(), fd.as_fd(), *w);
+                }
+                Ok(SyncPoint::from(SyncFdFence(fd)))
+            }
+            Err(_) => {
+                // never exported, so it stays signaled: don't recycle it
+                self.pending.back_mut().unwrap().sems.retain(|x| *x != s);
+                unsafe {
+                    dev.raw.wait_for_fences(&[fence], true, u64::MAX)?;
+                    dev.raw.destroy_semaphore(s, None);
+                }
+                Ok(SyncPoint::signaled())
+            }
+        }
+    }
+}
