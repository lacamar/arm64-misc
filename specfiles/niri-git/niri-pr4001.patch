+pub fn get_surface_size(surface: &WlSurface) -> Size<i32, Logical> {
+    with_states(surface, |states| {
+        states
+            .data_map
+            .get::<RendererSurfaceStateUserData>()
+            .and_then(|d| d.lock().unwrap().surface_size())
+            .unwrap_or_default()
+    })
+}
