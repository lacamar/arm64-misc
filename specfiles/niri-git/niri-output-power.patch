diff --git a/src/protocols/output_power.rs b/src/protocols/output_power.rs
new file mode 100644
index 0000000..56d7905
--- /dev/null
+++ b/src/protocols/output_power.rs
@@ -0,0 +1,133 @@
+use smithay::output::Output;
+use smithay::reexports::wayland_protocols_wlr::output_power_management::v1::server::{
+    zwlr_output_power_manager_v1, zwlr_output_power_v1,
+};
+use smithay::reexports::wayland_server::backend::ClientId;
+use smithay::reexports::wayland_server::{Client, DataInit, DisplayHandle, New, Resource, WEnum};
+use smithay::wayland::{Dispatch2, GlobalDispatch2};
+use zwlr_output_power_manager_v1::ZwlrOutputPowerManagerV1;
+use zwlr_output_power_v1::{Mode, ZwlrOutputPowerV1};
+
+use crate::niri::{ClientState, State};
+use crate::protocols::EmptyData;
+
+#[derive(Default)]
+pub struct OutputPowerManagerState {
+    powers: Vec<ZwlrOutputPowerV1>,
+}
+
+pub struct OutputPowerGlobalData;
+
+pub struct OutputPowerData(Option<Output>);
+
+fn mode(active: bool) -> Mode {
+    if active {
+        Mode::On
+    } else {
+        Mode::Off
+    }
+}
+
+impl OutputPowerManagerState {
+    pub fn new(display: &DisplayHandle) -> Self {
+        display.create_global::<State, ZwlrOutputPowerManagerV1, _>(1, OutputPowerGlobalData);
+        Self::default()
+    }
+
+    pub fn monitors_active_changed(&self, active: bool) {
+        for power in &self.powers {
+            power.mode(mode(active));
+        }
+    }
+
+    pub fn output_removed(&mut self, output: &Output) {
+        self.powers.retain(|power| {
+            let gone = power
+                .data::<OutputPowerData>()
+                .is_some_and(|d| d.0.as_ref() == Some(output));
+            if gone {
+                power.failed();
+            }
+            !gone
+        });
+    }
+}
+
+impl GlobalDispatch2<ZwlrOutputPowerManagerV1, State> for OutputPowerGlobalData {
+    fn bind(
+        &self,
+        _state: &mut State,
+        _handle: &DisplayHandle,
+        _client: &Client,
+        manager: New<ZwlrOutputPowerManagerV1>,
+        data_init: &mut DataInit<'_, State>,
+    ) {
+        data_init.init(manager, EmptyData);
+    }
+
+    fn can_view(&self, client: &Client) -> bool {
+        !client.get_data::<ClientState>().unwrap().restricted
+    }
+}
+
+impl Dispatch2<ZwlrOutputPowerManagerV1, State> for EmptyData {
+    fn request(
+        &self,
+        state: &mut State,
+        _client: &Client,
+        _resource: &ZwlrOutputPowerManagerV1,
+        request: zwlr_output_power_manager_v1::Request,
+        _dhandle: &DisplayHandle,
+        data_init: &mut DataInit<'_, State>,
+    ) {
+        match request {
+            zwlr_output_power_manager_v1::Request::GetOutputPower { id, output } => {
+                let output = Output::from_resource(&output);
+                let known = output.is_some();
+                let power = data_init.init(id, OutputPowerData(output));
+                if known {
+                    power.mode(mode(state.niri.monitors_active));
+                    state.niri.output_power_state.powers.push(power);
+                } else {
+                    power.failed();
+                }
+            }
+            zwlr_output_power_manager_v1::Request::Destroy => (),
+            _ => unreachable!(),
+        }
+    }
+}
+
+impl Dispatch2<ZwlrOutputPowerV1, State> for OutputPowerData {
+    fn request(
+        &self,
+        state: &mut State,
+        _client: &Client,
+        resource: &ZwlrOutputPowerV1,
+        request: zwlr_output_power_v1::Request,
+        _dhandle: &DisplayHandle,
+        _data_init: &mut DataInit<'_, State>,
+    ) {
+        match request {
+            zwlr_output_power_v1::Request::SetMode { mode } => match mode {
+                // ponytail: niri powers all monitors together, so any output toggles all.
+                WEnum::Value(Mode::On) => state.niri.activate_monitors(&mut state.backend),
+                WEnum::Value(Mode::Off) => state.niri.deactivate_monitors(&mut state.backend),
+                _ => resource.post_error(
+                    zwlr_output_power_v1::Error::InvalidMode,
+                    "invalid power mode",
+                ),
+            },
+            zwlr_output_power_v1::Request::Destroy => (),
+            _ => unreachable!(),
+        }
+    }
+
+    fn destroyed(&self, state: &mut State, _client: ClientId, resource: &ZwlrOutputPowerV1) {
+        state
+            .niri
+            .output_power_state
+            .powers
+            .retain(|p| p != resource);
+    }
+}
