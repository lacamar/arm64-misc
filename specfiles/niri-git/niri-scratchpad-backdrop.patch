+#[test]
+fn scratchpad_scales_to_output() {
+    let ops = [
+        Op::AddOutput(1),
+        Op::AddScaledOutput {
+            id: 2,
+            scale: 2.,
+            layout_config: None,
+        },
+        Op::FocusOutput(1),
+        Op::AddWindow {
+            params: TestWindowParams::new(1),
+        },
+        Op::MoveWindowToScratchpad { id: None },
+        Op::FocusOutput(2),
+    ];
+    let mut layout = check_ops(ops);
+    let size = layout.scratchpad[0].tile.window().expected_size().unwrap();
+
+    layout.toggle_scratchpad(None);
+    let win = layout.windows().next().unwrap().1;
+    assert_eq!(win.requested_size(), Some(size.downscale(2)));
+    layout.verify_invariants();
+
+    layout.toggle_scratchpad(None);
+    let mut options = Options::default();
+    options.layout.scratchpad.width = Some(niri_config::DefaultPresetSize(Some(
+        PresetSize::Proportion(0.5),
+    )));
+    options.layout.scratchpad.height =
+        Some(niri_config::DefaultPresetSize(Some(PresetSize::Fixed(100))));
+    layout.update_options(options);
+    layout.toggle_scratchpad(None);
+    let win = layout.windows().next().unwrap().1;
+    assert_eq!(win.requested_size(), Some(Size::from((320, 100))));
+}
