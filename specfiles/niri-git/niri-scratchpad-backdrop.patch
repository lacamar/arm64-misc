+#[test]
+fn scratchpad_hide_on_click_outside() {
+    let ops = [
+        Op::AddOutput(1),
+        Op::AddWindow {
+            params: TestWindowParams::new(1),
+        },
+        Op::AddWindow {
+            params: TestWindowParams::new(2),
+        },
+        Op::MoveWindowToScratchpad { id: None },
+    ];
+    let mut layout = check_ops(ops);
+    layout.toggle_scratchpad(None);
+    assert_eq!(layout.scratchpad_outside(None), None);
+
+    let mut options = Options::default();
+    options.layout.scratchpad.hide_on_click_outside = true;
+    layout.update_options(options);
+    assert_eq!(layout.scratchpad_outside(Some(&2)), None);
+    assert_eq!(layout.scratchpad_outside(Some(&1)), Some(2));
+    assert_eq!(layout.scratchpad_outside(None), Some(2));
+
+    layout.activate_window(&1);
+    assert_eq!(layout.scratchpad_outside(Some(&1)), Some(2));
+}
