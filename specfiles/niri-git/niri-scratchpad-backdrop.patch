+    pub fn scratchpad_outside(&self, target: Option<&W::Id>) -> Option<W::Id> {
+        let MonitorSet::Normal { monitors, .. } = &self.monitor_set else {
+            return None;
+        };
+        let sp = monitors
+            .iter()
+            .map(|mon| mon.active_workspace_ref())
+            .filter(|ws| {
+                ws.is_floating_visible() && ws.options.layout.scratchpad.hide_on_click_outside
+            })
+            .flat_map(|ws| {
+                ws.tiles()
+                    .filter(move |t| t.is_scratchpad && ws.is_floating(t.window().id()))
+            })
+            .map(Tile::window)
+            .next()?;
+        let target = target.and_then(|id| self.windows().find(|(_, w)| w.id() == id));
+        if target.is_some_and(|(_, w)| w.id() == sp.id() || w.is_child_of(sp)) {
+            return None;
+        }
+        Some(sp.id().clone())
+    }
