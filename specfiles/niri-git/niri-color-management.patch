+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::Mutex;
+
+use smithay::output::Output;
+use smithay::reexports::wayland_protocols::wp::color_management::v1::server::{
+    wp_color_management_output_v1, wp_color_management_surface_feedback_v1,
+    wp_color_management_surface_v1, wp_color_manager_v1, wp_image_description_creator_icc_v1,
+    wp_image_description_creator_params_v1, wp_image_description_info_v1, wp_image_description_v1,
+};
+use smithay::reexports::wayland_server::protocol::wl_surface::WlSurface;
+use smithay::reexports::wayland_server::{
+    Client, DataInit, Dispatch, DisplayHandle, GlobalDispatch, New, Resource, WEnum, Weak,
+};
+use smithay::wayland::compositor::{with_states, Cacheable, SurfaceData};
+use smithay::wayland::{Dispatch2, GlobalDispatch2};
+use wp_color_management_output_v1::WpColorManagementOutputV1;
+use wp_color_management_surface_feedback_v1::WpColorManagementSurfaceFeedbackV1;
+use wp_color_management_surface_v1::WpColorManagementSurfaceV1;
+use wp_color_manager_v1::{Feature, Primaries, RenderIntent, TransferFunction, WpColorManagerV1};
+use wp_image_description_creator_icc_v1::WpImageDescriptionCreatorIccV1;
+use wp_image_description_creator_params_v1::WpImageDescriptionCreatorParamsV1;
+use wp_image_description_info_v1::WpImageDescriptionInfoV1;
+use wp_image_description_v1::WpImageDescriptionV1;
+
+use crate::protocols::EmptyData;
+use crate::render_helpers::color::{self, ColorDesc, Tf};
+
+const VERSION: u32 = 3;
+
+static NEXT_IDENTITY: AtomicU64 = AtomicU64::new(1);
+
+pub struct ColorManagementState {
+    outputs: Vec<WpColorManagementOutputV1>,
+    pending_done: Vec<WpImageDescriptionInfoV1>,
+    feedbacks: Vec<WpColorManagementSurfaceFeedbackV1>,
+}
+
+pub struct ColorManagerGlobalData {
+    filter: Box<dyn for<'c> Fn(&'c Client) -> bool + Send + Sync>,
+}
+
+pub trait ColorManagementHandler {
+    fn color_management_state(&mut self) -> &mut ColorManagementState;
+    fn output_color_desc(&mut self, output: &Output) -> ColorDesc;
+    fn preferred_color_desc(&mut self, surface: &WlSurface) -> ColorDesc;
+}
+
+#[derive(Default, Clone, Copy)]
+struct CachedColorDesc(Option<ColorDesc>);
+
+impl Cacheable for CachedColorDesc {
+    fn commit(&mut self, _dh: &DisplayHandle) -> Self {
+        *self
+    }
+
+    fn merge_into(self, into: &mut Self, _dh: &DisplayHandle) {
+        *into = self;
+    }
+}
+
+#[derive(Default)]
+struct ColorSurfaceAttached(AtomicBool);
+
+pub struct ImageDescData {
+    desc: Option<ColorDesc>,
+    info: bool,
+}
+
+pub struct ColorOutputData(Option<Output>);
+
+pub struct ColorSurfaceData(Weak<WlSurface>);
+
+#[derive(Default)]
+pub struct ParamsData(Mutex<Params>);
+
+#[derive(Default)]
+struct Params {
+    tf: Option<Tf>,
+    primaries: Option<[f32; 8]>,
+    lum: Option<(f32, f32, f32)>,
+    mastering_primaries: bool,
+    mastering_max: Option<f32>,
+    max_cll: Option<f32>,
+    max_fall: Option<f32>,
+}
+
+pub fn surface_color_desc(states: &SurfaceData) -> ColorDesc {
+    states
+        .cached_state
+        .get::<CachedColorDesc>()
+        .current()
+        .0
+        .unwrap_or(ColorDesc::SRGB)
+}
+
+impl ColorManagementState {
+    pub fn new<D, F>(display: &DisplayHandle, filter: F) -> Self
+    where
+        D: GlobalDispatch<WpColorManagerV1, ColorManagerGlobalData>,
+        D: 'static,
+        F: for<'c> Fn(&'c Client) -> bool + Send + Sync + 'static,
+    {
+        let global_data = ColorManagerGlobalData {
+            filter: Box::new(filter),
+        };
+        display.create_global::<D, WpColorManagerV1, _>(VERSION, global_data);
+
+        Self {
+            outputs: Vec::new(),
+            pending_done: Vec::new(),
+            feedbacks: Vec::new(),
+        }
+    }
+
+    // Sending a destructor event on an object created in the same request is a use-after-free in
+    // wayland-backend.
+    pub fn send_pending_done(&mut self) {
+        for info in self.pending_done.drain(..) {
+            info.done();
+        }
+    }
+
+    pub fn descriptions_changed(&mut self) {
+        self.outputs.retain(|o| o.is_alive());
+        self.feedbacks.retain(|f| f.is_alive());
+        for output in &self.outputs {
+            output.image_description_changed();
+        }
+        for feedback in &self.feedbacks {
+            if feedback.version() >= 2 {
+                let id = next_identity();
+                feedback.preferred_changed2((id >> 32) as u32, id as u32);
+            } else {
+                feedback.preferred_changed(next_identity() as u32);
+            }
+        }
+    }
+}
+
+fn next_identity() -> u64 {
+    NEXT_IDENTITY.fetch_add(1, Ordering::Relaxed)
+}
+
+fn init_desc<D>(
+    data_init: &mut DataInit<'_, D>,
+    id: New<WpImageDescriptionV1>,
+    desc: Option<ColorDesc>,
+    info: bool,
+) where
+    D: Dispatch<WpImageDescriptionV1, ImageDescData> + 'static,
+{
+    let obj = data_init.init(id, ImageDescData { desc, info });
+    if desc.is_none() {
+        obj.failed(
+            wp_image_description_v1::Cause::NoOutput,
+            "output is gone".into(),
+        );
+        return;
+    }
+    let id = next_identity();
+    if obj.version() >= 2 {
+        obj.ready2((id >> 32) as u32, id as u32);
+    } else {
+        obj.ready(id as u32);
+    }
+}
+
+fn named_tf(tf: TransferFunction) -> Option<Tf> {
+    Some(match tf {
+        TransferFunction::Gamma22 | TransferFunction::Srgb | TransferFunction::CompoundPower24 => {
+            Tf::Gamma(2.2)
+        }
+        TransferFunction::Bt1886 => Tf::Gamma(2.4),
+        TransferFunction::Gamma28 => Tf::Gamma(2.8),
+        TransferFunction::ExtLinear => Tf::Linear,
+        TransferFunction::St2084Pq => Tf::Pq,
+        TransferFunction::Hlg => Tf::Hlg,
+        _ => return None,
+    })
+}
+
+const NAMED_PRIMARIES: [(Primaries, [f32; 8]); 5] = [
+    (Primaries::Srgb, color::SRGB),
+    (Primaries::Bt2020, color::BT2020),
+    (Primaries::DciP3, color::DCI_P3),
+    (Primaries::DisplayP3, color::DISPLAY_P3),
+    (Primaries::AdobeRgb, color::ADOBE_RGB),
+];
+
+impl<D> GlobalDispatch2<WpColorManagerV1, D> for ColorManagerGlobalData
+where
+    D: Dispatch<WpColorManagerV1, EmptyData>,
+    D: 'static,
+{
+    fn bind(
+        &self,
+        _state: &mut D,
+        _handle: &DisplayHandle,
+        _client: &Client,
+        manager: New<WpColorManagerV1>,
+        data_init: &mut DataInit<'_, D>,
+    ) {
+        let manager = data_init.init(manager, EmptyData);
+        manager.supported_intent(RenderIntent::Perceptual);
+        let mut features = vec![
+            Feature::Parametric,
+            Feature::SetPrimaries,
+            Feature::SetTfPower,
+            Feature::SetLuminances,
+            Feature::SetMasteringDisplayPrimaries,
+            Feature::WindowsScrgb,
+        ];
+        if manager.version() >= 3 {
+            features.push(Feature::WindowsBt2100);
+        }
+        for feature in features {
+            manager.supported_feature(feature);
+        }
+        let mut tfs = vec![
+            TransferFunction::Bt1886,
+            TransferFunction::Gamma22,
+            TransferFunction::Gamma28,
+            TransferFunction::ExtLinear,
+            TransferFunction::St2084Pq,
+            TransferFunction::Hlg,
+            TransferFunction::Srgb,
+        ];
+        if manager.version() >= 2 {
+            tfs.push(TransferFunction::CompoundPower24);
+        }
+        for tf in tfs {
+            manager.supported_tf_named(tf);
+        }
+        for (primaries, _) in NAMED_PRIMARIES {
+            manager.supported_primaries_named(primaries);
+        }
+        manager.done();
+    }
+
+    fn can_view(&self, client: &Client) -> bool {
+        (self.filter)(client)
+    }
+}
+
+impl<D> Dispatch2<WpColorManagerV1, D> for EmptyData
+where
+    D: Dispatch<WpColorManagementOutputV1, ColorOutputData>,
+    D: Dispatch<WpColorManagementSurfaceV1, ColorSurfaceData>,
+    D: Dispatch<WpColorManagementSurfaceFeedbackV1, ColorSurfaceData>,
+    D: Dispatch<WpImageDescriptionCreatorParamsV1, ParamsData>,
+    D: Dispatch<WpImageDescriptionV1, ImageDescData>,
+    D: ColorManagementHandler,
+    D: 'static,
+{
+    fn request(
+        &self,
+        state: &mut D,
+        _client: &Client,
+        resource: &WpColorManagerV1,
+        request: <WpColorManagerV1 as Resource>::Request,
+        _dhandle: &DisplayHandle,
+        data_init: &mut DataInit<'_, D>,
+    ) {
+        use wp_color_manager_v1::{Error, Request};
+
+        match request {
+            Request::GetOutput { id, output } => {
+                let obj = data_init.init(id, ColorOutputData(Output::from_resource(&output)));
+                state.color_management_state().outputs.push(obj);
+            }
+            Request::GetSurface { id, surface } => {
+                let exists = with_states(&surface, |states| {
+                    states
+                        .data_map
+                        .get_or_insert_threadsafe(ColorSurfaceAttached::default)
+                        .0
+                        .swap(true, Ordering::Relaxed)
+                });
+                if exists {
+                    resource.post_error(Error::SurfaceExists, "surface already managed");
+                }
+                data_init.init(id, ColorSurfaceData(surface.downgrade()));
+            }
+            Request::GetSurfaceFeedback { id, surface } => {
+                let obj = data_init.init(id, ColorSurfaceData(surface.downgrade()));
+                state.color_management_state().feedbacks.push(obj);
+            }
+            Request::CreateIccCreator { obj } => {
+                data_init.post_error(obj, Error::UnsupportedFeature, "ICC not supported");
+            }
+            Request::CreateParametricCreator { obj } => {
+                data_init.init(obj, ParamsData::default());
+            }
+            Request::CreateWindowsScrgb { image_description } => {
+                let desc = ColorDesc {
+                    tf: Tf::Linear,
+                    primaries: color::SRGB,
+                    min_lum: 0.,
+                    max_lum: 80.,
+                    ref_lum: 203.,
+                    target_max: Some(1000.),
+                };
+                init_desc(data_init, image_description, Some(desc), false);
+            }
+            Request::CreateWindowsBt2100 { image_description } => {
+                let desc = ColorDesc {
+                    tf: Tf::Pq,
+                    primaries: color::BT2020,
+                    min_lum: 0.005,
+                    max_lum: 10000.005,
+                    ref_lum: 203.,
+                    target_max: None,
+                };
+                init_desc(data_init, image_description, Some(desc), false);
+            }
+            Request::GetImageDescription {
+                image_description, ..
+            } => {
+                data_init.post_error(
+                    image_description,
+                    Error::UnsupportedFeature,
+                    "no references",
+                );
+            }
+            Request::Destroy => (),
+            _ => unreachable!(),
+        }
+    }
+}
+
+impl<D> Dispatch2<WpColorManagementOutputV1, D> for ColorOutputData
+where
+    D: Dispatch<WpImageDescriptionV1, ImageDescData>,
+    D: ColorManagementHandler,
+    D: 'static,
+{
+    fn request(
+        &self,
+        state: &mut D,
+        _client: &Client,
+        _resource: &WpColorManagementOutputV1,
+        request: <WpColorManagementOutputV1 as Resource>::Request,
+        _dhandle: &DisplayHandle,
+        data_init: &mut DataInit<'_, D>,
+    ) {
+        match request {
+            wp_color_management_output_v1::Request::GetImageDescription { image_description } => {
+                let desc = self.0.as_ref().map(|o| state.output_color_desc(o));
+                init_desc(data_init, image_description, desc, true);
+            }
+            wp_color_management_output_v1::Request::Destroy => (),
+            _ => unreachable!(),
+        }
+    }
+}
+
+impl<D> Dispatch2<WpColorManagementSurfaceV1, D> for ColorSurfaceData
+where
+    D: 'static,
+{
+    fn request(
+        &self,
+        _state: &mut D,
+        _client: &Client,
+        resource: &WpColorManagementSurfaceV1,
+        request: <WpColorManagementSurfaceV1 as Resource>::Request,
+        _dhandle: &DisplayHandle,
+        _data_init: &mut DataInit<'_, D>,
+    ) {
+        use wp_color_management_surface_v1::{Error, Request};
+
+        let surface = self.0.upgrade().ok();
+        let set = |desc: Option<ColorDesc>| {
+            if let Some(surface) = &surface {
+                with_states(surface, |states| {
+                    states.cached_state.get::<CachedColorDesc>().pending().0 = desc;
+                });
+            }
+        };
+
+        match request {
+            Request::SetImageDescription {
+                image_description,
+                render_intent,
+            } => {
+                if surface.is_none() {
+                    resource.post_error(Error::Inert, "surface is gone");
+                    return;
+                }
+                if render_intent != WEnum::Value(RenderIntent::Perceptual) {
+                    resource.post_error(Error::RenderIntent, "unsupported render intent");
+                    return;
+                }
+                let Some(desc) = image_description
+                    .data::<ImageDescData>()
+                    .and_then(|d| d.desc)
+                else {
+                    resource.post_error(Error::ImageDescription, "image description failed");
+                    return;
+                };
+                set(Some(desc));
+            }
+            Request::UnsetImageDescription => {
+                if surface.is_none() {
+                    resource.post_error(Error::Inert, "surface is gone");
+                    return;
+                }
+                set(None);
+            }
+            Request::Destroy => {
+                set(None);
+                if let Some(surface) = &surface {
+                    with_states(surface, |states| {
+                        if let Some(a) = states.data_map.get::<ColorSurfaceAttached>() {
+                            a.0.store(false, Ordering::Relaxed);
+                        }
+                    });
+                }
+            }
+            _ => unreachable!(),
+        }
+    }
+}
+
+impl<D> Dispatch2<WpColorManagementSurfaceFeedbackV1, D> for ColorSurfaceData
+where
+    D: Dispatch<WpImageDescriptionV1, ImageDescData>,
+    D: ColorManagementHandler,
+    D: 'static,
+{
+    fn request(
+        &self,
+        state: &mut D,
+        _client: &Client,
+        resource: &WpColorManagementSurfaceFeedbackV1,
+        request: <WpColorManagementSurfaceFeedbackV1 as Resource>::Request,
+        _dhandle: &DisplayHandle,
+        data_init: &mut DataInit<'_, D>,
+    ) {
+        use wp_color_management_surface_feedback_v1::{Error, Request};
+
+        match request {
+            Request::GetPreferred { image_description }
+            | Request::GetPreferredParametric { image_description } => {
+                let Ok(surface) = self.0.upgrade() else {
+                    resource.post_error(Error::Inert, "surface is gone");
+                    data_init.init(
+                        image_description,
+                        ImageDescData {
+                            desc: None,
+                            info: false,
+                        },
+                    );
+                    return;
+                };
+                let desc = state.preferred_color_desc(&surface);
+                init_desc(data_init, image_description, Some(desc), true);
+            }
+            Request::Destroy => (),
+            _ => unreachable!(),
+        }
+    }
+}
+
+impl<D> Dispatch2<WpImageDescriptionCreatorParamsV1, D> for ParamsData
+where
+    D: Dispatch<WpImageDescriptionV1, ImageDescData>,
+    D: 'static,
+{
+    fn request(
+        &self,
+        _state: &mut D,
+        _client: &Client,
+        resource: &WpImageDescriptionCreatorParamsV1,
+        request: <WpImageDescriptionCreatorParamsV1 as Resource>::Request,
+        _dhandle: &DisplayHandle,
+        data_init: &mut DataInit<'_, D>,
+    ) {
+        use wp_image_description_creator_params_v1::{Error, Request};
+
+        let mut p = self.0.lock().unwrap();
+        let already_set = || resource.post_error(Error::AlreadySet, "already set");
+        let xy = |v: i32| v as f32 / 1_000_000.;
+
+        match request {
+            Request::Create { image_description } => {
+                let (Some(tf), Some(primaries)) = (p.tf, p.primaries) else {
+                    resource.post_error(Error::IncompleteSet, "tf and primaries required");
+                    data_init.init(
+                        image_description,
+                        ImageDescData {
+                            desc: None,
+                            info: false,
+                        },
+                    );
+                    return;
+                };
+                if let (Some(cll), Some(fall)) = (p.max_cll, p.max_fall) {
+                    if fall > cll {
+                        resource.post_error(Error::InvalidLuminance, "max_fall > max_cll");
+                    }
+                }
+                let (min_lum, max_lum, ref_lum) = p.lum.unwrap_or(match tf {
+                    Tf::Pq => (0.005, 10000., 203.),
+                    Tf::Hlg => (0.005, 1000., 203.),
+                    Tf::Gamma(2.4) => (0.01, 100., 100.),
+                    _ => (0.2, 80., 80.),
+                });
+                let max_lum = if tf == Tf::Pq {
+                    min_lum + 10000.
+                } else {
+                    max_lum
+                };
+                let desc = ColorDesc {
+                    tf,
+                    primaries,
+                    min_lum,
+                    max_lum,
+                    ref_lum,
+                    target_max: p.max_cll.or(p.mastering_max).filter(|&m| m > 0.),
+                };
+                init_desc(data_init, image_description, Some(desc), false);
+            }
+            Request::SetTfNamed { tf } => {
+                if p.tf.is_some() {
+                    return already_set();
+                }
+                match tf.into_result().ok().and_then(named_tf) {
+                    Some(tf) => p.tf = Some(tf),
+                    None => resource.post_error(Error::InvalidTf, "unsupported tf"),
+                }
+            }
+            Request::SetTfPower { eexp } => {
+                if p.tf.is_some() {
+                    return already_set();
+                }
+                if !(10000..=100000).contains(&eexp) {
+                    resource.post_error(Error::InvalidTf, "exponent out of range");
+                    return;
+                }
+                p.tf = Some(Tf::Gamma(eexp as f32 / 10000.));
+            }
+            Request::SetPrimariesNamed { primaries } => {
+                if p.primaries.is_some() {
+                    return already_set();
+                }
+                match NAMED_PRIMARIES
+                    .iter()
+                    .find(|(n, _)| WEnum::Value(*n) == primaries)
+                {
+                    Some((_, v)) => p.primaries = Some(*v),
+                    None => resource.post_error(Error::InvalidPrimariesNamed, "unsupported"),
+                }
+            }
+            Request::SetPrimaries {
+                r_x,
+                r_y,
+                g_x,
+                g_y,
+                b_x,
+                b_y,
+                w_x,
+                w_y,
+            } => {
+                if p.primaries.is_some() {
+                    return already_set();
+                }
+                p.primaries = Some([r_x, r_y, g_x, g_y, b_x, b_y, w_x, w_y].map(xy));
+            }
+            Request::SetLuminances {
+                min_lum,
+                max_lum,
+                reference_lum,
+            } => {
+                if p.lum.is_some() {
+                    return already_set();
+                }
+                let min = min_lum as f32 / 10000.;
+                let (max, reference) = (max_lum as f32, reference_lum as f32);
+                if max <= min || reference <= min {
+                    resource.post_error(Error::InvalidLuminance, "invalid luminance");
+                    return;
+                }
+                p.lum = Some((min, max, reference));
+            }
+            Request::SetMasteringDisplayPrimaries { .. } => {
+                if p.mastering_primaries {
+                    return already_set();
+                }
+                p.mastering_primaries = true;
+            }
+            Request::SetMasteringLuminance { max_lum, .. } => {
+                if p.mastering_max.is_some() {
+                    return already_set();
+                }
+                p.mastering_max = Some(max_lum as f32);
+            }
+            Request::SetMaxCll { max_cll } => {
+                if p.max_cll.is_some() {
+                    return already_set();
+                }
+                p.max_cll = Some(max_cll as f32);
+            }
+            Request::SetMaxFall { max_fall } => {
+                if p.max_fall.is_some() {
+                    return already_set();
+                }
+                p.max_fall = Some(max_fall as f32);
+            }
+            _ => unreachable!(),
+        }
+    }
+}
+
+impl<D> Dispatch2<WpImageDescriptionV1, D> for ImageDescData
+where
+    D: Dispatch<WpImageDescriptionInfoV1, EmptyData>,
+    D: ColorManagementHandler,
+    D: 'static,
+{
+    fn request(
+        &self,
+        state: &mut D,
+        _client: &Client,
+        resource: &WpImageDescriptionV1,
+        request: <WpImageDescriptionV1 as Resource>::Request,
+        _dhandle: &DisplayHandle,
+        data_init: &mut DataInit<'_, D>,
+    ) {
+        use wp_image_description_v1::{Error, Request};
+
+        match request {
+            Request::GetInformation { information } => {
+                let info = data_init.init(information, EmptyData);
+                let Some(desc) = self.desc else {
+                    resource.post_error(Error::NotReady, "image description failed");
+                    return;
+                };
+                if !self.info {
+                    resource.post_error(Error::NoInformation, "get_information not allowed");
+                    return;
+                }
+                send_info(&info, &desc);
+                state.color_management_state().pending_done.push(info);
+            }
+            Request::Destroy => (),
+            _ => unreachable!(),
+        }
+    }
+}
+
+fn send_info(info: &WpImageDescriptionInfoV1, desc: &ColorDesc) {
+    let p = desc.primaries.map(|v| (v * 1_000_000.).round() as i32);
+    info.primaries(p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7]);
+    if let Some((named, _)) = NAMED_PRIMARIES.iter().find(|(_, v)| *v == desc.primaries) {
+        info.primaries_named(*named);
+    }
+    match desc.tf {
+        Tf::Gamma(2.2) => info.tf_named(TransferFunction::Gamma22),
+        Tf::Gamma(g) => info.tf_power((g * 10000.).round() as u32),
+        Tf::Pq => info.tf_named(TransferFunction::St2084Pq),
+        Tf::Hlg => info.tf_named(TransferFunction::Hlg),
+        Tf::Linear => info.tf_named(TransferFunction::ExtLinear),
+    }
+    let min = (desc.min_lum * 10000.).round() as u32;
+    info.luminances(min, desc.max_lum as u32, desc.ref_lum as u32);
+    info.target_primaries(p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7]);
+    info.target_luminance(min, desc.target_max.unwrap_or(desc.max_lum) as u32);
+}
+
+impl<D> Dispatch2<WpImageDescriptionInfoV1, D> for EmptyData {
+    fn request(
+        &self,
+        _state: &mut D,
+        _client: &Client,
+        _resource: &WpImageDescriptionInfoV1,
+        _request: <WpImageDescriptionInfoV1 as Resource>::Request,
+        _dhandle: &DisplayHandle,
+        _data_init: &mut DataInit<'_, D>,
+    ) {
+        unreachable!()
+    }
+}
+
+impl<D> Dispatch2<WpImageDescriptionCreatorIccV1, D> for EmptyData {
+    fn request(
+        &self,
+        _state: &mut D,
+        _client: &Client,
+        _resource: &WpImageDescriptionCreatorIccV1,
+        _request: <WpImageDescriptionCreatorIccV1 as Resource>::Request,
+        _dhandle: &DisplayHandle,
+        _data_init: &mut DataInit<'_, D>,
+    ) {
+        unreachable!()
+    }
+}
