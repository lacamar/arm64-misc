+impl<D> Dispatch2<WpImageDescriptionCreatorParamsV1, D> for ParamsData
+where
+    D: Dispatch<WpImageDescriptionV1, ImageDescData>,
+    D: 'static,
+{
+    fn request(
+        &self,
+        _state: &mut D,
+        _client: &Client,
+        resource: &WpImageDescriptionCreatorParamsV1,
+        request: <WpImageDescriptionCreatorParamsV1 as Resource>::Request,
+        _dhandle: &DisplayHandle,
+        data_init: &mut DataInit<'_, D>,
+    ) {
+        use wp_image_description_creator_params_v1::{Error, Request};
+
+        let mut p = self.0.lock().unwrap();
+        let already_set = || resource.post_error(Error::AlreadySet, "already set");
+        let xy = |v: i32| v as f32 / 1_000_000.;
+
+        match request {
+            Request::Create { image_description } => {
+                let (Some(tf), Some(primaries)) = (p.tf, p.primaries) else {
+                    resource.post_error(Error::IncompleteSet, "tf and primaries required");
+                    data_init.init(
+                        image_description,
+                        ImageDescData {
+                            desc: None,
+                            info: false,
+                        },
+                    );
+                    return;
+                };
+                if let (Some(cll), Some(fall)) = (p.max_cll, p.max_fall) {
+                    if fall > cll {
+                        resource.post_error(Error::InvalidLuminance, "max_fall > max_cll");
+                    }
+                }
+                let (min_lum, max_lum, ref_lum) = p.lum.unwrap_or(match tf {
+                    Tf::Pq => (0.005, 10000., 203.),
+                    Tf::Hlg => (0.005, 1000., 203.),
+                    Tf::Gamma(2.4) => (0.01, 100., 100.),
+                    _ => (0.2, 80., 80.),
+                });
+                let max_lum = if tf == Tf::Pq {
+                    min_lum + 10000.
+                } else {
+                    max_lum
+                };
+                let desc = ColorDesc {
+                    tf,
+                    primaries,
+                    min_lum,
+                    max_lum,
+                    ref_lum,
+                    target_max: p.max_cll.or(p.mastering_max).filter(|&m| m > 0.),
+                };
+                init_desc(data_init, image_description, Some(desc), false);
+            }
+            Request::SetTfNamed { tf } => {
+                if p.tf.is_some() {
+                    return already_set();
+                }
+                match tf.into_result().ok().and_then(named_tf) {
+                    Some(tf) => p.tf = Some(tf),
+                    None => resource.post_error(Error::InvalidTf, "unsupported tf"),
+                }
+            }
+            Request::SetTfPower { eexp } => {
+                if p.tf.is_some() {
+                    return already_set();
+                }
+                if !(10000..=100000).contains(&eexp) {
+                    resource.post_error(Error::InvalidTf, "exponent out of range");
+                    return;
+                }
+                p.tf = Some(Tf::Gamma(eexp as f32 / 10000.));
+            }
+            Request::SetPrimariesNamed { primaries } => {
+                if p.primaries.is_some() {
+                    return already_set();
+                }
+                match NAMED_PRIMARIES
+                    .iter()
+                    .find(|(n, _)| WEnum::Value(*n) == primaries)
+                {
+                    Some((_, v)) => p.primaries = Some(*v),
+                    None => resource.post_error(Error::InvalidPrimariesNamed, "unsupported"),
+                }
+            }
+            Request::SetPrimaries {
+                r_x,
+                r_y,
+                g_x,
+                g_y,
+                b_x,
+                b_y,
+                w_x,
+                w_y,
+            } => {
+                if p.primaries.is_some() {
+                    return already_set();
+                }
+                p.primaries = Some([r_x, r_y, g_x, g_y, b_x, b_y, w_x, w_y].map(xy));
+            }
+            Request::SetLuminances {
+                min_lum,
+                max_lum,
+                reference_lum,
+            } => {
+                if p.lum.is_some() {
+                    return already_set();
+                }
+                let min = min_lum as f32 / 10000.;
+                let (max, reference) = (max_lum as f32, reference_lum as f32);
+                if max <= min || reference <= min {
+                    resource.post_error(Error::InvalidLuminance, "invalid luminance");
+                    return;
+                }
+                p.lum = Some((min, max, reference));
+            }
+            Request::SetMasteringDisplayPrimaries { .. } => {
+                if p.mastering_primaries {
+                    return already_set();
+                }
+                p.mastering_primaries = true;
+            }
+            Request::SetMasteringLuminance { max_lum, .. } => {
+                if p.mastering_max.is_some() {
+                    return already_set();
+                }
+                p.mastering_max = Some(max_lum as f32);
+            }
+            Request::SetMaxCll { max_cll } => {
+                if p.max_cll.is_some() {
+                    return already_set();
+                }
+                p.max_cll = Some(max_cll as f32);
+            }
+            Request::SetMaxFall { max_fall } => {
+                if p.max_fall.is_some() {
+                    return already_set();
+                }
+                p.max_fall = Some(max_fall as f32);
+            }
+            _ => unreachable!(),
+        }
+    }
+}
+
+impl<D> Dispatch2<WpImageDescriptionV1, D> for ImageDescData
+where
+    D: Dispatch<WpImageDescriptionInfoV1, EmptyData>,
+    D: ColorManagementHandler,
+    D: 'static,
+{
+    fn request(
+        &self,
+        state: &mut D,
+        _client: &Client,
+        resource: &WpImageDescriptionV1,
+        request: <WpImageDescriptionV1 as Resource>::Request,
+        _dhandle: &DisplayHandle,
+        data_init: &mut DataInit<'_, D>,
+    ) {
+        use wp_image_description_v1::{Error, Request};
+
+        match request {
+            Request::GetInformation { information } => {
+                let info = data_init.init(information, EmptyData);
+                let Some(desc) = self.desc else {
+                    resource.post_error(Error::NotReady, "image description failed");
+                    return;
+                };
+                if !self.info {
+                    resource.post_error(Error::NoInformation, "get_information not allowed");
+                    return;
+                }
+                send_info(&info, &desc);
+                state.color_management_state().pending_done.push(info);
+            }
+            Request::Destroy => (),
+            _ => unreachable!(),
+        }
+    }
+}
+
+fn send_info(info: &WpImageDescriptionInfoV1, desc: &ColorDesc) {
+    let p = desc.primaries.map(|v| (v * 1_000_000.).round() as i32);
+    info.primaries(p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7]);
+    if let Some((named, _)) = NAMED_PRIMARIES.iter().find(|(_, v)| *v == desc.primaries) {
+        info.primaries_named(*named);
+    }
+    match desc.tf {
+        Tf::Gamma(2.2) => info.tf_named(TransferFunction::Gamma22),
+        Tf::Gamma(g) => info.tf_power((g * 10000.).round() as u32),
+        Tf::Pq => info.tf_named(TransferFunction::St2084Pq),
+        Tf::Hlg => info.tf_named(TransferFunction::Hlg),
+        Tf::Linear => info.tf_named(TransferFunction::ExtLinear),
+    }
+    let min = (desc.min_lum * 10000.).round() as u32;
+    info.luminances(min, desc.max_lum as u32, desc.ref_lum as u32);
+    info.target_primaries(p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7]);
+    info.target_luminance(min, desc.max_lum as u32);
+}
+
+impl<D> Dispatch2<WpImageDescriptionInfoV1, D> for EmptyData {
+    fn request(
+        &self,
+        _state: &mut D,
+        _client: &Client,
+        _resource: &WpImageDescriptionInfoV1,
+        _request: <WpImageDescriptionInfoV1 as Resource>::Request,
+        _dhandle: &DisplayHandle,
+        _data_init: &mut DataInit<'_, D>,
+    ) {
+        unreachable!()
+    }
+}
+
+impl<D> Dispatch2<WpImageDescriptionCreatorIccV1, D> for EmptyData {
+    fn request(
+        &self,
+        _state: &mut D,
+        _client: &Client,
+        _resource: &WpImageDescriptionCreatorIccV1,
+        _request: <WpImageDescriptionCreatorIccV1 as Resource>::Request,
+        _dhandle: &DisplayHandle,
+        _data_init: &mut DataInit<'_, D>,
+    ) {
+        unreachable!()
+    }
+}
