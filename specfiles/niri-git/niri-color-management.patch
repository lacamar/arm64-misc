diff --git a/src/render_helpers/color.rs b/src/render_helpers/color.rs
new file mode 100644
index 0000000..b1d07f1
--- /dev/null
+++ b/src/render_helpers/color.rs
@@ -0,0 +1,214 @@
+use std::cell::Cell;
+
+use glam::{Mat3, Vec3};
+use smithay::backend::renderer::gles::Uniform;
+use smithay::output::Output;
+
+use super::shaders::mat3_uniform;
+
+pub const SRGB: [f32; 8] = [0.64, 0.33, 0.30, 0.60, 0.15, 0.06, 0.3127, 0.3290];
+pub const DISPLAY_P3: [f32; 8] = [0.680, 0.320, 0.265, 0.690, 0.150, 0.060, 0.3127, 0.3290];
+pub const DCI_P3: [f32; 8] = [0.680, 0.320, 0.265, 0.690, 0.150, 0.060, 0.314, 0.351];
+pub const BT2020: [f32; 8] = [0.708, 0.292, 0.170, 0.797, 0.131, 0.046, 0.3127, 0.3290];
+pub const ADOBE_RGB: [f32; 8] = [0.64, 0.33, 0.21, 0.71, 0.15, 0.06, 0.3127, 0.3290];
+
+const REF_NITS: f32 = 203.;
+
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Hdr {
+    pub sdr_nits: f32,
+    pub max_nits: f32,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum Tf {
+    Gamma(f32),
+    Pq,
+    Hlg,
+    Linear,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct ColorDesc {
+    pub tf: Tf,
+    pub primaries: [f32; 8],
+    pub min_lum: f32,
+    pub max_lum: f32,
+    pub ref_lum: f32,
+    pub target_max: Option<f32>,
+}
+
+impl ColorDesc {
+    pub const SRGB: Self = Self {
+        tf: Tf::Gamma(2.2),
+        primaries: SRGB,
+        min_lum: 0.2,
+        max_lum: 80.,
+        ref_lum: 80.,
+        target_max: None,
+    };
+
+    pub fn output(wide_gamut: bool, hdr: Option<Hdr>) -> Self {
+        match hdr {
+            Some(hdr) => Self {
+                tf: Tf::Pq,
+                primaries: BT2020,
+                min_lum: 0.005,
+                max_lum: 10000.,
+                ref_lum: hdr.sdr_nits,
+                target_max: Some(hdr.max_nits),
+            },
+            None => Self {
+                primaries: if wide_gamut { DISPLAY_P3 } else { SRGB },
+                ..Self::SRGB
+            },
+        }
+    }
+
+    // HDR outputs render to an extended-range sRGB buffer, PQ-encoded in a final pass.
+    fn render_target(wide_gamut: bool, hdr: Option<Hdr>) -> Self {
+        match hdr {
+            Some(hdr) => Self {
+                max_lum: hdr.max_nits,
+                ref_lum: hdr.sdr_nits,
+                ..Self::SRGB
+            },
+            None => Self::output(wide_gamut, None),
+        }
+    }
+
+    fn peak(&self) -> f32 {
+        // ponytail: unknown HDR peak assumed 1000 nits, no dynamic peak detection.
+        let max = self.target_max.unwrap_or(self.max_lum.min(1000.));
+        max.max(self.ref_lum) / self.ref_lum
+    }
+}
+
+// Rendering happens one output at a time; screenshots and screencasts stay sRGB.
+thread_local! {
+    static TARGET: Cell<ColorDesc> = const { Cell::new(ColorDesc::SRGB) };
+}
+
+pub fn set_target(wide_gamut: bool, hdr: Option<Hdr>) {
+    TARGET.set(ColorDesc::render_target(wide_gamut, hdr));
+}
+
+pub fn target() -> ColorDesc {
+    TARGET.get()
+}
+
+struct OutputHdr(Cell<Option<Hdr>>);
+
+pub fn output_hdr(output: &Output) -> Option<Hdr> {
+    output
+        .user_data()
+        .get::<OutputHdr>()
+        .and_then(|x| x.0.get())
+}
+
+pub fn set_output_hdr(output: &Output, hdr: Option<Hdr>) {
+    let data = output.user_data();
+    data.insert_if_missing(|| OutputHdr(Cell::new(None)));
+    data.get::<OutputHdr>().unwrap().0.set(hdr);
+}
+
+fn xy_to_xyz(x: f32, y: f32) -> Vec3 {
+    Vec3::new(x / y, 1., (1. - x - y) / y)
+}
+
+fn rgb_to_xyz(p: &[f32; 8]) -> Mat3 {
+    let m = Mat3::from_cols(
+        xy_to_xyz(p[0], p[1]),
+        xy_to_xyz(p[2], p[3]),
+        xy_to_xyz(p[4], p[5]),
+    );
+    let s = m.inverse() * xy_to_xyz(p[6], p[7]);
+    m * Mat3::from_diagonal(s)
+}
+
+fn adapt(from: Vec3, to: Vec3) -> Mat3 {
+    let bradford = Mat3::from_cols_array(&[
+        0.8951, -0.7502, 0.0389, 0.2664, 1.7135, -0.0685, -0.1614, 0.0367, 1.0296,
+    ]);
+    let scale = (bradford * to) / (bradford * from);
+    bradford.inverse() * Mat3::from_diagonal(scale) * bradford
+}
+
+fn pq_oetf(nits: f32) -> f32 {
+    let (m1, m2, c1, c2, c3) = (0.159_301_76, 78.84375, 0.8359375, 18.851_563, 18.6875);
+    let p = (nits / 10000.).max(0.).powf(m1);
+    ((c1 + c2 * p) / (1. + c3 * p)).powf(m2)
+}
+
+pub fn conversion(src: &ColorDesc, dst: &ColorDesc) -> Option<Vec<Uniform<'static>>> {
+    let gamut = src.primaries == dst.primaries;
+    let src_scale = src.max_lum / src.ref_lum;
+    let src_peak = src.peak();
+    let dst_peak = dst.max_lum / dst.ref_lum;
+    if src.tf == dst.tf && gamut && src_scale == 1. && src_peak <= dst_peak {
+        return None;
+    }
+
+    let (sp, dp) = (&src.primaries, &dst.primaries);
+    let mut mat = rgb_to_xyz(dp).inverse();
+    if (sp[6], sp[7]) != (dp[6], dp[7]) {
+        mat *= adapt(xy_to_xyz(sp[6], sp[7]), xy_to_xyz(dp[6], dp[7]));
+    }
+    mat *= rgb_to_xyz(sp) * src_scale;
+
+    let (kind, gamma) = match src.tf {
+        Tf::Gamma(g) => (0., g),
+        Tf::Pq => (1., 1.),
+        Tf::Hlg => (2., 1.),
+        Tf::Linear => (3., 1.),
+    };
+    let Tf::Gamma(out_gamma) = dst.tf else {
+        unreachable!()
+    };
+
+    Some(vec![
+        mat3_uniform("cm_mat", mat),
+        Uniform::new("cm_tf", (kind, gamma)),
+        Uniform::new(
+            "cm_tm",
+            (pq_oetf(src_peak * REF_NITS), pq_oetf(dst_peak * REF_NITS)),
+        ),
+        Uniform::new("cm_out", (out_gamma, dst_peak)),
+    ])
+}
+
+pub fn hdr_output_uniforms(hdr: Hdr) -> Vec<Uniform<'static>> {
+    let mat = rgb_to_xyz(&BT2020).inverse() * rgb_to_xyz(&SRGB) * (hdr.sdr_nits / 10000.);
+    vec![mat3_uniform("hdr_mat", mat)]
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn srgb_to_p3() {
+        let m = rgb_to_xyz(&DISPLAY_P3).inverse() * rgb_to_xyz(&SRGB);
+        let red = m * Vec3::X;
+        assert!(
+            (red - Vec3::new(0.8225, 0.0332, 0.0171))
+                .abs()
+                .max_element()
+                < 1e-3
+        );
+        assert!((m * Vec3::ONE - Vec3::ONE).abs().max_element() < 1e-4);
+        assert!(conversion(&ColorDesc::SRGB, &ColorDesc::SRGB).is_none());
+        assert!(conversion(&ColorDesc::SRGB, &ColorDesc::output(true, None)).is_some());
+
+        let hdr = Hdr {
+            sdr_nits: 203.,
+            max_nits: 500.,
+        };
+        let target = ColorDesc::render_target(false, Some(hdr));
+        assert!(conversion(&ColorDesc::SRGB, &target).is_none());
+        assert!(conversion(&ColorDesc::output(false, Some(hdr)), &target).is_some());
+        let white = rgb_to_xyz(&BT2020).inverse() * rgb_to_xyz(&SRGB) * Vec3::ONE;
+        assert!((white - Vec3::ONE).abs().max_element() < 1e-4);
+        assert!((pq_oetf(10000.) - 1.).abs() < 1e-4);
+    }
+}
diff --git a/src/render_helpers/hdr_output.rs b/src/render_helpers/hdr_output.rs
new file mode 100644
index 0000000..aaa5905
--- /dev/null
+++ b/src/render_helpers/hdr_output.rs
@@ -0,0 +1,150 @@
+use smithay::backend::allocator::Fourcc;
+use smithay::backend::renderer::damage::OutputDamageTracker;
+use smithay::backend::renderer::element::{Element, Id, RenderElement, RenderElementStates};
+use smithay::backend::renderer::gles::GlesTexture;
+use smithay::backend::renderer::utils::CommitCounter;
+use smithay::backend::renderer::Bind;
+use smithay::output::Output;
+use smithay::utils::user_data::UserDataMap;
+use smithay::utils::{Buffer, Physical, Rectangle, Scale, Size, Transform};
+
+use super::color::{self, Hdr};
+use super::create_texture;
+use super::renderer::{AsGlesFrame, AsGlesRenderer};
+use super::shaders::Shaders;
+use crate::backend::tty::{TtyFrame, TtyRenderer, TtyRendererError};
+
+// ponytail: full-output damage and no direct scanout while HDR is on.
+pub struct HdrRender {
+    texture: GlesTexture,
+    damage_tracker: OutputDamageTracker,
+    size: Size<i32, Physical>,
+    scale: f64,
+    age: usize,
+    id: Id,
+    commit: CommitCounter,
+}
+
+#[derive(Debug)]
+pub struct HdrOutputElement {
+    texture: GlesTexture,
+    size: Size<i32, Physical>,
+    id: Id,
+    commit: CommitCounter,
+    hdr: Hdr,
+}
+
+impl HdrRender {
+    pub fn render<'r, E: RenderElement<TtyRenderer<'r>>>(
+        this: &mut Option<Self>,
+        renderer: &mut TtyRenderer<'r>,
+        output: &Output,
+        elements: &[E],
+        hdr: Hdr,
+    ) -> Result<(HdrOutputElement, RenderElementStates), TtyRendererError<'r>> {
+        let mode = output.current_mode().unwrap();
+        let size = output.current_transform().transform_size(mode.size);
+        let scale = output.current_scale().fractional_scale();
+
+        if this
+            .as_ref()
+            .is_none_or(|x| (x.size, x.scale) != (size, scale))
+        {
+            let texture = create_texture(renderer.as_gles_renderer(), size, Fourcc::Abgr16161616f)?;
+            *this = Some(Self {
+                texture,
+                damage_tracker: OutputDamageTracker::new(size, scale, Transform::Normal),
+                size,
+                scale,
+                age: 0,
+                id: Id::new(),
+                commit: CommitCounter::default(),
+            });
+        }
+        let this = this.as_mut().unwrap();
+
+        let mut texture = this.texture.clone();
+        let mut fb = renderer.bind(&mut texture)?;
+        let res = this.damage_tracker.render_output(
+            renderer,
+            &mut fb,
+            this.age,
+            elements,
+            [0., 0., 0., 1.],
+        );
+        let res = res.map_err(|err| match err {
+            smithay::backend::renderer::damage::Error::Rendering(err) => err,
+            smithay::backend::renderer::damage::Error::OutputNoMode(_) => unreachable!(),
+        })?;
+        this.age = 1;
+        if res.damage.is_some_and(|d| !d.is_empty()) {
+            this.commit.increment();
+        }
+
+        let elem = HdrOutputElement {
+            texture: this.texture.clone(),
+            size,
+            id: this.id.clone(),
+            commit: this.commit,
+            hdr,
+        };
+        Ok((elem, res.states))
+    }
+}
+
+impl Element for HdrOutputElement {
+    fn id(&self) -> &Id {
+        &self.id
+    }
+
+    fn current_commit(&self) -> CommitCounter {
+        self.commit
+    }
+
+    fn geometry(&self, _scale: Scale<f64>) -> Rectangle<i32, Physical> {
+        Rectangle::from_size(self.size)
+    }
+
+    fn src(&self) -> Rectangle<f64, Buffer> {
+        Rectangle::from_size(
+            self.size
+                .to_f64()
+                .to_logical(1.)
+                .to_buffer(1., Transform::Normal),
+        )
+    }
+
+    fn opaque_regions(
+        &self,
+        scale: Scale<f64>,
+    ) -> smithay::backend::renderer::utils::OpaqueRegions<i32, Physical> {
+        smithay::backend::renderer::utils::OpaqueRegions::from_slice(&[self.geometry(scale)])
+    }
+}
+
+impl<'render> RenderElement<TtyRenderer<'render>> for HdrOutputElement {
+    fn draw(
+        &self,
+        frame: &mut TtyFrame<'_, '_, '_>,
+        src: Rectangle<f64, Buffer>,
+        dst: Rectangle<i32, Physical>,
+        damage: &[Rectangle<i32, Physical>],
+        opaque_regions: &[Rectangle<i32, Physical>],
+        _cache: Option<&UserDataMap>,
+    ) -> Result<(), TtyRendererError<'render>> {
+        let frame = frame.as_gles_frame();
+        let program = Shaders::get_from_frame(frame).hdr_output.clone();
+        frame.render_texture_from_to(
+            &self.texture,
+            src,
+            dst,
+            damage,
+            opaque_regions,
+            Transform::Normal,
+            1.,
+            program.as_ref(),
+            &color::hdr_output_uniforms(self.hdr),
+        )?;
+        Ok(())
+    }
+}
