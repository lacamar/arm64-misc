new file mode 100644
index 0000000..f005122
--- /dev/null
+++ b/src/render_helpers/shaders/color.frag
@@ -0,0 +1,71 @@
+
+uniform mat3 cm_mat;
+uniform vec2 cm_tf;
+uniform vec2 cm_tm;
+uniform vec2 cm_out;
+
+const float CM_M1 = 0.1593017578125;
+const float CM_M2 = 78.84375;
+const float CM_C1 = 0.8359375;
+const float CM_C2 = 18.8515625;
+const float CM_C3 = 18.6875;
+const float CM_REF = 203.0 / 10000.0;
+
+vec3 cm_pq_eotf(vec3 v) {
+    vec3 p = pow(max(v, 0.0), vec3(1.0 / CM_M2));
+    return pow(max(p - CM_C1, 0.0) / (CM_C2 - CM_C3 * p), vec3(1.0 / CM_M1));
+}
+
+float cm_pq_oetf(float l) {
+    float p = pow(max(l, 0.0), CM_M1);
+    return pow((CM_C1 + CM_C2 * p) / (1.0 + CM_C3 * p), CM_M2);
+}
+
+vec3 cm_hlg_eotf(vec3 v) {
+    vec3 lo = v * v / 3.0;
+    vec3 hi = (exp((v - 0.55991073) / 0.17883277) + 0.28466892) / 12.0;
+    vec3 s = mix(lo, hi, step(0.5, v));
+    float y = dot(s, vec3(0.2627, 0.6780, 0.0593));
+    return s * pow(max(y, 1e-6), 0.2);
+}
+
+vec3 cm_decode(vec3 c) {
+    if (cm_tf.x == 1.0)
+        return cm_pq_eotf(c);
+    if (cm_tf.x == 2.0)
+        return cm_hlg_eotf(max(c, 0.0));
+    if (cm_tf.x == 3.0)
+        return c;
+    return sign(c) * pow(abs(c), vec3(cm_tf.y));
+}
+
+// BT.2390 EETF on maxRGB.
+vec3 cm_tone_map(vec3 c) {
+    float m = max(max(c.r, c.g), c.b);
+    if (cm_tm.x <= cm_tm.y || m <= 0.0)
+        return c;
+
+    float e = min(cm_pq_oetf(m * CM_REF) / cm_tm.x, 1.0);
+    float max_lum = cm_tm.y / cm_tm.x;
+    float ks = 1.5 * max_lum - 0.5;
+    if (e > ks) {
+        float t = (e - ks) / (1.0 - ks);
+        float t2 = t * t;
+        float t3 = t2 * t;
+        e = (2.0 * t3 - 3.0 * t2 + 1.0) * ks + (t3 - 2.0 * t2 + t) * (1.0 - ks)
+            + (-2.0 * t3 + 3.0 * t2) * max_lum;
+    }
+    float l = cm_pq_eotf(vec3(e * cm_tm.x)).r / CM_REF;
+    return c * (l / m);
+}
+
+vec4 cm_convert(vec4 color) {
+    if (color.a <= 0.0)
+        return color;
+
+    vec3 c = cm_mat * cm_decode(color.rgb / color.a);
+    // ponytail: hard gamut clip, no perceptual gamut mapping.
+    c = cm_tone_map(max(c, 0.0));
+    c = pow(min(c * cm_out.y, 1.0), vec3(1.0 / cm_out.x));
+    return vec4(c * color.a, color.a);
+}
