+}
+
+fn wanted_hdr(
+    config: &Config,
+    name: &OutputName,
+    single_gpu: bool,
+    format: Fourcc,
+) -> Option<color::Hdr> {
+    let is_10bit = matches!(format, Fourcc::Abgr2101010 | Fourcc::Argb2101010);
+    if !single_gpu || !is_10bit {
+        return None;
+    }
+    let hdr = config.outputs.find(name)?.hdr.as_ref()?;
+    Some(color::Hdr {
+        sdr_nits: hdr.sdr_luminance.0 as f32,
+        max_nits: hdr.max_luminance.0 as f32,
+    })
 }
 
