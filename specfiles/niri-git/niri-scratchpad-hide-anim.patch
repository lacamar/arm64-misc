+    pub fn with_scratchpad_hide_animation(&mut self, f: impl FnOnce(&mut Layout<Mapped>)) {
+        let shown = self.niri.layout.scratchpads_on_screen();
+        for (output, _, window, _) in &shown {
+            self.store_unmap_snapshot(window, output.as_ref());
+        }
+        f(&mut self.niri.layout);
+        for (_, ws_id, window, pos) in shown {
+            if self.niri.layout.is_in_scratchpad(&window) {
+                self.backend.with_primary_renderer(|renderer| {
+                    self.niri
+                        .layout
+                        .start_scratchpad_hide_animation(renderer, ws_id, &window, pos);
+                });
+            } else {
+                self.niri.layout.clear_unmap_snapshot(&window);
+            }
+        }
+    }
