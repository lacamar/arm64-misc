+    pub fn scratchpads_on_screen(
+        &self,
+    ) -> Vec<(Option<Output>, WorkspaceId, W::Id, Point<f64, Logical>)> {
+        self.workspaces()
+            .filter(|(_, _, ws)| ws.is_floating_visible())
+            .flat_map(|(mon, _, ws)| {
+                let output = mon.map(|mon| mon.output().clone());
+                ws.tiles_with_render_positions()
+                    .filter(|(tile, _, _)| {
+                        tile.is_scratchpad && ws.is_floating(tile.window().id())
+                    })
+                    .map(move |(tile, pos, _)| {
+                        (output.clone(), ws.id(), tile.window().id().clone(), pos)
+                    })
+            })
+            .collect()
+    }
+
+    pub fn start_scratchpad_hide_animation(
+        &mut self,
+        renderer: &mut BaseRenderer,
+        ws_id: WorkspaceId,
+        window: &W::Id,
+        tile_pos: Point<f64, Logical>,
+    ) {
+        let Some(idx) = self.scratchpad_idx(window) else {
+            return;
+        };
+        let tile = &mut self.scratchpad[idx].tile;
+        let Some(snapshot) = tile.take_unmap_snapshot() else {
+            return;
+        };
+        let tile_size = tile.tile_size();
+        if let Some(ws) = self.workspaces_mut().find(|ws| ws.id() == ws_id) {
+            ws.start_close_animation_for_tile(
+                renderer,
+                snapshot,
+                tile_size,
+                tile_pos,
+                TransactionBlocker::completed(),
+            );
+        }
+    }
