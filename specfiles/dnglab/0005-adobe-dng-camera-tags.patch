+/// Adobe DNG Converter's per-camera tags, where the camera config provides them.
+fn write_camera_dng_tags<W: Write + Seek + Send>(dng: &mut DngWriter<W>, rawimage: &RawImage) {
+  let camera = &rawimage.camera;
+  let root = dng.root_ifd_mut();
+  root.add_tag(DngTag::AnalogBalance, [Rational::new(1, 1), Rational::new(1, 1), Rational::new(1, 1)]);
+  root.add_tag(DngTag::LinearResponseLimit, Rational::new(1, 1));
+  root.add_tag(DngTag::ShadowScale, Rational::new(1, 1));
+  if let Some(v) = camera.param_f64("dng_baseline_exposure") {
+    root.add_tag(DngTag::BaselineExposure, SRational::new((v * 100.0).round() as i32, 100));
+  }
+  if let Some(v) = camera.param_f64("dng_baseline_noise") {
+    root.add_tag(DngTag::BaselineNoise, Rational::new((v * 100.0).round() as u32, 100));
+  }
+  if let Some(v) = camera.param_f64("dng_baseline_sharpness") {
+    root.add_tag(DngTag::BaselineSharpness, Rational::new((v * 100.0).round() as u32, 100));
+  }
+  if let Some(m) = camera.param_f64_array("dng_camera_calibration").filter(|m| m.len() == 9) {
+    let m: Vec<SRational> = m.iter().map(|v| SRational::new((v * 10000.0).round() as i32, 10000)).collect();
+    root.add_tag(DngTag::CameraCalibration1, m.as_slice());
+    root.add_tag(DngTag::CameraCalibration2, m.as_slice());
+    if let Some(sig) = camera.param_str("dng_camera_calibration_signature") {
+      root.add_tag(DngTag::CameraCalibrationSignature, sig);
+    }
+  }
+  if let Some(v) = camera.param_f64("focal_plane_resolution") {
+    let exif = dng.exif_ifd_mut();
+    if !exif.contains(ExifTag::FocalPlaneXResolution2) {
+      let res = Rational::new((v * 32768.0).round() as u32, 32768);
+      exif.add_tag(ExifTag::FocalPlaneXResolution2, res);
+      exif.add_tag(ExifTag::FocalPlaneYResolution2, res);
+      exif.add_tag(ExifTag::FocalPlaneResolutionUnit2, 3_u16);
+    }
+  }
+}
