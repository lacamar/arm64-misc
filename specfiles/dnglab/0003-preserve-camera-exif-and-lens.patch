-  /// Overwrite the lens information with the resolved lens description.
-  ///
-  /// This is only called when the lens resolver was able to find a matching
-  /// lens in the database. Otherwise the lens information parsed from the
-  /// source EXIF data (if any) is kept.
+  /// Fill in lens information from the resolved lens description, but only
+  /// where the camera left it out: lens profile matching (e.g. Lightroom)
+  /// keys on the camera's own LensModel/LensSpecification strings.
   pub(crate) fn extend_from_lens(&mut self, lens: &LensDescription) {
+    if self.lens_model.is_some() {
+      return;
+    }
     let lens_info: [Rational; 4] = [lens.focal_range[0], lens.focal_range[1], lens.aperture_range[0], lens.aperture_range[1]];
-    self.lens_spec = Some(lens_info);
-    self.lens_make = Some(lens.lens_make.clone());
+    self.lens_spec.get_or_insert(lens_info);
+    self.lens_make.get_or_insert_with(|| lens.lens_make.clone());
     self.lens_model = Some(lens.lens_model.clone());
   }
+
+  /// Derive APEX values the camera didn't record, like Adobe DNG Converter.
+  pub(crate) fn fill_apex_values(&mut self) {
+    if self.aperture_value.is_none() {
+      if let Some(f) = self.fnumber.filter(|f| f.n > 0 && f.d > 0) {
+        let av = 2.0 * (f.n as f64 / f.d as f64).log2();
+        if av >= 0.0 {
+          self.aperture_value = Some(Rational::new((av * 1_000_000.0).round() as u32, 1_000_000));
+        }
+      }
+    }
+    if self.shutter_speed_value.is_none() {
+      if let Some(t) = self.exposure_time.filter(|t| t.n > 0 && t.d > 0) {
+        let tv = -(t.n as f64 / t.d as f64).log2();
+        self.shutter_speed_value = Some(SRational::new((tv * 1_000_000.0).round() as i32, 1_000_000));
+      }
+    }
+  }
 }
