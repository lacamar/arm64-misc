+# Bundling Qt/ICU/Wayland .so files and the whole qml/plugins tree next to the
+# binary (DeployLinux.cmake, and Qt's own qt_generate_deploy_app_script/
+# qt6_deploy_runtime_dependencies) is for portable, unpackaged distribution.
+# It also hardcodes Debian/Ubuntu-style paths and exact upstream Qt Online
+# Installer library filenames (e.g. libicui18n.so.73), which don't match a
+# distro's own Qt6 packages (Fedora keeps 64-bit libs in /usr/lib64, not
+# /usr/lib, and ships whatever ICU version it currently has, not .73). A
+# proper distro package should link against the system Qt6 instead and let
+# the package manager's automatic library dependencies (Requires:) handle
+# runtime linkage, so this is skippable entirely there.
+option(BRIDGE_GUI_BUNDLE_QT "Bundle Qt/ICU/QML runtime files next to the binary instead of relying on a system Qt install" ON)
+if (BRIDGE_GUI_BUNDLE_QT)
+    qt_generate_deploy_app_script(
+            TARGET bridge-gui
+            OUTPUT_SCRIPT deploy_script
+            NO_UNSUPPORTED_PLATFORM_ERROR)
 
