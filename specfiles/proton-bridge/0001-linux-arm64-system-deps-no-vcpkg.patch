@@ -168,6 +175,15 @@
 # GoogleTest
 #*****************************************************************************************************************************************************
 
+# Fetched unconditionally upstream, which means `cmake` needs network access
+# to github.com just to *configure* bridgepp, even for consumers who only
+# want the bridgepp library and never build bridgepp-test (which is already
+# EXCLUDE_FROM_ALL). Gated behind BUILD_TESTING (default ON, matching CMake's
+# usual convention) so an offline/package build can pass -DBUILD_TESTING=OFF
+# and skip the fetch entirely.
+option(BUILD_TESTING "Build bridgepp-test (fetches GoogleTest from network)" ON)
+if (BUILD_TESTING)
+
 if (CMAKE_VERSION VERSION_GREATER_EQUAL "3.24.0")
     cmake_policy(SET CMP0135 NEW) # avoid warning DOWNLOAD_EXTRACT_TIMESTAMP
 endif ()
@@ -205,3 +221,5 @@
 
 include(GoogleTest)
 gtest_discover_tests(bridgepp-test)
+
+endif (BUILD_TESTING)
