[Unit]
Description=Join the iPhone's Personal Hotspot when offline
After=dbus.socket

[Service]
Type=exec
ExecStart=/usr/bin/instant-hotspot
Restart=always
RestartSec=30
# it sits on a D-Bus signal in a few MB; a leak must not hurt the session
MemoryHigh=64M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_BLUETOOTH AF_NETLINK

[Install]
WantedBy=default.target
