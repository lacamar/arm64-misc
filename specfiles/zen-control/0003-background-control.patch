diff --git a/extension/popup.js b/extension/popup.js
index c6ba81d..2002b7c 100644
--- a/extension/popup.js
+++ b/extension/popup.js
@@ -31,7 +31,34 @@ function render() {
   if (!settings.allowedSites.length) ul.innerHTML = '<li class="muted">None</li>';
 }
 
+async function renderPrompts() {
+  const hosts = await browser.runtime.sendMessage({ type: "prompts_query" });
+  document.getElementById("prompts").replaceChildren(...hosts.map((h) => {
+    const div = document.createElement("div");
+    div.className = "prompt";
+    const q = document.createElement("p");
+    q.textContent = `Allow Claude to read and act on ${h}, including pages where you are logged in?`;
+    const row = document.createElement("div");
+    row.className = "row";
+    for (const [decision, label] of [["deny", "Deny"], ["once", "Allow once"], ["always", "Always allow"]]) {
+      const b = document.createElement("button");
+      b.textContent = label;
+      if (decision === "always") b.className = "primary";
+      b.addEventListener("click", async () => {
+        await browser.runtime.sendMessage({ type: "site_decision", host: h, decision });
+        if (decision === "always") settings = { ...settings, allowedSites: [...new Set([...settings.allowedSites, h])] };
+        div.remove();
+        render();
+      });
+      row.append(b);
+    }
+    div.append(q, row);
+    return div;
+  }));
+}
+
 (async () => {
+  renderPrompts();
   settings = { allSites: false, allowedSites: [], ...(await browser.storage.local.get("settings")).settings };
   [tab] = await browser.tabs.query({ active: true, currentWindow: true });
   const state = await browser.runtime.sendMessage({ type: "marker_query", tabId: tab.id });
