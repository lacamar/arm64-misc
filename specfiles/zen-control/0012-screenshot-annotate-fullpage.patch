+function markUp(ctx, marks, ox, oy, k) {
+  ctx.lineWidth = 3;
+  ctx.font = "bold 14px sans-serif";
+  ctx.textBaseline = "top";
+  for (const m of marks) {
+    const c = (v, max) => Math.min(Math.max(v, 1.5), max - 1.5);
+    const x = c((m.x - ox) * k - 1.5, ctx.canvas.width), y = c((m.y - oy) * k - 1.5, ctx.canvas.height);
+    const w = c((m.x + m.width - ox) * k + 1.5, ctx.canvas.width) - x, h = c((m.y + m.height - oy) * k + 1.5, ctx.canvas.height) - y;
+    ctx.strokeStyle = ctx.fillStyle = m.color;
+    ctx.strokeRect(x, y, w, h);
+    if (!m.label) continue;
+    const ly = y >= 22 ? y - 22 : y + h + 22 <= ctx.canvas.height ? y + h + 2 : y + 2;
+    ctx.fillRect(x, ly, ctx.measureText(m.label).width + 10, 20);
+    ctx.fillStyle = "#fff";
+    ctx.fillText(m.label, x + 5, ly + 3);
+  }
+}
