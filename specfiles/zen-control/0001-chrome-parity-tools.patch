diff --git a/extension/gif.js b/extension/gif.js
new file mode 100644
index 0000000..de7f195
--- /dev/null
+++ b/extension/gif.js
@@ -0,0 +1,65 @@
+/* Zen Control — minimal animated GIF encoder (fixed 6x7x6 palette, no dithering). */
+function encodeGif(frames, width, height, delayMs) {
+  const out = [];
+  const bytes = (...b) => { for (const x of b) out.push(x & 255); };
+  const u16 = (n) => bytes(n, n >> 8);
+  for (const c of "GIF89a") out.push(c.charCodeAt(0));
+  u16(width); u16(height);
+  bytes(0xf7, 0, 0);
+  for (let i = 0; i < 256; i++) {
+    if (i < 252) bytes(Math.round(Math.floor(i / 42) * 51), Math.round((Math.floor(i / 6) % 7) * 42.5), (i % 6) * 51);
+    else bytes(0, 0, 0);
+  }
+  bytes(0x21, 0xff, 11); for (const c of "NETSCAPE2.0") out.push(c.charCodeAt(0)); bytes(3, 1, 0, 0, 0);
+  frames.forEach((rgba, f) => {
+    const delay = Math.round((f === frames.length - 1 ? Math.max(delayMs, 2000) : delayMs) / 10);
+    bytes(0x21, 0xf9, 4, 0, delay, delay >> 8, 0, 0);
+    bytes(0x2c); u16(0); u16(0); u16(width); u16(height); bytes(0);
+    const idx = new Uint8Array(width * height);
+    for (let i = 0, p = 0; i < idx.length; i++, p += 4) {
+      idx[i] = Math.round(rgba[p] / 51) * 42 + Math.round(rgba[p + 1] / 42.5) * 6 + Math.round(rgba[p + 2] / 51);
+    }
+    bytes(8);
+    const data = lzw(idx, 8);
+    for (let i = 0; i < data.length; i += 255) {
+      const n = Math.min(255, data.length - i);
+      out.push(n);
+      for (let j = 0; j < n; j++) out.push(data[i + j]);
+    }
+    bytes(0);
+  });
+  bytes(0x3b);
+  return new Uint8Array(out);
+}
+
+function lzw(indices, minCodeSize) {
+  const clear = 1 << minCodeSize, eoi = clear + 1;
+  let codeSize = minCodeSize + 1, next = eoi + 1;
+  let dict = new Map();
+  const out = [];
+  let cur = 0, bits = 0;
+  const emit = (c) => { cur |= c << bits; bits += codeSize; while (bits >= 8) { out.push(cur & 255); cur >>>= 8; bits -= 8; } };
+  emit(clear);
+  let prefix = indices[0];
+  for (let i = 1; i < indices.length; i++) {
+    const k = indices[i];
+    const key = (prefix << 8) | k;
+    const code = dict.get(key);
+    if (code !== undefined) { prefix = code; continue; }
+    emit(prefix);
+    if (next === 4096) {
+      emit(clear);
+      dict = new Map();
+      codeSize = minCodeSize + 1;
+      next = eoi + 1;
+    } else {
+      if (next >= 1 << codeSize) codeSize++;
+      dict.set(key, next++);
+    }
+    prefix = k;
+  }
+  emit(prefix);
+  emit(eoi);
+  if (bits > 0) out.push(cur & 255);
+  return out;
+}
