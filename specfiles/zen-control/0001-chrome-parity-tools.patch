diff --git a/extension/popup.js b/extension/popup.js
new file mode 100644
index 0000000..dc22c31
--- /dev/null
+++ b/extension/popup.js
@@ -0,0 +1,42 @@
+let settings;
+let host = null;
+
+async function save(patch) {
+  settings = { ...settings, ...patch };
+  await browser.storage.local.set({ settings });
+  render();
+}
+
+function render() {
+  document.getElementById("all").checked = settings.allSites;
+  const toggle = document.getElementById("toggle");
+  const allowed = host && settings.allowedSites.includes(host);
+  document.getElementById("current").textContent = host ? host : "This page can't be controlled";
+  toggle.hidden = !host;
+  toggle.textContent = allowed ? "Revoke" : "Always allow";
+  toggle.className = allowed ? "" : "primary";
+  const ul = document.getElementById("sites");
+  ul.replaceChildren(...settings.allowedSites.map((h) => {
+    const li = document.createElement("li");
+    li.className = "row";
+    const name = document.createElement("span");
+    name.textContent = h;
+    const rm = document.createElement("button");
+    rm.textContent = "Remove";
+    rm.addEventListener("click", () => save({ allowedSites: settings.allowedSites.filter((x) => x !== h) }));
+    li.append(name, rm);
+    return li;
+  }));
+  if (!settings.allowedSites.length) ul.innerHTML = '<li class="muted">None</li>';
+}
+
+(async () => {
+  settings = { allSites: false, allowedSites: [], label: "", ...(await browser.storage.local.get("settings")).settings };
+  const [tab] = await browser.tabs.query({ active: true, currentWindow: true });
+  try { const u = new URL(tab.url); if (/^(https?|file):$/.test(u.protocol)) host = u.host || "file"; } catch {}
+  document.getElementById("label").value = settings.label || "";
+  document.getElementById("toggle").addEventListener("click", () => save({ allowedSites: settings.allowedSites.includes(host) ? settings.allowedSites.filter((x) => x !== host) : [...settings.allowedSites, host] }));
+  document.getElementById("all").addEventListener("change", (e) => save({ allSites: e.target.checked }));
+  document.getElementById("label").addEventListener("change", (e) => save({ label: e.target.value.trim() }));
+  render();
+})();
