+const { Reflect } = ChromeUtils.importESModule("moz-src:///toolkit/components/reflect/reflect.sys.mjs");
+
+export class ZenControlParent extends JSWindowActorParent {}
+
+const KEYS = { return: "Enter", enter: "Enter", esc: "Escape", escape: "Escape", space: " ", spacebar: " ", tab: "Tab", backspace: "Backspace", delete: "Delete", del: "Delete", insert: "Insert", home: "Home", end: "End", pageup: "PageUp", pagedown: "PageDown", up: "ArrowUp", down: "ArrowDown", left: "ArrowLeft", right: "ArrowRight", arrowup: "ArrowUp", arrowdown: "ArrowDown", arrowleft: "ArrowLeft", arrowright: "ArrowRight", contextmenu: "ContextMenu", menu: "ContextMenu" };
+const MODS = { ctrl: "ctrlKey", control: "ctrlKey", shift: "shiftKey", alt: "altKey", option: "altKey", meta: "metaKey", cmd: "metaKey", command: "metaKey", super: "metaKey", win: "metaKey" };
+
+function modsOf(parts) {
+  const mods = {};
+  for (const p of parts) {
+    const m = MODS[p.toLowerCase()];
+    if (!m) throw new Error(`Unknown modifier "${p}"`);
+    mods[m] = true;
+  }
+  return mods;
+}
+
+function chord(combo) {
+  const parts = combo.split("+");
+  let key = parts.pop();
+  if (!key && parts.length) { parts.pop(); key = "+"; }
+  const mods = modsOf(parts);
+  key = KEYS[key.toLowerCase()] || (/^f\d{1,2}$/i.test(key) ? key.toUpperCase() : key);
+  return { key: key.length > 1 ? "KEY_" + key : key, mods };
+}
+
+function asyncWrap(code) {
+  const head = "(async () => {\n", src = `${head}${code}\n})()`;
+  const body = Reflect.parse(src, { loc: true }).body[0].expression.callee.body.body;
+  const last = body.at(-1);
+  if (last?.type !== "ExpressionStatement") return src;
+  const lines = src.split("\n");
+  const off = ({ line, column }) => lines.slice(0, line - 1).reduce((n, l) => n + l.length + 1, 0) + column - 1;
+  const a = body.length > 1 ? off(body.at(-2).loc.end) : head.length, b = off(last.loc.end);
+  return `${src.slice(0, a)}\nreturn (\n${src.slice(a, b).replace(/^\s*;|;\s*$/g, "")}\n);${src.slice(b)}`;
+}
+
+const SERIALIZE = `(v) => {
+  if (typeof v === "string") return v;
+  const seen = new WeakSet();
+  const s = JSON.stringify(v, (k, x) => {
+    if (typeof x === "bigint") return x + "n";
+    if (typeof x === "function") return "[Function " + (x.name || "anonymous") + "]";
+    if (x instanceof Node) return x.nodeType === 1 ? "<" + x.localName + (x.id ? "#" + x.id : "") + ">" : x.nodeName;
+    if (x && typeof x === "object") { if (seen.has(x)) return "[Circular]"; seen.add(x); }
+    return x;
+  }, 2);
+  return s === undefined ? String(v) : s;
+}`;
+
+export class ZenControlChild extends JSWindowActorChild {
+  get eu() {
+    const win = this.contentWindow;
+    if (this._eu?.window !== win) {
+      this._eu = { window: win, parent: win, WheelEvent: win.WheelEvent, _EU_Ci: Ci, _EU_Cc: Cc };
+      Services.scriptloader.loadSubScript("chrome://remote/content/external/EventUtils.js", this._eu);
+    }
+    return this._eu;
+  }
+
+  mouse(x, y, ev) {
+    this.eu.synthesizeMouseAtPoint(x, y, ev, this.contentWindow);
+  }
+
+  withoutMarker(fn) {
+    const m = this.document.querySelector("zen-control-marker");
+    m?.style.setProperty("display", "none", "important");
+    try { return fn(); } finally { m?.style.removeProperty("display"); }
+  }
+
+  click({ x, y, button = 0, count = 1, modifiers = "" }) {
+    modifiers = modsOf(modifiers.split("+").filter(Boolean));
+    this.withoutMarker(() => {
+      this.mouse(x, y, { type: "mousemove", ...modifiers });
+      for (let i = 1; i <= count; i++) {
+        this.mouse(x, y, { type: "mousedown", button, clickCount: i, ...modifiers });
+        this.mouse(x, y, { type: "mouseup", button, clickCount: i, ...modifiers });
+      }
+    });
+  }
+
+  hover({ x, y }) {
+    this.withoutMarker(() => this.mouse(x, y, { type: "mousemove" }));
+  }
+
+  async drag({ x, y, toX, toY, modifiers = "" }) {
+    modifiers = modsOf(modifiers.split("+").filter(Boolean));
+    const win = this.contentWindow, eu = this.eu, tick = () => new Promise((r) => win.setTimeout(r, 0));
+    const m = this.document.querySelector("zen-control-marker");
+    m?.style.setProperty("display", "none", "important");
+    try {
+      this.mouse(x, y, { type: "mousemove", ...modifiers });
+      this.mouse(x, y, { type: "mousedown", ...modifiers });
+      for (let i = 1; i <= 10; i++) {
+        await tick();
+        this.mouse(x + ((toX - x) * i) / 10, y + ((toY - y) * i) / 10, { type: "mousemove", buttons: 1, allowToHandleDragDrop: true, ...modifiers });
+      }
+      await tick();
+      const ds = win.windowUtils.dragSession;
+      if (!ds) return this.mouse(toX, toY, { type: "mouseup", ...modifiers });
+      const target = win.document.elementFromPoint(toX, toY);
+      const send = (type) => eu.sendDragEvent(eu.createDragEventObject(type, target, win, ds.dataTransfer, { clientX: toX, clientY: toY, ...modifiers }), target, win);
+      if (target && !send("dragover")) send("drop");
+      this.mouse(toX, toY, { type: "mouseup", ...modifiers });
+      ds.endDragSession(true, 0);
+    } finally {
+      m?.style.removeProperty("display");
+    }
+  }
+
+  wheel({ x, y, direction = "down", amount }) {
+    const win = this.contentWindow, doc = this.document;
+    x ??= win.innerWidth / 2;
+    y ??= win.innerHeight / 2;
+    const horiz = direction === "left" || direction === "right";
+    amount = (direction === "up" || direction === "left" ? -1 : 1) * (amount ?? Math.round((horiz ? win.innerWidth : win.innerHeight) * 0.8));
+    const deltaX = horiz ? amount : 0, deltaY = horiz ? 0 : amount;
+    const can = (e, d, axis) => d && /auto|scroll/.test(win.getComputedStyle(e)[`overflow${axis}`]) && (axis === "Y" ? (d > 0 ? e.scrollTop + e.clientHeight < e.scrollHeight : e.scrollTop > 0) : d > 0 ? e.scrollLeft + e.clientWidth < e.scrollWidth : e.scrollLeft > 0);
+    let el = doc.elementFromPoint(x, y);
+    while (el && el !== doc.body && el !== doc.documentElement && !can(el, deltaY, "Y") && !can(el, deltaX, "X")) el = el.parentElement || el.getRootNode().host;
+    const target = el && el !== doc.body && el !== doc.documentElement ? el : win;
+    let prevented = true;
+    // the browser's own wheel scroll is smooth and stalls in background tabs
+    const onWheel = (e) => {
+      if (e.defaultPrevented) return;
+      prevented = false;
+      e.preventDefault();
+      target.scrollBy({ left: deltaX, top: deltaY, behavior: "instant" });
+    };
+    win.addEventListener("wheel", onWheel, { mozSystemGroup: true, passive: false });
+    try { this.withoutMarker(() => this.eu.synthesizeWheelAtPoint(x, y, { deltaX, deltaY, deltaMode: 0 }, win)); } finally { win.removeEventListener("wheel", onWheel, { mozSystemGroup: true }); }
+    return target === win ? { prevented, scrollX: win.scrollX, scrollY: win.scrollY } : { prevented, element: target.localName + (target.id ? "#" + target.id : ""), scrollLeft: target.scrollLeft, scrollTop: target.scrollTop };
+  }
+
+  keys({ keys, repeat = 1 }) {
+    const seq = String(keys).trim().split(/\s+/).map(chord);
+    for (let i = 0; i < repeat; i++) for (const { key, mods } of seq) this.eu.synthesizeKey(key, mods, this.contentWindow);
+  }
+
+  type({ text }) {
+    const win = this.contentWindow;
+    String(text).split("\n").forEach((line, i) => {
+      if (i) this.eu.synthesizeKey("KEY_Enter", {}, win);
+      this.eu.sendString(line, win);
+    });
+  }
+
+  async eval({ code }) {
+    const sb = Cu.Sandbox(this.contentWindow, { sandboxPrototype: this.contentWindow, wantXrays: false, sandboxName: "zen-control evaluate" });
+    const run = (src) => Cu.evalInSandbox(src, sb, null, "zen-control-eval", 1);
+    let v;
+    try { v = run(code); } catch (e) {
+      if (e?.name !== "SyntaxError") throw e;
+      v = run(asyncWrap(code));
+    }
+    return run(SERIALIZE)(await v);
+  }
+
+  async receiveMessage({ name, data }) {
+    try {
+      if (!["click", "hover", "drag", "wheel", "keys", "type", "eval"].includes(name)) throw new Error("Unknown command " + name);
+      return { result: await this[name](data || {}) };
+    } catch (e) {
+      return { error: String(e?.message ?? e) };
+    }
+  }
+}
diff --git a/extension/privileged/api.js b/extension/privileged/api.js
new file mode 100644
index 0000000..a1da981
--- /dev/null
+++ b/extension/privileged/api.js
@@ -0,0 +1,29 @@
+"use strict";
+const resProto = Services.io.getProtocolHandler("resource").QueryInterface(Ci.nsIResProtocolHandler);
+
+this.zenControl = class extends ExtensionAPI {
+  onStartup() {
+    resProto.setSubstitution("zencontrol", Services.io.newURI("privileged/", null, this.extension.rootURI));
+    const esModuleURI = "resource://zencontrol/actor.sys.mjs";
+    ChromeUtils.registerWindowActor("ZenControl", { parent: { esModuleURI }, child: { esModuleURI }, allFrames: true, safeForUntrustedWebProcess: true, matches: ["http://*/*", "https://*/*", "file:///*"] });
+  }
+  onShutdown(isAppShutdown) {
+    if (isAppShutdown) return;
+    ChromeUtils.unregisterWindowActor("ZenControl");
+    resProto.setSubstitution("zencontrol", null);
+  }
+  getAPI(context) {
+    return {
+      zenControl: {
+        async send(tabId, name, data) {
+          try {
+            const wg = context.extension.tabManager.get(tabId).nativeTab.linkedBrowser.browsingContext.currentWindowGlobal;
+            return await wg.getActor("ZenControl").sendQuery(name, data);
+          } catch (e) {
+            throw new ExtensionUtils.ExtensionError(String(e?.message || e));
+          }
+        },
+      },
+    };
+  }
+};
