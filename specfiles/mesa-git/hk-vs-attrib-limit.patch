    /* Vertex buffers */
-   struct hk_addr_range vb[AGX_MAX_VBUFS];
+   struct hk_addr_range vb[MESA_VK_MAX_VERTEX_BINDINGS];
 
    /* Transform feedback buffers */
    struct hk_addr_range xfb[4];
