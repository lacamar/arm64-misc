+static bool
+zero_excess_vs_input(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   if (intr->intrinsic != nir_intrinsic_load_input ||
+       nir_src_as_uint(intr->src[0]) + nir_intrinsic_base(intr) <
+          AGX_MAX_ATTRIBS)
+      return false;
+
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_def_replace(&intr->def, nir_imm_zero(b, intr->def.num_components,
+                                            intr->def.bit_size));
+   return true;
+}
+
