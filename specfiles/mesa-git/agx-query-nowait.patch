+static bool
+query_writers_idle(struct agx_context *ctx, struct agx_query *query)
+{
+   struct agx_device *dev = agx_device(ctx->base.screen);
+
+   flush_query_writers(ctx, query, "Polling query results");
+
+   for (unsigned i = 0; i < AGX_MAX_BATCHES; ++i) {
+      struct agx_batch *batch = &ctx->batches.slots[i];
+
+      if (query->writer_generation[i] == ctx->batches.generation[i] &&
+          agx_batch_is_submitted(batch) &&
+          drmSyncobjWait(dev->fd, &batch->syncobj, 1, 0, 0, NULL))
+         return false;
+   }
+
+   return true;
+}
