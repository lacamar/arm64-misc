 #include "async.h"
+#include "char32.h"
 #include "commands.h"
 #include "config.h"
 #include "debug.h"
@@ -1810,6 +1811,232 @@
     alarm_raised = 1;
 }
 
+struct snapshot_buf {
+    char32_t *buf;
+    size_t len;
+    size_t cap;
+};
+
+static void
+snapshot_buf_ensure(struct snapshot_buf *b, size_t additional)
+{
+    if (b->len + additional <= b->cap)
+        return;
+
+    size_t new_cap = b->cap == 0 ? 512 : b->cap * 2;
+    while (new_cap < b->len + additional)
+        new_cap *= 2;
+
+    b->buf = xrealloc(b->buf, new_cap * sizeof(b->buf[0]));
+    b->cap = new_cap;
+}
+
+static void
+snapshot_buf_append_char(struct snapshot_buf *b, char32_t c)
+{
+    snapshot_buf_ensure(b, 1);
+    b->buf[b->len++] = c;
+}
+
+static void
+snapshot_buf_append_ascii(struct snapshot_buf *b, const char *s)
+{
+    size_t len = strlen(s);
+    snapshot_buf_ensure(b, len);
+    for (size_t i = 0; i < len; i++)
+        b->buf[b->len++] = (char32_t)(unsigned char)s[i];
+}
+
+struct snapshot_cell_style {
+    bool bold, dim, italic, underline, strikethrough, blink, reverse, conceal;
+    bool fg_default, bg_default;
+    uint32_t fg, bg;
+};
+
+static void
+snapshot_resolve_cell_style(const struct terminal *term, const struct cell *cell,
+                             struct snapshot_cell_style *out)
+{
+    *out = (struct snapshot_cell_style){
+        .bold = cell->attrs.bold,
+        .dim = cell->attrs.dim,
+        .italic = cell->attrs.italic,
+        .underline = cell->attrs.underline,
+        .strikethrough = cell->attrs.strikethrough,
+        .blink = cell->attrs.blink,
+        .reverse = cell->attrs.reverse,
+        .conceal = cell->attrs.conceal,
+        .fg_default = true,
+        .bg_default = true,
+    };
+
+    switch (cell->attrs.fg_src) {
+    case COLOR_RGB:
+        out->fg = cell->attrs.fg;
+        out->fg_default = false;
+        break;
+
+    case COLOR_BASE16:
+    case COLOR_BASE256:
+        out->fg = term->colors.table[cell->attrs.fg];
+        out->fg_default = false;
+        break;
+
+    case COLOR_DEFAULT:
+        break;
+    }
+
+    switch (cell->attrs.bg_src) {
+    case COLOR_RGB:
+        out->bg = cell->attrs.bg;
+        out->bg_default = false;
+        break;
+
+    case COLOR_BASE16:
+    case COLOR_BASE256:
+        out->bg = term->colors.table[cell->attrs.bg];
+        out->bg_default = false;
+        break;
+
+    case COLOR_DEFAULT:
+        break;
+    }
+}
+
+static bool
+snapshot_cell_style_eq(const struct snapshot_cell_style *a,
+                        const struct snapshot_cell_style *b)
+{
+    return a->bold == b->bold && a->dim == b->dim && a->italic == b->italic &&
+        a->underline == b->underline && a->strikethrough == b->strikethrough &&
+        a->blink == b->blink && a->reverse == b->reverse &&
+        a->conceal == b->conceal &&
+        a->fg_default == b->fg_default && a->bg_default == b->bg_default &&
+        (a->fg_default || a->fg == b->fg) &&
+        (a->bg_default || a->bg == b->bg);
+}
+
+static void
+snapshot_emit_style(struct snapshot_buf *b, const struct snapshot_cell_style *s)
+{
+    char sgr[96];
+    size_t n = 0;
+
+    n += xsnprintf(sgr + n, sizeof(sgr) - n, "\x1b[0");
+    if (s->bold) n += xsnprintf(sgr + n, sizeof(sgr) - n, ";1");
+    if (s->dim) n += xsnprintf(sgr + n, sizeof(sgr) - n, ";2");
+    if (s->italic) n += xsnprintf(sgr + n, sizeof(sgr) - n, ";3");
+    if (s->underline) n += xsnprintf(sgr + n, sizeof(sgr) - n, ";4");
+    if (s->blink) n += xsnprintf(sgr + n, sizeof(sgr) - n, ";5");
+    if (s->reverse) n += xsnprintf(sgr + n, sizeof(sgr) - n, ";7");
+    if (s->conceal) n += xsnprintf(sgr + n, sizeof(sgr) - n, ";8");
+    if (s->strikethrough) n += xsnprintf(sgr + n, sizeof(sgr) - n, ";9");
+    if (!s->fg_default) {
+        n += xsnprintf(sgr + n, sizeof(sgr) - n, ";38;2;%u;%u;%u",
+                       (s->fg >> 16) & 0xff, (s->fg >> 8) & 0xff, s->fg & 0xff);
+    }
+    if (!s->bg_default) {
+        n += xsnprintf(sgr + n, sizeof(sgr) - n, ";48;2;%u;%u;%u",
+                       (s->bg >> 16) & 0xff, (s->bg >> 8) & 0xff, s->bg & 0xff);
+    }
+    xsnprintf(sgr + n, sizeof(sgr) - n, "m");
+
+    snapshot_buf_append_ascii(b, sgr);
+}
+
+char *
+term_snapshot_text(const struct terminal *term, int extra_scrollback_lines)
+{
+    struct grid *grid = term->grid;
+
+    if (extra_scrollback_lines < 0)
+        extra_scrollback_lines = 0;
+
+    int max_extra = grid->num_rows - term->rows;
+    if (extra_scrollback_lines > max_extra)
+        extra_scrollback_lines = max_extra;
+
+    /* Skip past any not-yet-written-to rows at the top of scrollback */
+    int start_row_no = -extra_scrollback_lines;
+    while (start_row_no < 0 &&
+           grid->rows[grid_row_absolute(grid, start_row_no)] == NULL)
+    {
+        start_row_no++;
+    }
+
+    struct snapshot_buf b = {0};
+    size_t last_content_len = 0;
+    bool first_row = true;
+
+    for (int r = start_row_no; r < term->rows; r++) {
+        struct row *row = grid->rows[grid_row_absolute(grid, r)];
+
+        int last_content_col = -1;
+        if (row != NULL) {
+            for (int c = 0; c < term->cols; c++) {
+                if (row->cells[c].wc != 0)
+                    last_content_col = c;
+            }
+        }
+
+        if (!first_row)
+            snapshot_buf_append_char(&b, U'\n');
+        first_row = false;
+
+        if (row != NULL && last_content_col >= 0) {
+            struct snapshot_cell_style cur_style = {0};
+            bool style_active = false;
+
+            for (int c = 0; c <= last_content_col; c++) {
+                const struct cell *cell = &row->cells[c];
+
+                if (cell->wc == CELL_SPACER)
+                    continue;
+
+                struct snapshot_cell_style style;
+                snapshot_resolve_cell_style(term, cell, &style);
+
+                if (!style_active || !snapshot_cell_style_eq(&cur_style, &style)) {
+                    snapshot_emit_style(&b, &style);
+                    cur_style = style;
+                    style_active = true;
+                }
+
+                if (cell->wc == 0) {
+                    snapshot_buf_append_char(&b, U' ');
+                } else if (cell->wc >= CELL_COMB_CHARS_LO &&
+                           cell->wc <= CELL_COMB_CHARS_HI) {
+                    const struct composed *comp = composed_lookup(
+                        term->composed, cell->wc - CELL_COMB_CHARS_LO);
+                    if (comp != NULL) {
+                        for (uint8_t i = 0; i < comp->count; i++)
+                            snapshot_buf_append_char(&b, comp->chars[i]);
+                    } else
+                        snapshot_buf_append_char(&b, U' ');
+                } else
+                    snapshot_buf_append_char(&b, cell->wc);
+            }
+
+            if (style_active)
+                snapshot_buf_append_ascii(&b, "\x1b[0m");
+
+            last_content_len = b.len;
+        }
+    }
+
+    snapshot_buf_append_char(&b, 0);
+
+    if (last_content_len == 0) {
+        free(b.buf);
+        return xstrdup("");
+    }
+
+    b.buf[last_content_len] = 0;
+    char *text = ac32tombs(b.buf);
+    free(b.buf);
+    return text;
+}
+
 int
 term_destroy(struct terminal *term)
 {
