+/*
+ * ---------------------------------------------------------------
+ * Session save/restore
+ * ---------------------------------------------------------------
+ */
+
+struct proc_info {
+    pid_t pid;
+    pid_t ppid;
+    pid_t pgid;
+    pid_t sid;
+    unsigned long long starttime;
+};
+
+typedef tll(struct proc_info) proc_list_t;
+
+static bool
+read_proc_info(pid_t pid, struct proc_info *out)
+{
+    char path[64];
+    snprintf(path, sizeof(path), "/proc/%d/stat", (int)pid);
+
+    FILE *f = fopen(path, "re");
+    if (f == NULL)
+        return false;
+
+    char line[1024];
+    bool ok = fgets(line, sizeof(line), f) != NULL;
+    fclose(f);
+    if (!ok)
+        return false;
+
+    /* comm is parenthesized and may itself contain spaces and parens */
+    const char *p = strrchr(line, ')');
+    if (p == NULL)
+        return false;
+
+    int ppid, pgid, sid;
+    unsigned long long starttime;
+    if (sscanf(p + 1,
+               " %*c %d %d %d %*d %*d %*u %*u %*u %*u %*u %*u %*u"
+               " %*d %*d %*d %*d %*d %*d %llu",
+               &ppid, &pgid, &sid, &starttime) != 4)
+    {
+        return false;
+    }
+
+    *out = (struct proc_info){
+        .pid = pid,
+        .ppid = ppid,
+        .pgid = pgid,
+        .sid = sid,
+        .starttime = starttime,
+    };
+    return true;
+}
+
+static void
+scan_processes(proc_list_t *out)
+{
+    DIR *d = opendir("/proc");
+    if (d == NULL) {
+        LOG_ERRNO("failed to open /proc");
+        return;
+    }
+
+    struct dirent *e;
+    while ((e = readdir(d)) != NULL) {
+        if (e->d_name[0] < '1' || e->d_name[0] > '9')
+            continue;
+
+        char *end;
+        long pid = strtol(e->d_name, &end, 10);
+        if (*end != '\0' || pid <= 0)
+            continue;
+
+        struct proc_info info;
+        if (read_proc_info((pid_t)pid, &info))
+            tll_push_back(*out, info);
+    }
+
+    closedir(d);
+}
+
+static bool
+fd_is_tty(pid_t pid, int fd, const char *pts_path)
+{
+    char link[64];
+    snprintf(link, sizeof(link), "/proc/%d/fd/%d", (int)pid, fd);
+
+    char target[PATH_MAX];
+    ssize_t n = readlink(link, target, sizeof(target) - 1);
+    if (n < 0)
+        return false;
+
+    target[n] = '\0';
+    return streq(target, pts_path);
+}
+
+/*
+ * Follows the chain of interactive programs on the window's pty,
+ * starting at foot's own child: at each level, the child whose
+ * stdin *and* stdout are the pty. That excludes helpers a program
+ * spawns with pipes (a build tool's compilers, an AI agent's tool
+ * subprocesses), while still descending through e.g. a file
+ * manager into the program it launched.
+ *
+ * The foreground process group is deliberately not the primary
+ * signal: many programs (lf, for one) run their sub-commands in
+ * their own process group, so it only ever points at the outermost
+ * program. It is used as a tie-breaker, then the most recently
+ * started child wins.
+ */
+static void
+build_process_chain(const struct terminal *term, const proc_list_t *procs,
+                    proc_list_t *chain)
+{
+    char pts_path[PATH_MAX];
+    if (ptsname_r(term->ptmx, pts_path, sizeof(pts_path)) != 0) {
+        LOG_ERRNO("ptsname_r() failed");
+        return;
+    }
+
+    const pid_t root = term->slave;
+    const pid_t fg_pgid = tcgetpgrp(term->ptmx);
+
+    struct proc_info cur;
+    bool found = false;
+    tll_foreach(*procs, it) {
+        if (it->item.pid == root) {
+            cur = it->item;
+            found = true;
+            break;
+        }
+    }
+    if (!found)
+        return;
+
+    tll_push_back(*chain, cur);
+
+    for (int depth = 0; depth < 16; depth++) {
+        const struct proc_info *best = NULL;
+
+        tll_foreach(*procs, it) {
+            const struct proc_info *p = &it->item;
+
+            /* The slave did setsid(); everything on this pty shares its session */
+            if (p->ppid != cur.pid || p->sid != root)
+                continue;
+
+            if (!fd_is_tty(p->pid, STDIN_FILENO, pts_path) ||
+                !fd_is_tty(p->pid, STDOUT_FILENO, pts_path))
+            {
+                continue;
+            }
+
+            if (best == NULL) {
+                best = p;
+                continue;
+            }
+
+            bool p_fg = p->pgid == fg_pgid;
+            bool best_fg = best->pgid == fg_pgid;
+            if (p_fg != best_fg ? p_fg : p->starttime > best->starttime)
+                best = p;
+        }
+
+        if (best == NULL)
+            break;
+
+        cur = *best;
+        tll_push_back(*chain, cur);
+    }
+}
+
+/*
+ * term->cwd is only ever updated via OSC 7, which requires the
+ * shell to explicitly opt in with prompt-integration hooks most
+ * shells don't ship by default. Absent that, term->cwd just sits at
+ * whatever directory the window happened to be spawned in and never
+ * tracks where the user actually navigated to.
+ *
+ * /proc/<pid>/cwd is authoritative and needs no cooperation from
+ * the program, so prefer it; fall back to term->cwd, then $HOME.
+ */
+static char *
+resolve_cwd_for_pid(pid_t pid, const struct terminal *term)
+{
+    if (pid > 0) {
+        char proc_path[32];
+        snprintf(proc_path, sizeof(proc_path), "/proc/%d/cwd", (int)pid);
+
+        char buf[PATH_MAX];
+        ssize_t n = readlink(proc_path, buf, sizeof(buf) - 1);
+        if (n > 0) {
+            buf[n] = '\0';
+            return xstrdup(buf);
+        }
+    }
+
+    if (term->cwd != NULL)
+        return xstrdup(term->cwd);
+
+    const char *home = getenv("HOME");
+    return xstrdup(home != NULL ? home : "/");
+}
+
+static const char *
+path_basename(const char *path)
+{
+    const char *slash = strrchr(path, '/');
+    return slash != NULL ? slash + 1 : path;
+}
+
+/* Reads /proc/<pid>/cmdline (NUL-separated argv) into a heap-allocated
+ * argv array. Returns NULL (with *out_argc == 0) if unreadable/empty. */
+static char **
+read_proc_cmdline(pid_t pid, size_t *out_argc)
+{
+    *out_argc = 0;
+
+    char proc_path[32];
+    snprintf(proc_path, sizeof(proc_path), "/proc/%d/cmdline", (int)pid);
+
+    FILE *f = fopen(proc_path, "re");
+    if (f == NULL)
+        return NULL;
+
+    char *buf = NULL;
+    size_t cap = 0, len = 0;
+    char chunk[4096];
+    size_t n;
+
+    while ((n = fread(chunk, 1, sizeof(chunk), f)) > 0) {
+        if (len + n > cap) {
+            cap = (len + n) * 2;
+            buf = xrealloc(buf, cap);
+        }
+        memcpy(buf + len, chunk, n);
+        len += n;
+    }
+    fclose(f);
+
+    if (len == 0) {
+        free(buf);
+        return NULL;
+    }
+
+    size_t argc = 0;
+    for (size_t i = 0; i < len; i++) {
+        if (buf[i] == '\0')
+            argc++;
+    }
+    if (buf[len - 1] != '\0')
+        argc++;  /* truncated/unterminated last field */
+
+    char **argv = xcalloc(argc, sizeof(argv[0]));
+    size_t idx = 0, start = 0;
+    for (size_t i = 0; i < len; i++) {
+        if (buf[i] == '\0') {
+            argv[idx++] = xstrndup(buf + start, i - start);
+            start = i + 1;
+        }
+    }
+    if (start < len)
+        argv[idx++] = xstrndup(buf + start, len - start);
+
+    free(buf);
+    *out_argc = idx;
+    return argv;
+}
+
+static void
+write_shell_quoted(FILE *f, const char *s)
+{
+    fputc('\'', f);
+    for (const char *p = s; *p != '\0'; p++) {
+        if (*p == '\'')
+            fputs("'\\''", f);
+        else
+            fputc((unsigned char)*p, f);
+    }
+    fputc('\'', f);
+}
+
+static void
+write_shell_quoted_argv(FILE *f, size_t argc, char *const *argv)
+{
+    for (size_t i = 0; i < argc; i++) {
+        if (i > 0)
+            fputc(' ', f);
+        write_shell_quoted(f, argv[i]);
+    }
+}
+
+static const struct session_restore_rule *
+find_restore_rule(const struct config *conf, const char *argv0)
+{
+    const char *base = path_basename(argv0);
+    tll_foreach(conf->session.restore_rules, it) {
+        if (streq(it->item.program, base))
+            return &it->item;
+    }
+    return NULL;
+}
+
+/*
+ * Expands a [session-restore] rule for a running program by letting
+ * /bin/sh word-split it exactly like a command line, with $0 and
+ * "$@" set to the program's own argv, and FOOT_PID/FOOT_CWD in the
+ * environment. Doing this while the program is still alive is what
+ * lets a rule pick up state that only exists then, such as a
+ * session ID keyed by PID.
+ *
+ * Runs synchronously (with a timeout) on the server's main loop;
+ * results are cached per process, so a rule runs once per program
+ * instance, not once per checkpoint.
+ *
+ * Returns the expanded argv; NULL/0 means "don't relaunch".
+ */
+static char **
+expand_restore_rule(struct server *server,
+                    const struct session_restore_rule *rule,
+                    pid_t pid, const char *cwd,
+                    size_t argc, char *const *argv, size_t *out_argc)
+{
+    *out_argc = 0;
+
+    char *script = NULL;
+    size_t script_len = 0;
+    FILE *f = open_memstream(&script, &script_len);
+    if (f == NULL)
+        return NULL;
+
+    fprintf(f, "FOOT_PID=%d\nFOOT_CWD=", (int)pid);
+    write_shell_quoted(f, cwd);
+    fputs("\nexport FOOT_PID FOOT_CWD\nprintf '%s\\0' ", f);
+    fputs(rule->command, f);
+    fputc('\n', f);
+    fclose(f);
+
+    char **sh_argv = xcalloc(3 + argc + 1, sizeof(sh_argv[0]));
+    sh_argv[0] = "/bin/sh";
+    sh_argv[1] = "-c";
+    sh_argv[2] = script;
+    for (size_t i = 0; i < argc; i++)
+        sh_argv[3 + i] = argv[i];
+
+    int pipe_fds[2];
+    if (pipe2(pipe_fds, O_CLOEXEC) < 0) {
+        LOG_ERRNO("failed to create pipe");
+        free(sh_argv);
+        free(script);
+        return NULL;
+    }
+
+    pid_t child = spawn(server->reaper, cwd, sh_argv,
+                        -1, pipe_fds[1], -1, NULL, NULL, NULL);
+    close(pipe_fds[1]);
+    free(sh_argv);
+    free(script);
+
+    if (child < 0) {
+        close(pipe_fds[0]);
+        return NULL;
+    }
+
+    /* spawn() hands the child to the reaper; we wait for it ourselves */
+    reaper_del(server->reaper, child);
+
+    char *out = NULL;
+    size_t out_len = 0, out_cap = 0;
+    bool timed_out = false;
+
+    while (true) {
+        struct pollfd pfd = {.fd = pipe_fds[0], .events = POLLIN};
+        int r = poll(&pfd, 1, 5000);
+        if (r == 0) {
+            timed_out = true;
+            break;
+        }
+        if (r < 0) {
+            if (errno == EINTR)
+                continue;
+            LOG_ERRNO("poll() failed");
+            break;
+        }
+
+        if (out_len + 4096 > out_cap) {
+            out_cap = out_cap == 0 ? 4096 : out_cap * 2;
+            out = xrealloc(out, out_cap);
+        }
+
+        ssize_t n = read(pipe_fds[0], out + out_len, out_cap - out_len);
+        if (n < 0 && errno == EINTR)
+            continue;
+        if (n <= 0)
+            break;
+        out_len += n;
+    }
+    close(pipe_fds[0]);
+
+    if (timed_out) {
+        LOG_WARN("[session-restore] %s: rule timed out, killing it",
+                 rule->program);
+        kill(child, SIGKILL);
+    }
+
+    int status;
+    while (waitpid(child, &status, 0) < 0 && errno == EINTR)
+        ;
+
+    if (timed_out || !WIFEXITED(status) || WEXITSTATUS(status) != 0) {
+        LOG_WARN("[session-restore] %s: rule failed, not relaunching",
+                 rule->program);
+        free(out);
+        return NULL;
+    }
+
+    size_t words = 0;
+    for (size_t i = 0; i < out_len; i++) {
+        if (out[i] == '\0')
+            words++;
+    }
+
+    /* An empty rule expands to a single empty word */
+    if (words == 0 || out[0] == '\0') {
+        free(out);
+        return NULL;
+    }
+
+    char **result = xcalloc(words, sizeof(result[0]));
+    size_t idx = 0, start = 0;
+    for (size_t i = 0; i < out_len; i++) {
+        if (out[i] == '\0') {
+            result[idx++] = xstrdup(out + start);
+            start = i + 1;
+        }
+    }
+
+    free(out);
+    *out_argc = words;
+    return result;
+}
+
+/*
+ * Looks up, or computes and caches, the relaunch command for one
+ * process in a window's chain. argc == 0 in the cache means "no
+ * rule matched (or it declined)", so the lookup is skipped too.
+ */
+static bool
+resolve_relaunch(struct terminal_instance *instance,
+                 const struct proc_info *proc,
+                 size_t *out_argc, char ***out_argv)
+{
+    struct server *server = instance->server;
+    const struct config *conf =
+        instance->conf != NULL ? instance->conf : server->conf;
+
+    tll_foreach(instance->relaunch_cache, it) {
+        const struct relaunch_cache_entry *e = &it->item;
+        if (e->pid == proc->pid && e->starttime == proc->starttime) {
+            *out_argc = e->argc;
+            *out_argv = session_argv_dup(e->argc, e->argv);
+            return e->argc > 0;
+        }
+    }
+
+    struct relaunch_cache_entry entry = {
+        .pid = proc->pid,
+        .starttime = proc->starttime,
+    };
+
+    size_t argc;
+    char **argv = read_proc_cmdline(proc->pid, &argc);
+    if (argv != NULL) {
+        const struct session_restore_rule *rule =
+            find_restore_rule(conf, argv[0]);
+
+        if (rule != NULL) {
+            char *cwd = resolve_cwd_for_pid(proc->pid, instance->terminal);
+            entry.argv = expand_restore_rule(
+                server, rule, proc->pid, cwd, argc, argv, &entry.argc);
+            free(cwd);
+
+            LOG_DBG("[session-restore] %s (pid=%d): %zu word(s)",
+                    rule->program, (int)proc->pid, entry.argc);
+        }
+
+        session_argv_free(argc, argv);
+    }
+
+    *out_argc = entry.argc;
+    *out_argv = session_argv_dup(entry.argc, entry.argv);
+    tll_push_back(instance->relaunch_cache, entry);
+    return entry.argc > 0;
+}
+
+static void
+prune_relaunch_cache(struct terminal_instance *instance,
+                     const proc_list_t *chain)
+{
+    tll_foreach(instance->relaunch_cache, it) {
+        bool live = false;
+        tll_foreach(*chain, cit) {
+            if (cit->item.pid == it->item.pid &&
+                cit->item.starttime == it->item.starttime)
+            {
+                live = true;
+                break;
+            }
+        }
+
+        if (!live) {
+            session_argv_free(it->item.argc, it->item.argv);
+            tll_remove(instance->relaunch_cache, it);
+        }
+    }
+}
+
+static void
+relaunch_cache_free(struct terminal_instance *instance)
+{
+    tll_foreach(instance->relaunch_cache, it) {
+        session_argv_free(it->item.argc, it->item.argv);
+        tll_remove(instance->relaunch_cache, it);
+    }
+}
+
+static void
+save_terminal_window(struct terminal_instance *instance,
+                     const proc_list_t *procs,
+                     session_window_list_t *windows)
+{
+    struct terminal *term = instance->terminal;
+    const struct config *conf =
+        instance->conf != NULL ? instance->conf : instance->server->conf;
+
+    proc_list_t chain = tll_init();
+    build_process_chain(term, procs, &chain);
+    prune_relaunch_cache(instance, &chain);
+
+    struct session_window w = {
+        .cols = term->cols,
+        .rows = term->rows,
+        .snapshot = term_snapshot_text(term, conf->session.scrollback_lines),
+        .launch_argc = instance->launch_argc,
+        .launch_argv = session_argv_dup(
+            instance->launch_argc, instance->launch_argv),
+        .commands = tll_init(),
+    };
+
+    /* The window's directory is that of foot's own child: the shell,
+     * or whatever footclient was told to run (which, for a file
+     * manager, is wherever the user navigated to) */
+    pid_t root_pid = tll_length(chain) > 0 ? tll_front(chain).pid : term->slave;
+    w.cwd = resolve_cwd_for_pid(root_pid, term);
+
+    if (conf->session.relaunch_command) {
+        bool is_root = true;
+        tll_foreach(chain, it) {
+            size_t argc;
+            char **argv;
+            bool matched = resolve_relaunch(instance, &it->item, &argc, &argv);
+
+            if (is_root) {
+                is_root = false;
+
+                /* A rule for foot's own child replaces the launch
+                 * command (e.g. 'footclient claude' -> resume) */
+                if (matched) {
+                    session_argv_free(w.launch_argc, w.launch_argv);
+                    w.launch_argc = argc;
+                    w.launch_argv = argv;
+                }
+                continue;
+            }
+
+            if (!matched)
+                continue;
+
+            /* Innermost first */
+            tll_push_front(w.commands, ((struct session_command){
+                .cwd = resolve_cwd_for_pid(it->item.pid, term),
+                .argc = argc,
+                .argv = argv,
+            }));
+        }
+    }
+
+    tll_free(chain);
+    tll_push_back(*windows, w);
+}
+
+static void
+session_do_save(struct server *server)
+{
+    if (!server->conf->session.enabled)
+        return;
+
+    char *path = session_state_path();
+    if (path == NULL)
+        return;
+
+    proc_list_t procs = tll_init();
+    scan_processes(&procs);
+
+    session_window_list_t windows = tll_init();
+
+    tll_foreach(server->clients, it) {
+        struct terminal_instance *instance = it->item->instance;
+        if (instance == NULL || instance->terminal == NULL)
+            continue;
+        save_terminal_window(instance, &procs, &windows);
+    }
+
+    tll_foreach(server->terminals, it) {
+        if (it->item->terminal == NULL)
+            continue;
+        save_terminal_window(it->item, &procs, &windows);
+    }
+
+    tll_free(procs);
+
+    if (tll_length(windows) == 0) {
+        /* Nothing to save - drop any stale state from a previous run */
+        unlink(path);
+    } else if (!session_write(path, &windows)) {
+        LOG_WARN("failed to save session state to %s", path);
+    } else {
+        LOG_DBG("saved %zu window(s) to %s", tll_length(windows), path);
+    }
+
+    session_window_list_free(&windows);
+    free(path);
+}
+
+/*
+ * Writes a horizontal divider, made up of box-drawing characters and
+ * a centered label, exactly 'cols' columns wide (falling back to a
+ * sane minimum width if 'cols' is too narrow for the label).
+ */
+static void
+write_restore_banner(FILE *f, int cols)
+{
+    static const char label[] = " restored session ";
+    int label_cols = (int)sizeof(label) - 1;  /* ASCII-only: 1 byte == 1 column */
+
+    if (cols < label_cols + 4)
+        cols = label_cols + 4;
+
+    int dashes = cols - label_cols;
+    int left = dashes / 2;
+    int right = dashes - left;
+
+    fputs("\x1b[38;2;110;150;200m", f);
+    for (int i = 0; i < left; i++)
+        fputs("\xe2\x94\x80", f);  /* U+2500 BOX DRAWINGS LIGHT HORIZONTAL */
+    fputs("\x1b[1m", f);
+    fputs(label, f);
+    fputs("\x1b[22m", f);
+    for (int i = 0; i < right; i++)
+        fputs("\xe2\x94\x80", f);
+    fputs("\x1b[0m\n", f);
+}
+
+/*
+ * Writes 'snapshot' (may be NULL/empty) followed by a "restored"
+ * banner to a private temp file under XDG_RUNTIME_DIR, for a
+ * restored window's wrapper shell to cat(1) out on startup.
+ *
+ * We cannot feed this text directly into the new terminal via
+ * vt_from_slave() right after term_init(): the grid isn't allocated
+ * until the compositor's first surface configure arrives, which
+ * happens later, asynchronously, on the Wayland event loop. Piping
+ * it through the child's own stdout instead reuses the exact same,
+ * already-safe path normal program output takes.
+ */
+static char *
+write_restore_snapshot_file(const char *snapshot, int cols)
+{
+    const char *runtime_dir = getenv("XDG_RUNTIME_DIR");
+    if (runtime_dir == NULL || runtime_dir[0] == '\0')
+        runtime_dir = "/tmp";
+
+    size_t len = strlen(runtime_dir) + strlen("/foot-session-restore-XXXXXX") + 1;
+    char *path = xmalloc(len);
+    snprintf(path, len, "%s/foot-session-restore-XXXXXX", runtime_dir);
+
+    int fd = mkstemp(path);
+    if (fd < 0) {
+        LOG_ERRNO("failed to create session restore temp file");
+        free(path);
+        return NULL;
+    }
+
+    FILE *f = fdopen(fd, "w");
+    if (f == NULL) {
+        LOG_ERRNO("fdopen() failed");
+        close(fd);
+        unlink(path);
+        free(path);
+        return NULL;
+    }
+
+    if (snapshot != NULL && snapshot[0] != '\0')
+        fprintf(f, "%s\n", snapshot);
+    write_restore_banner(f, cols);
+
+    fclose(f);
+    return path;
+}
+
+/*
+ * Builds the POSIX sh -c script a restored window's wrapper shell
+ * runs: replay the saved snapshot (if any), re-run each saved
+ * program in turn (innermost first, each in its own directory - a
+ * fresh instance unless its rule resumes it), then finally exec
+ * into the window's original launch command, or the shell.
+ */
+static char *
+build_restore_script(const char *snapshot_path,
+                     const struct session_window *w,
+                     size_t shell_argc, char *const *shell_argv)
+{
+    char *buf = NULL;
+    size_t size = 0;
+    FILE *f = open_memstream(&buf, &size);
+    if (f == NULL)
+        return NULL;
+
+    if (snapshot_path != NULL) {
+        fputs("cat ", f);
+        write_shell_quoted(f, snapshot_path);
+        fputs(" 2>/dev/null; rm -f ", f);
+        write_shell_quoted(f, snapshot_path);
+        fputc('\n', f);
+    }
+
+    tll_foreach(w->commands, it) {
+        fputs("cd ", f);
+        write_shell_quoted(f, it->item.cwd);
+        fputs(" && ", f);
+        write_shell_quoted_argv(f, it->item.argc, it->item.argv);
+        fputc('\n', f);
+    }
+
+    if (tll_length(w->commands) > 0) {
+        fputs("cd ", f);
+        write_shell_quoted(f, w->cwd);
+        fputc('\n', f);
+    }
+
+    fputs("exec ", f);
+    if (w->launch_argc > 0)
+        write_shell_quoted_argv(f, w->launch_argc, w->launch_argv);
+    else
+        write_shell_quoted_argv(f, shell_argc, shell_argv);
+    fputc('\n', f);
+
+    fclose(f);
+    return buf;
+}
+
+static void
+session_do_restore(struct server *server)
+{
+    if (!server->conf->session.enabled)
+        return;
+
+    char *path = session_state_path();
+    if (path == NULL)
+        return;
+
+    session_window_list_t windows = tll_init();
+    bool ok = session_read(path, &windows);
+    free(path);
+
+    if (!ok) {
+        session_window_list_free(&windows);
+        return;
+    }
+
+    char **shell_argv = NULL;
+    if (!tokenize_cmdline(server->conf->shell, &shell_argv)) {
+        LOG_ERR("failed to tokenize shell command line: %s",
+                server->conf->shell);
+        session_window_list_free(&windows);
+        return;
+    }
+
+    size_t shell_argc = 0;
+    while (shell_argv[shell_argc] != NULL)
+        shell_argc++;
+
+    tll_foreach(windows, it) {
+        struct session_window *w = &it->item;
+
+        char *snapshot_path = write_restore_snapshot_file(w->snapshot, w->cols);
+        char *script = build_restore_script(
+            snapshot_path, w, shell_argc, shell_argv);
+
+        if (script == NULL) {
+            LOG_ERR("failed to build restore script for window (cwd=%s)", w->cwd);
+            if (snapshot_path != NULL)
+                unlink(snapshot_path);
+            free(snapshot_path);
+            continue;
+        }
+
+        char *argv[] = {"/bin/sh", "-c", script, "foot", NULL};
+
+        struct terminal_instance *instance = xmalloc(sizeof(*instance));
+        *instance = (struct terminal_instance){
+            .client = NULL,
+            .server = server,
+            .conf = NULL,
+            .launch_argc = w->launch_argc,
+            .launch_argv = session_argv_dup(w->launch_argc, w->launch_argv),
+            .relaunch_cache = tll_init(),
+        };
+
+        instance->terminal = term_init(
+            server->conf, server->fdm, server->reaper, server->wayl,
+            "foot", w->cwd, NULL, NULL, 4, argv, NULL,
+            &term_shutdown_handler, instance);
+
+        if (instance->terminal == NULL) {
+            LOG_WARN("failed to restore window (cwd=%s)", w->cwd);
+            session_argv_free(instance->launch_argc, instance->launch_argv);
+            free(instance);
+            if (snapshot_path != NULL)
+                unlink(snapshot_path);
+        } else {
+            tll_push_back(server->terminals, instance);
+        }
+
+        free(snapshot_path);
+        free(script);
+    }
+
+    for (size_t i = 0; i < shell_argc; i++)
+        free(shell_argv[i]);
+    free(shell_argv);
+
+    session_window_list_free(&windows);
+}
+
+static bool
+fdm_session_timer(struct fdm *fdm, int fd, int events, void *data)
+{
+    struct server *server = data;
+
+    uint64_t expirations;
+    ssize_t amount = read(fd, &expirations, sizeof(expirations));
+    if (amount < 0 && errno != EAGAIN)
+        LOG_ERRNO("failed to read session timer");
+
+    session_do_save(server);
+    return true;
+}
