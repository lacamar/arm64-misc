+}
+
+/* Paths and file I/O */
+
+static char *
+state_path(void)
+{
+    const char *xdg = getenv("XDG_STATE_HOME");
+    if (xdg != NULL && xdg[0] == '/')
+        return xasprintf("%s/foot/session.state", xdg);
+
+    const char *home = getenv("HOME");
+    return home != NULL ? xasprintf("%s/.local/state/foot/session.state", home) : NULL;
+}
+
+static bool
+mkdir_parent(const char *path)
+{
+    char *copy = xstrdup(path);
+    bool ok = true;
+
+    for (char *p = copy + 1; ok && (p = strchr(p, '/')) != NULL; p++) {
+        *p = '\0';
+        if (mkdir(copy, 0700) < 0 && errno != EEXIST) {
+            LOG_ERRNO("%s: failed to create directory", copy);
+            ok = false;
+        }
+        *p = '/';
+    }
+
+    free(copy);
+    return ok;
+}
+
+static bool
+write_file_atomic(const char *path, const char *data, size_t len)
+{
+    if (!mkdir_parent(path))
+        return false;
+
+    char *tmp = xstrjoin(path, ".tmp");
+    int fd = open(tmp, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0600);
+    if (fd < 0) {
+        LOG_ERRNO("%s: failed to open", tmp);
+        free(tmp);
+        return false;
+    }
+
+    bool ok = true;
+    for (size_t done = 0; ok && done < len;) {
+        ssize_t n = write(fd, data + done, len - done);
+        if (n < 0 && errno == EINTR)
+            continue;
+        if (n < 0) {
+            LOG_ERRNO("%s: failed to write", tmp);
+            ok = false;
+        } else
+            done += n;
+    }
+
+    ok = ok && fsync(fd) == 0;
+    ok = close(fd) == 0 && ok;
+
+    if (ok && rename(tmp, path) < 0) {
+        LOG_ERRNO("%s: failed to rename to %s", tmp, path);
+        ok = false;
+    }
+    if (!ok)
+        unlink(tmp);
+
+    free(tmp);
+    return ok;
+}
+
+static char *
+read_file(const char *path, size_t *len)
+{
+    int fd = open(path, O_RDONLY | O_CLOEXEC);
+    if (fd < 0)
+        return NULL;
+
+    char *buf = NULL;
+    size_t size = 0, cap = 0;
+
+    while (true) {
+        if (size + 4096 > cap) {
+            cap = cap == 0 ? 4096 : cap * 2;
+            buf = xrealloc(buf, cap + 1);
+        }
+
+        ssize_t n = read(fd, buf + size, cap - size);
+        if (n < 0 && errno == EINTR)
+            continue;
+        if (n < 0) {
+            free(buf);
+            close(fd);
+            return NULL;
+        }
+        if (n == 0)
+            break;
+        size += n;
+    }
+
+    close(fd);
+    buf[size] = '\0';
+    *len = size;
+    return buf;
+}
+
+static char **
+split_nul(const char *buf, size_t len, size_t *argc)
+{
+    size_t count = 0;
+    for (size_t i = 0; i < len; i++) {
+        if (buf[i] == '\0' || i == len - 1)
+            count++;
+    }
+
+    *argc = count;
+    if (count == 0)
+        return NULL;
+
+    char **argv = xcalloc(count, sizeof(argv[0]));
+    size_t idx = 0;
+    for (size_t start = 0; start < len; idx++) {
+        size_t n = strnlen(buf + start, len - start);
+        argv[idx] = xstrndup(buf + start, n);
+        start += n + 1;
+    }
+    return argv;
+}
+
+/* State file */
+
+static void
+write_blob(FILE *f, const char *data)
+{
+    size_t len = data != NULL ? strlen(data) : 0;
+    fprintf(f, "%zu\n", len);
+    fwrite(data != NULL ? data : "", 1, len, f);
+    fputc('\n', f);
+}
+
+static void
+write_argv(FILE *f, size_t argc, char *const *argv)
+{
+    fprintf(f, "%zu\n", argc);
+    for (size_t i = 0; i < argc; i++)
+        write_blob(f, argv[i]);
+}
+
+static void
+write_window(FILE *f, const struct session_window *w)
+{
+    write_blob(f, w->name);
+    write_blob(f, w->cwd);
+    write_blob(f, w->snapshot);
+    write_argv(f, w->launch_argc, w->launch_argv);
+    fprintf(f, "%zu\n", tll_length(w->commands));
+    tll_foreach(w->commands, it) {
+        write_blob(f, it->item.cwd);
+        write_argv(f, it->item.argc, it->item.argv);
+    }
+}
+
+static char *
+read_blob(FILE *f)
+{
+    size_t len;
+    if (fscanf(f, "%zu", &len) != 1 || fgetc(f) != '\n' || len > 64 * 1024 * 1024)
+        return NULL;
+
+    char *buf = xmalloc(len + 1);
+    if (fread(buf, 1, len, f) != len || fgetc(f) != '\n') {
+        free(buf);
+        return NULL;
+    }
+    buf[len] = '\0';
+    return buf;
+}
+
+static bool
+read_argv(FILE *f, size_t *argc, char ***argv)
+{
+    *argc = 0;
+    *argv = NULL;
+
+    size_t count;
+    if (fscanf(f, "%zu", &count) != 1 || fgetc(f) != '\n' || count > 1024)
+        return false;
+
+    char **v = count > 0 ? xcalloc(count, sizeof(v[0])) : NULL;
+    for (size_t i = 0; i < count; i++) {
+        if ((v[i] = read_blob(f)) == NULL) {
+            argv_free(i, v);
+            return false;
+        }
+    }
+
+    *argc = count;
+    *argv = v;
+    return true;
+}
+
+static struct session_window *
+read_window(FILE *f, int version)
+{
+    struct session_window *w = xcalloc(1, sizeof(*w));
+    size_t count;
+    int cols, rows;
+
+    w->name = version >= 4 ? read_blob(f) : toplevel_name_new();
+
+    bool ok = w->name != NULL && (w->cwd = read_blob(f)) != NULL &&
+        (version > 2 || fscanf(f, "%d %d\n", &cols, &rows) == 2) &&
+        (w->snapshot = read_blob(f)) != NULL &&
+        read_argv(f, &w->launch_argc, &w->launch_argv) &&
+        fscanf(f, "%zu", &count) == 1 && fgetc(f) == '\n' && count <= 64;
+
+    for (size_t i = 0; ok && i < count; i++) {
+        struct session_command cmd = {.cwd = read_blob(f)};
+        ok = cmd.cwd != NULL && read_argv(f, &cmd.argc, &cmd.argv);
+        if (ok)
+            tll_push_back(w->commands, cmd);
+        else
+            free(cmd.cwd);
+    }
+
+    if (!ok) {
+        window_free(w);
+        return NULL;
+    }
+    return w;
+}
+
+static void
+read_state(const char *path, window_list_t *out, char **xdg_id)
+{
+    FILE *f = fopen(path, "re");
+    if (f == NULL)
+        return;
+
+    char magic[32];
+    int version;
+    size_t count;
+    bool ok = fscanf(f, "%31s %d\n", magic, &version) == 2 &&
+        streq(magic, STATE_MAGIC) &&
+        version >= 2 && version <= STATE_VERSION &&
+        (version < 4 || (*xdg_id = read_blob(f)) != NULL) &&
+        fscanf(f, "%zu", &count) == 1 && fgetc(f) == '\n';
+
+    if (*xdg_id != NULL && (*xdg_id)[0] == '\0') {
+        free(*xdg_id);
+        *xdg_id = NULL;
+    }
+
+    for (size_t i = 0; ok && i < count; i++) {
+        struct session_window *w = read_window(f, version);
+        if (w != NULL)
+            tll_push_back(*out, w);
+        else
+            ok = false;
+    }
+
+    fclose(f);
+
+    if (!ok) {
+        LOG_ERR("%s: malformed session state, ignoring", path);
+        tll_foreach(*out, it) {
+            window_free(it->item);
+            tll_remove(*out, it);
+        }
+    }
+
+    /* Never restore the same state twice, e.g. if restoring crashes */
+    char *backup = xstrjoin(path, ".restored");
+    rename(path, backup);
+    free(backup);
+}
+
+static void
+write_state(struct session *s)
+{
+    const time_t now = now_secs();
+    tll_foreach(s->closed, it) {
+        if (now - it->item.at >= CLOSE_GRACE_SECS) {
+            if (s->wayl->xdg_session != NULL)
+                xdg_session_v1_remove_toplevel(s->wayl->xdg_session, it->item.w->name);
+            window_free(it->item.w);
+            tll_remove(s->closed, it);
+        }
+    }
+
+    size_t count = tll_length(s->closed);
+    tll_foreach(s->windows, it)
+        count += it->item->saved != NULL;
+
+    char *buf = NULL;
+    size_t len = 0;
+    FILE *f = open_memstream(&buf, &len);
+    if (f == NULL)
+        return;
+
+    fprintf(f, "%s %d\n", STATE_MAGIC, STATE_VERSION);
+    write_blob(f, s->xdg_id);
+    fprintf(f, "%zu\n", count);
+    tll_foreach(s->windows, it) {
+        if (it->item->saved != NULL)
+            write_window(f, it->item->saved);
+    }
+    tll_foreach(s->closed, it)
+        write_window(f, it->item.w);
+
+    if (fclose(f) != 0) {
+        free(buf);
+        return;
+    }
+
+    if (s->written != NULL && s->written_len == len &&
+        memcmp(s->written, buf, len) == 0)
+    {
+        free(buf);
+        return;
+    }
+
+    bool ok = count > 0 || s->xdg_id != NULL
+        ? write_file_atomic(s->path, buf, len)
+        : unlink(s->path) == 0 || errno == ENOENT;
+
+    if (ok) {
+        free(s->written);
+        s->written = buf;
+        s->written_len = len;
+    } else
+        free(buf);
+}
+
+/* Process inspection */
+
+static bool
+read_proc(pid_t pid, struct proc *out)
+{
+    char path[64];
+    snprintf(path, sizeof(path), "/proc/%d/stat", (int)pid);
+
+    size_t len;
+    char *stat = read_file(path, &len);
+    if (stat == NULL)
+        return false;
+
+    const char *p = strrchr(stat, ')');
+    char state;
+    int ppid, pgid, sid;
+    unsigned long long starttime;
+
+    bool ok = p != NULL && sscanf(
+        p + 1,
+        " %c %d %d %d %*d %*d %*u %*u %*u %*u %*u %*u %*u"
+        " %*d %*d %*d %*d %*d %*d %llu",
+        &state, &ppid, &pgid, &sid, &starttime) == 5 &&
+        state != 'Z' && state != 'X';
+
+    free(stat);
+    if (ok) {
+        *out = (struct proc){
+            .pid = pid, .ppid = ppid, .pgid = pgid, .sid = sid,
+            .starttime = starttime,
+        };
+    }
+    return ok;
+}
+
+static void
+scan_procs(proc_list_t *out)
+{
+    DIR *d = opendir("/proc");
+    if (d == NULL) {
+        LOG_ERRNO("failed to open /proc");
+        return;
+    }
+
+    const struct dirent *e;
+    while ((e = readdir(d)) != NULL) {
+        char *end;
+        long pid = strtol(e->d_name, &end, 10);
+        struct proc p;
+        if (*end == '\0' && pid > 0 && read_proc(pid, &p))
+            tll_push_back(*out, p);
+    }
+
+    closedir(d);
+}
+
+static bool
+fd_is(pid_t pid, int fd, const char *target)
+{
+    char path[64];
+    snprintf(path, sizeof(path), "/proc/%d/fd/%d", (int)pid, fd);
+
+    char buf[PATH_MAX];
+    ssize_t n = readlink(path, buf, sizeof(buf) - 1);
+    if (n < 0)
+        return false;
+    buf[n] = '\0';
+    return streq(buf, target);
+}
+
+/*
+ * At each level, the child with stdin *and* stdout on the pty: skips
+ * helpers spawned with pipes. The foreground pgrp can't be the main
+ * signal, since e.g. lf runs its commands in their own pgrp.
+ */
+static size_t
+proc_chain(const struct terminal *term, const proc_list_t *procs,
+           struct proc chain[static MAX_CHAIN_DEPTH])
+{
+    char pts[PATH_MAX];
+    if (term->ptmx < 0 || ptsname_r(term->ptmx, pts, sizeof(pts)) != 0)
+        return 0;
+
+    const pid_t root = term->slave;
+    const pid_t fg = tcgetpgrp(term->ptmx);
+    size_t n = 0;
+
+    tll_foreach(*procs, it) {
+        if (it->item.pid == root) {
+            chain[n++] = it->item;
+            break;
+        }
+    }
+
+    while (n > 0 && n < MAX_CHAIN_DEPTH) {
+        const struct proc *best = NULL;
+
+        tll_foreach(*procs, it) {
+            const struct proc *p = &it->item;
+            if (p->ppid != chain[n - 1].pid || p->sid != root ||
+                !fd_is(p->pid, STDIN_FILENO, pts) ||
+                !fd_is(p->pid, STDOUT_FILENO, pts))
+            {
+                continue;
+            }
+
+            if (best == NULL ||
+                ((p->pgid == fg) != (best->pgid == fg)
+                 ? p->pgid == fg
+                 : p->starttime > best->starttime))
+            {
+                best = p;
+            }
+        }
+
+        if (best == NULL)
+            break;
+        chain[n++] = *best;
+    }
+
+    return n;
+}
+
+static char *
+proc_cwd(pid_t pid)
+{
+    char path[64];
+    snprintf(path, sizeof(path), "/proc/%d/cwd", (int)pid);
+
+    char buf[PATH_MAX];
+    ssize_t n = readlink(path, buf, sizeof(buf) - 1);
+    if (n <= 0)
+        return NULL;
+    buf[n] = '\0';
+    return xstrdup(buf);
+}
+
+static char **
+proc_file_argv(pid_t pid, const char *file, size_t *argc)
+{
+    char path[64];
+    snprintf(path, sizeof(path), "/proc/%d/%s", (int)pid, file);
+
+    size_t len;
+    char *buf = read_file(path, &len);
+    *argc = 0;
+    if (buf == NULL)
+        return NULL;
+
+    char **argv = split_nul(buf, len, argc);
+    free(buf);
+    return argv;
+}
+
+static int
+proc_restore_step(pid_t pid)
+{
+    size_t envc;
+    char **env = proc_file_argv(pid, "environ", &envc);
+    int step = -1;
+
+    for (size_t i = 0; i < envc; i++) {
+        if (strncmp(env[i], "FOOT_RESTORE_STEP=", 18) == 0) {
+            char *end;
+            long v = strtol(env[i] + 18, &end, 10);
+            if (*end == '\0' && v >= 0 && v < INT_MAX)
+                step = v;
+        }
+    }
+
+    argv_free(envc, env);
+    return step;
+}
+
+/* [session-restore] rule evaluation */
+
+static struct relaunch *
+relaunch_find(struct session *s, pid_t pid, unsigned long long starttime)
+{
+    tll_foreach(s->relaunch, it) {
+        if (it->item.pid == pid && it->item.starttime == starttime)
+            return &it->item;
+    }
+    return NULL;
+}
+
+static void
+relaunch_reset(struct relaunch *r, const char *program)
+{
+    free(r->program);
+    argv_free(r->argc, r->argv);
+    *r = (struct relaunch){
+        .pid = r->pid,
+        .starttime = r->starttime,
+        .program = xstrdup(program),
+        .evaluating = r->evaluating,
+    };
+}
+
+/* Success with "\0" alone: the rule declined. Empty words: failure */
+static bool
+parse_words(const char *out, size_t len, size_t *argc, char ***argv)
+{
+    *argc = 0;
+    *argv = NULL;
+
+    if (len == 0 || out[len - 1] != '\0')
+        return false;
+    if (len == 1)
+        return true;
+
+    for (size_t i = 0; i < len; i++) {
+        if (out[i] == '\0' && (i == 0 || out[i - 1] == '\0'))
+            return false;
+    }
+
+    *argv = split_nul(out, len, argc);
+    return true;
+}
+
+static void
+eval_finish(struct rule_eval *ev)
+{
+    struct session *s = ev->session;
+
+    tll_foreach(s->evals, it) {
+        if (it->item == ev)
+            tll_remove(s->evals, it);
+    }
+
+    struct relaunch *r = relaunch_find(s, ev->pid, ev->starttime);
+    if (r != NULL && streq(r->program, ev->program)) {
+        r->evaluating = false;
+
+        size_t argc;
+        char **argv;
+        bool ok = !ev->failed && WIFEXITED(ev->status) &&
+            WEXITSTATUS(ev->status) == 0 &&
+            parse_words(ev->out, ev->len, &argc, &argv);
+
+        if (!ok) {
+            if (!r->warned) {
+                LOG_WARN("[session-restore] %s (pid=%d): rule failed%s",
+                         r->program, (int)ev->pid,
+                         r->resolved ? ", keeping previous result" : "");
+                r->warned = true;
+            }
+        } else {
+            argv_free(r->argc, r->argv);
+            r->argc = argc;
+            r->argv = argv;
+            r->resolved = true;
+            r->warned = false;
+        }
+    } else if (r != NULL)
+        r->evaluating = false;
+
+    free(ev->program);
+    free(ev->out);
+    free(ev);
+}
+
+static void
+eval_maybe_finish(struct rule_eval *ev)
+{
+    if (ev->fd < 0 && ev->exited)
+        eval_finish(ev);
+}
+
+static void
+eval_abort(struct rule_eval *ev)
+{
+    ev->failed = true;
+    if (!ev->exited)
+        kill(ev->child, SIGKILL);
+    if (ev->fd >= 0) {
+        fdm_del(ev->session->fdm, ev->fd);
+        ev->fd = -1;
+    }
+}
+
+static bool
+fdm_eval_output(struct fdm *fdm, int fd, int events, void *data)
+{
+    struct rule_eval *ev = data;
+
+    char buf[4096];
+    ssize_t n = read(fd, buf, sizeof(buf));
+    if (n < 0 && (errno == EINTR || errno == EAGAIN))
+        return true;
+
+    if (n > 0 && ev->len + n <= RULE_OUTPUT_MAX) {
+        ev->out = xrealloc(ev->out, ev->len + n);
+        memcpy(ev->out + ev->len, buf, n);
+        ev->len += n;
+        return true;
+    }
+
+    if (n != 0)
+        eval_abort(ev);
+    else {
+        fdm_del(fdm, fd);
+        ev->fd = -1;
+    }
+
+    eval_maybe_finish(ev);
+    return true;
+}
+
+static void
+eval_reaped(struct reaper *reaper, pid_t pid, int status, void *data)
+{
+    struct rule_eval *ev = data;
+    ev->exited = true;
+    ev->status = status;
+    eval_maybe_finish(ev);
+}
+
+static char **
+eval_envp(pid_t pid, const char *cwd)
+{
+    size_t envc;
+    char **env = proc_file_argv(pid, "environ", &envc);
+
+    char **envp = xcalloc(envc + 3, sizeof(envp[0]));
+    size_t n = 0;
+    for (size_t i = 0; i < envc; i++) {
+        if (strncmp(env[i], "FOOT_PID=", 9) != 0 &&
+            strncmp(env[i], "FOOT_CWD=", 9) != 0)
+        {
+            envp[n++] = xstrdup(env[i]);
+        }
+    }
+    envp[n++] = xasprintf("FOOT_PID=%d", (int)pid);
+    envp[n++] = xasprintf("FOOT_CWD=%s", cwd);
+
+    argv_free(envc, env);
+    return envp;
+}
+
+static void
+eval_start(struct session *s, struct relaunch *r, const char *command,
+           const char *cwd, size_t argc, char *const *argv)
+{
+    int fds[2];
+    if (pipe2(fds, O_CLOEXEC) < 0) {
+        LOG_ERRNO("failed to create pipe");
+        return;
+    }
+    fcntl(fds[0], F_SETFL, O_NONBLOCK);
+
+    char *script = xasprintf("printf '%%s\\0' %s", command);
+    char **sh_argv = xcalloc(argc + 4, sizeof(sh_argv[0]));
+    sh_argv[0] = "/bin/sh";
+    sh_argv[1] = "-c";
+    sh_argv[2] = script;
+    for (size_t i = 0; i < argc; i++)
+        sh_argv[3 + i] = argv[i];
+
+    char **envp = eval_envp(r->pid, cwd);
+
+    sigset_t mask;
+    sigemptyset(&mask);
+    const struct sigaction dfl = {.sa_handler = SIG_DFL};
+
+    pid_t child = fork();
+    if (child == 0) {
+        int null = open("/dev/null", O_RDWR);
+        if (null < 0 || dup2(null, STDIN_FILENO) < 0 ||
+            dup2(fds[1], STDOUT_FILENO) < 0 ||
+            dup2(null, STDERR_FILENO) < 0 ||
+            sigprocmask(SIG_SETMASK, &mask, NULL) < 0 ||
+            sigaction(SIGPIPE, &dfl, NULL) < 0 ||
+            sigaction(SIGHUP, &dfl, NULL) < 0)
+        {
+            _exit(127);
+        }
+        (void)!chdir(cwd);
+        execve(sh_argv[0], sh_argv, envp);
+        _exit(127);
+    }
+
+    close(fds[1]);
+    free(script);
+    free(sh_argv);
+    for (char **e = envp; *e != NULL; e++)
+        free(*e);
+    free(envp);
+
+    if (child < 0) {
+        LOG_ERRNO("failed to fork");
+        close(fds[0]);
+        return;
+    }
+
+    struct rule_eval *ev = xmalloc(sizeof(*ev));
+    *ev = (struct rule_eval){
+        .session = s,
+        .pid = r->pid,
+        .starttime = r->starttime,
+        .program = xstrdup(r->program),
+        .child = child,
+        .fd = fds[0],
+        .started = now_secs(),
+    };
+
+    reaper_add(s->reaper, child, &eval_reaped, ev);
+    if (!fdm_add(s->fdm, fds[0], EPOLLIN, &fdm_eval_output, ev)) {
+        close(fds[0]);
+        ev->fd = -1;
+        ev->failed = true;
+    }
+
+    tll_push_back(s->evals, ev);
+    r->evaluating = true;
+}
+
+static void
+evals_expire(struct session *s)
+{
+    const time_t now = now_secs();
+    tll_foreach(s->evals, it) {
+        struct rule_eval *ev = it->item;
+        if (ev->failed || now - ev->started < RULE_TIMEOUT_SECS)
+            continue;
+
+        LOG_WARN("[session-restore] %s (pid=%d): rule timed out",
+                 ev->program, (int)ev->pid);
+        eval_abort(ev);
+        if (ev->exited)
+            eval_finish(ev);
+    }
+}
+
+enum resolution { NO_RULE, PENDING, DECLINED, RESOLVED };
+
+static enum resolution
+resolve(struct session *s, const struct config *conf, const struct proc *p,
+        const char *fallback_cwd, bool evaluate,
+        const struct relaunch **out)
+{
+    size_t argc;
+    char **argv = proc_file_argv(p->pid, "cmdline", &argc);
+    if (argc == 0)
+        return NO_RULE;
+
+    const char *slash = strrchr(argv[0], '/');
+    const char *base = slash != NULL ? slash + 1 : argv[0];
+
+    const struct session_restore_rule *rule = NULL;
+    tll_foreach(conf->session.restore_rules, it) {
+        if (streq(it->item.program, base)) {
+            rule = &it->item;
+            break;
+        }
+    }
+
+    if (rule == NULL) {
+        argv_free(argc, argv);
+        return NO_RULE;
+    }
+
+    struct relaunch *r = relaunch_find(s, p->pid, p->starttime);
+    if (r == NULL) {
+        tll_push_back(s->relaunch, ((struct relaunch){
+            .pid = p->pid, .starttime = p->starttime}));
+        r = &tll_back(s->relaunch);
+    }
+    if (r->program == NULL || !streq(r->program, rule->program))
+        relaunch_reset(r, rule->program);
+    r->seen = true;
+
+    if (evaluate && !r->evaluating) {
+        char *cwd = proc_cwd(p->pid);
+        eval_start(s, r, rule->command, cwd != NULL ? cwd : fallback_cwd,
+                   argc, argv);
+        free(cwd);
+    }
+
+    argv_free(argc, argv);
+    *out = r;
+    return !r->resolved ? PENDING : r->argc == 0 ? DECLINED : RESOLVED;
+}
+
+/* Checkpoints */
+
+static struct session_window *
+build_window(struct session *s, const struct session_tracked *t,
+             const proc_list_t *procs, bool evaluate)
+{
+    struct proc chain[MAX_CHAIN_DEPTH];
+    size_t depth = proc_chain(t->term, procs, chain);
+    if (depth == 0)
+        return NULL;
+
+    struct session_window *w = xmalloc(sizeof(*w));
+    *w = (struct session_window){
+        .name = xstrdup(t->name),
+        .cwd = proc_cwd(chain[0].pid),
+        .snapshot = term_snapshot_text(t->term, t->conf->session.scrollback_lines),
+        .launch_argc = t->launch_argc,
+        .launch_argv = argv_dup(t->launch_argc, t->launch_argv),
+        .commands = tll_init(),
+    };
+
+    if (w->cwd == NULL) {
+        const char *home = getenv("HOME");
+        w->cwd = xstrdup(t->term->cwd != NULL ? t->term->cwd
+                         : home != NULL ? home : "/");
+    }
+
+    const int step = depth > 1 ? proc_restore_step(chain[1].pid) : -1;
+    const struct session_command *step_cmd = NULL;
+    if (step >= 0) {
+        int i = 0;
+        tll_foreach(t->restore_commands, it) {
+            if (i++ == step)
+                step_cmd = &it->item;
+        }
+    }
+
+    for (size_t i = 0; i < depth; i++) {
+        const struct relaunch *r = NULL;
+        enum resolution res = resolve(s, t->conf, &chain[i], w->cwd, evaluate, &r);
+
+        if (i == 0) {
+            if (res == RESOLVED) {
+                argv_free(w->launch_argc, w->launch_argv);
+                w->launch_argc = r->argc;
+                w->launch_argv = argv_dup(r->argc, r->argv);
+            }
+            continue;
+        }
+
+        char *cwd = proc_cwd(chain[i].pid);
+        const char *dir = cwd != NULL ? cwd : w->cwd;
+
+        if (res == RESOLVED)
+            command_push(&w->commands, true, dir, r->argc, r->argv);
+        else if (res == PENDING && i == 1 && step_cmd != NULL)
+            command_push(&w->commands, true, dir, step_cmd->argc, step_cmd->argv);
+
+        free(cwd);
+    }
+
+    if (step_cmd != NULL) {
+        int i = 0;
+        tll_foreach(t->restore_commands, it) {
+            if (i++ > step) {
+                command_push(&w->commands, false, it->item.cwd,
+                             it->item.argc, it->item.argv);
+            }
+        }
+    }
+
+    return w;
+}
+
+static void
+checkpoint(struct session *s, bool evaluate)
+{
+    proc_list_t procs = tll_init();
+    scan_procs(&procs);
+
+    tll_foreach(s->relaunch, it)
+        it->item.seen = false;
+
+    tll_foreach(s->windows, it) {
+        struct session_tracked *t = it->item;
+        struct session_window *w = build_window(s, t, &procs, evaluate);
+        if (w == NULL)
+            continue;
+
+        /* At logout programs die concurrently with the final save */
+        if (!evaluate && t->saved != NULL &&
+            tll_length(w->commands) < tll_length(t->saved->commands))
+        {
+            window_free(w);
+            continue;
+        }
+
+        window_free(t->saved);
+        t->saved = w;
+    }
+
+    tll_foreach(s->relaunch, it) {
+        if (!it->item.seen && !it->item.evaluating) {
+            free(it->item.program);
+            argv_free(it->item.argc, it->item.argv);
+            tll_remove(s->relaunch, it);
+        }
+    }
+
+    tll_free(procs);
+    write_state(s);
+}
+
+static bool
+fdm_timer(struct fdm *fdm, int fd, int events, void *data)
+{
+    struct session *s = data;
+
+    uint64_t expirations;
+    if (read(fd, &expirations, sizeof(expirations)) < 0 && errno != EAGAIN)
+        LOG_ERRNO("failed to read session timer");
+
+    evals_expire(s);
+    checkpoint(s, true);
+    return true;
+}
+
+/* Restore */
+
+static void
+write_quoted(FILE *f, const char *s)
+{
+    fputc('\'', f);
+    for (; *s != '\0'; s++) {
+        if (*s == '\'')
+            fputs("'\\''", f);
+        else
+            fputc(*s, f);
+    }
+    fputc('\'', f);
+}
+
+static void
+write_quoted_argv(FILE *f, size_t argc, char *const *argv)
+{
+    for (size_t i = 0; i < argc; i++) {
+        if (i > 0)
+            fputc(' ', f);
+        write_quoted(f, argv[i]);
+    }
+}
+
+/* Replayed through the child's stdout: the grid doesn't exist yet */
+static char *
+write_snapshot_file(const char *snapshot)
+{
+    const char *dir = getenv("XDG_RUNTIME_DIR");
+    char *path = xasprintf(
+        "%s/foot-session-restore-XXXXXX",
+        dir != NULL && dir[0] == '/' ? dir : "/tmp");
+
+    int fd = mkostemp(path, O_CLOEXEC);
+    if (fd < 0) {
+        LOG_ERRNO("failed to create session restore file");
+        free(path);
+        return NULL;
+    }
+
+    FILE *f = fdopen(fd, "w");
+    if (f == NULL) {
+        close(fd);
+        unlink(path);
+        free(path);
+        return NULL;
+    }
+
+    if (snapshot != NULL)
+        fputs(snapshot, f);
+
+    /* Fixed width: a full-width rule wraps after a resize */
+    fputs("\x1b[38;2;110;150;200m"
+          "\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80"
+          "\x1b[1m restored session \x1b[22m"
+          "\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80"
+          "\x1b[0m\n", f);
+
+    if (fclose(f) != 0) {
+        unlink(path);
+        free(path);
+        return NULL;
+    }
+    return path;
+}
+
+static char *
+restore_script(const char *snapshot_path, const struct session_window *w,
+               const char *conf_shell)
+{
+    char *buf = NULL;
+    size_t len = 0;
+    FILE *f = open_memstream(&buf, &len);
+    if (f == NULL)
+        return NULL;
+
+    fputs("trap : INT QUIT\n", f);
+
+    /* foot sets $SHELL to our /bin/sh wrapper */
+    const char *shell = getenv("SHELL");
+    if (shell != NULL) {
+        fputs("export SHELL=", f);
+        write_quoted(f, shell);
+        fputc('\n', f);
+    }
+
+    if (snapshot_path != NULL) {
+        fputs("cat ", f);
+        write_quoted(f, snapshot_path);
+        fputs(" 2>/dev/null; rm -f ", f);
+        write_quoted(f, snapshot_path);
+        fputc('\n', f);
+    }
+
+    size_t step = 0;
+    tll_foreach(w->commands, it) {
+        fputs("(cd ", f);
+        write_quoted(f, it->item.cwd);
+        fprintf(f, " 2>/dev/null; export FOOT_RESTORE_STEP=%zu; exec ", step++);
+        write_quoted_argv(f, it->item.argc, it->item.argv);
+        fputs(")\n", f);
+    }
+
+    fputs("exec ", f);
+    if (w->launch_argc > 0)
+        write_quoted_argv(f, w->launch_argc, w->launch_argv);
+    else
+        fputs(conf_shell, f);
+    fputc('\n', f);
+
+    if (fclose(f) != 0) {
+        free(buf);
+        return NULL;
+    }
+    return buf;
+}
+
+static void
+xdg_session_created(void *data, struct xdg_session_v1 *xdg, const char *id)
+{
+    struct session *s = data;
+    free(s->xdg_id);
+    s->xdg_id = xstrdup(id);
+}
+
+static void
+xdg_session_restored(void *data, struct xdg_session_v1 *xdg)
+{
+}
+
+static void
+xdg_session_replaced(void *data, struct xdg_session_v1 *xdg)
+{
+    struct session *s = data;
+    LOG_WARN("compositor session taken over by another client");
+
+    xdg_session_v1_destroy(xdg);
+    s->wayl->xdg_session = NULL;
+    free(s->xdg_id);
+    s->xdg_id = NULL;
+}
+
+static const struct xdg_session_v1_listener xdg_session_listener = {
+    .created = &xdg_session_created,
+    .restored = &xdg_session_restored,
+    .replaced = &xdg_session_replaced,
+};
+
+static void
+restore(struct session *s, session_restore_cb cb, void *data)
+{
+    window_list_t windows = tll_init();
+    read_state(s->path, &windows, &s->xdg_id);
+
+    if (s->wayl->session_manager != NULL) {
+        s->wayl->xdg_session = xdg_session_manager_v1_get_session(
+            s->wayl->session_manager,
+            tll_length(windows) > 0
+                ? XDG_SESSION_MANAGER_V1_REASON_SESSION_RESTORE
+                : XDG_SESSION_MANAGER_V1_REASON_LAUNCH,
+            s->xdg_id);
+        xdg_session_v1_add_listener(s->wayl->xdg_session, &xdg_session_listener, s);
+    }
+
+    tll_foreach(windows, it) {
+        struct session_window *w = it->item;
+        char *snapshot_path = write_snapshot_file(w->snapshot);
+        char *script = restore_script(snapshot_path, w, s->conf->shell);
+        char *argv[] = {"/bin/sh", "-c", script, "foot", NULL};
+
+        if (script == NULL || !cb(data, s, w, w->cwd, argv)) {
+            if (snapshot_path != NULL)
+                unlink(snapshot_path);
+            window_free(w);
+        }
+
+        free(snapshot_path);
+        free(script);
+        tll_remove(windows, it);
+    }
+}
+
+/* Public API */
+
+struct session *
+session_init(const struct config *conf, struct fdm *fdm, struct reaper *reaper,
+             struct wayland *wayl, session_restore_cb restore_cb,
+             void *restore_data)
+{
+    if (!conf->session.enabled)
+        return NULL;
+
+    char *path = state_path();
+    if (path == NULL)
+        return NULL;
+
+    struct session *s = xmalloc(sizeof(*s));
+    *s = (struct session){
+        .conf = conf,
+        .fdm = fdm,
+        .reaper = reaper,
+        .wayl = wayl,
+        .path = path,
+        .timer_fd = -1,
+        .windows = tll_init(),
+        .closed = tll_init(),
+        .relaunch = tll_init(),
+        .evals = tll_init(),
+    };
+
+    restore(s, restore_cb, restore_data);
+
+    if (conf->session.save_interval_secs == 0)
+        return s;
+
+    int fd = timerfd_create(CLOCK_MONOTONIC, TFD_CLOEXEC | TFD_NONBLOCK);
+    const struct itimerspec its = {
+        .it_value = {.tv_sec = conf->session.save_interval_secs},
+        .it_interval = {.tv_sec = conf->session.save_interval_secs},
+    };
+
+    if (fd < 0 || timerfd_settime(fd, 0, &its, NULL) < 0) {
+        LOG_ERRNO("failed to create session save timer");
+        if (fd >= 0)
+            close(fd);
+    } else if (!fdm_add(fdm, fd, EPOLLIN, &fdm_timer, s))
+        close(fd);
+    else
+        s->timer_fd = fd;
+
+    return s;
+}
+
+void
+session_destroy(struct session *s)
+{
+    if (s == NULL)
+        return;
+
+    checkpoint(s, false);
+
+    if (s->wayl->xdg_session != NULL) {
+        xdg_session_v1_destroy(s->wayl->xdg_session);
+        s->wayl->xdg_session = NULL;
+    }
+
+    if (s->timer_fd >= 0)
+        fdm_del(s->fdm, s->timer_fd);
+
+    tll_foreach(s->evals, it) {
+        struct rule_eval *ev = it->item;
+        reaper_del(s->reaper, ev->child);
+        if (!ev->exited)
+            kill(ev->child, SIGKILL);
+        if (ev->fd >= 0)
+            fdm_del(s->fdm, ev->fd);
+        free(ev->program);
+        free(ev->out);
+        free(ev);
+        tll_remove(s->evals, it);
+    }
+
+    tll_foreach(s->relaunch, it) {
+        free(it->item.program);
+        argv_free(it->item.argc, it->item.argv);
+        tll_remove(s->relaunch, it);
+    }
+
+    tll_foreach(s->closed, it) {
+        window_free(it->item.w);
+        tll_remove(s->closed, it);
+    }
+
+    tll_foreach(s->windows, it) {
+        it->item->session = NULL;
+        tll_remove(s->windows, it);
+    }
+
+    free(s->written);
+    free(s->xdg_id);
+    free(s->path);
+    free(s);
+}
+
+static struct session_tracked *
+track(struct session *s, struct terminal *term, const struct config *conf,
+      char *name, size_t launch_argc, char *const *launch_argv)
+{
+    struct session_tracked *t = xmalloc(sizeof(*t));
+    *t = (struct session_tracked){
+        .session = s,
+        .term = term,
+        .conf = conf,
+        .name = name,
+        .launch_argc = launch_argc,
+        .launch_argv = argv_dup(launch_argc, launch_argv),
+        .restore_commands = tll_init(),
+    };
+    tll_push_back(s->windows, t);
+    return t;
+}
+
+struct session_tracked *
+session_track(struct session *s, struct terminal *term,
+              const struct config *conf,
+              size_t launch_argc, char *const *launch_argv)
+{
+    if (s == NULL)
+        return NULL;
+
+    struct session_tracked *t = track(
+        s, term, conf, toplevel_name_new(), launch_argc, launch_argv);
+
+    struct wl_window *win = term->window;
+    if (s->wayl->xdg_session != NULL) {
+        win->toplevel_session = xdg_session_v1_add_toplevel(
+            s->wayl->xdg_session, win->xdg_toplevel, t->name);
+    }
+    return t;
+}
+
+struct session_tracked *
+session_track_restored(struct session *s, struct terminal *term,
+                       const struct config *conf,
+                       struct session_window *w)
+{
+    struct session_tracked *t = track(
+        s, term, conf, xstrdup(w->name), w->launch_argc, w->launch_argv);
+
+    tll_foreach(w->commands, it) {
+        command_push(&t->restore_commands, false, it->item.cwd,
+                     it->item.argc, it->item.argv);
+    }
+    t->saved = w;
+    return t;
+}
+
+void
+session_untrack(struct session_tracked *t)
+{
+    if (t == NULL)
+        return;
+
+    struct session *s = t->session;
+    if (s != NULL) {
+        tll_foreach(s->windows, it) {
+            if (it->item == t)
+                tll_remove(s->windows, it);
+        }
+
+        if (t->saved != NULL) {
+            tll_push_back(s->closed, ((struct closed_window){t->saved, now_secs()}));
+            t->saved = NULL;
+        } else if (s->wayl->xdg_session != NULL)
+            xdg_session_v1_remove_toplevel(s->wayl->xdg_session, t->name);
+    }
+
+    window_free(t->saved);
+    free(t->name);
+    argv_free(t->launch_argc, t->launch_argv);
+    command_list_free(&t->restore_commands);
+    free(t);
+}
+
+const char *
+session_window_name(const struct session_window *w)
+{
+    return w->name;
+}
