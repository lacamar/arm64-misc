+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <tllist.h>
+
+/* A program to re-run in a restored window, in a specific directory */
+struct session_command {
+    char *cwd;
+    size_t argc;
+    char **argv;
+};
+
+typedef tll(struct session_command) session_command_list_t;
+
+struct session_window {
+    char *cwd;
+    int cols;
+    int rows;
+    char *snapshot;  /* UTF-8 text, NULL if none */
+
+    /*
+     * The command line the window was originally launched with
+     * (e.g. footclient's arguments); empty means "the configured
+     * shell". This is exec'ed last, after all of 'commands'.
+     */
+    size_t launch_argc;
+    char **launch_argv;
+
+    /*
+     * Programs that were running in the window at save time,
+     * innermost (deepest in the process tree) first, as resolved
+     * through the [session-restore] rules. They are re-run, in
+     * order, before finally exec'ing the launch command - so that
+     * quitting a restored program lands you where it did before.
+     */
+    session_command_list_t commands;
+};
+
+typedef tll(struct session_window) session_window_list_t;
+
+char *session_state_path(void);
+
+bool session_write(const char *path, const session_window_list_t *windows);
+bool session_read(const char *path, session_window_list_t *out);
+
+void session_argv_free(size_t argc, char **argv);
+char **session_argv_dup(size_t argc, char *const *argv);
+void session_command_list_free(session_command_list_t *list);
+void session_window_list_free(session_window_list_t *list);
