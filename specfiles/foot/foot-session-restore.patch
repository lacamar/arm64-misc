+/*
+ * term->cwd is only ever updated via OSC 7, which requires the
+ * shell to explicitly opt in with prompt-integration hooks most
+ * shells don't ship by default. Absent that, term->cwd just sits at
+ * whatever directory the window happened to be spawned in and never
+ * tracks where the user actually navigated to.
+ *
+ * /proc/<pid>/cwd on the pty's foreground process is authoritative
+ * and needs no shell cooperation, so prefer it; fall back to
+ * term->cwd (e.g. OSC 7 reported a directory the shell already
+ * cd'ed away from in a race earlier, or the process is already
+ * gone), then $HOME.
+ */
+static char *
+resolve_cwd_for_pid(pid_t pid, const struct terminal *term)
+{
+    if (pid > 0) {
+        char proc_path[32];
+        snprintf(proc_path, sizeof(proc_path), "/proc/%d/cwd", (int)pid);
+
+        char buf[PATH_MAX];
+        ssize_t n = readlink(proc_path, buf, sizeof(buf) - 1);
+        if (n > 0) {
+            buf[n] = '\0';
+            return xstrdup(buf);
+        }
+    }
+
+    if (term->cwd != NULL)
+        return xstrdup(term->cwd);
+
+    const char *home = getenv("HOME");
+    return xstrdup(home != NULL ? home : "/");
+}
+
+static const char *
+path_basename(const char *path)
+{
+    const char *slash = strrchr(path, '/');
+    return slash != NULL ? slash + 1 : path;
+}
+
+static bool
+is_known_shell_name(const char *name)
+{
+    static const char *const shells[] = {
+        "bash", "sh", "dash", "zsh", "fish", "ksh", "mksh", "tcsh",
+        "csh", "nu", "elvish", "pwsh", NULL,
+    };
+    for (size_t i = 0; shells[i] != NULL; i++) {
+        if (streq(name, shells[i]))
+            return true;
+    }
+    return false;
+}
+
+/* Reads /proc/<pid>/cmdline (NUL-separated argv) into a heap-allocated
+ * argv array. Returns NULL (with *out_argc == 0) if unreadable/empty. */
+static char **
+read_proc_cmdline(pid_t pid, size_t *out_argc)
+{
+    *out_argc = 0;
+
+    char proc_path[32];
+    snprintf(proc_path, sizeof(proc_path), "/proc/%d/cmdline", (int)pid);
+
+    FILE *f = fopen(proc_path, "r");
+    if (f == NULL)
+        return NULL;
+
+    char *buf = NULL;
+    size_t cap = 0, len = 0;
+    char chunk[4096];
+    size_t n;
+
+    while ((n = fread(chunk, 1, sizeof(chunk), f)) > 0) {
+        if (len + n > cap) {
+            cap = (len + n) * 2;
+            buf = xrealloc(buf, cap);
+        }
+        memcpy(buf + len, chunk, n);
+        len += n;
+    }
+    fclose(f);
+
+    if (len == 0) {
+        free(buf);
+        return NULL;
+    }
+
+    size_t argc = 0;
+    for (size_t i = 0; i < len; i++) {
+        if (buf[i] == '\0')
+            argc++;
+    }
+    if (buf[len - 1] != '\0')
+        argc++;  /* truncated/unterminated last field */
+
+    if (argc == 0) {
+        free(buf);
+        return NULL;
+    }
+
+    char **argv = xcalloc(argc, sizeof(argv[0]));
+    size_t idx = 0, start = 0;
+    for (size_t i = 0; i < len; i++) {
+        if (buf[i] == '\0') {
+            argv[idx++] = xstrndup(buf + start, i - start);
+            start = i + 1;
+        }
+    }
+    if (start < len)
+        argv[idx++] = xstrndup(buf + start, len - start);
+
+    free(buf);
+    *out_argc = idx;
+    return argv;
+}
+
+/*
+ * Inspects the program actually running in 'term' right now: its
+ * cwd, and - if something other than the (configured) shell is in
+ * the foreground, e.g. an editor or file manager - that program's
+ * command line, so it can be re-launched (not resumed - we have no
+ * way to restore its internal state) on restore.
+ *
+ * The pty's foreground process group is the standard, shell-
+ * agnostic way to find "what's actually running right now": when
+ * you run a program from an interactive shell, it becomes the
+ * foreground process group of the terminal until it exits.
+ */
+static void
+inspect_terminal_process(const struct terminal *term, const char *shell_basename,
+                          char **out_cwd, size_t *out_argc, char ***out_argv)
+{
+    *out_argc = 0;
+    *out_argv = NULL;
+
+    pid_t fg_pgid = tcgetpgrp(term->ptmx);
+    *out_cwd = resolve_cwd_for_pid(fg_pgid > 0 ? fg_pgid : term->slave, term);
+
+    if (fg_pgid <= 0 || fg_pgid == term->slave)
+        return;
+
+    size_t argc;
+    char **argv = read_proc_cmdline(fg_pgid, &argc);
+    if (argv == NULL)
+        return;
+
+    const char *base = path_basename(argv[0]);
+    if (is_known_shell_name(base) ||
+        (shell_basename != NULL && streq(base, shell_basename)))
+    {
+        for (size_t i = 0; i < argc; i++)
+            free(argv[i]);
+        free(argv);
+        return;
+    }
+
+    *out_argc = argc;
+    *out_argv = argv;
+}
+
+static void
+save_terminal_window(struct server *server, struct terminal *term,
+                      const char *shell_basename, session_window_list_t *windows)
+{
+    char *cwd;
+    size_t command_argc;
+    char **command_argv;
+    inspect_terminal_process(term, shell_basename, &cwd, &command_argc, &command_argv);
+
+    if (!server->conf->session.relaunch_command && command_argc > 0) {
+        for (size_t i = 0; i < command_argc; i++)
+            free(command_argv[i]);
+        free(command_argv);
+        command_argc = 0;
+        command_argv = NULL;
+    }
+
+    tll_push_back(*windows, ((struct session_window){
+        .cwd = cwd,
+        .cols = term->cols,
+        .rows = term->rows,
+        .snapshot = term_snapshot_text(
+            term, server->conf->session.scrollback_lines),
+        .command_argc = command_argc,
+        .command_argv = command_argv,
+    }));
+}
+
+static void
+session_do_save(struct server *server)
+{
+    if (!server->conf->session.enabled)
+        return;
+
+    char *path = session_state_path();
+    if (path == NULL)
+        return;
+
+    /* Basename of the configured shell, to avoid re-launching a
+     * subshell (e.g. from `su`) as if it were a "foreground
+     * program" of interest. */
+    char shell_basename_buf[256];
+    {
+        const char *shell = server->conf->shell;
+        const char *end = strchr(shell, ' ');
+        size_t len = end != NULL ? (size_t)(end - shell) : strlen(shell);
+        if (len >= sizeof(shell_basename_buf))
+            len = sizeof(shell_basename_buf) - 1;
+        memcpy(shell_basename_buf, shell, len);
+        shell_basename_buf[len] = '\0';
+    }
+    const char *shell_basename = path_basename(shell_basename_buf);
+
+    session_window_list_t windows = tll_init();
+
+    tll_foreach(server->clients, it) {
+        struct terminal_instance *instance = it->item->instance;
+        if (instance == NULL || instance->terminal == NULL)
+            continue;
+        save_terminal_window(server, instance->terminal, shell_basename, &windows);
+    }
+
+    tll_foreach(server->terminals, it) {
+        if (it->item->terminal == NULL)
+            continue;
+        save_terminal_window(server, it->item->terminal, shell_basename, &windows);
+    }
+
+    if (tll_length(windows) == 0) {
+        /* Nothing to save - drop any stale state from a previous run */
+        unlink(path);
+    } else if (!session_write(path, &windows)) {
+        LOG_WARN("failed to save session state to %s", path);
+    } else {
+        LOG_DBG("saved %zu window(s) to %s", tll_length(windows), path);
+    }
+
+    session_window_list_free(&windows);
+    free(path);
+}
+
+/*
+ * Writes a horizontal divider, made up of box-drawing characters and
+ * a centered label, exactly 'cols' columns wide (falling back to a
+ * sane minimum width if 'cols' is too narrow for the label).
+ */
+static void
+write_restore_banner(FILE *f, int cols)
+{
+    static const char label[] = " restored session ";
+    int label_cols = (int)sizeof(label) - 1;  /* ASCII-only: 1 byte == 1 column */
+
+    if (cols < label_cols + 4)
+        cols = label_cols + 4;
+
+    int dashes = cols - label_cols;
+    int left = dashes / 2;
+    int right = dashes - left;
+
+    fputs("\x1b[38;2;110;150;200m", f);
+    for (int i = 0; i < left; i++)
+        fputs("\xe2\x94\x80", f);  /* U+2500 BOX DRAWINGS LIGHT HORIZONTAL */
+    fputs("\x1b[1m", f);
+    fputs(label, f);
+    fputs("\x1b[22m", f);
+    for (int i = 0; i < right; i++)
+        fputs("\xe2\x94\x80", f);
+    fputs("\x1b[0m\n", f);
+}
+
+/*
+ * Writes 'snapshot' (may be NULL/empty) followed by a "restored"
+ * banner to a private temp file under XDG_RUNTIME_DIR, for a
+ * restored window's wrapper shell to cat(1) out on startup.
+ *
+ * We cannot feed this text directly into the new terminal via
+ * vt_from_slave() right after term_init(): the grid isn't allocated
+ * until the compositor's first surface configure arrives, which
+ * happens later, asynchronously, on the Wayland event loop. Piping
+ * it through the child's own stdout instead reuses the exact same,
+ * already-safe path normal program output takes.
+ */
+static char *
+write_restore_snapshot_file(const char *snapshot, int cols)
+{
+    const char *runtime_dir = getenv("XDG_RUNTIME_DIR");
+    if (runtime_dir == NULL || runtime_dir[0] == '\0')
+        runtime_dir = "/tmp";
+
+    size_t len = strlen(runtime_dir) + strlen("/foot-session-restore-XXXXXX") + 1;
+    char *path = xmalloc(len);
+    snprintf(path, len, "%s/foot-session-restore-XXXXXX", runtime_dir);
+
+    int fd = mkstemp(path);
+    if (fd < 0) {
+        LOG_ERRNO("failed to create session restore temp file");
+        free(path);
+        return NULL;
+    }
+
+    FILE *f = fdopen(fd, "w");
+    if (f == NULL) {
+        LOG_ERRNO("fdopen() failed");
+        close(fd);
+        unlink(path);
+        free(path);
+        return NULL;
+    }
+
+    if (snapshot != NULL && snapshot[0] != '\0')
+        fprintf(f, "%s\n", snapshot);
+    write_restore_banner(f, cols);
+
+    fclose(f);
+    return path;
+}
+
+static void
+write_shell_quoted(FILE *f, const char *s)
+{
+    fputc('\'', f);
+    for (const char *p = s; *p != '\0'; p++) {
+        if (*p == '\'')
+            fputs("'\\''", f);
+        else
+            fputc((unsigned char)*p, f);
+    }
+    fputc('\'', f);
+}
+
+/*
+ * Builds the POSIX sh -c script a restored window's wrapper shell
+ * runs: replay the saved snapshot (if any), then, if something other
+ * than the shell was running in the window (e.g. an editor), re-run
+ * that command - a fresh instance, not a resumed one - before
+ * finally exec'ing into the interactive shell.
+ */
+static char *
+build_restore_script(const char *snapshot_path,
+                      size_t command_argc, char *const *command_argv,
+                      size_t shell_argc, char *const *shell_argv)
+{
+    char *buf = NULL;
+    size_t size = 0;
+    FILE *f = open_memstream(&buf, &size);
+    if (f == NULL)
+        return NULL;
+
+    if (snapshot_path != NULL) {
+        fputs("cat ", f);
+        write_shell_quoted(f, snapshot_path);
+        fputs(" 2>/dev/null; rm -f ", f);
+        write_shell_quoted(f, snapshot_path);
+        fputc('\n', f);
+    }
+
+    if (command_argc > 0) {
+        for (size_t i = 0; i < command_argc; i++) {
+            write_shell_quoted(f, command_argv[i]);
+            fputc(' ', f);
+        }
+        fputc('\n', f);
+    }
+
+    fputs("exec ", f);
+    for (size_t i = 0; i < shell_argc; i++) {
+        write_shell_quoted(f, shell_argv[i]);
+        fputc(' ', f);
+    }
+    fputc('\n', f);
+
+    fclose(f);
+    return buf;
+}
+
+static void
+session_do_restore(struct server *server)
+{
+    if (!server->conf->session.enabled)
+        return;
+
+    char *path = session_state_path();
+    if (path == NULL)
+        return;
+
+    session_window_list_t windows = tll_init();
+    bool ok = session_read(path, &windows);
+    free(path);
+
+    if (!ok) {
+        session_window_list_free(&windows);
+        return;
+    }
+
+    tll_foreach(windows, it) {
+        struct session_window *w = &it->item;
+
+        char **shell_argv = NULL;
+        if (!tokenize_cmdline(server->conf->shell, &shell_argv)) {
+            LOG_ERR("failed to tokenize shell command line: %s",
+                    server->conf->shell);
+            continue;
+        }
+
+        size_t shell_argc = 0;
+        while (shell_argv[shell_argc] != NULL)
+            shell_argc++;
+
+        char *snapshot_path = write_restore_snapshot_file(w->snapshot, w->cols);
+        char *script = build_restore_script(
+            snapshot_path, w->command_argc, w->command_argv,
+            shell_argc, shell_argv);
+
+        if (script == NULL) {
+            LOG_ERR("failed to build restore script for window (cwd=%s)", w->cwd);
+            free(snapshot_path);
+            for (size_t i = 0; i < shell_argc; i++)
+                free(shell_argv[i]);
+            free(shell_argv);
+            continue;
+        }
+
+        char *argv[] = {"/bin/sh", "-c", script, "foot", NULL};
+
+        struct terminal_instance *instance = xmalloc(sizeof(*instance));
+        *instance = (struct terminal_instance){
+            .client = NULL,
+            .server = server,
+            .conf = NULL,
+        };
+
+        instance->terminal = term_init(
+            server->conf, server->fdm, server->reaper, server->wayl,
+            "foot", w->cwd, NULL, NULL, 4, argv, NULL,
+            &term_shutdown_handler, instance);
+
+        if (instance->terminal == NULL) {
+            LOG_WARN("failed to restore window (cwd=%s)", w->cwd);
+            free(instance);
+            if (snapshot_path != NULL)
+                unlink(snapshot_path);
+        } else {
+            tll_push_back(server->terminals, instance);
+        }
+
+        free(snapshot_path);
+        free(script);
+        for (size_t i = 0; i < shell_argc; i++)
+            free(shell_argv[i]);
+        free(shell_argv);
+    }
+
+    session_window_list_free(&windows);
+}
