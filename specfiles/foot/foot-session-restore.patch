diff -Nru '--exclude=build' -x '*.o' pristine/session.c foot-src/session.c
--- pristine/session.c	1970-01-01 01:00:00.000000000 +0100
+++ foot-src/session.c	2026-09-15 08:17:31.900975666 +0200
@@ -0,0 +1,288 @@
+#include "session.h"
+
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include <errno.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <pwd.h>
+
+#define LOG_MODULE "session"
+#define LOG_ENABLE_DBG 0
+#include "log.h"
+#include "util.h"
+#include "xmalloc.h"
+
+#define SESSION_MAGIC "FOOT-SESSION"
+#define SESSION_VERSION 1
+
+static char *
+xdg_state_home(void)
+{
+    const char *xdg = getenv("XDG_STATE_HOME");
+    if (xdg != NULL && xdg[0] != '\0')
+        return xstrdup(xdg);
+
+    const char *home = getenv("HOME");
+    if (home == NULL || home[0] == '\0') {
+        struct passwd *pw = getpwuid(getuid());
+        home = pw != NULL ? pw->pw_dir : NULL;
+    }
+
+    if (home == NULL)
+        return NULL;
+
+    size_t len = strlen(home) + strlen("/.local/state") + 1;
+    char *path = xmalloc(len);
+    snprintf(path, len, "%s/.local/state", home);
+    return path;
+}
+
+char *
+session_state_path(void)
+{
+    char *state_home = xdg_state_home();
+    if (state_home == NULL)
+        return NULL;
+
+    size_t len = strlen(state_home) + strlen("/foot/session.state") + 1;
+    char *path = xmalloc(len);
+    snprintf(path, len, "%s/foot/session.state", state_home);
+    free(state_home);
+    return path;
+}
+
+static bool
+mkdir_parent(const char *path)
+{
+    char *copy = xstrdup(path);
+    char *slash = strrchr(copy, '/');
+    if (slash == NULL) {
+        free(copy);
+        return true;
+    }
+    *slash = '\0';
+
+    /* Create each path component; ignore EEXIST */
+    for (char *p = copy + 1; *p != '\0'; p++) {
+        if (*p == '/') {
+            *p = '\0';
+            if (mkdir(copy, 0700) < 0 && errno != EEXIST) {
+                LOG_ERRNO("failed to create directory: %s", copy);
+                free(copy);
+                return false;
+            }
+            *p = '/';
+        }
+    }
+
+    if (mkdir(copy, 0700) < 0 && errno != EEXIST) {
+        LOG_ERRNO("failed to create directory: %s", copy);
+        free(copy);
+        return false;
+    }
+
+    free(copy);
+    return true;
+}
+
+static bool
+write_blob(FILE *f, const char *data)
+{
+    size_t len = data != NULL ? strlen(data) : 0;
+    if (fprintf(f, "%zu\n", len) < 0)
+        return false;
+    if (len > 0 && fwrite(data, 1, len, f) != len)
+        return false;
+    if (fputc('\n', f) == EOF)
+        return false;
+    return true;
+}
+
+static char *
+read_blob(FILE *f)
+{
+    char len_line[32];
+    if (fgets(len_line, sizeof(len_line), f) == NULL)
+        return NULL;
+
+    errno = 0;
+    char *end;
+    unsigned long len = strtoul(len_line, &end, 10);
+    if (errno != 0 || end == len_line || (*end != '\n' && *end != '\0'))
+        return NULL;
+
+    /* Sanity cap: refuse absurdly large blobs (corrupt/hostile file) */
+    if (len > 64 * 1024 * 1024)
+        return NULL;
+
+    char *buf = xmalloc(len + 1);
+    if (len > 0 && fread(buf, 1, len, f) != len) {
+        free(buf);
+        return NULL;
+    }
+    buf[len] = '\0';
+
+    int c = fgetc(f);
+    if (c != '\n' && c != EOF) {
+        free(buf);
+        return NULL;
+    }
+
+    return buf;
+}
+
+bool
+session_write(const char *path, const session_window_list_t *windows)
+{
+    if (!mkdir_parent(path))
+        return false;
+
+    size_t tmp_len = strlen(path) + strlen(".tmp") + 1;
+    char *tmp_path = xmalloc(tmp_len);
+    snprintf(tmp_path, tmp_len, "%s.tmp", path);
+
+    FILE *f = fopen(tmp_path, "we");
+    if (f == NULL) {
+        LOG_ERRNO("failed to open %s for writing", tmp_path);
+        free(tmp_path);
+        return false;
+    }
+
+    bool ok = fprintf(f, "%s %d\n", SESSION_MAGIC, SESSION_VERSION) >= 0 &&
+              fprintf(f, "%zu\n", tll_length(*windows)) >= 0;
+
+    tll_foreach(*windows, it) {
+        if (!ok)
+            break;
+        const struct session_window *w = &it->item;
+        ok = write_blob(f, w->cwd) &&
+             fprintf(f, "%d %d\n", w->cols, w->rows) >= 0 &&
+             write_blob(f, w->snapshot) &&
+             fprintf(f, "%zu\n", w->command_argc) >= 0;
+
+        for (size_t i = 0; ok && i < w->command_argc; i++)
+            ok = write_blob(f, w->command_argv[i]);
+    }
+
+    ok = ok && fflush(f) == 0;
+    if (fclose(f) != 0)
+        ok = false;
+
+    if (!ok) {
+        unlink(tmp_path);
+        free(tmp_path);
+        return false;
+    }
+
+    if (rename(tmp_path, path) < 0) {
+        LOG_ERRNO("failed to rename %s -> %s", tmp_path, path);
+        unlink(tmp_path);
+        free(tmp_path);
+        return false;
+    }
+
+    free(tmp_path);
+    return true;
+}
+
+bool
+session_read(const char *path, session_window_list_t *out)
+{
+    FILE *f = fopen(path, "re");
+    if (f == NULL) {
+        /* No saved session is not an error */
+        return true;
+    }
+
+    char magic[32] = {0};
+    int version = -1;
+    bool ok = fscanf(f, "%31s %d\n", magic, &version) == 2 &&
+              streq(magic, SESSION_MAGIC) && version == SESSION_VERSION;
+
+    size_t count = 0;
+    ok = ok && fscanf(f, "%zu\n", &count) == 1;
+
+    size_t loaded = 0;
+    for (size_t i = 0; ok && i < count; i++) {
+        char *cwd = read_blob(f);
+        int cols = 0, rows = 0;
+        bool line_ok = cwd != NULL && fscanf(f, "%d %d\n", &cols, &rows) == 2;
+        char *snapshot = line_ok ? read_blob(f) : NULL;
+
+        size_t command_argc = 0;
+        line_ok = line_ok && fscanf(f, "%zu\n", &command_argc) == 1;
+
+        /* Sanity cap: refuse absurd argument counts (corrupt file) */
+        line_ok = line_ok && command_argc <= 1024;
+
+        char **command_argv = NULL;
+        if (line_ok && command_argc > 0)
+            command_argv = xcalloc(command_argc, sizeof(command_argv[0]));
+
+        for (size_t a = 0; line_ok && a < command_argc; a++) {
+            command_argv[a] = read_blob(f);
+            if (command_argv[a] == NULL)
+                line_ok = false;
+        }
+
+        if (!line_ok || cols <= 0 || rows <= 0) {
+            free(cwd);
+            free(snapshot);
+            if (command_argv != NULL) {
+                for (size_t a = 0; a < command_argc; a++)
+                    free(command_argv[a]);
+                free(command_argv);
+            }
+            ok = false;
+            break;
+        }
+
+        tll_push_back(*out, ((struct session_window){
+            .cwd = cwd,
+            .cols = cols,
+            .rows = rows,
+            .snapshot = snapshot,
+            .command_argc = command_argc,
+            .command_argv = command_argv,
+        }));
+        loaded++;
+    }
+
+    fclose(f);
+
+    if (!ok) {
+        LOG_ERR("%s: malformed session state file, ignoring", path);
+        session_window_list_free(out);
+        /*
+         * Rename it aside instead of deleting - it might be useful
+         * for debugging, and this guarantees we do not loop trying
+         * (and failing) to restore it again next time.
+         */
+    } else {
+        LOG_INFO("loaded %zu window(s) from previous session", loaded);
+    }
+
+    size_t backup_len = strlen(path) + strlen(".restored") + 1;
+    char *backup_path = xmalloc(backup_len);
+    snprintf(backup_path, backup_len, "%s.restored", path);
+    rename(path, backup_path);
+    free(backup_path);
+
+    return ok;
+}
+
+void
+session_window_list_free(session_window_list_t *list)
+{
+    tll_foreach(*list, it) {
+        free(it->item.cwd);
+        free(it->item.snapshot);
+        for (size_t i = 0; i < it->item.command_argc; i++)
+            free(it->item.command_argv[i]);
+        free(it->item.command_argv);
+        tll_remove(*list, it);
+    }
+}
diff -Nru '--exclude=build' -x '*.o' pristine/session.h foot-src/session.h
--- pristine/session.h	1970-01-01 01:00:00.000000000 +0100
+++ foot-src/session.h	2026-09-15 08:17:31.900975666 +0200
@@ -0,0 +1,45 @@
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+
+#include <tllist.h>
+
+struct session_window {
+    char *cwd;
+    int cols;
+    int rows;
+    char *snapshot;  /* UTF-8 text, NULL if none */
+
+    /*
+     * The foreground program running in the window at save time
+     * (e.g. an editor or file manager), if any - NULL/0 if the
+     * shell itself was in the foreground. Restoring re-launches
+     * this command in the window before dropping to an interactive
+     * shell; it is a fresh instance, not a resumed one.
+     */
+    size_t command_argc;
+    char **command_argv;
+};
+
+typedef tll(struct session_window) session_window_list_t;
+
+/*
+ * Path to the session state file, under $XDG_STATE_HOME (or its
+ * default). Returned string is heap allocated; caller frees it.
+ */
+char *session_state_path(void);
+
+/* Atomically write 'windows' to 'path'. */
+bool session_write(const char *path, const session_window_list_t *windows);
+
+/*
+ * Read and parse 'path' into 'out'. On success, and if the file
+ * described at least one window, the file is renamed to
+ * '<path>.restored' so it is not picked up again on the next
+ * start. Returns false only on I/O/parse errors; an empty (but
+ * present) file is not an error.
+ */
+bool session_read(const char *path, session_window_list_t *out);
+
+void session_window_list_free(session_window_list_t *list);
