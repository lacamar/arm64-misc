+static char *
+xdg_state_home(void)
+{
+    const char *xdg = getenv("XDG_STATE_HOME");
+    if (xdg != NULL && xdg[0] != '\0')
+        return xstrdup(xdg);
+
+    const char *home = getenv("HOME");
+    if (home == NULL || home[0] == '\0') {
+        struct passwd *pw = getpwuid(getuid());
+        home = pw != NULL ? pw->pw_dir : NULL;
+    }
+
+    if (home == NULL)
+        return NULL;
+
+    size_t len = strlen(home) + strlen("/.local/state") + 1;
+    char *path = xmalloc(len);
+    snprintf(path, len, "%s/.local/state", home);
+    return path;
+}
+
+char *
+session_state_path(void)
+{
+    char *state_home = xdg_state_home();
+    if (state_home == NULL)
+        return NULL;
+
+    size_t len = strlen(state_home) + strlen("/foot/session.state") + 1;
+    char *path = xmalloc(len);
+    snprintf(path, len, "%s/foot/session.state", state_home);
+    free(state_home);
+    return path;
+}
+
+static bool
+mkdir_parent(const char *path)
+{
+    char *copy = xstrdup(path);
+    char *slash = strrchr(copy, '/');
+    if (slash == NULL) {
+        free(copy);
+        return true;
+    }
+    *slash = '\0';
+
+    /* Create each path component; ignore EEXIST */
+    for (char *p = copy + 1; *p != '\0'; p++) {
+        if (*p == '/') {
+            *p = '\0';
+            if (mkdir(copy, 0700) < 0 && errno != EEXIST) {
+                LOG_ERRNO("failed to create directory: %s", copy);
+                free(copy);
+                return false;
+            }
+            *p = '/';
+        }
+    }
+
+    if (mkdir(copy, 0700) < 0 && errno != EEXIST) {
+        LOG_ERRNO("failed to create directory: %s", copy);
+        free(copy);
+        return false;
+    }
+
+    free(copy);
+    return true;
+}
+
+static bool
+write_blob(FILE *f, const char *data)
+{
+    size_t len = data != NULL ? strlen(data) : 0;
+    if (fprintf(f, "%zu\n", len) < 0)
+        return false;
+    if (len > 0 && fwrite(data, 1, len, f) != len)
+        return false;
+    if (fputc('\n', f) == EOF)
+        return false;
+    return true;
+}
+
+static char *
+read_blob(FILE *f)
+{
+    char len_line[32];
+    if (fgets(len_line, sizeof(len_line), f) == NULL)
+        return NULL;
+
+    errno = 0;
+    char *end;
+    unsigned long len = strtoul(len_line, &end, 10);
+    if (errno != 0 || end == len_line || (*end != '\n' && *end != '\0'))
+        return NULL;
+
+    /* Sanity cap: refuse absurdly large blobs (corrupt/hostile file) */
+    if (len > 64 * 1024 * 1024)
+        return NULL;
+
+    char *buf = xmalloc(len + 1);
+    if (len > 0 && fread(buf, 1, len, f) != len) {
+        free(buf);
+        return NULL;
+    }
+    buf[len] = '\0';
+
+    int c = fgetc(f);
+    if (c != '\n' && c != EOF) {
+        free(buf);
+        return NULL;
+    }
+
+    return buf;
+}
+
+void
+session_argv_free(size_t argc, char **argv)
+{
+    for (size_t i = 0; i < argc; i++)
+        free(argv[i]);
+    free(argv);
+}
+
+char **
+session_argv_dup(size_t argc, char *const *argv)
+{
+    if (argc == 0)
+        return NULL;
+    char **copy = xcalloc(argc, sizeof(copy[0]));
+    for (size_t i = 0; i < argc; i++)
+        copy[i] = xstrdup(argv[i]);
+    return copy;
+}
+
+static bool
+write_argv(FILE *f, size_t argc, char *const *argv)
+{
+    if (fprintf(f, "%zu\n", argc) < 0)
+        return false;
+    for (size_t i = 0; i < argc; i++) {
+        if (!write_blob(f, argv[i]))
+            return false;
+    }
+    return true;
+}
+
+/* Returns false on a malformed file; an empty argv is not an error */
+static bool
+read_argv(FILE *f, size_t *out_argc, char ***out_argv)
+{
+    *out_argc = 0;
+    *out_argv = NULL;
+
+    size_t argc = 0;
+    if (fscanf(f, "%zu\n", &argc) != 1)
+        return false;
+
+    /* Sanity cap: refuse absurd argument counts (corrupt file) */
+    if (argc > 1024)
+        return false;
+
+    if (argc == 0)
+        return true;
+
+    char **argv = xcalloc(argc, sizeof(argv[0]));
+    for (size_t i = 0; i < argc; i++) {
+        argv[i] = read_blob(f);
+        if (argv[i] == NULL) {
+            session_argv_free(argc, argv);
+            return false;
+        }
+    }
+
+    *out_argc = argc;
+    *out_argv = argv;
+    return true;
+}
+
+bool
+session_write(const char *path, const session_window_list_t *windows)
+{
+    if (!mkdir_parent(path))
+        return false;
+
+    size_t tmp_len = strlen(path) + strlen(".tmp") + 1;
+    char *tmp_path = xmalloc(tmp_len);
+    snprintf(tmp_path, tmp_len, "%s.tmp", path);
+
+    FILE *f = fopen(tmp_path, "we");
+    if (f == NULL) {
+        LOG_ERRNO("failed to open %s for writing", tmp_path);
+        free(tmp_path);
+        return false;
+    }
+
+    bool ok = fprintf(f, "%s %d\n", SESSION_MAGIC, SESSION_VERSION) >= 0 &&
+              fprintf(f, "%zu\n", tll_length(*windows)) >= 0;
+
+    tll_foreach(*windows, it) {
+        if (!ok)
+            break;
+        const struct session_window *w = &it->item;
+        ok = write_blob(f, w->cwd) &&
+             fprintf(f, "%d %d\n", w->cols, w->rows) >= 0 &&
+             write_blob(f, w->snapshot) &&
+             write_argv(f, w->launch_argc, w->launch_argv) &&
+             fprintf(f, "%zu\n", tll_length(w->commands)) >= 0;
+
+        tll_foreach(w->commands, cit) {
+            if (!ok)
+                break;
+            ok = write_blob(f, cit->item.cwd) &&
+                 write_argv(f, cit->item.argc, cit->item.argv);
+        }
+    }
+
+    ok = ok && fflush(f) == 0;
+    if (fclose(f) != 0)
+        ok = false;
+
+    if (!ok) {
+        unlink(tmp_path);
+        free(tmp_path);
+        return false;
+    }
+
+    if (rename(tmp_path, path) < 0) {
+        LOG_ERRNO("failed to rename %s -> %s", tmp_path, path);
+        unlink(tmp_path);
+        free(tmp_path);
+        return false;
+    }
+
+    free(tmp_path);
+    return true;
+}
+
+bool
+session_read(const char *path, session_window_list_t *out)
+{
+    FILE *f = fopen(path, "re");
+    if (f == NULL) {
+        /* No saved session is not an error */
+        return true;
+    }
+
+    char magic[32] = {0};
+    int version = -1;
+    bool ok = fscanf(f, "%31s %d\n", magic, &version) == 2 &&
+              streq(magic, SESSION_MAGIC) &&
+              (version == 1 || version == SESSION_VERSION);
+
+    size_t count = 0;
+    ok = ok && fscanf(f, "%zu\n", &count) == 1;
+
+    size_t loaded = 0;
+    for (size_t i = 0; ok && i < count; i++) {
+        struct session_window w = {.commands = tll_init()};
+
+        w.cwd = read_blob(f);
+        bool line_ok = w.cwd != NULL &&
+            fscanf(f, "%d %d\n", &w.cols, &w.rows) == 2 &&
+            w.cols > 0 && w.rows > 0;
+
+        if (line_ok) {
+            w.snapshot = read_blob(f);
+            line_ok = w.snapshot != NULL;
+        }
+
+        size_t command_count = 0;
+        if (version == 1) {
+            /* v1 carried a single "re-run verbatim" foreground
+             * command; those were unfiltered, so drop it */
+            size_t argc;
+            char **argv;
+            line_ok = line_ok && read_argv(f, &argc, &argv);
+            if (line_ok)
+                session_argv_free(argc, argv);
+        } else {
+            line_ok = line_ok &&
+                read_argv(f, &w.launch_argc, &w.launch_argv) &&
+                fscanf(f, "%zu\n", &command_count) == 1 &&
+                command_count <= 64;
+        }
+
+        for (size_t c = 0; line_ok && c < command_count; c++) {
+            struct session_command cmd = {0};
+            cmd.cwd = read_blob(f);
+            line_ok = cmd.cwd != NULL && read_argv(f, &cmd.argc, &cmd.argv);
+            if (!line_ok) {
+                free(cmd.cwd);
+                break;
+            }
+            tll_push_back(w.commands, cmd);
+        }
+
+        if (!line_ok) {
+            free(w.cwd);
+            free(w.snapshot);
+            session_argv_free(w.launch_argc, w.launch_argv);
+            session_command_list_free(&w.commands);
+            ok = false;
+            break;
+        }
+
+        tll_push_back(*out, w);
+        loaded++;
+    }
+
+    fclose(f);
+
+    if (!ok) {
+        LOG_ERR("%s: malformed session state file, ignoring", path);
+        session_window_list_free(out);
+        /*
+         * Rename it aside instead of deleting - it might be useful
+         * for debugging, and this guarantees we do not loop trying
+         * (and failing) to restore it again next time.
+         */
+    } else {
+        LOG_INFO("loaded %zu window(s) from previous session", loaded);
+    }
+
+    size_t backup_len = strlen(path) + strlen(".restored") + 1;
+    char *backup_path = xmalloc(backup_len);
+    snprintf(backup_path, backup_len, "%s.restored", path);
+    rename(path, backup_path);
+    free(backup_path);
+
+    return ok;
+}
+
+void
+session_command_list_free(session_command_list_t *list)
+{
+    tll_foreach(*list, it) {
+        free(it->item.cwd);
+        session_argv_free(it->item.argc, it->item.argv);
+        tll_remove(*list, it);
+    }
+}
+
+void
+session_window_list_free(session_window_list_t *list)
+{
+    tll_foreach(*list, it) {
+        free(it->item.cwd);
+        free(it->item.snapshot);
+        session_argv_free(it->item.launch_argc, it->item.launch_argv);
+        session_command_list_free(&it->item.commands);
+        tll_remove(*list, it);
+    }
+}
