+struct snapshot {
+    char32_t *buf;
+    size_t len;
+    size_t cap;
+};
+
+static void
+snapshot_append(struct snapshot *s, char32_t c)
+{
+    if (s->len == s->cap) {
+        s->cap = max(s->cap * 2, 1024);
+        s->buf = xreallocarray(s->buf, s->cap, sizeof(s->buf[0]));
+    }
+    s->buf[s->len++] = c;
+}
+
+static void
+snapshot_append_ascii(struct snapshot *s, const char *str)
+{
+    for (; *str != '\0'; str++)
+        snapshot_append(s, (unsigned char)*str);
+}
+
+static bool
+snapshot_attrs_eq(const struct attributes *a, const struct attributes *b)
+{
+    return a->bold == b->bold && a->dim == b->dim && a->italic == b->italic &&
+        a->underline == b->underline && a->strikethrough == b->strikethrough &&
+        a->blink == b->blink && a->conceal == b->conceal &&
+        a->reverse == b->reverse &&
+        a->fg_src == b->fg_src && (a->fg_src == COLOR_DEFAULT || a->fg == b->fg) &&
+        a->bg_src == b->bg_src && (a->bg_src == COLOR_DEFAULT || a->bg == b->bg);
+}
+
+static size_t
+snapshot_sgr_color(char *buf, size_t size, enum color_source src,
+                   uint32_t color, bool bg)
+{
+    switch (src) {
+    case COLOR_DEFAULT:
+        return 0;
+    case COLOR_BASE16:
+        return xsnprintf(buf, size, ";%u",
+                         (color < 8 ? (bg ? 40 : 30) : (bg ? 100 : 90)) + color % 8);
+    case COLOR_BASE256:
+        return xsnprintf(buf, size, ";%u;5;%u", bg ? 48 : 38, color);
+    case COLOR_RGB:
+        return xsnprintf(buf, size, ";%u;2;%u;%u;%u", bg ? 48 : 38,
+                         (color >> 16) & 0xff, (color >> 8) & 0xff, color & 0xff);
+    }
+    return 0;
+}
+
+static void
+snapshot_sgr(struct snapshot *s, const struct attributes *a)
+{
+    char sgr[64];
+    size_t n = xsnprintf(sgr, sizeof(sgr), "\x1b[0%s%s%s%s%s%s%s%s",
+                         a->bold ? ";1" : "", a->dim ? ";2" : "",
+                         a->italic ? ";3" : "", a->underline ? ";4" : "",
+                         a->blink ? ";5" : "", a->reverse ? ";7" : "",
+                         a->conceal ? ";8" : "", a->strikethrough ? ";9" : "");
+    n += snapshot_sgr_color(sgr + n, sizeof(sgr) - n, a->fg_src, a->fg, false);
+    n += snapshot_sgr_color(sgr + n, sizeof(sgr) - n, a->bg_src, a->bg, true);
+    xsnprintf(sgr + n, sizeof(sgr) - n, "m");
+    snapshot_append_ascii(s, sgr);
+}
+
+char *
+term_snapshot_text(const struct terminal *term, int scrollback_lines)
+{
+    /* Full-screen programs redraw themselves when relaunched */
+    const struct grid *grid = &term->normal;
+
+    int start = -min(max(scrollback_lines, 0), grid->num_rows - term->rows);
+    while (start < 0 && grid->rows[grid_row_absolute(grid, start)] == NULL)
+        start++;
+
+    struct snapshot s = {0};
+    size_t keep = 0;
+    const struct attributes none = {0};
+
+    for (int r = start; r < term->rows; r++) {
+        const struct row *row = grid->rows[grid_row_absolute(grid, r)];
+
+        /* Soft-wrapped rows are emitted unbroken, to re-wrap on reflow */
+        const bool wrapped = row != NULL && !row->linebreak && r < term->rows - 1;
+
+        int end = row != NULL ? term->cols : 0;
+        while (!wrapped && end > 0 && row->cells[end - 1].wc == 0)
+            end--;
+
+        struct attributes cur = none;
+        for (int c = 0; c < end; c++) {
+            const struct cell *cell = &row->cells[c];
+            if (cell->wc >= CELL_SPACER)
+                continue;
+
+            if (!snapshot_attrs_eq(&cur, &cell->attrs)) {
+                snapshot_sgr(&s, &cell->attrs);
+                cur = cell->attrs;
+            }
+
+            if (cell->wc >= CELL_COMB_CHARS_LO && cell->wc <= CELL_COMB_CHARS_HI) {
+                const struct composed *comp = composed_lookup(
+                    term->composed, cell->wc - CELL_COMB_CHARS_LO);
+                for (size_t i = 0; comp != NULL && i < comp->count; i++)
+                    snapshot_append(&s, comp->chars[i]);
+            } else if (cell->wc == 0 || cell->wc == U'\t')
+                snapshot_append(&s, U' ');
+            else
+                snapshot_append(&s, cell->wc);
+        }
+
+        if (!snapshot_attrs_eq(&cur, &none))
+            snapshot_append_ascii(&s, "\x1b[0m");
+        if (!wrapped)
+            snapshot_append(&s, U'\n');
+        if (end > 0)
+            keep = s.len;
+    }
+
+    s.len = keep;
+    if (keep > 0 && s.buf[keep - 1] != U'\n')
+        snapshot_append(&s, U'\n');
+    snapshot_append(&s, U'\0');
+
+    char *text = ac32tombs(s.buf);
+
+    free(s.buf);
+    return text;
+}
+
 int
 term_destroy(struct terminal *term)
 {
