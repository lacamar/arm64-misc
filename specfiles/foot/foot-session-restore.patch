+static bool
+fdm_session_timer(struct fdm *fdm, int fd, int events, void *data)
+{
+    struct server *server = data;
+
+    uint64_t expirations;
+    ssize_t amount = read(fd, &expirations, sizeof(expirations));
+    if (amount < 0 && errno != EAGAIN)
+        LOG_ERRNO("failed to read session timer");
+
+    session_do_save(server);
+    return true;
+}
