+/* Blocks the UI for at most DUPLICATE_TIMEOUT_MS; the reaper only reaps from the main loop */
+static bool
+eval_sync(pid_t pid, const char *command, const char *cwd,
+          size_t argc, char *const *argv, size_t *out_argc, char ***out_argv)
+{
+    int fd;
+    pid_t child = eval_spawn(pid, command, cwd, argc, argv, &fd);
+    if (child < 0)
+        return false;
+
+    char *out = NULL;
+    size_t len = 0;
+    bool failed = false;
+    const uint64_t deadline = tabs_now_ms() + DUPLICATE_TIMEOUT_MS;
+
+    for (;;) {
+        const uint64_t now = tabs_now_ms();
+        struct pollfd p = {.fd = fd, .events = POLLIN};
+        if (now >= deadline || poll(&p, 1, deadline - now) == 0) {
+            failed = true;
+            break;
+        }
+        char buf[4096];
+        ssize_t n = read(fd, buf, sizeof(buf));
+        if (n < 0 && (errno == EINTR || errno == EAGAIN))
+            continue;
+        if (n <= 0)
+            break;
+        if (len + n > RULE_OUTPUT_MAX) {
+            failed = true;
+            break;
+        }
+        out = xrealloc(out, len + n);
+        memcpy(out + len, buf, n);
+        len += n;
+    }
+    close(fd);
+
+    if (failed)
+        kill(child, SIGKILL);
+    int status = 0;
+    while (waitpid(child, &status, 0) < 0 && errno == EINTR)
+        ;
+
+    bool ok = !failed && WIFEXITED(status) && WEXITSTATUS(status) == 0 &&
+        parse_words(out, len, out_argc, out_argv) && *out_argc > 0;
+    free(out);
+    return ok;
