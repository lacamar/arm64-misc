+static bool
+menu_has_input(const struct wl_window *win)
+{
+    return win->menu.kind == TAB_MENU_RENAME || win->menu.kind == TAB_MENU_SWITCHER;
+}
+
+static char32_t *
+tab_title32(const struct terminal *t)
+{
+    const char *s = t->tab_label != NULL ? t->tab_label
+        : t->window_title != NULL ? t->window_title : "foot";
+    char32_t *r = ambstoc32(s);
+    return r != NULL ? r : xc32dup(U"foot");
+}
+
+char32_t *
+tabs_menu_header(const struct wl_window *win)
+{
+    const struct terminal *t = win->menu.target;
+    char *h = NULL;
+    switch (win->menu.kind) {
+    case TAB_MENU_CONFIRM_KILL:
+        h = xasprintf("Kill “%s”?", t->window_title != NULL ? t->window_title : "foot");
+        break;
+    case TAB_MENU_CONFIRM_CLOSE:
+        h = xasprintf("Close pinned “%s”?",
+                      t->tab_label != NULL ? t->tab_label
+                      : t->window_title != NULL ? t->window_title : "foot");
+        break;
+    case TAB_MENU_RENAME:
+        h = xstrdup("Rename tab (empty: use the program's title)");
+        break;
+    case TAB_MENU_SWITCHER:
+        h = xstrdup("Go to tab");
+        break;
+    case TAB_MENU_SORT:
+        h = xstrdup("Sort tabs");
+        break;
+    default:
+        return NULL;
+    }
+    char32_t *r = ambstoc32(h);
+    free(h);
+    return r;
+}
+
+const char32_t *
+tabs_menu_input(const struct wl_window *win)
+{
+    return menu_has_input(win) ? win->menu.text : NULL;
+}
+
+char32_t *
+tabs_menu_line(const struct wl_window *win, int i)
+{
+    if (win->menu.kind != TAB_MENU_SWITCHER) {
+        char32_t *r = ambstoc32(menu_labels[win->menu.items[i]]);
+        return r != NULL ? r : xc32dup(U"");
+    }
+
+    const struct terminal *t = win->menu.found[i];
+    char32_t *title = tab_title32(t);
+    int wi = 1;
+    tll_foreach(t->wl->windows, it) {
+        if (it->item == t->window)
+            break;
+        wi++;
+    }
+    char tail[32];
+    snprintf(tail, sizeof(tail), "  — window %d", wi);
+    char32_t *tail32 = ambstoc32(tail);
+    const size_t a = c32len(title), b = tail32 != NULL ? c32len(tail32) : 0;
+    char32_t *r = xmalloc((a + b + 1) * sizeof(char32_t));
+    memcpy(r, title, a * sizeof(char32_t));
+    if (b > 0)
+        memcpy(&r[a], tail32, b * sizeof(char32_t));
+    r[a + b] = U'\0';
+    free(title);
+    free(tail32);
+    return r;
+}
+
+static bool
+fuzzy(const char32_t *hay, const char32_t *needle)
+{
+    for (; *needle != U'\0'; needle++) {
+        const char32_t c = toc32lower(*needle);
+        while (*hay != U'\0' && toc32lower(*hay) != c)
+            hay++;
+        if (*hay == U'\0')
+            return false;
+        hay++;
+    }
+    return true;
+}
+
+static void
+switcher_filter(struct wl_window *win)
+{
+    int n = 0;
+    tll_foreach(win->term->wl->windows, wit) {
+        tll_foreach(wit->item->tabs, it) {
+            if (n >= (int)ALEN(win->menu.found))
+                break;
+            char32_t *title = tab_title32(it->item);
+            if (fuzzy(title, win->menu.text))
+                win->menu.found[n++] = it->item;
+            free(title);
+        }
+    }
+    win->menu.n = n;
+    win->menu.sel = min(win->menu.sel, max(0, n - 1));
+}
+
+static void
+menu_open(struct wl_window *win, struct terminal *t, enum tab_menu_kind kind,
+          int x, int y)
+{
+    tabs_menu_close(win);
+    win->menu.kind = kind;
+    win->menu.target = t;
+    win->menu.x = x;
+    win->menu.y = y;
+
+    int *it = win->menu.items;
+    int n = 0;
+    switch (kind) {
+    case TAB_MENU_ACTIONS:
+        it[n++] = MI_CLOSE;
+        it[n++] = MI_KILL;
+        it[n++] = MI_DUPLICATE;
+        it[n++] = MI_RENAME;
+        it[n++] = t->tab_pinned ? MI_UNPIN : MI_PIN;
+        if (t->group != 0 && t->group == win->term->group) {
+            it[n++] = MI_POP;
+            it[n++] = MI_UNSPLIT;
+            it[n++] = t->group_broadcast ? MI_UNBROADCAST : MI_BROADCAST;
+        } else if (t != win->term)
+            it[n++] = MI_SPLIT;
+        break;
+    case TAB_MENU_SELECTION:
+        it[n++] = MI_SPLIT_SELECTED;
+        it[n++] = MI_CLOSE_SELECTED;
+        it[n++] = MI_CLEAR_SELECTION;
+        break;
+    case TAB_MENU_CONFIRM_KILL:
+        it[n++] = MI_NO;
+        it[n++] = MI_YES;
+        break;
+    case TAB_MENU_CONFIRM_CLOSE:
+        it[n++] = MI_NO;
+        it[n++] = MI_YES_CLOSE;
+        break;
+    case TAB_MENU_RENAME: {
+        const char *cur = t->tab_label != NULL ? t->tab_label : "";
+        char32_t *c = ambstoc32(cur);
+        if (c != NULL) {
+            win->menu.text_len = min(c32len(c), ALEN(win->menu.text) - 1);
+            memcpy(win->menu.text, c, win->menu.text_len * sizeof(char32_t));
+            free(c);
+        }
+        break;
+    }
+    case TAB_MENU_SWITCHER:
+        break;
+    case TAB_MENU_SORT:
+        it[n++] = MI_SORT_NAME;
+        it[n++] = MI_SORT_RECENT;
+        it[n++] = MI_SORT_PROGRAM;
+        it[n++] = MI_SORT_AGE;
+        it[n++] = MI_REOPEN;
+        break;
+    case TAB_MENU_NONE:
+        return;
+    }
+    win->menu.n = n;
+    if (kind == TAB_MENU_SWITCHER)
+        switcher_filter(win);
+
+    if (!wayl_win_subsurface_new(win, &win->menu_surf, true)) {
+        memset(&win->menu, 0, sizeof(win->menu));
+        return;
+    }
+    wl_subsurface_set_desync(win->menu_surf.sub);
+    render_tab_menu(win);
+}
+
+void
+tabs_menu_close(struct wl_window *win)
+{
+    if (win->menu.kind == TAB_MENU_NONE)
+        return;
+    memset(&win->menu, 0, sizeof(win->menu));
+    sub_drop(win, &win->menu_surf);
+    shm_purge(win->menu_chain);
+}
+
+/* Centered modals */
+static void
+menu_open_center(struct wl_window *win, struct terminal *t, enum tab_menu_kind kind)
+{
+    menu_open(win, t, kind, -1, -1);
+}
+
+void
+tabs_rename(struct terminal *t, const char *label)
+{
+    free(t->tab_label);
+    t->tab_label = label != NULL && label[0] != '\0' ? xstrdup(label) : NULL;
+    render_refresh_sidebar(t->window);
+}
+
+void
+tabs_pin(struct terminal *t, bool pin)
+{
+    struct wl_window *win = t->window;
+    t->tab_pinned = pin;
+    /* Pinned tabs lead the list */
+    int pinned = 0;
+    for (int r = 0, rows = tabs_row_count(win); r < rows; r++) {
+        const struct terminal *rt = tabs_row_term(win, r);
+        if (rt != t && rt->tab_pinned)
+            pinned++;
+    }
+    move_row(win, t, pinned - tabs_row_of(win, t));
+    render_refresh_sidebar(win);
+}
+
+void
+tabs_close_tab(struct terminal *t)
+{
+    if (t->tab_pinned && t->window != NULL) {
+        menu_open_center(t->window, t, TAB_MENU_CONFIRM_CLOSE);
+        return;
+    }
+    term_shutdown(t);
+}
+
+void
+tabs_toggle_broadcast(struct wl_window *win)
+{
+    struct terminal *act = win->term;
+    if (act->group == 0)
+        return;
+    const bool on = !act->group_broadcast;
+    tll_foreach(win->tabs, it)
+        if (it->item->group == act->group)
+            it->item->group_broadcast = on;
+    tabs_relayout(win);
+}
+
+void
+tabs_reopen(struct wl_window *win)
+{
+    struct wayland *wayl = win->term->wl;
+    if (wayl->tab_host.reopen_script == NULL || wayl->tab_host.new_tab == NULL)
+        return;
+    char *cwd = NULL;
+    char *script = wayl->tab_host.reopen_script(wayl->tab_host.data, &cwd);
+    if (script != NULL) {
+        char *argv[] = {"/bin/sh", "-c", script, "foot", NULL};
+        wayl->tab_host.new_tab(wayl->tab_host.data, win, false, cwd, 4, argv);
+    }
+    free(script);
+    free(cwd);
+}
+
+void
+tabs_open_switcher(struct wl_window *win)
+{
+    menu_open_center(win, win->term, TAB_MENU_SWITCHER);
+}
+
+void
+tabs_open_rename(struct wl_window *win, struct terminal *t)
+{
+    menu_open_center(win, t, TAB_MENU_RENAME);
+}
+
+struct switch_ctx {
+    struct wayland *wayl;
+    struct wl_window *win;
+};
+
+static void
+switch_token(const char *token, void *data)
+{
+    struct switch_ctx *ctx = data;
+    tll_foreach(ctx->wayl->windows, it) {
+        if (it->item == ctx->win) {
+            wayl_activate(ctx->wayl, ctx->win, token);
+            break;
+        }
+    }
+    free(ctx);
+}
+
+static void
+switch_to(struct seat *seat, struct wl_window *from, struct terminal *t)
+{
+    struct wl_window *to = t->window;
+    if (to == NULL || to->closing)
+        return;
+    tabs_activate(to, t);
+    if (to == from || seat == NULL)
+        return;
+    struct switch_ctx *ctx = xmalloc(sizeof(*ctx));
+    *ctx = (struct switch_ctx){.wayl = t->wl, .win = to};
+    if (!wayl_get_activation_token(t->wl, seat, seat->kbd.serial, from, &switch_token, ctx))
+        free(ctx);
+}
+
+static void
+menu_commit_text(struct seat *seat, struct wl_window *win)
+{
+    struct terminal *t = win->menu.target;
+    if (win->menu.kind == TAB_MENU_RENAME) {
+        win->menu.text[win->menu.text_len] = U'\0';
+        char *label = ac32tombs(win->menu.text);
+        tabs_menu_close(win);
+        tabs_rename(t, label);
+        free(label);
+    } else if (win->menu.kind == TAB_MENU_SWITCHER) {
+        struct terminal *pick = win->menu.n > 0 ? win->menu.found[win->menu.sel] : NULL;
+        tabs_menu_close(win);
+        if (pick != NULL)
+            switch_to(seat, win, pick);
+    }
+}
+
+static void
+menu_activate(struct seat *seat, struct wl_window *win, int i)
+{
+    if (i < 0 || i >= win->menu.n)
+        return;
+    if (win->menu.kind == TAB_MENU_SWITCHER) {
+        win->menu.sel = i;
+        menu_commit_text(seat, win);
+        return;
+    }
+    struct terminal *t = win->menu.target;
+    const int item = win->menu.items[i];
+    const int x = win->menu.x, y = win->menu.y;
+    tabs_menu_close(win);
+
+    switch (item) {
+    case MI_CLOSE:     tabs_close_tab(t); break;
+    case MI_KILL:      menu_open(win, t, TAB_MENU_CONFIRM_KILL, x, y); break;
+    case MI_YES:       tabs_kill(t); break;
+    case MI_YES_CLOSE: term_shutdown(t); break;
+    case MI_DUPLICATE: tabs_duplicate(t); break;
+    case MI_SPLIT:     tabs_split_with(t); break;
+    case MI_UNSPLIT:   tabs_unsplit(win); break;
+    case MI_POP:       pop_out(win, t); break;
+    case MI_NO:        break;
+    case MI_RENAME:    menu_open(win, t, TAB_MENU_RENAME, x, y); break;
+    case MI_PIN:       tabs_pin(t, true); break;
+    case MI_UNPIN:     tabs_pin(t, false); break;
+    case MI_BROADCAST:
+    case MI_UNBROADCAST: tabs_toggle_broadcast(win); break;
+    case MI_REOPEN:    tabs_reopen(win); break;
+    case MI_SORT_NAME:    tabs_sort(win, SORT_NAME); break;
+    case MI_SORT_RECENT:  tabs_sort(win, SORT_RECENT); break;
+    case MI_SORT_PROGRAM: tabs_sort(win, SORT_PROGRAM); break;
+    case MI_SORT_AGE:     tabs_sort(win, SORT_AGE); break;
+    case MI_SPLIT_SELECTED:  split_selected(win); break;
+    case MI_CLOSE_SELECTED:  close_selected(win); break;
+    case MI_CLEAR_SELECTION: clear_selection(win); break;
+    }
+}
+
+static void
+menu_select(struct wl_window *win, int sel)
+{
+    if (sel == win->menu.sel)
+        return;
+    win->menu.sel = sel;
+    render_tab_menu(win);
+}
+
+static int
+menu_item_at(const struct wl_window *win, int x, int y)
+{
+    const int ch = win->term->cell_height;
+    if (x < 0 || x >= win->menu.w || y < 0 || ch <= 0)
+        return -1;
+    const int i = y / ch - 1 - win->menu.header;
+    return i >= 0 && i < win->menu.n ? i : -1;
+}
+
+static bool
+menu_text_key(struct seat *seat, struct wl_window *win, xkb_keysym_t sym,
+              const char *utf8)
+{
+    size_t *len = &win->menu.text_len;
+    switch (sym) {
+    case XKB_KEY_Return:
+    case XKB_KEY_KP_Enter:
+        seat_stop_repeat(seat);
+        menu_commit_text(seat, win);
+        return true;
+    case XKB_KEY_Escape:
+        seat_stop_repeat(seat);
+        tabs_menu_close(win);
+        return true;
+    case XKB_KEY_BackSpace:
+        if (*len > 0)
+            (*len)--;
+        break;
+    case XKB_KEY_Up:
+    case XKB_KEY_ISO_Left_Tab:
+        if (win->menu.n > 0)
+            win->menu.sel = (win->menu.sel + win->menu.n - 1) % win->menu.n;
+        break;
+    case XKB_KEY_Down:
+    case XKB_KEY_Tab:
+        if (win->menu.n > 0)
+            win->menu.sel = (win->menu.sel + 1) % win->menu.n;
+        break;
+    default:
+        if ((sym == XKB_KEY_u || sym == XKB_KEY_U) && seat->kbd.ctrl) {
+            *len = 0;
+            break;
+        }
+        if (utf8 != NULL && (unsigned char)utf8[0] >= 0x20) {
+            char32_t *w = ambstoc32(utf8);
+            for (size_t i = 0; w != NULL && w[i] != U'\0'; i++)
+                if (*len < ALEN(win->menu.text) - 1 && w[i] >= 0x20)
+                    win->menu.text[(*len)++] = w[i];
+            free(w);
+        }
+        break;
+    }
+    win->menu.text[*len] = U'\0';
+    if (win->menu.kind == TAB_MENU_SWITCHER)
+        switcher_filter(win);
+    render_tab_menu(win);
+    return true;
+}
+
+bool
+tabs_menu_key(struct seat *seat, struct wl_window *win, xkb_keysym_t sym,
+              const char *utf8)
+{
+    if (win->menu.kind == TAB_MENU_NONE)
+        return false;
+    if (menu_has_input(win))
+        return menu_text_key(seat, win, sym, utf8);
+
+    const int n = win->menu.n;
+    const bool confirm = win->menu.kind == TAB_MENU_CONFIRM_KILL ||
+        win->menu.kind == TAB_MENU_CONFIRM_CLOSE;
+
+    switch (sym) {
+    case XKB_KEY_Up:
+    case XKB_KEY_k:
+    case XKB_KEY_ISO_Left_Tab:
+        menu_select(win, (win->menu.sel + n - 1) % n);
+        break;
+    case XKB_KEY_Down:
+    case XKB_KEY_j:
+    case XKB_KEY_Tab:
+        menu_select(win, (win->menu.sel + 1) % n);
+        break;
+    case XKB_KEY_Return:
+    case XKB_KEY_KP_Enter:
+    case XKB_KEY_space:
+        seat_stop_repeat(seat);
+        menu_activate(seat, win, win->menu.sel);
+        break;
+    case XKB_KEY_y:
+    case XKB_KEY_Y:
+        if (confirm) {
+            seat_stop_repeat(seat);
+            menu_activate(seat, win, 1);
+        }
+        break;
+    case XKB_KEY_Escape:
+    case XKB_KEY_q:
+    case XKB_KEY_n:
+    case XKB_KEY_N:
+        seat_stop_repeat(seat);
+        tabs_menu_close(win);
+        break;
+    }
+    return true;
+}
+
+void
+tabs_menu_motion(struct seat *seat, struct wl_window *win)
+{
+    const int i = menu_item_at(win, seat->mouse.x, seat->mouse.y);
+    if (i >= 0)
+        menu_select(win, i);
+}
+
+void
+tabs_menu_button(struct seat *seat, struct wl_window *win, int button, bool pressed)
+{
+    if (!pressed || button != BTN_LEFT)
+        return;
+    menu_activate(seat, win, menu_item_at(win, seat->mouse.x, seat->mouse.y));
+}
