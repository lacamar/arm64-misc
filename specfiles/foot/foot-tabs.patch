+              bool mouse)
+{
+    if (seat->kbd_focus == old) {
+        seat->kbd_focus = new;
+        stop_repeater(seat, -1);
+    }
+
+    if (seat->ime_focus == old) {
+        ime_disable(seat);
+        seat->ime_focus = new;
+        ime_enable(seat);
+    }
+
+    if (!mouse || seat->mouse_focus == NULL)
+        return;
+
+    struct terminal *m = seat->mouse_focus;
+    enum term_surface s = m->active_surface;
+    m->active_surface = TERM_SURF_NONE;
+
+    if (s == TERM_SURF_GRID) {
+        selection_finalize(seat, m, seat->pointer.serial);
+        /* pane/sidebar presses activate from inside the press handler */
+        if (m->group == 0)
+            mouse_button_state_reset(seat);
+    }
+
+    seat->mouse_focus = new;
+    new->active_surface = s;
+    term_xcursor_update_for_seat(new, seat);
+}
