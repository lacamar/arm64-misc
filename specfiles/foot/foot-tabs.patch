+    for (size_t i = 0; i < n; i++)
+        tll_push_back(win->tabs, arr[i]);
+    free(arr);
+}
+
+static ssize_t
+arr_index(struct terminal **arr, size_t n, const struct terminal *t)
+{
+    for (size_t i = 0; i < n; i++)
+        if (arr[i] == t)
+            return i;
+    return -1;
+}
+
+static void
+row_extent(struct terminal **arr, size_t n, size_t i, size_t *s, size_t *e)
+{
+    *s = *e = i;
+    uint32_t g = arr[i]->group;
+    if (g != 0) {
+        while (*s > 0 && arr[*s - 1]->group == g)
+            (*s)--;
+        while (*e + 1 < n && arr[*e + 1]->group == g)
+            (*e)++;
+    }
+    (*e)++;
+}
+
+static bool
+row_start(const struct terminal *prev, const struct terminal *t)
+{
+    return t->group == 0 || prev == NULL || prev->group != t->group;
+}
+
+int
+tabs_row_count(const struct wl_window *win)
+{
+    int n = 0;
+    const struct terminal *prev = NULL;
+    tll_foreach(win->tabs, it) {
+        if (row_start(prev, it->item))
+            n++;
+        prev = it->item;
+    }
+    return n;
+}
+
+struct terminal *
+tabs_row_term(const struct wl_window *win, int row)
+{
+    int n = -1;
+    const struct terminal *prev = NULL;
+    tll_foreach(win->tabs, it) {
+        if (row_start(prev, it->item) && ++n == row)
+            return it->item;
+        prev = it->item;
+    }
+    return NULL;
+}
+
+int
+tabs_row_of(const struct wl_window *win, const struct terminal *t)
+{
+    int n = -1;
+    const struct terminal *prev = NULL;
+    tll_foreach(win->tabs, it) {
+        if (row_start(prev, it->item))
+            n++;
+        if (it->item == t)
+            return n;
+        prev = it->item;
+    }
+    return -1;
+}
+
+/* The sidebar lists every tab on its own line, split panes included */
+
+int
+tabs_line_count(const struct wl_window *win)
+{
+    return tll_length(win->tabs);
+}
+
+struct terminal *
+tabs_line_term(const struct wl_window *win, int line)
+{
+    int i = 0;
+    tll_foreach(win->tabs, it)
+        if (i++ == line)
+            return it->item;
+    return NULL;
+}
+
+int
+tabs_line_of(const struct wl_window *win, const struct terminal *t)
+{
+    int i = 0;
+    tll_foreach(win->tabs, it) {
+        if (it->item == t)
+            return i;
+        i++;
+    }
+    return -1;
+}
+
+/* Row index that a sidebar line insertion point falls in front of */
+static int
+row_at_line(const struct wl_window *win, int line)
+{
+    int row = 0, i = 0;
+    const struct terminal *prev = NULL;
+    tll_foreach(win->tabs, it) {
+        if (i++ >= line)
+            break;
+        if (row_start(prev, it->item))
+            row++;
+        prev = it->item;
+    }
+    return row;
+}
+
+static size_t
+visible_set(const struct terminal *t, struct terminal **out)
+{
+    if (t->group == 0) {
+        out[0] = (struct terminal *)t;
+        return 1;
+    }
+    size_t n = 0;
+    tll_foreach(t->window->tabs, it)
+        if (it->item->group == t->group && n < MAX_SET)
+            out[n++] = it->item;
+    return n;
+}
+
+size_t
+tabs_group_len(const struct terminal *t)
+{
+    struct terminal *set[MAX_SET];
+    return visible_set(t, set);
+}
+
+static bool
+in_set(const struct terminal *t, struct terminal **set, size_t n)
+{
+    for (size_t i = 0; i < n; i++)
+        if (set[i] == t)
+            return true;
+    return false;
+}
+
+void
+tabs_adopt_fonts(struct terminal *term, const struct terminal *from)
+{
+    for (size_t i = 0; i < 4; i++) {
+        size_t n = min(term->conf->fonts[i].count, from->conf->fonts[i].count);
+        memcpy(term->font_sizes[i], from->font_sizes[i],
+               n * sizeof(term->font_sizes[i][0]));
+    }
+}
+
+static void
+unmap_sub(struct wayl_sub_surface *s)
+{
+    if (s->surface.surf == NULL)
+        return;
+    wl_surface_attach(s->surface.surf, NULL, 0, 0);
+    wl_surface_commit(s->surface.surf);
+}
+
+static void
+drop_buffers(struct terminal *t)
+{
+    render_wait_for_preapply_damage(t);
+    shm_unref(t->render.last_buf);
+    t->render.last_buf = NULL;
+    shm_purge(t->render.chains.grid);
+}
+
+static void
+full_repaint(struct terminal *t)
+{
+    if (t->rows == 0)
+        return;
+    render_wait_for_preapply_damage(t);
+    shm_unref(t->render.last_buf);
+    t->render.last_buf = NULL;
+    term_damage_view(t);
+    render_refresh(t);
+}
+
+static void
+clear_touch(struct wayland *wayl, struct wl_surface *surf)
+{
+    tll_foreach(wayl->seats, it) {
+        struct seat *s = &it->item;
+        if (s->touch.surface != surf)
+            continue;
+        s->touch.surface = NULL;
+        if (s->touch.state > TOUCH_STATE_IDLE)
+            s->touch.state = TOUCH_STATE_IDLE;
+    }
+}
+
+void
+pane_destroy(struct terminal *t)
+{
+    if (t->pane_cb != NULL) {
+        wl_callback_destroy(t->pane_cb);
+        t->pane_cb = NULL;
+    }
+    if (t->pane.surface.surf == NULL)
+        return;
+    clear_touch(t->wl, t->pane.surface.surf);
+    wayl_win_subsurface_destroy(&t->pane);
+    memset(&t->pane, 0, sizeof(t->pane));
+    shm_unref(t->render.last_buf);
+    t->render.last_buf = NULL;
+}
+
+static void
+hide_overlays(struct wl_window *win, struct terminal *old)
+{
+    search_cancel(old);
+    urls_reset(old);
+    unmap_sub(&win->scrollback_indicator);
+    unmap_sub(&win->render_timer);
+    unmap_sub(&win->overlay);
+    old->flash.active = false;
+}
+
+static void
+focus_handover(struct wl_window *win, struct terminal *old, struct terminal *new,
+               struct terminal **oldv, size_t on)
+{
+    bool focused = false;
+    tll_foreach(old->wl->seats, it) {
+        struct seat *s = &it->item;
+        if (s->kbd_focus == old)
+            focused = true;
+        bool m = s->mouse_focus != NULL && in_set(s->mouse_focus, oldv, on);
+        seat_retarget(s, old, new, m);
+    }
+
+    if (focused) {
+        if (!old->shutdown.in_progress)
+            term_kbd_focus_out(old);
+        term_kbd_focus_in(new);
+    }
+    if (!old->shutdown.in_progress)
+        term_visual_focus_out(old);
+    if (win->configure.is_activated)
+        term_visual_focus_in(new);
+    if (new->visibility_reports)
+        term_send_visibility_report(new);
+}
+
+static void
+window_chrome(struct wl_window *win)
+{
+    struct terminal *t = win->term;
+    render_refresh_title(t);
+    render_refresh_app_id(t);
+    render_refresh_csd(t);
+    render_refresh_sidebar(win);
+    wayl_win_alpha_changed(win);
+}
+
+void
+tabs_focus_pane(struct wl_window *win, struct terminal *t)
+{
+    struct terminal *old = win->term;
+    if (old == t)
+        return;
+
+    hide_overlays(win, old);
+    win->term = t;
+    t->tab_last_active = tabs_now_ms();
+
+    focus_handover(win, old, t, NULL, 0);
+    render_refresh(old);
+    render_refresh(t);
+    window_chrome(win);
+}
+
+void
+tabs_activate(struct wl_window *win, struct terminal *new)
+{
+    struct terminal *old = win->term;
+    if (old == new)
+        return;
+    if (new->group != 0 && new->group == old->group) {
+        tabs_focus_pane(win, new);
+        return;
+    }
+
+    int w, h;
+    tabs_win_size(win, &w, &h);
+
+    struct terminal *oldv[MAX_SET];
+    size_t on = visible_set(old, oldv);
+
+    hide_overlays(win, old);
+    uint64_t now = tabs_now_ms();
+    for (size_t i = 0; i < on; i++) {
+        struct terminal *t = oldv[i];
+        pane_destroy(t);
+        drop_buffers(t);
+        t->activity_mute_until = now + 500;
+        if (t->blink.fd >= 0) {
+            fdm_del(t->fdm, t->blink.fd);
+            t->blink.fd = -1;
+        }
+        t->blink.state = BLINK_ON;
+    }
+
+    win->term = new;
+    new->tab_last_active = tabs_now_ms();
+
+    struct terminal *newv[MAX_SET];
+    size_t nn = visible_set(new, newv);
+    for (size_t i = 0; i < nn; i++) {
+        struct terminal *t = newv[i];
+        t->tab_marker = t->tab_activity = t->tab_done = false;
+        t->activity_lines = 0;
+        if (t->scale != old->scale) {
+            float o = t->scale;
+            if (term_update_scale(t))
+                term_font_dpi_changed(t, o);
+        }
+    }
+
+    if (nn > 1 || on > 1 || new->width != old->width ||
+        new->height != old->height)
+    {
+        tabs_layout(win, w, h);
+    }
+
+    focus_handover(win, old, new, oldv, on);
+
+    for (size_t i = 0; i < nn; i++)
+        full_repaint(newv[i]);
+
+    window_chrome(win);
+}
+
+void
+tabs_attach(struct wl_window *win, struct terminal *term,
+            struct terminal *after, bool split)
+{
+    if (term->tab_created == 0)
+        term->tab_created = term->tab_last_active = tabs_now_ms();
+    struct terminal **arr;
+    size_t n = to_arr(win, &arr);
+    arr = xrealloc(arr, (n + 1) * sizeof(arr[0]));
+
+    size_t pos = n;
+    ssize_t ai = after != NULL ? arr_index(arr, n, after) : -1;
+    if (ai >= 0) {
+        if (split) {
+            if (after->group == 0)
+                after->group = ++term->wl->group_counter;
+            term->group = after->group;
+            term->group_vertical = after->group_vertical;
+            pos = ai + 1;
+        } else {
+            size_t s, e;
+            row_extent(arr, n, ai, &s, &e);
+            pos = e;
+        }
+    }
+
+    memmove(&arr[pos + 1], &arr[pos], (n - pos) * sizeof(arr[0]));
+    arr[pos] = term;
+    from_arr(win, arr, n + 1);
+    render_refresh_sidebar(win);
+}
+
+static struct terminal *
+neighbour(struct wl_window *win, struct terminal *term, bool skip_shutdown)
+{
+    struct terminal **arr;
+    size_t n = to_arr(win, &arr);
+    ssize_t i = arr_index(arr, n, term);
+    struct terminal *res = NULL;
+
+#define OK(t) ((t) != term && (!skip_shutdown || !(t)->shutdown.in_progress))
+
+    if (term->group != 0) {
+        for (ssize_t j = i + 1; j < (ssize_t)n && arr[j]->group == term->group && !res; j++)
+            if (OK(arr[j])) res = arr[j];
+        for (ssize_t j = i - 1; j >= 0 && arr[j]->group == term->group && !res; j--)
+            if (OK(arr[j])) res = arr[j];
+    }
+    if (res == NULL) {
+        size_t s, e;
+        row_extent(arr, n, i, &s, &e);
+        for (size_t j = e; j < n && !res; j++)
+            if (OK(arr[j])) res = arr[j];
+        for (ssize_t j = (ssize_t)s - 1; j >= 0 && !res; j--)
+            if (OK(arr[j])) res = arr[j];
+    }
+#undef OK
+    free(arr);
+    return res;
+}
+
+void
+tabs_detach(struct terminal *term)
+{
+    struct wl_window *win = term->window;
+
+    search_cancel(term);
+    urls_reset(term);
+    if (win->menu.target == term)
+        tabs_menu_close(win);
+
+    if (!win->closing && win->term == term) {
+        struct terminal *nb = neighbour(win, term, true);
+        if (nb == NULL)
+            nb = neighbour(win, term, false);
+        if (nb != NULL)
+            tabs_activate(win, nb);
+    }
+
+    tll_foreach(win->tabs, it) {
+        if (it->item == term) {
+            tll_remove(win->tabs, it);
+            break;
+        }
+    }
+
+    pane_destroy(term);
+    if (win->sidebar_drag.tab == term)
+        memset(&win->sidebar_drag, 0, sizeof(win->sidebar_drag));
+
+    if (win->term == term && tll_length(win->tabs) > 0)
+        win->term = tll_front(win->tabs);
+
+    render_wait_for_preapply_damage(term);
+    shm_unref(term->render.last_buf);
+    term->render.last_buf = NULL;
+    shm_purge(term->render.chains.grid);
+    shm_purge(term->render.chains.search);
+    shm_purge(term->render.chains.scrollback_indicator);
+    shm_purge(term->render.chains.render_timer);
+    shm_purge(term->render.chains.url);
+    shm_purge(term->render.chains.csd);
+    shm_purge(term->render.chains.overlay);
+
+    tll_foreach(term->wl->seats, it) {
+        struct seat *s = &it->item;
+        if (s->kbd_focus == term)
+            s->kbd_focus = NULL;
+        if (s->mouse_focus == term)
+            s->mouse_focus = NULL;
+        if (s->ime_focus == term)
+            s->ime_focus = NULL;
+    }
+}
+
+static void
+dissolve_singletons(struct wl_window *win)
+{
+    tll_foreach(win->tabs, it) {
+        struct terminal *t = it->item;
+        if (t->group != 0 && tabs_group_len(t) < 2)
+            t->group = 0;
+        if (t->group == 0)
+            t->group_vertical = false;
+    }
+}
+
+static void
+sub_drop(struct wl_window *win, struct wayl_sub_surface *sub)
+{
+    if (sub->surface.surf == NULL)
+        return;
+    clear_touch(win->term->wl, sub->surface.surf);
+    wayl_win_subsurface_destroy(sub);
+    memset(sub, 0, sizeof(*sub));
+}
+
+static void
+sidebar_update(struct wl_window *win)
+{
+    const bool show = tabs_sidebar_visible(win);
+    const bool btn = tabs_sidebar_has_tabs(win) && win->sidebar_hidden;
+
+    if (show) {
+        if (win->sidebar.surface.surf == NULL)
+            wayl_win_subsurface_new(win, &win->sidebar, true);
+    } else if (win->sidebar.surface.surf != NULL) {
+        sub_drop(win, &win->sidebar);
+        memset(&win->sidebar_drag, 0, sizeof(win->sidebar_drag));
+        memset(&win->sidebar_resize, 0, sizeof(win->sidebar_resize));
+    }
+
+    if (btn) {
+        if (win->sidebar_btn.surface.surf == NULL)
+            wayl_win_subsurface_new(win, &win->sidebar_btn, true);
+    } else {
+        /* Destroyed under the pointer: no leave event will reset this */
+        win->hover.btn = false;
+        sub_drop(win, &win->sidebar_btn);
+    }
+
+    if (!show && !btn)
+        shm_purge(win->sidebar_chain);
+}
+
+int
+tabs_sidebar_btn_px(const struct wl_window *win)
+{
+    const float scale = win->term->scale;
+    return (int)(ceilf(tabs_sidebar_row_h(win) / scale) * scale);
+}
+
+/* Collapsed to a sliver at the window edge so it doesn't cover the terminal */
+int
+tabs_sidebar_btn_w(const struct wl_window *win)
+{
+    const float scale = win->term->scale;
+    return win->hover.btn ? tabs_sidebar_btn_px(win) : (int)(ceilf(3) * scale);
+}
+
+/* Animations only touch the sidebar's own surfaces, never the terminals */
+
+#define ANIM_MS 140
+
+static float
+anim_progress(const struct wl_window *win)
+{
+    float t = (float)(tabs_now_ms() - win->anim.start) / ANIM_MS;
+    t = t < 0 ? 0 : t > 1 ? 1 : t;
+    return 1 - (1 - t) * (1 - t) * (1 - t);
+}
+
+static void sidebar_place(struct wl_window *win);
+
+static bool
+fdm_anim(struct fdm *fdm, int fd, int events, void *data)
+{
+    struct wl_window *win = data;
+    uint64_t expirations;
+    (void)!read(fd, &expirations, sizeof(expirations));
+
+    if (tabs_now_ms() - win->anim.start >= ANIM_MS) {
+        win->anim.highlight = win->anim.slide = false;
+        fdm_del(fdm, fd);
+        win->anim.fd = -1;
+    }
+    sidebar_place(win);
+    render_sidebar(win);
+    wl_surface_commit(win->surface.surf);
+    return true;
+}
+
+static void
+anim_start(struct wl_window *win)
+{
+    win->anim.start = tabs_now_ms();
+    if (win->anim.fd >= 0)
+        return;
+    int fd = timerfd_create(CLOCK_MONOTONIC, TFD_CLOEXEC | TFD_NONBLOCK);
+    if (fd < 0)
+        return;
+    const struct itimerspec its = {
+        .it_interval = {.tv_nsec = 16 * 1000000},
+        .it_value = {.tv_nsec = 16 * 1000000},
+    };
+    if (timerfd_settime(fd, 0, &its, NULL) < 0 ||
+        !fdm_add(win->term->fdm, fd, EPOLLIN, &fdm_anim, win))
+    {
+        close(fd);
+        return;
+    }
+    win->anim.fd = fd;
+}
+
+/* Where to draw the current-tab highlight, gliding after a change */
+float
+tabs_anim_line(struct wl_window *win, int line)
+{
+    if (win->term->conf->tabs.animations && win->anim.last_line >= 0 &&
+        line != win->anim.last_line)
+    {
+        const float cur = win->anim.highlight
+            ? win->anim.from_line + (win->anim.to_line - win->anim.from_line) * anim_progress(win)
+            : win->anim.last_line;
+        win->anim.from_line = cur;
+        win->anim.to_line = line;
+        win->anim.highlight = true;
+        anim_start(win);
+    }
+    win->anim.last_line = line;
+    if (!win->anim.highlight)
+        return line;
+    return win->anim.from_line + (win->anim.to_line - win->anim.from_line) * anim_progress(win);
+}
+
+static void
+sidebar_place(struct wl_window *win)
+{
+    const float scale = win->term->scale;
+    const bool right = win->term->conf->tabs.right;
+    int w, h;
+    tabs_win_size(win, &w, &h);
+
+    if (win->sidebar.surface.surf != NULL) {
+        const int sb = (int)roundf(tabs_sidebar_width_px(win) / scale);
+        const int off = win->anim.slide ? (int)roundf(sb * (1 - anim_progress(win))) : 0;
+        wl_subsurface_set_position(win->sidebar.sub, right ? w - sb + off : -off, 0);
+    }
+    if (win->sidebar_btn.surface.surf != NULL) {
+        const int b = (int)roundf(tabs_sidebar_btn_px(win) / scale);
+        const int bw = (int)roundf(tabs_sidebar_btn_w(win) / scale);
+        wl_subsurface_set_position(win->sidebar_btn.sub, right ? w - bw : 0, h - b);
+    }
+}
+
+int
+tabs_sidebar_row_h(const struct wl_window *win)
+{
+    return win->term->fonts[0]->height + 2 * (int)roundf(4 * win->term->scale);
+}
+
+int
+tabs_sidebar_height_px(const struct wl_window *win)
+{
+    const struct terminal *t = win->term;
+    if (t->pane.surface.surf != NULL || t->group != 0)
+        return (int)roundf(win->layout_h * t->scale);
+    return t->height;
+}
+
+void
+tabs_sidebar_scroll_fix(struct wl_window *win)
+{
+    const int row_h = tabs_sidebar_row_h(win);
+    const int list_h = tabs_sidebar_height_px(win) - row_h - 1;
+    const int vis = max(1, list_h / row_h);
+    const int rows = tabs_line_count(win);
+
+    /* Follow the current tab only when it changes, so manual scrolling sticks */
+    if (win->sidebar_follow != win->term) {
+        win->sidebar_follow = win->term;
+        const int r = tabs_line_of(win, win->term);
+        if (r < win->sidebar_scroll)
+            win->sidebar_scroll = r;
+        if (r >= win->sidebar_scroll + vis)
+            win->sidebar_scroll = r - vis + 1;
+    }
+    win->sidebar_scroll = max(0, min(win->sidebar_scroll, rows - vis));
+}
+
+/* Logical rect of pane i of n in a W x H window */
+void
+tabs_pane_rect(const struct wl_window *win, int W, int H, size_t n, size_t i,
+               bool vertical, int *x, int *y, int *w, int *h)
+{
+    const float scale = win->term->scale;
+    const int sb = (int)roundf(tabs_sidebar_width_px(win) / scale);
+    const int left = (int)roundf(tabs_sidebar_left_px(win) / scale);
+    const int aw = W - sb;
+    if (vertical) {
+        const int ph = (H - ((int)n - 1) * PANE_GAP) / (int)n;
+        *x = left;
+        *y = (int)i * (ph + PANE_GAP);
+        *w = aw;
+        *h = ph;
+    } else {
+        const int pw = (aw - ((int)n - 1) * PANE_GAP) / (int)n;
+        *x = left + (int)i * (pw + PANE_GAP);
+        *y = 0;
+        *w = pw;
+        *h = H;
+    }
+}
+
+/* Logical rects of the panes in set, sized by their weights */
+static void
+set_rects(const struct wl_window *win, int W, int H, struct terminal **set, size_t n,
+          bool vertical, int *xs, int *ys, int *ws, int *hs)
+{
+    const float scale = win->term->scale;
+    const int sb = (int)roundf(tabs_sidebar_width_px(win) / scale);
+    const int left = (int)roundf(tabs_sidebar_left_px(win) / scale);
+    const int aw = W - sb;
+    const int avail = (vertical ? H : aw) - ((int)n - 1) * PANE_GAP;
+
+    float total = 0;
+    for (size_t i = 0; i < n; i++)
+        total += set[i]->pane_weight > 0 ? set[i]->pane_weight : 1;
+
+    int pos = 0, used = 0;
+    for (size_t i = 0; i < n; i++) {
+        const float wi = set[i]->pane_weight > 0 ? set[i]->pane_weight : 1;
+        const int size = i == n - 1 ? avail - used : (int)(avail * wi / total);
+        xs[i] = vertical ? left : left + pos;
+        ys[i] = vertical ? pos : 0;
+        ws[i] = vertical ? aw : size;
+        hs[i] = vertical ? size : H;
+        pos += size + PANE_GAP;
+        used += size;
+    }
+}
+
+static bool
+pane_pos(const struct terminal *t, int *x, int *y)
+{
+    *x = *y = 0;
+    const struct wl_window *win = t->window;
+    if (win == NULL || t->pane.surface.surf == NULL)
+        return false;
+    struct terminal *set[MAX_SET];
+    const size_t n = visible_set(t, set);
+    int xs[MAX_SET], ys[MAX_SET], ws[MAX_SET], hs[MAX_SET];
+    set_rects(win, win->layout_w, win->layout_h, set, n, t->group_vertical, xs, ys, ws, hs);
+    for (size_t i = 0; i < n; i++) {
+        if (set[i] == t) {
+            *x = xs[i];
+            *y = ys[i];
+            return true;
+        }
+    }
+    return false;
+}
+
+int
+tabs_pane_x(const struct terminal *t)
+{
+    int x, y;
+    pane_pos(t, &x, &y);
+    return x;
+}
+
+int
+tabs_pane_y(const struct terminal *t)
+{
+    int x, y;
+    pane_pos(t, &x, &y);
+    return y;
+}
+
+void
+tabs_sidebar_sync(struct wl_window *win)
+{
+    if (win->closing || tll_length(win->tabs) == 0)
+        return;
+    sidebar_update(win);
+    sidebar_place(win);
+    render_refresh_sidebar(win);
+}
+
+bool
+tabs_layout(struct wl_window *win, int w, int h)
+{
+    if (win->closing || tll_length(win->tabs) == 0)
+        return false;
+
+    dissolve_singletons(win);
+    sidebar_update(win);
+
+    struct terminal *act = win->term;
+    struct terminal *vis[MAX_SET];
+    size_t nv = visible_set(act, vis);
+    bool resized = false;
+
+    tll_foreach(win->tabs, it) {
+        if (it->item->pane.surface.surf != NULL && (nv <= 1 || !in_set(it->item, vis, nv)))
+            pane_destroy(it->item);
+    }
+
+    if (nv <= 1) {
+        resized = render_resize(act, w, h, win->is_resizing ? 0 : RESIZE_FORCE);
+        w = (int)roundf(act->width / act->scale);
+        h = (int)roundf(act->height / act->scale);
+    } else if (w == 0 || h == 0) {
+        w = win->layout_w;
+        h = win->layout_h;
+        if (w == 0 || h == 0) {
+            /* Compositor lets us pick: use the default window size */
+            render_resize(act, 0, 0, RESIZE_FORCE);
+            w = (int)roundf(act->width / act->scale);
+            h = (int)roundf(act->height / act->scale);
+        }
+    }
+    win->layout_w = w;
+    win->layout_h = h;
+
+    /* While the user drags the window edge, only the visible panes follow;
+       the rest catch up when the resize ends */
+    const bool live = win->is_resizing;
+    const uint8_t force = live ? 0 : RESIZE_FORCE;
+
+    struct terminal *set[MAX_SET];
+    tll_foreach(win->tabs, it) {
+        struct terminal *t = it->item;
+        if (t == act && nv <= 1)
+            continue;
+        if (live && !tabs_is_visible(t))
+            continue;
+        const size_t n = visible_set(t, set);
+        if (n <= 1) {
+            resized |= render_resize(t, w, h, force);
+            continue;
+        }
+        size_t i = 0;
+        while (i < n && set[i] != t)
+            i++;
+        int xs[MAX_SET], ys[MAX_SET], ws[MAX_SET], hs[MAX_SET];
+        set_rects(win, w, h, set, n, t->group_vertical, xs, ys, ws, hs);
+        resized |= render_resize(t, ws[i], hs[i], force | RESIZE_PANE);
+    }
+
+    if (nv > 1)
+        render_split_layout(win);
+
+    sidebar_place(win);
+    render_refresh_sidebar(win);
+    return resized;
+}
+
+void
+tabs_win_size(const struct wl_window *win, int *w, int *h)
+{
+    const struct terminal *t = win->term;
+    if (t->group != 0 && t->pane.surface.surf != NULL) {
+        *w = win->layout_w;
+        *h = win->layout_h;
+    } else {
+        *w = (int)roundf(t->width / t->scale);
+        *h = (int)roundf(t->height / t->scale);
+    }
+}
+
+void
+tabs_relayout(struct wl_window *win)
+{
+    if (win->closing || tll_length(win->tabs) == 0)
+        return;
+    int w, h;
+    tabs_win_size(win, &w, &h);
+    if (w > 0 && h > 0)
+        tabs_layout(win, w, h);
+}
+
+void
+tabs_close_window(struct wl_window *win)
+{
+    if (win->closing)
+        return;
+    win->closing = true;
+    struct wayland *wayl = win->term->wl;
+    if (wayl->tab_host.window_closing != NULL)
+        wayl->tab_host.window_closing(wayl->tab_host.data, win);
+
+    struct terminal **arr;
+    size_t n = to_arr(win, &arr);
+    for (size_t i = 0; i < n; i++)
+        term_shutdown(arr[i]);
+    free(arr);
+}
+
+/* Moving tabs between windows */
+
+void
+tabs_transfer(struct terminal *t, struct wl_window *dst, bool keep_focus)
+{
+    uint64_t kbd = 0, mouse = 0;
+    size_t i = 0;
+    tll_foreach(t->wl->seats, it) {
+        if (keep_focus && i < 64) {
+            kbd |= (uint64_t)(it->item.kbd_focus == t) << i;
+            mouse |= (uint64_t)(it->item.mouse_focus == t) << i;
+        }
+        i++;
+    }
+
+    selection_cancel(t);
+    if (!keep_focus) {
+        term_kbd_focus_out(t);
+        term_visual_focus_out(t);
+    }
+
+    tabs_detach(t);
+
+    i = 0;
+    tll_foreach(t->wl->seats, it) {
+        if (i < 64 && (kbd >> i & 1))
+            it->item.kbd_focus = t;
+        if (i < 64 && (mouse >> i & 1))
+            it->item.mouse_focus = t;
+        i++;
+    }
+
+    t->window = dst;
+
+    if (dst->term != t) {
+        tabs_adopt_fonts(t, dst->term);
+        float old = t->scale;
+        term_update_scale(t);
+        if (!term_font_dpi_changed(t, old))
+            reload_fonts(t, false);
+    }
+
+    drop_buffers(t);
+    tll_push_back(dst->tabs, t);
+    if (t->wl->tab_host.tab_moved != NULL)
+        t->wl->tab_host.tab_moved(t->wl->tab_host.data, t, dst);
+}
+
+static struct terminal *
+outside_neighbour(struct wl_window *win, struct terminal **set, size_t n)
+{
+    struct terminal **arr;
+    size_t len = to_arr(win, &arr);
+    ssize_t s = arr_index(arr, len, set[0]);
+    ssize_t e = arr_index(arr, len, set[n - 1]) + 1;
+    struct terminal *res = NULL;
+
+    for (size_t j = e; j < len && !res; j++)
+        if (!in_set(arr[j], set, n)) res = arr[j];
+    for (ssize_t j = s - 1; j >= 0 && !res; j--)
+        if (!in_set(arr[j], set, n)) res = arr[j];
+    free(arr);
+    return res;
+}
+
+bool
+tabs_detach_window(struct terminal *t, bool whole_group)
+{
+    struct wl_window *src = t->window;
+    struct terminal *set[MAX_SET] = {t};
+    size_t n = whole_group ? visible_set(t, set) : 1;
+    if (src->closing || t->shutdown.in_progress || n >= tll_length(src->tabs))
+        return false;
+
+    if (in_set(src->term, set, n)) {
+        struct terminal *nb = whole_group ? NULL : neighbour(src, t, true);
+        if (nb == NULL)
+            nb = outside_neighbour(src, set, n);
+        tabs_activate(src, nb);
+    }
+
+    struct wl_window *new = wayl_win_init(set[0], NULL, NULL);
+    if (new == NULL)
+        return false;
+    new->sidebar_w = src->sidebar_w;
+    new->sidebar_hidden = src->sidebar_hidden;
+
+    for (size_t i = 0; i < n; i++) {
+        if (!whole_group)
+            set[i]->group = 0;
+        tabs_transfer(set[i], new, false);
+    }
+
+    render_refresh_title(new->term);
+    tabs_relayout(src);
+    return true;
+}
+
+struct wl_window *
+tabs_merge_target(struct wl_window *src)
+{
+    struct wl_window *best = NULL;
+    tll_foreach(src->term->wl->windows, it) {
+        struct wl_window *w = it->item;
+        if (w != src && !w->closing && w->is_configured &&
+            (best == NULL || w->focus_seq > best->focus_seq))
+            best = w;
+    }
+    return best;
+}
+
+struct wl_window *
+tabs_find_target(struct wayland *wayl)
+{
+    struct wl_window *best = NULL;
+    tll_foreach(wayl->windows, it) {
+        struct wl_window *w = it->item;
+        if (w->closing || tll_length(w->tabs) == 0)
+            continue;
+        if (best == NULL || w->focus_seq > best->focus_seq)
+            best = w;
+    }
+    return best;
+}
+
+bool
+tabs_merge_into(struct wl_window *src, struct wl_window *dst)
+{
+    if (dst == NULL || dst == src || src->closing || dst->closing)
+        return false;
+
+    tabs_menu_close(src);
+    struct terminal *moved = src->term;
+
+    src->closing = true;
+    struct terminal **arr;
+    size_t n = to_arr(src, &arr);
+    for (size_t i = 0; i < n; i++)
+        tabs_transfer(arr[i], dst, arr[i] == moved);
+    free(arr);
+
+    src->term = moved;
+    src->unmapped = true;
+    if (src->frame_callback != NULL) {
+        wl_callback_destroy(src->frame_callback);
+        src->frame_callback = NULL;
+    }
+    wayl_win_destroy(src);
+
+    term_visual_focus_out(moved);
+    tabs_activate(dst, moved);
+    tabs_relayout(dst);
+    return true;
+}
+
+/* Split view */
+
+static bool
+split_fits(struct wl_window *win, size_t n, bool vertical)
+{
+    int w, h, x, y, pw, ph;
+    tabs_win_size(win, &w, &h);
+    tabs_pane_rect(win, w, h, n, 0, vertical, &x, &y, &pw, &ph);
+    const float scale = win->term->scale;
+    return pw * scale >= win->term->cell_width && ph * scale >= win->term->cell_height;
+}
+
+bool
+tabs_split_new(struct terminal *from)
+{
+    struct wl_window *win = from->window;
+    if (!split_fits(win, tabs_group_len(win->term) + 1, win->term->group_vertical))
+        return false;
+    return tabs_new(from, true);
+}
+
+static bool
+current_vertical(const struct wl_window *win)
+{
+    return win->term->group != 0 && win->term->group_vertical;
+}
+
+/* Joins target's row into the current split at pane index pos (-1: last) */
+static bool
+split_join(struct wl_window *win, struct terminal *target, int pos, bool vertical)
+{
+    struct terminal *t = win->term;
+    struct terminal **arr;
+    size_t n = to_arr(win, &arr);
+    size_t s, e, ks, ke;
+    row_extent(arr, n, arr_index(arr, n, t), &s, &e);
+    ssize_t k = arr_index(arr, n, target);
+    if (k < 0 || ((size_t)k >= s && (size_t)k < e)) {
+        free(arr);
+        return false;
+    }
+    row_extent(arr, n, k, &ks, &ke);
+    size_t len = ke - ks;
+    if (len > MAX_SET || !split_fits(win, e - s + len, vertical)) {
+        free(arr);
+        return false;
+    }
+
+    struct terminal *row[MAX_SET];
+    memcpy(row, &arr[ks], len * sizeof(row[0]));
+    memmove(&arr[ks], &arr[ke], (n - ke) * sizeof(arr[0]));
+    row_extent(arr, n - len, arr_index(arr, n - len, t), &s, &e);
+    memmove(&arr[e + len], &arr[e], (n - len - e) * sizeof(arr[0]));
+    memcpy(&arr[e], row, len * sizeof(row[0]));
+    if (pos >= 0 && (size_t)pos < e - s) {
+        memmove(&arr[s + pos + len], &arr[s + pos], (e - s - pos) * sizeof(arr[0]));
+        memcpy(&arr[s + pos], row, len * sizeof(row[0]));
+    }
+
+    uint32_t g = t->group != 0 ? t->group : ++t->wl->group_counter;
+    for (size_t i = s; i < e + len; i++) {
+        arr[i]->group = g;
+        arr[i]->group_vertical = vertical;
+        arr[i]->pane_weight = 0;
+    }
+    for (size_t i = 0; i < len; i++) {
+        row[i]->tab_marker = row[i]->tab_activity = false;
+        row[i]->activity_lines = 0;
+        float o = row[i]->scale;
+        if (term_update_scale(row[i]))
+            term_font_dpi_changed(row[i], o);
+    }
+
+    int w, h;
+    tabs_win_size(win, &w, &h);
+    from_arr(win, arr, n);
+    tabs_layout(win, w, h);
+    return true;
+}
+
+bool
+tabs_split_next(struct wl_window *win)
+{
+    int r = tabs_row_of(win, win->term);
+    struct terminal *next = tabs_row_term(win, r + 1);
+    return next != NULL && split_join(win, next, -1, current_vertical(win));
+}
+
+/* Moves a pane of the current split to index pos, possibly changing orientation */
+static void
+group_place(struct wl_window *win, struct terminal *t, int pos, bool vertical)
+{
+    struct terminal **arr;
+    size_t n = to_arr(win, &arr);
+    size_t s, e;
+    ssize_t i = arr_index(arr, n, t);
+    row_extent(arr, n, i, &s, &e);
+    if (!split_fits(win, e - s, vertical)) {
+        free(arr);
+        return;
+    }
+    memmove(&arr[i], &arr[i + 1], (n - i - 1) * sizeof(arr[0]));
+    const size_t at = s + min((size_t)max(pos, 0), e - s - 1);
+    memmove(&arr[at + 1], &arr[at], (n - 1 - at) * sizeof(arr[0]));
+    arr[at] = t;
+    for (size_t k = s; k < e; k++) {
+        arr[k]->group_vertical = vertical;
+        arr[k]->pane_weight = 0;
+    }
+
+    int w, h;
+    tabs_win_size(win, &w, &h);
+    from_arr(win, arr, n);
+    tabs_layout(win, w, h);
+}
+
+static void pop_out(struct wl_window *win, struct terminal *t);
+
+void
+tabs_split_with(struct terminal *t)
+{
+    if (t->group != 0 && t->group == t->window->term->group)
+        return;
+    pop_out(t->window, t);
+    split_join(t->window, t, -1, current_vertical(t->window));
+}
+
+void
+tabs_unsplit(struct wl_window *win)
+{
+    struct terminal *act = win->term;
+    struct terminal *vis[MAX_SET];
+    size_t nv = visible_set(act, vis);
+    if (nv < 2)
+        return;
+
+    int w, h;
+    tabs_win_size(win, &w, &h);
+    uint64_t now = tabs_now_ms();
+    for (size_t i = 0; i < nv; i++) {
+        vis[i]->group = 0;
+        if (vis[i] == act)
+            continue;
+        pane_destroy(vis[i]);
+        drop_buffers(vis[i]);
+        vis[i]->activity_mute_until = now + 500;
+    }
+    tabs_layout(win, w, h);
+    full_repaint(act);
+}
+
+void
+tabs_focus_pane_cycle(struct wl_window *win, int delta)
+{
+    struct terminal *vis[MAX_SET];
+    size_t nv = visible_set(win->term, vis);
+    if (nv < 2)
+        return;
+    ssize_t i = arr_index(vis, nv, win->term);
+    tabs_focus_pane(win, vis[((i + delta) % (ssize_t)nv + nv) % nv]);
+}
+
+char *
+tabs_sock_pointer(void)
+{
+    const char *rt = getenv("XDG_RUNTIME_DIR");
+    const char *disp = getenv("WAYLAND_DISPLAY");
+    if (rt == NULL)
+        return NULL;
+    return xasprintf("%s/foot-tab-%s.sock", rt, disp != NULL ? disp : "wayland-0");
+}
+
+static bool
+sock_points_here(const char *ptr, const char *own)
+{
+    char buf[PATH_MAX];
+    ssize_t n = readlink(ptr, buf, sizeof(buf) - 1);
+    if (n < 0)
+        return false;
+    buf[n] = '\0';
+    return streq(buf, own);
+}
+
+void
+tabs_sock_focus(struct wayland *wayl)
+{
+    if (wayl->tab_sock_path == NULL)
+        return;
+    char *ptr = tabs_sock_pointer();
+    if (ptr != NULL && !sock_points_here(ptr, wayl->tab_sock_path)) {
+        char *tmp = xasprintf("%s.%d", ptr, (int)getpid());
+        unlink(tmp);
+        if (symlink(wayl->tab_sock_path, tmp) == 0 && rename(tmp, ptr) < 0)
+            unlink(tmp);
+        free(tmp);
+    }
+    free(ptr);
+}
+
+void
+tabs_sock_release(struct wayland *wayl)
+{
+    if (wayl->tab_sock_path == NULL)
+        return;
+    char *ptr = tabs_sock_pointer();
+    if (ptr != NULL && sock_points_here(ptr, wayl->tab_sock_path))
+        unlink(ptr);
+    free(ptr);
+    free(wayl->tab_sock_path);
+    wayl->tab_sock_path = NULL;
+}
+
+/* Ordering */
+
+static void
+move_row(struct wl_window *win, struct terminal *t, int delta)
+{
+    struct terminal **arr;
+    size_t n = to_arr(win, &arr);
+
+    for (; delta != 0; delta += delta > 0 ? -1 : 1) {
+        size_t s, e;
+        row_extent(arr, n, arr_index(arr, n, t), &s, &e);
+        size_t len = e - s;
+        struct terminal *row[MAX_SET];
+        if (len > MAX_SET)
+            break;
+        memcpy(row, &arr[s], len * sizeof(row[0]));
+
+        ssize_t k = -1;
+        if (delta > 0) {
+            for (size_t j = e; j < n; j++)
+                { k = j; break; }
+            if (k < 0)
+                break;
+            size_t ks, ke;
+            row_extent(arr, n, k, &ks, &ke);
+            memmove(&arr[s], &arr[e], (ke - e) * sizeof(arr[0]));
+            memcpy(&arr[ke - len], row, len * sizeof(row[0]));
+        } else {
+            for (ssize_t j = (ssize_t)s - 1; j >= 0; j--)
+                { k = j; break; }
+            if (k < 0)
+                break;
+            size_t ks, ke;
+            row_extent(arr, n, k, &ks, &ke);
+            memmove(&arr[ks + len], &arr[ks], (s - ks) * sizeof(arr[0]));
+            memcpy(&arr[ks], row, len * sizeof(row[0]));
+        }
+    }
+
+    from_arr(win, arr, n);
+    render_refresh_sidebar(win);
+}
+
+void
+tabs_move(struct wl_window *win, int delta)
+{
+    move_row(win, win->term, delta);
+}
+
+void
+tabs_select_index(struct wl_window *win, int idx)
+{
+    struct terminal *t = tabs_row_term(win, idx);
+    if (t != NULL)
+        tabs_activate(win, t);
+}
+
+void
+tabs_cycle(struct wl_window *win, int delta)
+{
+    int n = tabs_row_count(win);
+    if (n < 2)
+        return;
+    int r = tabs_row_of(win, win->term);
+    tabs_select_index(win, ((r + delta) % n + n) % n);
+}
+
+static char *
+live_cwd(const struct terminal *t)
+{
+    pid_t pid = t->ptmx >= 0 ? tcgetpgrp(t->ptmx) : -1;
+    if (pid > 0) {
+        char path[64], buf[PATH_MAX];
+        snprintf(path, sizeof(path), "/proc/%d/cwd", (int)pid);
+        ssize_t n = readlink(path, buf, sizeof(buf) - 1);
+        if (n > 0) {
+            buf[n] = '\0';
+            return xstrdup(buf);
+        }
+    }
+    return xstrdup(t->cwd);
+}
+
+bool
+tabs_new(struct terminal *from, bool split)
+{
+    struct wayland *wayl = from->wl;
+    struct wl_window *win = from->window;
+    if (wayl->tab_host.new_tab == NULL || win == NULL || win->closing)
+        return false;
+
+    char *cwd = live_cwd(from);
+    bool ok = wayl->tab_host.new_tab(
+        wayl->tab_host.data, win, split, cwd, 0, NULL);
+    free(cwd);
+    return ok;
+}
+
+struct terminal *
+tabs_term_for_surface(struct wl_window *win, struct wl_surface *surface)
+{
+    tll_foreach(win->tabs, it) {
+        if (it->item->pane.surface.surf == surface)
+            return it->item;
+    }
+    return win->term;
+}
+
+void
+tabs_sidebar_cancel_drag(struct wl_window *win)
+{
+    if (win->sidebar_drag.tab == NULL)
+        return;
+    memset(&win->sidebar_drag, 0, sizeof(win->sidebar_drag));
+    render_refresh_sidebar(win);
+}
+
+void
+tabs_toggle_sidebar(struct wl_window *win)
+{
+    win->sidebar_hidden = !win->sidebar_hidden;
+    if (!win->sidebar_hidden && win->term->conf->tabs.animations) {
+        win->anim.slide = true;
+        anim_start(win);
+    }
+    memset(&win->sidebar_drag, 0, sizeof(win->sidebar_drag));
+    memset(&win->sidebar_resize, 0, sizeof(win->sidebar_resize));
+    tabs_menu_close(win);
+    tabs_relayout(win);
+}
+
+static int
+sidebar_origin_px(const struct wl_window *win)
+{
+    if (!win->term->conf->tabs.right)
+        return 0;
+    int w, h;
+    tabs_win_size(win, &w, &h);
+    return (int)roundf(w * win->term->scale) - tabs_sidebar_width_px(win);
+}
+
+static bool
+on_grip(const struct wl_window *win, int x)
+{
+    const int w = tabs_sidebar_width_px(win);
+    const int grip = max(2, (int)roundf(4 * win->term->scale));
+    return win->term->conf->tabs.right ? x >= 0 && x < grip : x >= w - grip && x < w;
+}
+
+static void
+sidebar_resize_to(struct wl_window *win, int x)
+{
+    const float scale = win->term->scale;
+    int w, h;
+    tabs_win_size(win, &w, &h);
+
+    const int cur = win->sidebar_w;
+    int nw = win->term->conf->tabs.right
+        ? cur - (int)roundf(x / scale) : (int)roundf(x / scale);
+    const int min_w = 40;
+    const int max_w = max(min_w, w - (int)roundf(10 * win->term->cell_width / scale));
+    nw = max(min_w, min(nw, max_w));
+    if (nw == cur)
+        return;
+    win->sidebar_w = nw;
+    tabs_relayout(win);
+}
+
+static void
+menu_open(struct wl_window *win, struct terminal *t, enum tab_menu_kind kind,
+          int x, int y);
+
+/* Scrollbar along the window's outer edge; false when the list fits */
+bool
+tabs_scrollbar(const struct wl_window *win, int *x, int *w, int *ty, int *th)
+{
+    const int row_h = tabs_sidebar_row_h(win);
+    const int list_h = tabs_sidebar_height_px(win) - row_h - 1;
+    const int total = tabs_line_count(win);
+    const int vis = max(1, list_h / row_h);
+    if (total <= vis)
+        return false;
+    const float scale = win->term->scale;
+    *w = max(2, (int)roundf(4 * scale));
+    *x = win->term->conf->tabs.right ? tabs_sidebar_width_px(win) - *w : 0;
+    *th = max(row_h / 2, list_h * vis / total);
+    *ty = (list_h - *th) * win->sidebar_scroll / max(1, total - vis);
+    return true;
+}
+
+static void
+scrollbar_drag(struct wl_window *win, int y)
+{
+    int sx, sw, ty, th;
+    if (!tabs_scrollbar(win, &sx, &sw, &ty, &th))
+        return;
+    const int row_h = tabs_sidebar_row_h(win);
+    const int list_h = tabs_sidebar_height_px(win) - row_h - 1;
+    const int total = tabs_line_count(win);
+    const int vis = max(1, list_h / row_h);
+    const int range = max(1, list_h - th);
+    const int s = win->sidebar_sb.start_scroll +
+        (y - win->sidebar_sb.start_y) * (total - vis) / range;
+    if (s != win->sidebar_scroll) {
+        win->sidebar_scroll = s;
+        tabs_sidebar_scroll_fix(win);
+        render_refresh_sidebar(win);
+    }
+}
+
+/* The hover close button sits at the row end next to the inner edge */
+int
+tabs_close_x(const struct wl_window *win)
+{
+    const int w = tabs_sidebar_width_px(win);
+    const int row_h = tabs_sidebar_row_h(win);
+    const int grip = max(2, (int)roundf(4 * win->term->scale));
+    return win->term->conf->tabs.right ? grip : w - grip - row_h;
+}
+
+static enum tab_hover
+sidebar_zone(const struct wl_window *win, int x, int y, int *row)
+{
+    const int w = tabs_sidebar_width_px(win);
+    const int h = tabs_sidebar_height_px(win);
+    const int row_h = tabs_sidebar_row_h(win);
+    *row = -1;
+
+    if (x < 0 || x >= w || y < 0 || y >= h)
+        return TAB_HOVER_NONE;
+    if (on_grip(win, x))
+        return TAB_HOVER_GRIP;
+    int sx, sw, ty, th;
+    if (y < h - row_h && tabs_scrollbar(win, &sx, &sw, &ty, &th) &&
+        x >= sx - sw && x < sx + 2 * sw)
+    {
+        return TAB_HOVER_SCROLLBAR;
+    }
+    if (y >= h - row_h) {
+        if (x >= w - row_h)
+            return TAB_HOVER_HIDE;
+        if (x < row_h)
+            return TAB_HOVER_NEW;
+        return TAB_HOVER_NONE;
+    }
+    const int r = y / row_h + win->sidebar_scroll;
+    if (r >= tabs_line_count(win))
+        return TAB_HOVER_NONE;
+    *row = r;
+    const int cx = tabs_close_x(win);
+    if (x >= cx && x < cx + row_h)
+        return TAB_HOVER_CLOSE;
+    return TAB_HOVER_ROW;
+}
+
+static void
+set_hover(struct seat *seat, struct wl_window *win, enum tab_hover what, int row)
+{
+    if (what == win->hover.what && row == win->hover.row)
+        return;
+    win->hover.what = what;
+    win->hover.row = row;
+    win->sidebar_resize.hover = what == TAB_HOVER_GRIP;
+    render_refresh_sidebar(win);
+    if (seat != NULL && seat->mouse_focus != NULL)
+        term_xcursor_update_for_seat(seat->mouse_focus, seat);
+}
+
+void
+tabs_sidebar_scroll(struct wl_window *win, int lines)
+{
+    win->sidebar_scroll += lines;
+    tabs_sidebar_scroll_fix(win);
+    render_refresh_sidebar(win);
+}
+
+void
+tabs_sidebar_leave(struct wl_window *win)
+{
+    set_hover(NULL, win, TAB_HOVER_NONE, -1);
+}
+
+void
+tabs_sidebar_btn_hover(struct wl_window *win, bool hover)
+{
+    if (win->hover.btn == hover)
+        return;
+    win->hover.btn = hover;
+    sidebar_place(win);
+    render_refresh_sidebar(win);
+}
+
+/* Multi-select */
+
+static size_t
+selected_rows(struct wl_window *win, struct terminal **out, size_t max)
+{
+    size_t n = 0;
+    tll_foreach(win->tabs, it)
+        if (it->item->tab_selected && n < max)
+            out[n++] = it->item;
+    return n;
+}
+
+/* Take one pane out of its split, placing it right after the group */
+static void
+pop_out(struct wl_window *win, struct terminal *t)
+{
+    if (t->group == 0)
+        return;
+    struct terminal **arr;
+    size_t n = to_arr(win, &arr);
+    size_t s, e;
+    ssize_t i = arr_index(arr, n, t);
+    row_extent(arr, n, i, &s, &e);
+    memmove(&arr[i], &arr[i + 1], (e - i - 1) * sizeof(arr[0]));
+    arr[e - 1] = t;
+    from_arr(win, arr, n);
+
+    struct terminal *nb = win->term == t ? neighbour(win, t, true) : NULL;
+    t->group = 0;
+    if (nb != NULL)
+        tabs_activate(win, nb);
+    pane_destroy(t);
+    drop_buffers(t);
+    tabs_relayout(win);
+}
+
+static void
+clear_selection(struct wl_window *win)
+{
+    bool any = false;
+    tll_foreach(win->tabs, it) {
+        any |= it->item->tab_selected;
+        it->item->tab_selected = false;
+    }
+    if (any)
+        render_refresh_sidebar(win);
+}
+
+static void
+select_click(struct wl_window *win, struct terminal *t, bool range)
+{
+    struct terminal *set[MAX_SET];
+    struct terminal *act = win->term;
+    if (selected_rows(win, set, MAX_SET) == 0)
+        act->tab_selected = true;
+
+    if (range) {
+        const int a = tabs_line_of(win, act), b = tabs_line_of(win, t);
+        for (int l = min(a, b); l <= max(a, b); l++)
+            tabs_line_term(win, l)->tab_selected = true;
+    } else
+        t->tab_selected = !t->tab_selected;
+    render_refresh_sidebar(win);
+}
+
+static void
+split_selected(struct wl_window *win)
+{
+    struct terminal *rows[MAX_SET];
+    const size_t n = selected_rows(win, rows, MAX_SET);
+    clear_selection(win);
+    if (n < 2)
+        return;
+    tabs_activate(win, rows[0]);
+    for (size_t i = 1; i < n; i++) {
+        if (rows[i]->group != 0 && rows[i]->group == win->term->group)
+            continue;
+        pop_out(win, rows[i]);
+        split_join(win, rows[i], -1, current_vertical(win));
+    }
+}
+
+static void
+close_selected(struct wl_window *win)
+{
+    struct terminal *rows[MAX_SET];
+    const size_t n = selected_rows(win, rows, MAX_SET);
+    clear_selection(win);
+    for (size_t i = 0; i < n; i++)
+        term_shutdown(rows[i]);
+}
+
+/* Dragging tabs between windows uses Wayland DnD */
+
+static void
+dnd_cleanup(struct wayland *wayl)
+{
+    if (wayl->tab_dnd.source != NULL)
+        wl_data_source_destroy(wayl->tab_dnd.source);
+    if (wayl->tab_dnd.icon != NULL)
+        wl_surface_destroy(wayl->tab_dnd.icon);
+    if (wayl->tab_dnd.icon_chain != NULL) {
+        shm_purge(wayl->tab_dnd.icon_chain);
+        shm_chain_free(wayl->tab_dnd.icon_chain);
+    }
+    struct wl_window *target = wayl->tab_dnd.target;
+    if (target != NULL) {
+        target->drop_row = -1;
+        target->drop_split = false;
+        target->drop_center = false;
+        render_tab_drop_hint(target);
+        render_refresh_sidebar(target);
+    }
+    wayl->tab_dnd.source = NULL;
+    wayl->tab_dnd.icon = NULL;
+    wayl->tab_dnd.icon_chain = NULL;
+    wayl->tab_dnd.target = NULL;
+    wayl->tab_dnd.surface = NULL;
+}
+
+static void
+dnd_src_target(void *data, struct wl_data_source *src, const char *mime) {}
+
+static void
+dnd_src_send(void *data, struct wl_data_source *src, const char *mime, int fd)
+{
+    close(fd);
+}
+
+static void
+dnd_src_cancelled(void *data, struct wl_data_source *src)
+{
+    struct wayland *wayl = data;
+    if (wayl->tab_dnd.action == TAB_DND_NONE && wayl->tab_dnd.tab != NULL)
+        wayl->tab_dnd.action = TAB_DND_DETACH;
+    dnd_cleanup(wayl);
+}
+
+static void
+dnd_src_performed(void *data, struct wl_data_source *src) {}
+
+static void
+dnd_src_finished(void *data, struct wl_data_source *src)
+{
+    dnd_cleanup(data);
+}
+
+static void
+dnd_src_action(void *data, struct wl_data_source *src, uint32_t action) {}
+
+static const struct wl_data_source_listener dnd_source_listener = {
+    .target = &dnd_src_target,
+    .send = &dnd_src_send,
+    .cancelled = &dnd_src_cancelled,
+    .dnd_drop_performed = &dnd_src_performed,
+    .dnd_finished = &dnd_src_finished,
+    .action = &dnd_src_action,
+};
+
+static bool
+dnd_start(struct seat *seat, struct wl_window *win, struct terminal *t)
+{
+    struct wayland *wayl = t->wl;
+    if (wayl->data_device_manager == NULL || seat->data_device == NULL ||
+        wayl->tab_dnd.source != NULL || wayl->tab_dnd.action != TAB_DND_NONE)
+    {
+        return false;
+    }
+
+    struct wl_data_source *src =
+        wl_data_device_manager_create_data_source(wayl->data_device_manager);
+    if (src == NULL)
+        return false;
+    wl_data_source_offer(src, TAB_MIME);
+    wl_data_source_set_actions(src, WL_DATA_DEVICE_MANAGER_DND_ACTION_MOVE);
+    wl_data_source_add_listener(src, &dnd_source_listener, wayl);
+
+    wayl->tab_dnd.tab = t;
+    wayl->tab_dnd.source = src;
+    wayl->tab_dnd.icon = wl_compositor_create_surface(wayl->compositor);
+    wayl->tab_dnd.icon_chain = shm_chain_new(wayl, false, 1, SHM_BITS_8, NULL, NULL);
+    wayl->tab_dnd.row = -1;
+
+    wl_data_device_start_drag(
+        seat->data_device, src, win->sidebar.surface.surf,
+        wayl->tab_dnd.icon, seat->pointer.serial);
+    render_tab_drag_icon(wayl);
+    seat_forget_buttons(seat);
+    return true;
+}
+
+static bool
+dnd_owns_surface(const struct wl_window *w, const struct wl_surface *surface,
+                 int *x_ofs, int *y_ofs)
+{
+    *x_ofs = *y_ofs = 0;
+    if (surface == w->surface.surf)
+        return true;
+    if (surface == w->sidebar_btn.surface.surf) {
+        int ww, wh;
+        tabs_win_size(w, &ww, &wh);
+        *y_ofs = (int)roundf(wh * w->term->scale) - tabs_sidebar_btn_px(w);
+        return true;
+    }
+    if (surface == w->sidebar.surface.surf) {
+        *x_ofs = sidebar_origin_px(w);
+        return true;
+    }
+    tll_foreach(w->tabs, it) {
+        if (surface == it->item->pane.surface.surf) {
+            *x_ofs = (int)roundf(tabs_pane_x(it->item) * w->term->scale);
+            *y_ofs = (int)roundf(tabs_pane_y(it->item) * w->term->scale);
+            return true;
+        }
+    }
+    return false;
+}
+
+bool
+tabs_dnd_enter(struct wayland *wayl, struct wl_surface *surface)
+{
+    if (wayl->tab_dnd.tab == NULL || wayl->tab_dnd.source == NULL)
+        return false;
+    tll_foreach(wayl->windows, it) {
+        int ofs, yofs;
+        if (!it->item->closing && dnd_owns_surface(it->item, surface, &ofs, &yofs)) {
+            wayl->tab_dnd.target = it->item;
+            wayl->tab_dnd.surface = surface;
+            return true;
+        }
+    }
+    return false;
+}
+
+void
+tabs_dnd_motion(struct wayland *wayl, double sx, double sy)
+{
+    struct wl_window *w = wayl->tab_dnd.target;
+    struct terminal *t = wayl->tab_dnd.tab;
+    if (w == NULL || t == NULL)
+        return;
+
+    int ofs, yofs;
+    if (!dnd_owns_surface(w, wayl->tab_dnd.surface, &ofs, &yofs))
+        return;
+    const float scale = w->term->scale;
+    const int x = ofs + (int)roundf(sx * scale);
+    const int y = yofs + (int)roundf(sy * scale);
+    const int sb_x = sidebar_origin_px(w);
+    const int sb_w = tabs_sidebar_width_px(w);
+
+    int row = -1, pos = 0, n_new = 0;
+    bool split = false, vertical = false, center = false;
+    if (sb_w > 0 && x >= sb_x && x < sb_x + sb_w) {
+        const int row_h = tabs_sidebar_row_h(w);
+        row = max(0, min((y + row_h / 2) / row_h + w->sidebar_scroll, tabs_line_count(w)));
+    } else {
+        /* The edge of the pane under the pointer picks the side and orientation */
+        struct terminal *set[MAX_SET];
+        const size_t n = visible_set(w->term, set);
+        const bool vert_now = n > 1 && w->term->group_vertical;
+        int W, H, px = 0, py = 0, pw = 1, ph = 1;
+        tabs_win_size(w, &W, &H);
+        const float lx = x / scale, ly = y / scale;
+        size_t hit = n - 1;
+        for (size_t i = 0; i < n; i++) {
+            tabs_pane_rect(w, W, H, n, i, vert_now, &px, &py, &pw, &ph);
+            if ((vert_now ? ly < py + ph : lx < px + pw)) {
+                hit = i;
+                break;
+            }
+        }
+        tabs_pane_rect(w, W, H, n, hit, vert_now, &px, &py, &pw, &ph);
+        const float fx = (lx - px) / max(1, pw), fy = (ly - py) / max(1, ph);
+        const float dl = fx, dr = 1 - fx, dt = fy, db = 1 - fy;
+        const float m = fminf(fminf(dl, dr), fminf(dt, db));
+        vertical = m == dt || m == db;
+        pos = (int)hit + (m == dr || m == db ? 1 : 0);
+        const bool in_group = t->window == w && in_set(t, set, n);
+
+        if (m > 0.25f) {
+            /* Middle of a pane: add as a tab (or take a pane out of its split) */
+            center = t->window != w || (in_group && n > 1);
+            row = center ? tabs_line_count(w) : -1;
+        } else if (in_group) {
+            size_t ti = 0;
+            while (set[ti] != t)
+                ti++;
+            if ((size_t)pos > ti)
+                pos--;
+            n_new = n;
+            split = n > 1 && ((size_t)pos != ti || vertical != vert_now) &&
+                split_fits(w, n, vertical);
+        } else {
+            n_new = n + 1;
+            split = split_fits(w, n_new, vertical);
+        }
+    }
+
+    wayl->tab_dnd.row = row;
+    wayl->tab_dnd.pos = pos;
+    wayl->tab_dnd.vertical = vertical;
+    if (center)
+        row = -1;
+    if (w->drop_row != row || w->drop_split != split || w->drop_center != center ||
+        (split && (w->drop_pos != pos || w->drop_vertical != vertical)))
+    {
+        w->drop_center = center;
+        w->drop_row = row;
+        w->drop_split = split;
+        w->drop_pos = pos;
+        w->drop_n = n_new;
+        w->drop_vertical = vertical;
+        render_tab_drop_hint(w);
+        render_refresh_sidebar(w);
+    }
+}
+
+void
+tabs_dnd_leave(struct wayland *wayl)
+{
+    struct wl_window *w = wayl->tab_dnd.target;
+    if (w != NULL) {
+        w->drop_row = -1;
+        w->drop_split = false;
+        w->drop_center = false;
+        render_tab_drop_hint(w);
+        render_refresh_sidebar(w);
+    }
+    wayl->tab_dnd.target = NULL;
+    wayl->tab_dnd.surface = NULL;
+}
+
+void
+tabs_dnd_drop(struct wayland *wayl)
+{
+    struct wl_window *w = wayl->tab_dnd.target;
+    if (w == NULL || wayl->tab_dnd.tab == NULL)
+        return;
+    wayl->tab_dnd.dest = w;
+    if (w->drop_row >= 0 || w->drop_split || w->drop_center)
+        wayl->tab_dnd.action = TAB_DND_MOVE;
+    else if (w != wayl->tab_dnd.tab->window) {
+        wayl->tab_dnd.row = tabs_line_count(w);
+        wayl->tab_dnd.action = TAB_DND_MOVE;
+    } else
+        wayl->tab_dnd.action = TAB_DND_KEEP;
+}
+
+/* line < 0: split with dst's current tab */
+static void
+move_to_window(struct terminal *t, struct wl_window *dst, int line, int pos, bool vertical)
+{
+    struct wl_window *src = t->window;
+    struct terminal *keep = dst->term;
+    const int row = line >= 0 ? row_at_line(dst, line) : -1;
+
+    if (tll_length(src->tabs) <= 1)
+        tabs_merge_into(src, dst);
+    else {
+        pop_out(src, t);
+        if (src->term == t) {
+            struct terminal *set[1] = {t};
+            tabs_activate(src, outside_neighbour(src, set, 1));
+        }
+        t->group = 0;
+        tabs_transfer(t, dst, false);
+        tabs_relayout(src);
+    }
+
+    if (row >= 0) {
+        move_row(dst, t, row - tabs_row_of(dst, t));
+        tabs_activate(dst, t);
+    } else {
+        tabs_activate(dst, keep);
+        move_row(dst, t, tabs_row_of(dst, keep) + 1 - tabs_row_of(dst, t));
+        split_join(dst, t, pos, vertical);
+    }
+    tabs_relayout(dst);
+}
+
+void
+tabs_dnd_run(struct wayland *wayl)
+{
+    const int action = wayl->tab_dnd.action;
+    struct terminal *t = wayl->tab_dnd.tab;
+    struct wl_window *dst = wayl->tab_dnd.dest;
+    const int row = wayl->tab_dnd.row;
+
+    if (action == TAB_DND_NONE || wayl->tab_dnd.source != NULL)
+        return;
+    wayl->tab_dnd.action = TAB_DND_NONE;
+    wayl->tab_dnd.tab = NULL;
+    wayl->tab_dnd.dest = NULL;
+    if (t == NULL || t->window == NULL || t->window->closing || action == TAB_DND_KEEP)
+        return;
+
+    if (action == TAB_DND_DETACH) {
+        tabs_detach_window(t, false);
+        return;
+    }
+    if (dst == NULL || dst->closing)
+        return;
+
+    if (dst != t->window)
+        move_to_window(t, dst, row, wayl->tab_dnd.pos, wayl->tab_dnd.vertical);
+    else if (row < 0 && t->group != 0 && t->group == dst->term->group)
+        group_place(dst, t, wayl->tab_dnd.pos, wayl->tab_dnd.vertical);
+    else if (row < 0) {
+        pop_out(dst, t);
+        split_join(dst, t, wayl->tab_dnd.pos, wayl->tab_dnd.vertical);
+    }
+    else {
+        pop_out(dst, t);
+        const int to = row_at_line(dst, row), cur = tabs_row_of(dst, t);
+        move_row(dst, t, (to > cur ? to - 1 : to) - cur);
+    }
+}
+
+void
+tabs_sidebar_button(struct seat *seat, struct wl_window *win, int button, bool pressed)
+{
+    const int x = seat->mouse.x, y = seat->mouse.y;
+
+    if (!pressed) {
+        if (button != BTN_LEFT)
+            return;
+        if (win->sidebar_sb.seat == seat) {
+            win->sidebar_sb.seat = NULL;
+            return;
+        }
+        if (win->sidebar_resize.seat == seat) {
+            /* Compositors disagree on grab coordinates once the sidebar moves */
+            if (win->term->conf->tabs.right)
+                sidebar_resize_to(win, x);
+            win->sidebar_resize.seat = NULL;
+            render_refresh_sidebar(win);
+            return;
+        }
+        if (win->sidebar_drag.seat != seat)
+            return;
+        struct terminal *t = win->sidebar_drag.tab;
+        const bool dragging = win->sidebar_drag.dragging;
+        const enum tab_drop drop = win->sidebar_drag.drop;
+        tabs_sidebar_cancel_drag(win);
+        if (seat->mouse_focus != NULL)
+            term_xcursor_update_for_seat(seat->mouse_focus, seat);
+        if (!dragging) {
+            if (tabs_is_visible(t))
+                tabs_focus_pane(win, t);
+            else
+                tabs_activate(win, t);
+        }
+        else if (drop == TAB_DROP_DETACH)
+            tabs_detach_window(t, false);
+        else if (drop == TAB_DROP_SPLIT)
+            tabs_split_with(t);
+        return;
+    }
+
+    tabs_menu_close(win);
+
+    int row;
+    const enum tab_hover zone = sidebar_zone(win, x, y, &row);
+
+    if (button == BTN_LEFT && zone == TAB_HOVER_GRIP) {
+        win->sidebar_resize.seat = seat;
+        return;
+    }
+    if (button == BTN_LEFT && zone == TAB_HOVER_SCROLLBAR) {
+        int sx, sw, ty, th;
+        tabs_scrollbar(win, &sx, &sw, &ty, &th);
+        if (y < ty || y >= ty + th) {
+            const int vis = max(1, (tabs_sidebar_height_px(win) - tabs_sidebar_row_h(win)) /
+                                tabs_sidebar_row_h(win));
+            tabs_sidebar_scroll(win, y < ty ? -vis : vis);
+        }
+        win->sidebar_sb.seat = seat;
+        win->sidebar_sb.start_y = y;
+        win->sidebar_sb.start_scroll = win->sidebar_scroll;
+        return;
+    }
+    if (zone == TAB_HOVER_NEW && button == BTN_RIGHT) {
+        tabs_reopen(win);
+        return;
+    }
+    if (zone == TAB_HOVER_NONE && button == BTN_RIGHT) {
+        menu_open(win, win->term, TAB_MENU_SORT, sidebar_origin_px(win) + x, y);
+        return;
+    }
+    if (zone == TAB_HOVER_HIDE || zone == TAB_HOVER_NEW) {
+        if (button != BTN_LEFT)
+            return;
+        clear_selection(win);
+        if (zone == TAB_HOVER_HIDE)
+            tabs_toggle_sidebar(win);
+        else
+            tabs_new(win->term, false);
+        return;
+    }
+    if (zone == TAB_HOVER_CLOSE && button == BTN_LEFT) {
+        tabs_close_tab(tabs_line_term(win, row));
+        return;
+    }
+    if (zone != TAB_HOVER_ROW && zone != TAB_HOVER_CLOSE)
+        return;
+
+    struct terminal *t = tabs_line_term(win, row);
+    struct terminal *pane = t;
+
+    switch (button) {
+    case BTN_MIDDLE:
+        tabs_close_tab(pane);
+        return;
+
+    case BTN_RIGHT: {
+        struct terminal *sel[MAX_SET];
+        if (t->tab_selected && selected_rows(win, sel, MAX_SET) >= 2) {
+            menu_open(win, t, TAB_MENU_SELECTION, sidebar_origin_px(win) + x, y);
+            return;
+        }
+        clear_selection(win);
+        menu_open(win, pane, TAB_MENU_ACTIONS, sidebar_origin_px(win) + x, y);
+        return;
+    }
+
+    case BTN_LEFT:
+        if (seat->kbd.ctrl || seat->kbd.shift) {
+            select_click(win, t, seat->kbd.shift);
+            return;
+        }
+        if (seat->mouse.count == 2) {
+            tabs_open_rename(win, t);
+            return;
+        }
+        clear_selection(win);
+        memset(&win->sidebar_drag, 0, sizeof(win->sidebar_drag));
+        win->sidebar_drag.seat = seat;
+        win->sidebar_drag.tab = t;
+        win->sidebar_drag.start_y = y;
+        return;
+    }
+}
+
+static enum tab_drop
+drop_at(struct wl_window *win, int x, int y)
+{
+    const int w = tabs_sidebar_width_px(win);
+    const int h = tabs_sidebar_height_px(win);
+    if (x >= 0 && x < w && y >= 0 && y < h)
+        return TAB_DROP_NONE;
+
+    int ww, wh;
+    tabs_win_size(win, &ww, &wh);
+    const int wx = sidebar_origin_px(win) + x;
+    const float scale = win->term->scale;
+    if (wx >= 0 && wx < (int)roundf(ww * scale) && y >= 0 && y < (int)roundf(wh * scale)) {
+        struct terminal *t = win->sidebar_drag.tab;
+        const bool shown = t->group != 0 ? t->group == win->term->group : t == win->term;
+        return shown ? TAB_DROP_NONE : TAB_DROP_SPLIT;
+    }
+    return TAB_DROP_DETACH;
+}
+
+void
+tabs_sidebar_motion(struct seat *seat, struct wl_window *win)
+{
+    const int x = seat->mouse.x, y = seat->mouse.y;
+
+    if (win->sidebar_resize.seat == seat) {
+        if (!win->term->conf->tabs.right)
+            sidebar_resize_to(win, x);
+        return;
+    }
+    if (win->sidebar_sb.seat == seat) {
+        scrollbar_drag(win, y);
+        return;
+    }
+
+    if (win->sidebar_drag.seat != seat || win->sidebar_drag.tab == NULL) {
+        int row;
+        const enum tab_hover zone = sidebar_zone(win, x, y, &row);
+        set_hover(seat, win, zone, row);
+        return;
+    }
+
+    const int row_h = tabs_sidebar_row_h(win);
+    const int w = tabs_sidebar_width_px(win);
+    const int h = tabs_sidebar_height_px(win);
+
+    if (!win->sidebar_drag.dragging && abs(y - win->sidebar_drag.start_y) < row_h / 2 &&
+        x >= 0 && x < w)
+    {
+        return;
+    }
+    if (!win->sidebar_drag.dragging) {
+        win->sidebar_drag.dragging = true;
+        set_hover(seat, win, TAB_HOVER_NONE, -1);
+        render_refresh_sidebar(win);
+        if (seat->mouse_focus != NULL)
+            term_xcursor_update_for_seat(seat->mouse_focus, seat);
+    }
+
+    struct terminal *t = win->sidebar_drag.tab;
+    const bool outside = x < 0 || x >= w || y < 0 || y >= h;
+    if (outside && dnd_start(seat, win, t)) {
+        memset(&win->sidebar_drag, 0, sizeof(win->sidebar_drag));
+        render_refresh_sidebar(win);
+        return;
+    }
+
+    const enum tab_drop drop = drop_at(win, x, y);
+    if (drop != win->sidebar_drag.drop) {
+        win->sidebar_drag.drop = drop;
+        render_refresh_sidebar(win);
+    }
+    if (drop != TAB_DROP_NONE || y >= h - row_h - 1)
+        return;
+
+    const int line = min(y / row_h + win->sidebar_scroll, tabs_line_count(win) - 1);
+    const int target = tabs_row_of(win, tabs_line_term(win, line));
+    for (int cur = tabs_row_of(win, t); cur != target;) {
+        move_row(win, t, target > cur ? 1 : -1);
+        const int now = tabs_row_of(win, t);
+        if (now == cur)
+            break;
+        cur = now;
+    }
+}
+
+void
+tabs_sidebar_btn_button(struct seat *seat, struct wl_window *win, int button, bool pressed)
+{
+    if (pressed && button == BTN_LEFT)
+        tabs_toggle_sidebar(win);
+}
+
+/* Dragging the gap between split panes resizes them */
+
+static int
+divider_at(const struct wl_window *win, int x, int y)
+{
+    struct terminal *set[MAX_SET];
+    const size_t n = visible_set(win->term, set);
+    if (n < 2)
+        return -1;
+    const bool vert = win->term->group_vertical;
+    int xs[MAX_SET], ys[MAX_SET], ws[MAX_SET], hs[MAX_SET];
+    set_rects(win, win->layout_w, win->layout_h, set, n, vert, xs, ys, ws, hs);
+    const float scale = win->term->scale;
+    const int p = (int)roundf((vert ? y : x) / scale);
+    for (size_t k = 0; k + 1 < n; k++) {
+        const int a = vert ? ys[k] + hs[k] : xs[k] + ws[k];
+        const int b = vert ? ys[k + 1] : xs[k + 1];
+        if (p >= a - 2 && p <= b + 2)
+            return k;
+    }
+    return -1;
+}
+
+static void
+divider_drag(struct wl_window *win, int x, int y)
+{
+    struct terminal *set[MAX_SET];
+    const size_t n = visible_set(win->term, set);
+    const int k = win->pane_drag.divider;
+    if (k < 0 || (size_t)k + 1 >= n)
+        return;
+    const bool vert = win->term->group_vertical;
+    int xs[MAX_SET], ys[MAX_SET], ws[MAX_SET], hs[MAX_SET];
+    set_rects(win, win->layout_w, win->layout_h, set, n, vert, xs, ys, ws, hs);
+
+    const float scale = win->term->scale;
+    const int p = (int)roundf((vert ? y : x) / scale);
+    const int start = vert ? ys[k] : xs[k];
+    const int pair = vert ? hs[k] + hs[k + 1] : ws[k] + ws[k + 1];
+    const int min_size = (int)ceilf(2 * (vert ? win->term->cell_height : win->term->cell_width) / scale);
+    const int a = max(min_size, min(p - start - PANE_GAP / 2, pair - min_size));
+
+    for (size_t i = 0; i < n; i++)
+        set[i]->pane_weight = vert ? hs[i] : ws[i];
+    set[k]->pane_weight = a;
+    set[k + 1]->pane_weight = pair - a;
+    tabs_relayout(win);
+}
+
+void
+tabs_bg_motion(struct seat *seat, struct wl_window *win)
+{
+    if (win->pane_drag.seat == seat) {
+        divider_drag(win, seat->mouse.x, seat->mouse.y);
+        return;
+    }
+    const int d = divider_at(win, seat->mouse.x, seat->mouse.y);
+    if (d != win->pane_drag.hover) {
+        win->pane_drag.hover = d;
+        if (seat->mouse_focus != NULL)
+            term_xcursor_update_for_seat(seat->mouse_focus, seat);
+    }
+}
+
+void
+tabs_bg_button(struct seat *seat, struct wl_window *win, int button, bool pressed)
+{
+    if (button != BTN_LEFT)
+        return;
+    if (!pressed) {
+        win->pane_drag.seat = NULL;
+        return;
+    }
+    const int d = divider_at(win, seat->mouse.x, seat->mouse.y);
+    if (d >= 0) {
+        win->pane_drag.seat = seat;
+        win->pane_drag.divider = d;
+    }
+}
+
+void
+tabs_bg_leave(struct wl_window *win)
+{
+    win->pane_drag.hover = -1;
+}
+
+/* A prompt after a long command: mark the tab, and notify if its window isn't focused */
+
+#define DONE_MIN_MS 10000
+
+void
+tabs_prompt(struct terminal *t)
+{
+    const uint64_t started = t->cmd_started;
+    t->cmd_started = 0;
+    if (started == 0 || t->window == NULL || tabs_now_ms() - started < DONE_MIN_MS)
+        return;
+
+    bool focused = false;
+    tll_foreach(t->wl->seats, it)
+        focused |= it->item.kbd_focus != NULL && it->item.kbd_focus->window == t->window;
+
+    if (focused && tabs_is_visible(t))
+        return;
+
+    if (!tabs_is_visible(t)) {
+        t->tab_done = true;
+        render_refresh_sidebar(t->window);
+    }
+    if (!focused) {
+        char *title = xstrdup(t->tab_label != NULL ? t->tab_label
+                              : t->window_title != NULL ? t->window_title : "foot");
+        notify_notify(t, &(struct notification){
+            .title = xstrdup("Command finished"),
+            .body = title,
+            .expire_time = -1,
+            .focus = true,
+        });
+    }
+}
+
+/* Focus a tab by the PID of its shell, or of any process below it */
+
+static pid_t
+parent_pid(pid_t pid)
+{
+    char path[64], buf[512];
+    snprintf(path, sizeof(path), "/proc/%d/stat", (int)pid);
+    FILE *f = fopen(path, "re");
+    if (f == NULL)
+        return -1;
+    size_t n = fread(buf, 1, sizeof(buf) - 1, f);
+    fclose(f);
+    buf[n] = '\0';
+    const char *p = strrchr(buf, ')');
+    int ppid;
+    return p != NULL && sscanf(p + 1, " %*c %d", &ppid) == 1 ? ppid : -1;
+}
+
+bool
+tabs_focus_pid(struct wayland *wayl, pid_t pid, const char *token)
+{
+    for (int depth = 0; pid > 1 && depth < 64; depth++, pid = parent_pid(pid)) {
+        tll_foreach(wayl->terms, it) {
+            struct terminal *t = it->item;
+            if (t->slave != pid || t->window == NULL || t->window->closing)
+                continue;
+            tabs_activate(t->window, t);
+            if (token != NULL)
+                wayl_activate(wayl, t->window, token);
+            else
+                wayl_win_set_urgent(t->window);
+            return true;
+        }
+    }
+    return false;
+}
+
+/* Sorting: pinned tabs stay first, splits move as one row */
+
+enum { SORT_NAME, SORT_RECENT, SORT_PROGRAM, SORT_AGE };
+
+struct sort_row {
+    size_t start, len;
+    bool pinned;
+    char *name;
+    char *program;
+    uint64_t recent, created;
+    size_t order;
+};
+
+static int sort_mode;
+
+static char *
+program_of(const struct terminal *t)
+{
+    pid_t pid = t->ptmx >= 0 ? tcgetpgrp(t->ptmx) : -1;
+    if (pid <= 0)
+        pid = t->slave;
+    char path[64], buf[64] = {0};
+    snprintf(path, sizeof(path), "/proc/%d/comm", (int)pid);
+    FILE *f = fopen(path, "re");
+    if (f != NULL) {
+        if (fgets(buf, sizeof(buf), f) != NULL)
+            buf[strcspn(buf, "\n")] = '\0';
+        fclose(f);
+    }
+    return xstrdup(buf);
+}
+
+static int
+sort_cmp(const void *_a, const void *_b)
+{
+    const struct sort_row *a = _a, *b = _b;
+    if (a->pinned != b->pinned)
+        return a->pinned ? -1 : 1;
+    int r = 0;
+    switch (sort_mode) {
+    case SORT_NAME:
+        r = strcasecmp(a->name, b->name);
+        break;
+    case SORT_RECENT:
+        r = (a->recent < b->recent) - (a->recent > b->recent);
+        break;
+    case SORT_PROGRAM:
+        r = strcasecmp(a->program, b->program);
+        if (r == 0)
+            r = strcasecmp(a->name, b->name);
+        break;
+    case SORT_AGE:
+        r = (a->created > b->created) - (a->created < b->created);
+        break;
+    }
+    return r != 0 ? r : (a->order > b->order) - (a->order < b->order);
+}
+
+static void
+tabs_sort(struct wl_window *win, int mode)
+{
+    struct terminal **arr;
+    const size_t n = to_arr(win, &arr);
+    struct sort_row *rows = xcalloc(n + 1, sizeof(rows[0]));
+    size_t nr = 0;
+    for (size_t i = 0; i < n;) {
+        size_t s, e;
+        row_extent(arr, n, i, &s, &e);
+        struct terminal *t = arr[s];
+        struct sort_row *r = &rows[nr];
+        *r = (struct sort_row){.start = s, .len = e - s, .order = nr, .created = UINT64_MAX};
+        for (size_t k = s; k < e; k++) {
+            r->pinned |= arr[k]->tab_pinned;
+            r->recent = max(r->recent, arr[k]->tab_last_active);
+            r->created = min(r->created, arr[k]->tab_created);
+        }
+        r->name = xstrdup(t->tab_label != NULL ? t->tab_label
+                          : t->window_title != NULL ? t->window_title : "");
+        r->program = program_of(t);
+        nr++;
+        i = e;
+    }
+
+    sort_mode = mode;
+    qsort(rows, nr, sizeof(rows[0]), &sort_cmp);
+
+    struct terminal **out = xmalloc((n + 1) * sizeof(out[0]));
+    size_t k = 0;
+    for (size_t i = 0; i < nr; i++) {
+        memcpy(&out[k], &arr[rows[i].start], rows[i].len * sizeof(out[0]));
+        k += rows[i].len;
+        free(rows[i].name);
+        free(rows[i].program);
+    }
+    free(rows);
+    free(arr);
+    from_arr(win, out, n);
+    render_refresh_sidebar(win);
+}
+
+/* The wheel over the sidebar walks through the tabs, one line at a time */
+void
+tabs_cycle_lines(struct wl_window *win, int delta)
+{
+    const int n = tabs_line_count(win);
+    if (n < 2 || delta == 0)
+        return;
+    const int l = tabs_line_of(win, win->term);
+    struct terminal *t = tabs_line_term(win, ((l + (delta > 0 ? 1 : -1)) % n + n) % n);
+    if (tabs_is_visible(t))
+        tabs_focus_pane(win, t);
+    else
+        tabs_activate(win, t);
+}
+
+/* Duplicate, kill */
+
+void
+tabs_duplicate(struct terminal *t)
+{
+    struct wayland *wayl = t->wl;
+    struct wl_window *win = t->window;
+    if (wayl->tab_host.new_tab == NULL || win == NULL || win->closing)
+        return;
+
+    char *cwd = NULL;
+    char *script = wayl->tab_host.duplicate_script != NULL
+        ? wayl->tab_host.duplicate_script(wayl->tab_host.data, t, &cwd)
+        : NULL;
+
+    if (script == NULL) {
+        free(cwd);
+        cwd = live_cwd(t);
+        wayl->tab_host.new_tab(wayl->tab_host.data, win, false, cwd, 0, NULL);
+    } else {
+        char *argv[] = {"/bin/sh", "-c", script, "foot", NULL};
+        wayl->tab_host.new_tab(wayl->tab_host.data, win, false, cwd, 4, argv);
+    }
+    free(script);
+    free(cwd);
+}
+
+void
+tabs_kill(struct terminal *t)
+{
+    const pid_t fg = t->ptmx >= 0 ? tcgetpgrp(t->ptmx) : -1;
+    if (fg > 0)
+        kill(-fg, SIGKILL);
+    if (t->slave > 0)
+        kill(-t->slave, SIGKILL);
+}
