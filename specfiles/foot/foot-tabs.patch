+static int
+sidebar_text(const struct terminal *term, struct buffer *buf,
+             const char32_t *text, int x, int y, int row_h, int max_x,
+             uint32_t color, bool gamma)
+{
+    struct fcft_font *font = term->fonts[0];
+    const size_t len = c32len(text);
+    const struct fcft_glyph *ell =
+        fcft_rasterize_char_utf32(font, U'…', term->font_subpixel);
+    const int ell_w = ell != NULL ? ell->advance.x : 0;
+
+    pixman_color_t fg = color_hex_to_pixman(color, gamma);
+    pixman_image_t *src = pixman_image_create_solid_fill(&fg);
+    const int font_h = max(font->height, font->ascent + font->descent);
+    const int base = y + term->font_y_ofs + (row_h - font_h) / 2 + font->ascent;
+
+    int total = 0;
+    for (size_t i = 0; i < len; i++) {
+        const struct fcft_glyph *g =
+            fcft_rasterize_char_utf32(font, text[i], term->font_subpixel);
+        if (g != NULL)
+            total += g->advance.x;
+    }
+    const bool trunc = x + total > max_x;
+
+    for (size_t i = 0; i <= len; i++) {
+        const struct fcft_glyph *g = i < len
+            ? fcft_rasterize_char_utf32(font, text[i], term->font_subpixel)
+            : NULL;
+        if (i < len && g == NULL)
+            continue;
+        if (i == len || (trunc && x + g->advance.x + ell_w > max_x)) {
+            if (!trunc || ell == NULL)
+                break;
+            g = ell;
+            i = len;
+        }
+        pixman_image_composite32(
+            PIXMAN_OP_OVER, g->is_color_glyph ? g->pix : src,
+            g->is_color_glyph ? NULL : g->pix, buf->pix[0], 0, 0, 0, 0,
+            x + term->font_x_ofs + g->x, base - g->y, g->width, g->height);
+        x += g->advance.x;
+    }
+    pixman_image_unref(src);
+    return x;
+}
+
+static void
+sidebar_fill(struct buffer *buf, uint32_t color, uint16_t alpha, bool gamma,
+             int x, int y, int w, int h)
+{
+    pixman_color_t c = color_hex_to_pixman_with_alpha(color, alpha, gamma);
+    pixman_image_fill_rectangles(
+        PIXMAN_OP_SRC, buf->pix[0], &c, 1,
+        &(pixman_rectangle16_t){x, y, w, h});
+}
+
+static char32_t *
+sidebar_label(const struct wl_window *win, const struct terminal *row, bool *bell, bool *act)
+{
+    char *s = NULL;
+    *bell = *act = false;
+    for (const struct terminal *t = row; t != NULL;) {
+        const char *title = t->window_title != NULL ? t->window_title : "foot";
+        char *n = s == NULL ? xstrdup(title) : xasprintf("%s │ %s", s, title);
+        free(s);
+        s = n;
+        if (!tabs_is_visible(t)) {
+            *bell |= t->tab_marker;
+            *act |= t->tab_activity;
+        }
+        const struct terminal *next = NULL;
+        bool found = false;
+        tll_foreach(win->tabs, it) {
+            if (found) {
+                next = it->item;
+                break;
+            }
+            found = it->item == t;
+        }
+        t = t->group != 0 && next != NULL && next->group == t->group ? next : NULL;
+    }
+    char32_t *r = ambstoc32(s);
+    free(s);
+    return r != NULL ? r : xc32dup(U"");
+}
+
+void
+render_sidebar(struct wl_window *win)
+{
+    win->sidebar_dirty = false;
+    render_sidebar_btn(win);
+    if (win->sidebar.surface.surf == NULL)
+        return;
+
+    struct terminal *term = win->term;
+    const float scale = term->scale;
+    const int w = tabs_sidebar_width_px(win);
+    const int h = tabs_sidebar_height_px(win);
+    if (w <= 0 || h <= 0)
+        return;
+
+    struct buffer *buf = shm_get_buffer(win->sidebar_chain, w, h);
+    const bool gamma = wayl_do_linear_blending(term->wl, term->conf);
+    const struct colors *c = &term->colors;
+    const uint16_t alpha = win->is_fullscreen ? 0xffff : c->alpha;
+
+    const bool custom_sel = (c->selection_bg >> 24) == 0;
+    const uint32_t bg = color_blend_towards(c->bg, c->fg, 1.1);
+    const uint32_t sel_bg = custom_sel ? c->selection_bg : c->fg;
+    const uint32_t sel_fg = custom_sel
+        ? ((c->selection_fg >> 24) == 0 ? c->selection_fg : c->fg) : c->bg;
+    const uint32_t accent = (c->cursor_bg >> 31) ? c->cursor_bg : c->fg;
+    const uint32_t sel_accent = custom_sel ? accent : c->bg;
+    const int row_h = tabs_sidebar_row_h(win);
+    const int pad = roundf(8 * scale);
+    const int bar = roundf(3 * scale);
+
+    pixman_region32_t clip;
+    pixman_region32_init_rect(&clip, 0, 0, w, h);
+    pixman_image_set_clip_region32(buf->pix[0], &clip);
+    pixman_region32_fini(&clip);
+
+    sidebar_fill(buf, bg, alpha, gamma, 0, 0, w, h);
+
+    tabs_sidebar_scroll_fix(win);
+    const int list_h = h - row_h - 1;
+    const int rows = tabs_row_count(win);
+    struct terminal *act_row = tabs_row_term(win, tabs_row_of(win, term));
+
+    pixman_region32_init_rect(&clip, 0, 0, w, list_h);
+    pixman_image_set_clip_region32(buf->pix[0], &clip);
+    pixman_region32_fini(&clip);
+
+    const uint32_t hover_bg = color_blend_towards(c->bg, c->fg, 1.25);
+    const uint32_t picked_bg = color_blend_towards(c->bg, accent, 1.45);
+    const int line = max(1, (int)roundf(scale));
+    const bool right = term->conf->tabs.right;
+
+    for (int r = 0; r < rows; r++) {
+        const int y = (r - win->sidebar_scroll) * row_h;
+        if (y + row_h <= 0 || y >= list_h)
+            continue;
+        struct terminal *t = tabs_row_term(win, r);
+        const bool active = t == act_row;
+        const bool grabbed = win->sidebar_drag.dragging && win->sidebar_drag.tab == t;
+        const bool hovered = win->hover.what == TAB_HOVER_ROW && win->hover.row == r;
+
+        if (active)
+            sidebar_fill(buf, sel_bg, 0xffff, gamma, 0, y, w, row_h);
+        else if (t->tab_selected)
+            sidebar_fill(buf, picked_bg, 0xffff, gamma, 0, y, w, row_h);
+        else if (hovered || grabbed)
+            sidebar_fill(buf, hover_bg, alpha, gamma, 0, y, w, row_h);
+
+        if (active || t->tab_selected)
+            sidebar_fill(buf, active ? sel_accent : accent, 0xffff, gamma,
+                         right ? w - bar : 0, y, bar, row_h);
+
+        if (grabbed) {
+            const uint32_t o = win->sidebar_drag.drop == TAB_DROP_NONE ? accent : c->table[3];
+            sidebar_fill(buf, o, 0xffff, gamma, 0, y, w, 2 * line);
+            sidebar_fill(buf, o, 0xffff, gamma, 0, y + row_h - 2 * line, w, 2 * line);
+            sidebar_fill(buf, o, 0xffff, gamma, 0, y, 2 * line, row_h);
+            sidebar_fill(buf, o, 0xffff, gamma, w - 2 * line, y, 2 * line, row_h);
+        }
+
+        bool bell, act;
+        char32_t *label = sidebar_label(win, t, &bell, &act);
+        const char32_t *mark = bell ? U" •" : act ? U" ◦" : NULL;
+        const struct fcft_glyph *mg = mark != NULL
+            ? fcft_rasterize_char_utf32(term->fonts[0], mark[1], term->font_subpixel)
+            : NULL;
+        const int mark_w = mg != NULL ? 2 * mg->advance.x : 0;
+        const char32_t *hint =
+            grabbed && win->sidebar_drag.drop == TAB_DROP_SPLIT ? U"⇥ split " :
+            grabbed && win->sidebar_drag.drop == TAB_DROP_DETACH ? U"↗ new window " : NULL;
+        const uint32_t fg = active ? sel_fg : c->fg;
+        int x = pad;
+        if (hint != NULL)
+            x = sidebar_text(term, buf, hint, x, y, row_h, w - pad, c->table[3], gamma);
+        x = sidebar_text(term, buf, label, x, y, row_h, w - pad - mark_w, fg, gamma);
+        if (mark != NULL)
+            sidebar_text(term, buf, mark, x, y, row_h, w,
+                         bell ? c->table[3] : c->table[4], gamma);
+        free(label);
+    }
+
+    if (win->drop_row >= 0) {
+        const int y = (win->drop_row - win->sidebar_scroll) * row_h;
+        sidebar_fill(buf, accent, 0xffff, gamma, 0, max(0, y - line), w, 3 * line);
+    }
+
+    pixman_image_set_clip_region32(buf->pix[0], NULL);
+    const int fy = h - row_h;
+    sidebar_fill(buf, c->fg, 0x4000, gamma, 0, fy - 1, w, 1);
+    if (win->hover.what == TAB_HOVER_NEW)
+        sidebar_fill(buf, hover_bg, alpha, gamma, 0, fy, 2 * row_h, row_h);
+    if (win->hover.what == TAB_HOVER_HIDE)
+        sidebar_fill(buf, hover_bg, alpha, gamma, w - row_h, fy, row_h, row_h);
+    sidebar_text(term, buf, U"+", pad, fy, row_h, w, c->fg, gamma);
+    sidebar_text(term, buf, right ? U"›" : U"‹",
+                 w - row_h / 2 - pad / 2, fy, row_h, w, c->fg, gamma);
+
+    if (win->sidebar_resize.hover || win->sidebar_resize.seat != NULL)
+        sidebar_fill(buf, accent, 0xffff, gamma,
+                     term->conf->tabs.right ? 0 : w - bar, 0, bar, h);
+
+    pixman_image_set_clip_region32(buf->pix[0], NULL);
+
+    struct wayl_surface *surf = &win->sidebar.surface;
+    wayl_surface_scale(win, surf, buf, scale);
+    wl_surface_attach(surf->surf, buf->wl_buf, 0, 0);
+    wl_surface_damage_buffer(surf->surf, 0, 0, w, h);
+    if (alpha == 0xffff) {
+        struct wl_region *region = wl_compositor_create_region(term->wl->compositor);
+        if (region != NULL) {
+            wl_region_add(region, 0, 0, w, h);
+            wl_surface_set_opaque_region(surf->surf, region);
+            wl_region_destroy(region);
+        }
+    } else
+        wl_surface_set_opaque_region(surf->surf, NULL);
+    wl_surface_commit(surf->surf);
+}
+
+static void
+ui_commit(struct wl_window *win, struct wayl_surface *surf, struct buffer *buf,
+          int w, int h, bool opaque)
+{
+    struct terminal *term = win->term;
+    wayl_surface_scale(win, surf, buf, term->scale);
+    wl_surface_attach(surf->surf, buf->wl_buf, 0, 0);
+    wl_surface_damage_buffer(surf->surf, 0, 0, w, h);
+    struct wl_region *region = opaque
+        ? wl_compositor_create_region(term->wl->compositor) : NULL;
+    if (region != NULL) {
+        wl_region_add(region, 0, 0, w, h);
+        wl_surface_set_opaque_region(surf->surf, region);
+        wl_region_destroy(region);
+    } else
+        wl_surface_set_opaque_region(surf->surf, NULL);
+    wl_surface_commit(surf->surf);
+}
+
+void
+render_sidebar_btn(struct wl_window *win)
+{
+    if (win->sidebar_btn.surface.surf == NULL)
+        return;
+
+    struct terminal *term = win->term;
+    const struct colors *c = &term->colors;
+    const bool gamma = wayl_do_linear_blending(term->wl, term->conf);
+    const int s = tabs_sidebar_btn_px(win);
+    struct buffer *buf = shm_get_buffer(win->sidebar_chain, s, s);
+
+    pixman_image_set_clip_region32(buf->pix[0], NULL);
+    sidebar_fill(buf, color_blend_towards(c->bg, c->fg, win->hover.btn ? 1.35 : 1.1),
+                 0xffff, gamma, 0, 0, s, s);
+    const char32_t *arrow = term->conf->tabs.right ? U"‹" : U"›";
+    const struct fcft_glyph *g =
+        fcft_rasterize_char_utf32(term->fonts[0], arrow[0], term->font_subpixel);
+    const int gw = g != NULL ? g->advance.x : 0;
+    sidebar_text(term, buf, arrow, (s - gw) / 2, 0, s, s, c->fg, gamma);
+    ui_commit(win, &win->sidebar_btn.surface, buf, s, s, true);
+}
+
+void
+render_tab_menu(struct wl_window *win)
+{
+    if (win->menu.kind == TAB_MENU_NONE || win->menu_surf.surface.surf == NULL)
+        return;
+
+    struct terminal *term = win->term;
+    const struct colors *c = &term->colors;
+    const bool gamma = wayl_do_linear_blending(term->wl, term->conf);
+    const float scale = term->scale;
+    const int cw = term->cell_width, ch = term->cell_height;
+    const int line = max(1, (int)roundf(scale));
+
+    char32_t *header = NULL;
+    if (win->menu.kind == TAB_MENU_CONFIRM_KILL) {
+        const struct terminal *t = win->menu.target;
+        char *h = xasprintf("Kill “%s”?",
+                            t->window_title != NULL ? t->window_title : "foot");
+        header = ambstoc32(h);
+        free(h);
+    }
+
+    size_t cols = header != NULL ? min(c32len(header), (size_t)40) : 0;
+    for (int i = 0; i < win->menu.n; i++)
+        cols = max(cols, strlen(tabs_menu_label(win, i)));
+    cols += 4;
+    win->menu.header = header != NULL;
+    const int rows = win->menu.n + win->menu.header + 2;
+    /* Buffer size must be a multiple of the scale */
+    const int w = (int)(ceilf(cols * cw / scale) * scale);
+    const int h = (int)(ceilf(rows * ch / scale) * scale);
+    win->menu.w = w;
+    win->menu.h = h;
+
+    int ww, wh;
+    tabs_win_size(win, &ww, &wh);
+    const int x = max(0, min(win->menu.x, (int)roundf(ww * scale) - w));
+    const int y = max(0, min(win->menu.y, (int)roundf(wh * scale) - h));
+
+    struct buffer *buf = shm_get_buffer(win->menu_chain, w, h);
+    pixman_image_set_clip_region32(buf->pix[0], NULL);
+    sidebar_fill(buf, c->bg, 0xffff, gamma, 0, 0, w, h);
+
+    const int x0 = cw / 2, y0 = ch / 2, x1 = w - cw / 2, y1 = h - ch / 2;
+    sidebar_fill(buf, c->fg, 0xffff, gamma, x0, y0, x1 - x0, line);
+    sidebar_fill(buf, c->fg, 0xffff, gamma, x0, y1 - line, x1 - x0, line);
+    sidebar_fill(buf, c->fg, 0xffff, gamma, x0, y0, line, y1 - y0);
+    sidebar_fill(buf, c->fg, 0xffff, gamma, x1 - line, y0, line, y1 - y0);
+
+    if (header != NULL) {
+        sidebar_text(term, buf, header, 2 * cw, ch, ch, w - 2 * cw, c->table[1], gamma);
+        free(header);
+    }
+
+    for (int i = 0; i < win->menu.n; i++) {
+        const int ry = (1 + win->menu.header + i) * ch;
+        const bool sel = i == win->menu.sel;
+        if (sel)
+            sidebar_fill(buf, c->fg, 0xffff, gamma, cw, ry, w - 2 * cw, ch);
+        char32_t *label = ambstoc32(tabs_menu_label(win, i));
+        sidebar_text(term, buf, label != NULL ? label : U"", 2 * cw, ry, ch,
+                     w - 2 * cw, sel ? c->bg : c->fg, gamma);
+        free(label);
+    }
+
+    wl_subsurface_set_position(
+        win->menu_surf.sub, (int)roundf(x / scale), (int)roundf(y / scale));
+    ui_commit(win, &win->menu_surf.surface, buf, w, h, true);
+    wl_surface_commit(win->surface.surf);
+}
+
+static int
+text_width(const struct terminal *term, const char32_t *text)
+{
+    int w = 0;
+    for (; *text != U'\0'; text++) {
+        const struct fcft_glyph *g =
+            fcft_rasterize_char_utf32(term->fonts[0], *text, term->font_subpixel);
+        if (g != NULL)
+            w += g->advance.x;
+    }
+    return w;
+}
+
+void
+render_tab_drop_hint(struct wl_window *win)
+{
+    if (!win->drop_split) {
+        if (win->hint_surf.surface.surf != NULL) {
+            wayl_win_subsurface_destroy(&win->hint_surf);
+            memset(&win->hint_surf, 0, sizeof(win->hint_surf));
+        }
+        return;
+    }
+
+    struct terminal *term = win->term;
+    if (win->hint_surf.surface.surf == NULL) {
+        if (!wayl_win_subsurface_new(win, &win->hint_surf, false))
+            return;
+        wl_subsurface_set_desync(win->hint_surf.sub);
+    }
+
+    const struct colors *c = &term->colors;
+    const bool gamma = wayl_do_linear_blending(term->wl, term->conf);
+    const float scale = term->scale;
+    const uint32_t accent = (c->cursor_bg >> 31) ? c->cursor_bg : c->fg;
+    const int line = max(1, (int)roundf(2 * scale));
+
+    int ww, wh;
+    tabs_win_size(win, &ww, &wh);
+    const size_t n = tabs_group_len(term);
+    const int pw = tabs_pane_width(win, ww, n + 1);
+    const int lx = (int)roundf(tabs_sidebar_left_px(win) / scale) + (int)n * (pw + 4);
+    const int w = (int)roundf(pw * scale), h = (int)roundf(wh * scale);
+    if (w <= 0 || h <= 0)
+        return;
+
+    struct buffer *buf = shm_get_buffer(win->menu_chain, w, h);
+    pixman_image_set_clip_region32(buf->pix[0], NULL);
+    sidebar_fill(buf, accent, 0x3800, gamma, 0, 0, w, h);
+    sidebar_fill(buf, accent, 0xffff, gamma, 0, 0, w, line);
+    sidebar_fill(buf, accent, 0xffff, gamma, 0, h - line, w, line);
+    sidebar_fill(buf, accent, 0xffff, gamma, 0, 0, line, h);
+    sidebar_fill(buf, accent, 0xffff, gamma, w - line, 0, line, h);
+
+    const char32_t *label = U"⇥ split here";
+    const int tw = text_width(term, label);
+    const int rh = term->cell_height * 2;
+    sidebar_text(term, buf, label, max(line, (w - tw) / 2), (h - rh) / 2, rh, w,
+                 c->fg, gamma);
+
+    wl_subsurface_set_position(win->hint_surf.sub, lx, 0);
+    ui_commit(win, &win->hint_surf.surface, buf, w, h, false);
+    wl_surface_commit(win->surface.surf);
+}
+
+void
+render_tab_drag_icon(struct wayland *wayl)
+{
+    struct terminal *t = wayl->tab_dnd.tab;
+    struct wl_surface *icon = wayl->tab_dnd.icon;
+    if (t == NULL || icon == NULL)
+        return;
+
+    const struct colors *c = &t->colors;
+    const bool gamma = wayl_do_linear_blending(wayl, t->conf);
+    const int s = max(1, (int)ceilf(t->scale));
+    const uint32_t accent = (c->cursor_bg >> 31) ? c->cursor_bg : c->fg;
+
+    char32_t *label = ambstoc32(t->window_title != NULL ? t->window_title : "foot");
+    if (label == NULL)
+        label = xc32dup(U"foot");
+    const int pad = 8 * s;
+    const int rh = t->fonts[0]->height + 2 * pad;
+    int w = min(text_width(t, label) + 2 * pad, 360 * s);
+    w = (w + s - 1) / s * s;
+    const int h = (rh + s - 1) / s * s;
+
+    struct buffer *buf = shm_get_buffer(wayl->tab_dnd.icon_chain, w, h);
+    pixman_image_set_clip_region32(buf->pix[0], NULL);
+    sidebar_fill(buf, color_blend_towards(c->bg, c->fg, 1.15), 0xf000, gamma, 0, 0, w, h);
+    sidebar_fill(buf, accent, 0xffff, gamma, 0, 0, w, s);
+    sidebar_fill(buf, accent, 0xffff, gamma, 0, h - s, w, s);
+    sidebar_fill(buf, accent, 0xffff, gamma, 0, 0, s, h);
+    sidebar_fill(buf, accent, 0xffff, gamma, w - s, 0, s, h);
+    sidebar_text(t, buf, label, pad, 0, h, w - pad, c->fg, gamma);
+    free(label);
+
+    wl_surface_set_buffer_scale(icon, s);
+    wl_surface_attach(icon, buf->wl_buf, 0, 0);
+    wl_surface_damage_buffer(icon, 0, 0, w, h);
+    wl_surface_commit(icon);
+}
+
+void
+render_refresh_sidebar(struct wl_window *win)
+{
+    win->sidebar_dirty = true;
+    if (win->term != NULL)
+        win->term->render.refresh.csd = true;
+}
+
+void
+render_split_layout(struct wl_window *win)
+{
+    struct terminal *act = win->term;
+    const float scale = act->scale;
+    const int W = roundf(win->layout_w * scale);
+    const int H = roundf(win->layout_h * scale);
+    if (W <= 0 || H <= 0)
+        return;
+    size_t n = 0;
+
+    tll_foreach(win->tabs, it) {
+        struct terminal *t = it->item;
+        if (!tabs_is_visible(t))
+            continue;
+        if (t->pane.surface.surf == NULL) {
+            if (!wayl_win_subsurface_new(win, &t->pane, true))
+                continue;
+            wl_subsurface_set_desync(t->pane.sub);
+            shm_unref(t->render.last_buf);
+            t->render.last_buf = NULL;
+            term_damage_view(t);
+        }
+        wl_subsurface_set_position(t->pane.sub, tabs_pane_x(t), 0);
+        render_refresh(t);
+        n++;
+    }
+
+    /* The background has no terminal behind it */
+    struct wl_region *none = wl_compositor_create_region(act->wl->compositor);
+    if (none != NULL) {
+        wl_surface_set_input_region(win->surface.surf, none);
+        wl_region_destroy(none);
+    }
+
+    struct buffer *buf = shm_get_buffer(win->bg_chain, W, H);
+    const bool gamma = wayl_do_linear_blending(act->wl, act->conf);
+    const uint16_t alpha = win->is_fullscreen ? 0xffff : act->colors.alpha;
+    sidebar_fill(buf, act->colors.bg, alpha, gamma, 0, 0, W, H);
+    /* Translucent panes would otherwise stack on a translucent background */
+    tll_foreach(win->tabs, it) {
+        const struct terminal *t = it->item;
+        if (t->pane.surface.surf != NULL)
+            sidebar_fill(buf, 0, 0, gamma, roundf(tabs_pane_x(t) * scale), 0, t->width, H);
+    }
+    wayl_win_scale(win, buf);
+    wl_surface_attach(win->surface.surf, buf->wl_buf, 0, 0);
+    wl_surface_damage_buffer(win->surface.surf, 0, 0, W, H);
+
+    const int min_w = tabs_sidebar_width_px(win) +
+        n * act->cell_width + (n - 1) * roundf(4 * scale);
+    render_set_window_geometry(win, scale, W, H, min_w, act->cell_height);
+    render_refresh_csd(act);
+    render_refresh_sidebar(win);
+    wl_surface_commit(win->surface.surf);
+}
