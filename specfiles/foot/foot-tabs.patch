+                w.launch_argc = argc;
+                w.launch_argv = argv;
+                argv = NULL;
+                argc = 0;
+            } else
+                command_push(&w.commands, true, dir != NULL ? dir : w.cwd, argc, argv);
+        }
+
+        argv_free(argc, argv);
+        argv_free(pargc, pargv);
