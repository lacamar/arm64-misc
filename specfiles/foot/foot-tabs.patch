+static const struct session_restore_rule *
+duplicate_rule(const struct config *conf, const char *base)
+{
+    tll_foreach(conf->session.duplicate_rules, it) {
+        if (streq(it->item.program, base))
+            return &it->item;
+    }
+    tll_foreach(conf->session.restore_rules, it) {
+        if (streq(it->item.program, base))
+            return &it->item;
+    }
+    return NULL;
+}
