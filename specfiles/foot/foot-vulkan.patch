diff --git a/shaders/quad.frag b/shaders/quad.frag
new file mode 100644
index 0000000..5ea17e6
--- /dev/null
+++ b/shaders/quad.frag
@@ -0,0 +1,19 @@
+#version 450
+layout(set = 0, binding = 0) uniform sampler2D atlas;
+layout(location = 0) in vec2 uv;
+layout(location = 1) flat in vec4 col;
+layout(location = 2) flat in uint md;
+layout(location = 0, index = 0) out vec4 o;
+layout(location = 0, index = 1) out vec4 k;
+void main() {
+    uint m = md & 15u;
+    vec4 c = col, cov = vec4(1.0);
+    if (m != 0u) {
+        vec4 t = texelFetch(atlas, ivec2(uv), 0);
+        if (m == 1u) cov = vec4(t.a);
+        else if (m == 2u) c = t;
+        else cov = t;
+    }
+    o = c * cov;
+    k = (md & 16u) != 0u ? vec4(1.0) : c.a * cov;
+}
diff --git a/shaders/quad.vert b/shaders/quad.vert
new file mode 100644
index 0000000..fbe1c25
--- /dev/null
+++ b/shaders/quad.vert
@@ -0,0 +1,17 @@
+#version 450
+layout(location = 0) in vec4 rect;
+layout(location = 1) in vec2 uv0;
+layout(location = 2) in vec4 color;
+layout(location = 3) in uint mode;
+layout(push_constant) uniform PC { vec2 vp; } pc;
+layout(location = 0) out vec2 uv;
+layout(location = 1) flat out vec4 col;
+layout(location = 2) flat out uint md;
+void main() {
+    vec2 c = vec2(gl_VertexIndex & 1, gl_VertexIndex >> 1);
+    vec2 p = rect.xy + c * rect.zw;
+    gl_Position = vec4(p / pc.vp * 2.0 - 1.0, 0.0, 1.0);
+    uv = uv0 + c * rect.zw;
+    col = color;
+    md = mode;
+}
