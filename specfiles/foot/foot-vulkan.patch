diff --git a/vulkan.c b/vulkan.c
new file mode 100644
index 0000000..1d8edd4
--- /dev/null
+++ b/vulkan.c
@@ -0,0 +1,994 @@
+#include "vulkan.h"
+
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
