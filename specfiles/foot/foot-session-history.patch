+/* History: previous sessions, newest first */
+
+static void
+history_free(struct session *s)
+{
+    for (size_t i = 0; i < s->history_n; i++)
+        free(s->history[i].path);
+    free(s->history);
+    s->history = NULL;
+    s->history_n = 0;
+}
+
+static int
+history_cmp(const void *_a, const void *_b)
+{
+    const struct history_entry *a = _a, *b = _b;
+    if (a->when != b->when)
+        return a->when > b->when ? -1 : 1;
+    return -strcmp(a->path, b->path);
+}
+
+static void
+history_scan(struct session *s)
+{
+    history_free(s);
+    DIR *d = opendir(s->history_dir);
+    if (d == NULL)
+        return;
+
+    for (struct dirent *e; (e = readdir(d)) != NULL;) {
+        const size_t len = strlen(e->d_name);
+        if (len <= 6 || !streq(e->d_name + len - 6, ".state"))
+            continue;
+        char *path = xasprintf("%s/%s", s->history_dir, e->d_name);
+        struct stat st;
+        if (stat(path, &st) < 0) {
+            free(path);
+            continue;
+        }
+        s->history = xrealloc(s->history, (s->history_n + 1) * sizeof(s->history[0]));
+        s->history[s->history_n++] = (struct history_entry){
+            .path = path, .when = st.st_mtime};
+    }
+    closedir(d);
+    qsort(s->history, s->history_n, sizeof(s->history[0]), &history_cmp);
+}
+
+static void
+history_prune(struct session *s)
+{
+    history_scan(s);
+    while (s->history_n > s->conf->session.history) {
+        struct history_entry *h = &s->history[--s->history_n];
+        unlink(h->path);
+        free(h->path);
+    }
+}
+
+/* Moves a saved session into the history, so it is never restored twice
+ * (e.g. if restoring crashes) yet is never lost either */
+static void
+archive_state(struct session *s, const char *src, window_list_t *out, char **xdg_id)
+{
+    struct stat st;
