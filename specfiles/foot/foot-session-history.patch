+    for (int i = 1; access(dst, F_OK) == 0; i++) {
+        free(dst);
+        dst = xasprintf("%s/%lld-%d.state", s->history_dir, (long long)st.st_mtime, i);
+    }
+
+    if (!mkdir_parent(dst) || rename(src, dst) < 0) {
+        LOG_ERRNO("%s: failed to move to %s", src, dst);
+        free(dst);
+        return;
+    }
 
-    /* Never restore the same state twice, e.g. if restoring crashes */
-    char *backup = xstrjoin(path, ".restored");
-    rename(path, backup);
-    free(backup);
+    if (read_state(dst, out, xdg_id) && tll_length(*out) == 0)
+        unlink(dst);
