+/* History menu: recently closed tabs, then previous sessions */
+
+size_t
+session_history_load(struct session *s)
+{
+    if (s == NULL)
+        return 0;
+
+    history_scan(s);
+    size_t kept = 0;
+    for (size_t i = 0; i < s->history_n; i++) {
+        struct history_entry h = s->history[i];
+        window_list_t windows = tll_init();
+        char *xdg_id = NULL;
+        read_state(h.path, &windows, &xdg_id);
+        h.tabs = tll_length(windows);
+        const char *prev = NULL;
+        tll_foreach(windows, it) {
+            if (prev == NULL || !streq(prev, it->item->name))
+                h.windows++;
+            prev = it->item->name;
+        }
+        windows_free(&windows);
+        free(xdg_id);
+        if (h.tabs > 0)
+            s->history[kept++] = h;
+        else
+            free(h.path);
+    }
+    s->history_n = kept;
+    return tll_length(s->recent) + s->history_n;
+}
+
+bool
+session_history_is_tab(const struct session *s, size_t idx)
+{
+    return s != NULL && idx < tll_length(s->recent);
+}
+
+static char *
+tab_label(const struct session_window *w)
+{
+    const char *prog = "shell";
+    if (w->label != NULL && w->label[0] != '\0')
+        prog = w->label;
+    else if (tll_length(w->commands) > 0 && tll_front(w->commands).argc > 0)
+        prog = tll_front(w->commands).argv[0];
+    else if (w->launch_argc > 0)
+        prog = w->launch_argv[0];
+    const char *base = strrchr(prog, '/');
+    if (base != NULL && w->label == NULL)
+        prog = base + 1;
+
+    const char *home = getenv("HOME");
+    const size_t hl = home != NULL ? strlen(home) : 0;
+    if (hl > 1 && strncmp(w->cwd, home, hl) == 0 &&
+        (w->cwd[hl] == '/' || w->cwd[hl] == '\0'))
+    {
+        return xasprintf("↺ %s  ~%s", prog, w->cwd + hl);
+    }
+    return xasprintf("↺ %s  %s", prog, w->cwd);
+}
+
+char *
+session_history_label(const struct session *s, size_t idx)
+{
+    if (s == NULL)
+        return xstrdup("");
+
+    size_t i = 0;
+    tll_foreach(s->recent, it) {
+        if (i++ == idx)
+            return tab_label(it->item);
+    }
+
+    idx -= tll_length(s->recent);
+    if (idx >= s->history_n)
+        return xstrdup("");
+
+    const struct history_entry *h = &s->history[idx];
+    char when[64];
+    struct tm tm;
+    if (localtime_r(&h->when, &tm) == NULL ||
+        strftime(when, sizeof(when), "%a %d %b %H:%M", &tm) == 0)
+    {
+        when[0] = '\0';
+    }
+    return xasprintf("◷ Session %s  %zu tab%s, %zu window%s", when,
+                     h->tabs, h->tabs == 1 ? "" : "s",
+                     h->windows, h->windows == 1 ? "" : "s");
+}
+
+/* Opens alongside the current windows, never merging into them */
+void
+session_history_restore(struct session *s, size_t idx)
+{
+    if (s == NULL || idx < tll_length(s->recent))
+        return;
+    idx -= tll_length(s->recent);
+    if (idx >= s->history_n)
+        return;
+
+    window_list_t windows = tll_init();
+    char *xdg_id = NULL;
+    read_state(s->history[idx].path, &windows, &xdg_id);
+    free(xdg_id);
+
+    char *orig = NULL, *fresh = NULL;
+    tll_foreach(windows, it) {
+        struct session_window *w = it->item;
+        if (orig == NULL || !streq(orig, w->name)) {
+            free(orig);
+            free(fresh);
+            orig = xstrdup(w->name);
+            fresh = toplevel_name_new();
+        }
+        free(w->name);
+        w->name = xstrdup(fresh);
+    }
+    free(orig);
+    free(fresh);
+
+    restore_windows(s, windows);
+}
