+enum tab_busy { BUSY_NONE, BUSY_QUIET, BUSY_CPU };
+
+#define BUSY_CPU_TICKS 5  /* per second: 5% of a core */
+
+bool
+tabs_spinning(const struct terminal *term)
+{
+    const uint64_t now = tabs_now_ms();
+    return term->busy == BUSY_CPU ||
+        (term->spin_last - term->spin_prev < 2000 && now - term->spin_last < 2000);
+}
+
+bool
+tabs_busy_quiet(const struct terminal *term)
+{
+    return term->busy == BUSY_QUIET && !tabs_spinning(term);
+}
+
+/* Blocked reading the terminal: waiting for the user */
+static bool
+reads_tty(pid_t pid)
+{
+    char path[64], buf[128];
+    snprintf(path, sizeof(path), "/proc/%d/syscall", (int)pid);
+    FILE *f = fopen(path, "re");
+    if (f == NULL)
+        return false;
+    long nr = -1;
+    unsigned long fd = 1;
+    const bool ok = fscanf(f, "%ld %lx", &nr, &fd) == 2;
+    fclose(f);
+    if (!ok || nr != SYS_read || fd != 0)
+        return false;
+
+    snprintf(path, sizeof(path), "/proc/%d/fd/0", (int)pid);
+    const ssize_t n = readlink(path, buf, sizeof(buf) - 1);
+    return n > 0 && strncmp(buf, "/dev/pts/", 9) == 0;
+}
+
+struct job {
+    pid_t fg;
+    int procs;
+    int children;
+    unsigned long long cpu;
+    bool reading;
+};
+
+/* Descendants of the shell in the terminal's foreground process group */
+static void
+job_walk(pid_t pid, bool self, struct job *job, int depth)
+{
+    char path[64];
+    {
+        snprintf(path, sizeof(path), "/proc/%d/stat", (int)pid);
+        FILE *f = fopen(path, "re");
+        if (f == NULL)
+            return;
+        char buf[1024];
+        const size_t n = fread(buf, 1, sizeof(buf) - 1, f);
+        fclose(f);
+        buf[n] = '\0';
+        const char *p = strrchr(buf, ')');
+        int pgrp;
+        unsigned long ut, st;
+        long cut, cst;
+        if (p == NULL ||
+            sscanf(p + 1, " %*c %*d %d %*d %*d %*d %*u %*u %*u %*u %*u %lu %lu %ld %ld",
+                   &pgrp, &ut, &st, &cut, &cst) != 5)
+        {
+            return;
+        }
+        if (pgrp == job->fg) {
+            job->procs++;
+            job->children += !self;
+            /* A shell's reaped children are finished commands */
+            job->cpu += ut + st + (self ? 0 : cut + cst);
+            job->reading = job->reading || reads_tty(pid);
+        }
+    }
+    if (depth >= 16)
+        return;
+
+    snprintf(path, sizeof(path), "/proc/%d/task", (int)pid);
+    DIR *d = opendir(path);
+    if (d == NULL)
+        return;
+    for (struct dirent *e; (e = readdir(d)) != NULL;) {
+        if (e->d_name[0] == '.')
+            continue;
+        char cpath[96];
+        snprintf(cpath, sizeof(cpath), "/proc/%d/task/%.16s/children", (int)pid, e->d_name);
+        FILE *f = fopen(cpath, "re");
+        if (f == NULL)
+            continue;
+        for (int child; fscanf(f, "%d", &child) == 1;)
+            job_walk(child, false, job, depth + 1);
+        fclose(f);
+    }
+    closedir(d);
+}
+
+/* Returns whether a command is running in the terminal */
+static bool
+busy_check(struct terminal *t)
+{
+    struct job job = {.fg = t->ptmx >= 0 ? tcgetpgrp(t->ptmx) : -1};
+    if (job.fg > 0 && t->slave > 0)
+        job_walk(t->slave, true, &job, 0);
+
+    const unsigned long long prev = t->busy_cpu;
+    t->busy_cpu = job.cpu;
+    if (job.procs == 0) {
+        t->busy = BUSY_NONE;
+        return false;
+    }
+
+    struct termios tio;
+    if (prev != 0 && job.cpu > prev && job.cpu - prev >= BUSY_CPU_TICKS)
+        t->busy = BUSY_CPU;
+    else if (job.reading || (tcgetattr(t->ptmx, &tio) == 0 && !(tio.c_lflag & ICANON)))
+        t->busy = BUSY_NONE;  /* waiting for input, or an interactive program */
+    else
+        t->busy = BUSY_QUIET;
+    return job.children > 0 || t->busy != BUSY_NONE;
+}
+
+static bool
+fdm_busy(struct fdm *fdm, int fd, int events, void *data)
+{
+    struct wl_window *win = data;
+    uint64_t expirations;
+    (void)!read(fd, &expirations, sizeof(expirations));
+
+    bool running = false, changed = false, cpu = false;
+    tll_foreach(win->tabs, it) {
+        struct terminal *t = it->item;
+        const int was = t->busy;
+        running |= busy_check(t);
+        changed |= t->busy != was;
+        cpu |= t->busy == BUSY_CPU;
+    }
+    if (!running) {
+        fdm_del(fdm, fd);
+        win->busy_fd = -1;
+    }
+    if (cpu)
+        tabs_spin_poke(win);
+    if (changed)
+        render_refresh_sidebar(win);
+    return true;
+}
+
+void
+tabs_busy_poke(struct wl_window *win)
+{
+    if (win->busy_fd >= 0)
+        return;
+    int fd = timerfd_create(CLOCK_MONOTONIC, TFD_CLOEXEC | TFD_NONBLOCK);
+    if (fd < 0)
+        return;
+    const struct itimerspec its = {
+        .it_interval = {.tv_sec = 1},
+        .it_value = {.tv_sec = 1},
+    };
+    if (timerfd_settime(fd, 0, &its, NULL) < 0 ||
+        !fdm_add(win->term->fdm, fd, EPOLLIN, &fdm_busy, win))
+    {
+        close(fd);
+        return;
+    }
+    win->busy_fd = fd;
+}
+
+int
+tabs_spin_frame(void)
+{
+    return tabs_now_ms() / 100 % 10;
+}
+
+static bool
+fdm_spin(struct fdm *fdm, int fd, int events, void *data)
+{
+    struct wl_window *win = data;
+    uint64_t expirations;
+    (void)!read(fd, &expirations, sizeof(expirations));
+
+    bool any = false;
+    tll_foreach(win->tabs, it)
+        any |= tabs_spinning(it->item);
+    if (!any) {
+        fdm_del(fdm, fd);
+        win->spin_fd = -1;
+    }
+    render_refresh_sidebar(win);
+    return true;
+}
+
+void
+tabs_spin_poke(struct wl_window *win)
+{
+    if (win->spin_fd >= 0)
+        return;
+    int fd = timerfd_create(CLOCK_MONOTONIC, TFD_CLOEXEC | TFD_NONBLOCK);
+    if (fd < 0)
+        return;
+    const struct itimerspec its = {
+        .it_interval = {.tv_nsec = 100 * 1000000},
+        .it_value = {.tv_nsec = 100 * 1000000},
+    };
+    if (timerfd_settime(fd, 0, &its, NULL) < 0 ||
+        !fdm_add(win->term->fdm, fd, EPOLLIN, &fdm_spin, win))
+    {
+        close(fd);
+        return;
+    }
+    win->spin_fd = fd;
+}
+
