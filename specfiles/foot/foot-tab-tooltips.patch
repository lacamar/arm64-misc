+void
+render_tab_tooltip(struct wl_window *win, const char *text)
+{
+    if (text == NULL)
+        return;
+
+    struct terminal *term = win->term;
+    if (win->tip_surf.surface.surf == NULL) {
+        if (!wayl_win_subsurface_new(win, &win->tip_surf, false))
+            return;
+        wl_subsurface_set_desync(win->tip_surf.sub);
+    }
+
+    const struct colors *c = &term->colors;
+    const bool gamma = wayl_do_linear_blending(term->wl, term->conf);
+    const float scale = term->scale;
+    const int pad = (int)roundf(6 * scale);
+    const int line = max(1, (int)roundf(scale));
+    const int lh = term->cell_height;
+
+    int W, H;
+    tabs_win_size(win, &W, &H);
+
+    char32_t *lines[4];
+    int n = 0, tw = 0;
+    char *copy = xstrdup(text);
+    char *save = NULL;
+    for (char *tok = strtok_r(copy, "\n", &save); tok != NULL && n < (int)ALEN(lines);
+         tok = strtok_r(NULL, "\n", &save))
+    {
+        char32_t *l = ambstoc32(tok);
+        if (l == NULL)
+            continue;
+        lines[n++] = l;
+        tw = max(tw, text_width(term, l));
+    }
+    free(copy);
+
+    const int w = min(tw + 2 * pad, (int)roundf(W * scale));
+    const int h = n * lh + 2 * pad;
+    struct buffer *buf = shm_get_buffer(win->sidebar_chain, w, h);
+    pixman_image_set_clip_region32(buf->pix[0], NULL);
+    sidebar_fill(buf, c->bg, 0xffff, gamma, 0, 0, w, h);
+    sidebar_outline(buf, color_blend_towards(c->bg, c->fg, 1.6), gamma, 0, 0, w, h, line);
+    for (int i = 0; i < n; i++) {
+        sidebar_text(term, buf, lines[i], pad, pad + i * lh, lh, w - pad,
+                     i == 0 ? c->fg : color_blend_towards(c->fg, c->bg, 1.6), gamma);
+        free(lines[i]);
+    }
+
+    /* Rows: beside the sidebar; everything else: above the pointer */
+    const bool right = term->conf->tabs.right;
+    const int gap = 6;
+    const int lw = (int)roundf(w / scale), lht = (int)roundf(h / scale);
+    const int sb = (int)roundf(tabs_sidebar_width_px(win) / scale);
+    int x, y;
+    if (win->hover.btn) {
+        x = right ? W - lw - gap : gap;
+        y = H - (int)roundf(tabs_sidebar_btn_px(win) / scale) - lht - gap;
+    } else if (win->hover.what == TAB_HOVER_ROW) {
+        x = right ? W - sb - lw - gap : sb + gap;
+        y = (int)roundf(tabs_line_y(win, win->hover.row) / scale);
+    } else {
+        x = (right ? W - sb : 0) + (int)roundf(win->hover.x / scale) + gap;
+        y = (int)roundf(win->hover.y / scale) - lht - gap;
+    }
+    x = max(0, min(x, W - lw));
+    y = max(0, min(y, H - lht));
+
+    wl_subsurface_set_position(win->tip_surf.sub, x, y);
+    ui_commit(win, &win->tip_surf.surface, buf, w, h, true);
+    wl_surface_commit(win->surface.surf);
+}
