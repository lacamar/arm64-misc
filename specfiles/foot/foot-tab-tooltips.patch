+static char *
+tooltip_text(const struct wl_window *win)
+{
+    if (win->hover.btn)
+        return xstrdup("Show tabs");
+    switch (win->hover.what) {
+    case TAB_HOVER_NEW:       return xstrdup("New tab\nRight-click: reopen closed tab");
+    case TAB_HOVER_HISTORY:   return xstrdup("Session history");
+    case TAB_HOVER_SEARCH:    return xstrdup("Search tabs");
+    case TAB_HOVER_HIDE:      return xstrdup("Hide tabs");
+    case TAB_HOVER_GRIP:      return xstrdup("Drag to resize");
+    case TAB_HOVER_SCROLLBAR: return xstrdup("Drag to scroll");
+    case TAB_HOVER_CLOSE:     return xstrdup("Close tab");
+    case TAB_HOVER_ROW:       break;
+    default:                  return NULL;
+    }
+
+    const struct terminal *t = tabs_line_term(win, win->hover.row);
+    if (t == NULL)
+        return NULL;
+    char *title = tabs_title(t, false);
+    if (t->tab_label != NULL && t->window_title != NULL && t->window_title[0] != '\0' &&
+        strcmp(t->tab_label, t->window_title) != 0)
+    {
+        char *s = xasprintf("%s\n%s", title, t->window_title);
+        free(title);
+        title = s;
+    }
+
+    const char *states[] = {
+        t->tab_pinned ? "pinned" : NULL,
+        t->group_broadcast ? "broadcasting input" : NULL,
+        tabs_spinning(t) ? "busy" : tabs_busy_quiet(t) ? "running" : NULL,
+        t->tab_marker ? "bell" : NULL,
+        t->tab_done ? "finished" : NULL,
+        t->tab_activity ? "new output" : NULL,
+    };
+    char status[128] = "";
+    for (size_t i = 0; i < ALEN(states); i++) {
+        if (states[i] == NULL)
+            continue;
+        const size_t len = strlen(status);
+        snprintf(&status[len], sizeof(status) - len, "%s%s", len > 0 ? " · " : "", states[i]);
+    }
+    if (status[0] == '\0')
+        return title;
+    char *s = xasprintf("%s\n%s", title, status);
+    free(title);
+    return s;
+}
+
+void
+tabs_tooltip_hide(struct wl_window *win)
+{
+    static const struct itimerspec off = {0};
+    if (win->hover.tip_fd >= 0)
+        timerfd_settime(win->hover.tip_fd, 0, &off, NULL);
+    win->hover.tip = false;
+    sub_drop(win, &win->tip_surf);
+}
+
+static bool
+fdm_tip(struct fdm *fdm, int fd, int events, void *data)
+{
+    struct wl_window *win = data;
+    uint64_t expirations;
+    (void)!read(fd, &expirations, sizeof(expirations));
+    char *text = tooltip_text(win);
+    win->hover.tip = text != NULL;
+    render_tab_tooltip(win, text);
+    free(text);
+    return true;
+}
+
+static void
+tooltip_arm(struct wl_window *win)
+{
+    /* Once a tooltip is up, moving to the next element shows its tooltip at once */
+    const bool warm = win->hover.tip;
+    tabs_tooltip_hide(win);
+    if (win->hover.what == TAB_HOVER_NONE && !win->hover.btn)
+        return;
+    if (win->hover.tip_fd < 0) {
+        int fd = timerfd_create(CLOCK_MONOTONIC, TFD_CLOEXEC | TFD_NONBLOCK);
+        if (fd < 0)
+            return;
+        if (!fdm_add(win->term->fdm, fd, EPOLLIN, &fdm_tip, win)) {
+            close(fd);
+            return;
+        }
+        win->hover.tip_fd = fd;
+    }
+    const struct itimerspec its = {.it_value = {.tv_nsec = warm ? 30000000 : 600000000}};
+    timerfd_settime(win->hover.tip_fd, 0, &its, NULL);
+}
