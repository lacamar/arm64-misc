+static GVariant *
+add_request_handle (GVariant      *options,
+                    XdpRequestDex *request)
+{
+  g_auto(GVariantDict) dict = G_VARIANT_DICT_INIT (options);
+
+  g_variant_dict_insert (&dict, "request_handle", "o",
+                         xdp_request_dex_get_object_path (request));
+  return g_variant_ref_sink (g_variant_dict_end (&dict));
+}
+
 static gboolean handle_create_credential (XdpDbusExperimentalCredential *object,
