diff --git a/src/credential.c b/src/credential.c
index 89bad0c..64cbdcf 100644
--- a/src/credential.c
+++ b/src/credential.c
@@ -165,6 +165,17 @@ create_credential_validate_options (GVariant *arg_options,
       return g_variant_ref_sink (g_variant_builder_end (&options));
