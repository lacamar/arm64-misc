   g_autoptr (XdpRequestDex) request = NULL;
   g_autoptr (GVariant) options = NULL;
+  g_autoptr (GVariant) handler_options = NULL;
   g_autoptr (GError) error = NULL;
 
   XdpAppInfo *app_info = xdp_invocation_get_app_info (invocation);
@@ -206,6 +218,8 @@ static gboolean handle_create_credential (XdpDbusExperimentalCredential *object,
       invocation,
       xdp_request_dex_get_object_path (request));
 
+  handler_options = add_request_handle (options, request);
+
   {
     g_autoptr (XdpDbusExperimentalHandlerCredentialCreateCredentialResult) result = NULL;
     result = dex_await_boxed (xdp_dbus_experimental_handler_credential_call_create_credential_future (
@@ -213,7 +227,7 @@ static gboolean handle_create_credential (XdpDbusExperimentalCredential *object,
