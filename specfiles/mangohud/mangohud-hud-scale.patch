+void apply_hud_scale(overlay_params& params, float display_height)
+{
+   if (!params.hud_scale_height || !display_height)
+      return;
+   float s = display_height / params.hud_scale_height;
+   // another swapchain's config parse can reset the shared snapshot
+   if (s == params.hud_scale && s == get_params()->hud_scale)
+      return;
+   auto scale = [s](overlay_params& p) {
+      if (s == p.hud_scale)
+         return;
+      float f = s / p.hud_scale;
+      p.font_size *= f;
+      p.font_size_text *= f;
+      p.font_size_secondary *= f;
+      p.width = lroundf(p.width * f);
+      p.height = lroundf(p.height * f);
+      p.offset_x = lroundf(p.offset_x * f);
+      p.offset_y = lroundf(p.offset_y * f);
+      p.round_corners *= f;
+      p.hud_scale = s;
+   };
+   scale(params);
+   params.font_params_hash = get_hash(params.font_params_hash, s);
+   auto snapshot = std::make_shared<overlay_params>(*get_params());
+   scale(*snapshot);
+   std::atomic_store_explicit(&g_params, std::move(snapshot), std::memory_order_release);
+   real_font_size = ImVec2(params.font_size * params.font_scale, params.font_size * params.font_scale / 2);
+   HUDElements.colors.update = true;
+}
